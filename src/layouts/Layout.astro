---
import '../styles/custom.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { CookieBanner } from '../components/CookieBanner';
import { GITHUB_PROFILE_URL, LINKEDIN_URL, SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: 'website' | 'article';
	keywords?: string[];
	noindex?: boolean;
	frontmatter?: Partial<Props>;
}

const frontmatter = Astro.props.frontmatter ?? {};
const {
	title = frontmatter.title ?? SITE_NAME,
	description = frontmatter.description ?? SITE_DESCRIPTION,
	image = frontmatter.image ?? '/ginni.png',
	canonical = frontmatter.canonical,
	type = frontmatter.type ?? 'website',
	keywords = frontmatter.keywords ?? ['martech', 'data engineering', 'analytics', 'sql', 'python', 'kafka', 'data science'],
	noindex = frontmatter.noindex ?? false,
} = Astro.props as Props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site || SITE_URL).href;
const ogImage = new URL(image, Astro.site || SITE_URL).href;
const robotsContent = noindex
	? 'noindex, nofollow, noarchive'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const structuredData = serializeJsonLd({
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			name: SITE_NAME,
			url: SITE_URL,
			logo: `${SITE_URL}/ginni.png`,
			description: SITE_DESCRIPTION,
			sameAs: [LINKEDIN_URL, GITHUB_PROFILE_URL],
		},
		{
			'@type': 'WebSite',
			name: SITE_NAME,
			url: SITE_URL,
			description: SITE_DESCRIPTION,
			inLanguage: 'it-IT',
			potentialAction: {
				'@type': 'SearchAction',
				target: `${SITE_URL}/?q={search_term_string}`,
				'query-input': 'required name=search_term_string',
			},
		},
	],
});
---

<!doctype html>
<html lang="it" class="scroll-smooth overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords.join(', ')} />
		<meta name="author" content="GinnyTech" />
		<meta name="robots" content={robotsContent} />
		<meta name="googlebot" content={robotsContent} />
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical -->
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" href={canonicalURL} hreflang="it-IT" />
		<link rel="alternate" href={canonicalURL} hreflang="x-default" />

		<!-- Favicon -->
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:site_name" content={SITE_NAME} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- AI/LLM discovery -->
		<link rel="alternate" type="text/plain" title="LLMs.txt" href={`${SITE_URL}/llms.txt`} />

		<script type="application/ld+json" set:html={structuredData} is:inline />

		<GoogleAnalytics {...(Astro.props as any)} />
		<title>{title}</title>
	</head>
	<body class="bg-brand-dark text-slate-200 font-sans antialiased overflow-x-hidden selection:bg-[var(--color-acid-yellow)]/30 selection:text-[var(--color-acid-yellow)]">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-[101] focus:top-4 focus:left-4 focus:bg-white focus:text-black focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg focus:font-medium">
			Vai al contenuto principale
		</a>
		<slot />
		<CookieBanner client:only="react" />
	</body>
</html>
