---
import '../styles/custom.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { CookieBanner } from '../components/CookieBanner';
import { GITHUB_PROFILE_URL, LINKEDIN_URL, SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: 'website' | 'article';
	keywords?: string[];
	noindex?: boolean;
	lang?: 'it' | 'en';
	frontmatter?: Partial<Props>;
}

const frontmatter = Astro.props.frontmatter ?? {};
const {
	title = frontmatter.title ?? SITE_NAME,
	description = frontmatter.description ?? SITE_DESCRIPTION,
	image = frontmatter.image ?? '/ginni.webp',
	canonical = frontmatter.canonical,
	type = frontmatter.type ?? 'website',
	keywords = frontmatter.keywords ?? ['martech', 'data engineering', 'analytics', 'sql', 'python', 'kafka', 'data science'],
	noindex = frontmatter.noindex ?? false,
	lang = frontmatter.lang ?? 'it',
} = Astro.props as Props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site || SITE_URL).href;
const ogImage = new URL(image, Astro.site || SITE_URL).href;
const canonicalPathname = new URL(canonicalURL).pathname;
const italianPathname = canonicalPathname === '/en' || canonicalPathname === '/en/'
	? '/'
	: canonicalPathname.startsWith('/en/')
		? canonicalPathname.slice(3)
		: canonicalPathname;
const englishPathname = italianPathname === '/' ? '/en/' : `/en${italianPathname}`;
const italianAlternateURL = new URL(italianPathname, Astro.site || SITE_URL).href;
const englishAlternateURL = new URL(englishPathname, Astro.site || SITE_URL).href;
const htmlLang = lang === 'en' ? 'en' : 'it';
const schemaLanguage = lang === 'en' ? 'en-US' : 'it-IT';
const ogLocale = lang === 'en' ? 'en_US' : 'it_IT';
const skipLinkText = lang === 'en' ? 'Skip to main content' : 'Vai al contenuto principale';
const robotsContent = noindex
	? 'noindex, nofollow, noarchive'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const structuredData = serializeJsonLd({
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			name: SITE_NAME,
			url: SITE_URL,
			logo: `${SITE_URL}/ginni.webp`,
			description: SITE_DESCRIPTION,
			sameAs: [LINKEDIN_URL, GITHUB_PROFILE_URL],
		},
		{
			'@type': 'WebSite',
			name: SITE_NAME,
			url: SITE_URL,
			description: SITE_DESCRIPTION,
			inLanguage: schemaLanguage,
			potentialAction: {
				'@type': 'SearchAction',
				target: `${SITE_URL}/?q={search_term_string}`,
				'query-input': 'required name=search_term_string',
			},
		},
	],
});
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords.join(', ')} />
		<meta name="author" content="GinnyTech" />
		<meta name="robots" content={robotsContent} />
		<meta name="googlebot" content={robotsContent} />
		<meta name="generator" content={Astro.generator} />

		<!-- Critical CSS inlined to avoid render-blocking -->
		<style is:inline>
			/* Critical above-the-fold styles - GinnyTech dark theme */
			:root{--color-brand-dark:#08090d;--color-accent:#ccff00;--sl-color-bg:var(--color-brand-dark);--sl-color-text:#f4f4f5}
			html{scroll-behavior:smooth;overflow-x:hidden}
			body{margin:0;background:var(--color-brand-dark);color:#f4f4f5;font-family:Inter,-apple-system,BlinkMacSystemFont,sans-serif;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;overflow-x:hidden}
			.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border-width:0}
			.sr-only:focus{position:fixed;top:1rem;left:1rem;z-index:9999;width:auto;height:auto;padding:.5rem 1rem;clip:auto;white-space:normal;background:#fff;color:#000;border-radius:.375rem;font-weight:500;box-shadow:0 4px 12px rgba(0,0,0,.3)}
			.min-h-screen{min-height:100vh}
			.pt-32{padding-top:8rem}
			.container{margin:0 auto;padding-left:1.5rem;padding-right:1.5rem}
			.fixed{position:fixed}
			.top-0{top:0}
			.z-50{z-index:50}
			.text-white{color:#fff}
			.bg-\[var\(--sl-color-bg\)\]{background-color:var(--sl-color-bg)}
			/* Navbar placeholder to prevent layout shift */
			nav.gh-nav{z-index:100;position:fixed;top:0;left:0;right:0;min-height:64px}
			/* Course layout skeleton */
			.course-layout{display:flex;min-height:100vh}
			.course-content-wrapper{flex:1;min-width:0}
			@media(max-width:1024px){.course-layout{flex-direction:column}}
		</style>

		<!-- Critical font preloads -->
		<link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href="/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href="/fonts/montserrat-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href="/fonts/montserrat-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

		<!-- Canonical -->
		{!noindex && (
			<>
				<link rel="canonical" href={canonicalURL} />
				<link rel="alternate" href={italianAlternateURL} hreflang="it-IT" />
				<link rel="alternate" href={englishAlternateURL} hreflang="en-US" />
				<link rel="alternate" href={italianAlternateURL} hreflang="x-default" />
			</>
		)}

		<!-- Favicon -->
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:site_name" content={SITE_NAME} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- AI/LLM discovery -->
		<link rel="alternate" type="text/plain" title="LLMs.txt" href={`${SITE_URL}/llms.txt`} />

		<script type="application/ld+json" set:html={structuredData} is:inline />

		<GoogleAnalytics />
		<title>{title}</title>
	</head>
	<body class="bg-[var(--sl-color-bg)] text-[var(--sl-color-text)] font-sans antialiased overflow-x-hidden selection:bg-[var(--color-accent)]/30 selection:text-[var(--color-accent)]">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-[101] focus:top-4 focus:left-4 focus:bg-white focus:text-black focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg focus:font-medium">
			{skipLinkText}
		</a>
		<slot />
		<CookieBanner client:only="react" />
	</body>
</html>
