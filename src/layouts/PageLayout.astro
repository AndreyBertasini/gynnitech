---
import Layout from './Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  frontmatter?: { title: string; description: string };
}

// Support both direct props and MDX frontmatter props
const { title, description, frontmatter } = Astro.props;
const resolvedTitle = frontmatter?.title ?? title;
const resolvedDescription = frontmatter?.description ?? description;
---

<Layout title={resolvedTitle} description={resolvedDescription}>
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main id="main-content" class="relative flex-1 bg-[#050505] overflow-hidden selection:bg-accent/30 selection:text-white">
      <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-mint-900/10 to-transparent pointer-events-none"></div>

      <div class="container mx-auto px-6 pt-32 pb-20 relative z-10">
        <div class="max-w-3xl mx-auto">
          <div class="prose-page">
            <slot />
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .prose-page :global(h1) {
    font-size: 2.5rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1.5rem;
    font-family: var(--font-heading, sans-serif);
    line-height: 1.2;
  }
  .prose-page :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-heading, sans-serif);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .prose-page :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    color: #e2e8f0;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-heading, sans-serif);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .prose-page :global(p) {
    color: #cbd5e1;
    line-height: 1.75;
    margin-bottom: 0.75rem;
  }
  .prose-page :global(strong) {
    color: white;
    font-weight: 600;
  }
  .prose-page :global(em) {
    color: #94a3b8;
    font-style: italic;
  }
  .prose-page :global(a) {
    color: #00ffa3;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-page :global(a:hover) {
    color: white;
  }
  .prose-page :global(ul), .prose-page :global(ol) {
    color: #cbd5e1;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .prose-page :global(li) {
    margin-bottom: 0.25rem;
  }
  .prose-page :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .prose-page :global(th) {
    text-align: left;
    padding: 0.75rem 1rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    color: white;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .prose-page :global(td) {
    padding: 0.65rem 1rem;
    border: 1px solid rgba(255,255,255,0.06);
    color: #cbd5e1;
    vertical-align: top;
  }
  .prose-page :global(tr:hover td) {
    background: rgba(255,255,255,0.02);
  }
  .prose-page :global(code) {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.85em;
    color: #00ffa3;
    font-family: monospace;
  }
  .prose-page :global(hr) {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.08);
    margin: 2rem 0;
  }
</style>
