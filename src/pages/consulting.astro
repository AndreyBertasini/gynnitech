---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { CheckCircle2, ArrowRight, MessageSquare, Target, Zap } from 'lucide-react';

---

<Layout title="Consulenza - GYNNITECH">
  <Navbar client:load />
  
  <main class="pt-32 pb-20">
    <div class="container mx-auto px-6">
      {/* Hero Consulenza */}
      <div class="text-center max-w-4xl mx-auto mb-20">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
          Soluzioni rapide con un <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-mint-300 to-mint-500">analista esperto</span>
        </h1>
        <p class="text-xl text-slate-400 mb-10 leading-relaxed">
          Affronta le tue sfide di business con il supporto diretto. 
          Risultati riproducibili, più veloce ed economico di un'agenzia.
        </p>
        <div class="flex justify-center">
            <a href="mailto:info@gynnitech.it" class="px-8 py-4 bg-mint-500 hover:bg-mint-400 text-white font-bold rounded-full transition-all shadow-lg hover:shadow-mint-500/50 flex items-center gap-2">
                Prenota una Call
                <ArrowRight class="w-5 h-5" />
            </a>
        </div>
      </div>

      {/* Vantaggi */}
      <div class="grid md:grid-cols-2 gap-12 mb-24">
        <div class="bg-white/5 border border-white/10 p-8 rounded-2xl hover:border-mint-500/30 transition-all">
            <div class="w-12 h-12 bg-mint-500/20 rounded-lg flex items-center justify-center text-mint-400 mb-6">
                <Target class="w-6 h-6" />
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">Competenza Interna</h3>
            <p class="text-slate-400 leading-relaxed">
                Risolviamo il problema insieme al tuo team. Non solo ottieni un risultato, ma il tuo team impara come è stato raggiunto, mantenendo il know-how in azienda.
            </p>
        </div>
        <div class="bg-white/5 border border-white/10 p-8 rounded-2xl hover:border-mint-500/30 transition-all">
            <div class="w-12 h-12 bg-mint-500/20 rounded-lg flex items-center justify-center text-mint-400 mb-6">
                <Zap class="w-6 h-6" />
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">Efficienza e Velocità</h3>
            <p class="text-slate-400 leading-relaxed">
                Nessun overhead di agenzia. Comunicazione diretta, comprensione rapida del contesto e soluzioni mirate senza perdite di tempo.
            </p>
        </div>
      </div>

      {/* Come Funziona */}
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-white text-center mb-12">Come Funziona</h2>
        
        <div class="space-y-8">
            <div class="flex gap-6">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-mint-500/10 text-mint-400 flex items-center justify-center font-bold border border-mint-500/20">1</div>
                <div>
                    <h4 class="text-xl font-bold text-white mb-2">Contatto Iniziale</h4>
                    <p class="text-slate-400">Lascia un contatto o scrivici una email brevemente descrivendo la tua sfida.</p>
                </div>
            </div>
            
            <div class="flex gap-6">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-mint-500/10 text-mint-400 flex items-center justify-center font-bold border border-mint-500/20">2</div>
                <div>
                    <h4 class="text-xl font-bold text-white mb-2">Definizione Obiettivi</h4>
                    <p class="text-slate-400">Analizziamo la richiesta e definiamo insieme l'immagine del risultato atteso.</p>
                </div>
            </div>

            <div class="flex gap-6">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-mint-500/10 text-mint-400 flex items-center justify-center font-bold border border-mint-500/20">3</div>
                <div>
                    <h4 class="text-xl font-bold text-white mb-2">Lavoro e Risultato</h4>
                    <p class="text-slate-400">Lavoriamo insieme online per risolvere il problema. Pagamento flessibile (personale o aziendale).</p>
                </div>
            </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
