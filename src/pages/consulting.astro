---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import {
  ArrowRight,
  ArrowUpRight,
  Award,
  BarChart3,
  CheckCircle2,
  Database,
  Gauge,
  Layers,
  ShieldCheck,
  Target,
  TrendingDown,
  Zap,
} from 'lucide-react';
import { BOOKING_URL, CONTACT_EMAIL, CREDLY_CLICKHOUSE_BADGE_URL, SITE_AUTHOR, SITE_URL } from '../consts';
import {
  ORGANIZATION_ID,
  PERSON_ID,
  breadcrumbListNode,
  organizationNode,
  personNode,
} from '../lib/entity';
import { serializeJsonLd } from '../utils/jsonld';

const pageUrl = `${SITE_URL}/consulting/`;
const title = 'Consulenza Analytics Engineering, Data Warehouse & ClickHouse | GinnyTech';
const description =
  'Consulenza B2B in Analytics Engineering, ClickHouse (Certified Developer), dbt, riduzione costi BigQuery e Product Analytics con Andrii Dyshkantiuk.';

const faqs = [
  {
    q: 'Quando ha senso chiamare un Analytics Engineer invece di un’agenzia marketing o BI tradizionale?',
    a: 'Quando il problema non è fare un grafico in più, ma fidarsi dei numeri che ci sono dentro. Intervengo quando CRM, Google/Meta Ads, GA4, Stripe e database applicativo mostrano ricavi o conversioni diversi, quando le query sono troppo lente o costose, o quando serve strutturare un data warehouse solido con dbt e SQL.',
  },
  {
    q: 'Puoi aiutarci a ridurre i costi di BigQuery / Snowflake o a velocizzare PostgreSQL?',
    a: 'Sì. Come ClickHouse Certified Developer progetto architetture OLAP ad alte prestazioni su ClickHouse e ottimizzo modelli incrementali e partizionamento su BigQuery/PostgreSQL. Spesso riduciamo la spesa cloud del 50-80% portando i tempi di risposta delle dashboard sotto i 100 millisecondi.',
  },
  {
    q: 'Come funziona il trasferimento di competenze al nostro team interno?',
    a: 'Non lavoro a scatola nera: ogni pipeline, modello dbt, schema ClickHouse o setup di tracking viene scritto nei vostri repository Git, documentato e costruito in affiancamento con i vostri sviluppatori o analisti, così il know-how resta interamente in azienda.',
  },
  {
    q: 'Lavori solo con aziende che usano già ClickHouse o dbt?',
    a: 'No. Affianco sia aziende che partono da fogli sparsi, GA4 e un database PostgreSQL/MySQL di produzione e vogliono strutturare il primo data warehouse, sia scale-up e team engineering con decine di milioni di eventi al giorno che devono scalare su ClickHouse, Kafka e dbt.',
  },
  {
    q: 'Quali sono le modalità e i tempi di attivazione?',
    a: 'Dopo una call conoscitiva gratuita di 15 minuti definiamo il perimetro: possiamo partire con un Audit Architetturale mirato (1-2 settimane), uno Sprint di implementazione chiavi in mano (3-6 settimane) oppure un affiancamento continuativo come Fractional Analytics Engineer.',
  },
];

const jsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    personNode(),
    organizationNode('Organization'),
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'it-IT',
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': PERSON_ID },
      author: { '@id': PERSON_ID },
      publisher: { '@id': ORGANIZATION_ID },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${pageUrl}#service`,
      name: 'GinnyTech — Consulenza Analytics Engineering, Data Warehouse & ClickHouse',
      url: pageUrl,
      description,
      provider: { '@id': PERSON_ID },
      brand: { '@id': ORGANIZATION_ID },
      areaServed: {
        '@type': 'Country',
        name: 'Italy',
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servizi di Consulenza Dati B2B',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Consulenza ClickHouse & Real-Time OLAP (Certified Developer)',
              url: `${SITE_URL}/consulenza/clickhouse`,
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Analytics Engineering, Data Modeling con dbt & Data Governance',
              url: pageUrl,
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Product Analytics, Server-Side Tracking & Marketing Attribution',
              url: pageUrl,
            },
          },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
    breadcrumbListNode([
      { name: 'Home', url: SITE_URL },
      { name: 'Consulenza', url: pageUrl },
    ]),
  ],
});
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  markdownAlternate="/consulting.md"
  keywords={[
    'consulenza analytics engineering',
    'consulente analisi dati aziendali',
    'strutturare dati azienda',
    'consulenza data warehouse',
    'consulenza clickhouse italia',
    'clickhouse certified developer',
    'ridurre costi bigquery',
    'query lente postgresql dashboard',
    'consulente dbt italia',
    'consulente product analytics',
  ]}
>
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main
      id="main-content"
      class="relative flex-1 bg-[var(--sl-color-bg)] overflow-hidden selection:bg-accent/30 selection:text-white"
      data-pagefind-body
    >
      <script type="application/ld+json" set:html={jsonLd} is:inline />

      {/* Background Effects */}
      <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-accent/10 to-transparent pointer-events-none"></div>

      <div class="container mx-auto px-6 pt-32 pb-24 relative z-10 max-w-6xl">
        {/* Hero Consulenza */}
        <div class="text-center max-w-4xl mx-auto mb-20">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-accent text-xs font-mono font-medium tracking-wider mb-6 backdrop-blur-sm">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            ANALYTICS ENGINEERING · CLICKHOUSE CERTIFIED DEVELOPER · MARTECH
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6 font-heading leading-tight drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
            Struttura i dati della tua azienda con un <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent drop-shadow-[0_0_15px_rgba(204,255,0,0.4)]">
              Analytics Engineer &amp; ClickHouse Specialist
            </span>
          </h1>
          <p class="text-lg text-slate-300 mb-4 leading-relaxed font-sans max-w-3xl mx-auto">
            Affianco aziende, SaaS ed e-commerce in Italia per trasformare dati frammentati, query lente e costi cloud fuori controllo in un&apos;architettura dati affidabile, documentata e real-time.
          </p>
          <p class="text-sm md:text-base text-slate-400 mb-10 max-w-2xl mx-auto">
            Lavori direttamente con <strong class="text-white">{SITE_AUTHOR}</strong> (<strong class="text-accent">ClickHouse Certified Developer</strong>): nessun overhead di agenzia, codice pulito su Git e know-how che resta nel tuo team.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noreferrer"
              class="px-8 py-4 bg-accent hover:bg-accent text-black font-bold rounded-full transition shadow-[0_0_20px_rgba(204,255,0,0.35)] hover:shadow-[0_0_30px_rgba(204,255,0,0.55)] hover:scale-105 flex items-center gap-2 font-ui focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              Prenota una Call di 15 min
              <ArrowRight className="w-5 h-5" />
            </a>
            <a
              href="/consulenza/clickhouse"
              class="px-7 py-4 rounded-full border border-accent/40 bg-accent/10 text-accent font-semibold hover:border-accent hover:bg-accent/15 transition flex items-center gap-2 font-ui"
            >
              Verticale: Consulenza ClickHouse
              <ArrowRight className="w-4 h-4" />
            </a>
          </div>
        </div>

        {/* I 4 Problemi di Business & Tecnici che risolvo */}
        <section class="mb-24" aria-labelledby="problemi-risolti">
          <div class="text-center max-w-3xl mx-auto mb-12">
            <h2 id="problemi-risolti" class="text-2xl md:text-3xl font-bold text-white font-heading mb-3">
              Quale collo di bottiglia sta frenando il tuo team?
            </h2>
            <p class="text-slate-400">
              Intervengo sia sul piano architetturale e di business (mettere ordine nei numeri aziendali), sia sui problemi infrastrutturali ad alta complessità tecnica.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <article class="bg-white/[0.03] border border-white/10 p-8 rounded-2xl hover:border-accent/50 transition group">
              <div class="w-12 h-12 bg-accent/15 rounded-xl flex items-center justify-center text-accent mb-5">
                <Layers className="w-6 h-6" />
              </div>
              <div class="text-xs font-mono uppercase tracking-wider text-accent mb-1">Single Source of Truth &amp; dbt</div>
              <h3 class="text-xl font-bold text-white mb-3 font-heading group-hover:text-accent transition-colors">
                1. Numeri che non tornano tra CRM, Ads, GA4 e Database
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-4">
                Marketing, Finance e Prodotto guardano dashboard diverse con KPI discordanti. Centralizziamo le fonti nel data warehouse e costruiamo modelli <strong class="text-white">dbt</strong> testati, versionati e documentati in cui ogni metrica (CAC, LTV, MRR, margine netto) ha una sola definizione.
              </p>
              <a href="/course/analytics-engineering/dbt-e-ruolo-dell-analytics-engineer/" class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1">
                Approfondisci il metodo con dbt <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </article>

            <article class="bg-white/[0.03] border border-white/10 p-8 rounded-2xl hover:border-accent/50 transition group">
              <div class="w-12 h-12 bg-accent/15 rounded-xl flex items-center justify-center text-accent mb-5">
                <TrendingDown className="w-6 h-6" />
              </div>
              <div class="text-xs font-mono uppercase tracking-wider text-accent mb-1">ClickHouse &amp; Cost Optimization</div>
              <h3 class="text-xl font-bold text-white mb-3 font-heading group-hover:text-accent transition-colors">
                2. Costi BigQuery/Snowflake esplosi o PostgreSQL in blocco
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-4">
                Le dashboard impiegano 30 secondi a caricare su PostgreSQL oppure le scansioni su BigQuery/Snowflake drenano il budget cloud. Progettiamo l&apos;offloading analitico o la migrazione su <strong class="text-white">ClickHouse</strong> per ottenere query sub-secondo con il 60-80% di costo in meno.
              </p>
              <a href="/consulenza/clickhouse" class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1">
                Vai alla Consulenza ClickHouse <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </article>

            <article class="bg-white/[0.03] border border-white/10 p-8 rounded-2xl hover:border-accent/50 transition group">
              <div class="w-12 h-12 bg-accent/15 rounded-xl flex items-center justify-center text-accent mb-5">
                <BarChart3 className="w-6 h-6" />
              </div>
              <div class="text-xs font-mono uppercase tracking-wider text-accent mb-1">Product Analytics &amp; Server-Side</div>
              <h3 class="text-xl font-bold text-white mb-3 font-heading group-hover:text-accent transition-colors">
                3. Perdita di dati su GA4, cookie banner e tracking fragile
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-4">
                Ad-blocker, ITP e campionamento di GA4 nascondono fino al 30-40% del percorso utente. Progettiamo tassonomie eventi first-party, pipeline <strong class="text-white">Server-Side</strong> e raccolta eventi raw su database proprietario per analisi di funnel, retention, coorti e A/B testing rigorosi.
              </p>
              <a href="/course/data-collection/event-tracking/" class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1">
                Vedi come strutturiamo l&apos;event tracking <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </article>

            <article class="bg-white/[0.03] border border-white/10 p-8 rounded-2xl hover:border-accent/50 transition group">
              <div class="w-12 h-12 bg-accent/15 rounded-xl flex items-center justify-center text-accent mb-5">
                <Database className="w-6 h-6" />
              </div>
              <div class="text-xs font-mono uppercase tracking-wider text-accent mb-1">Real-Time Pipelines &amp; Data Streaming</div>
              <h3 class="text-xl font-bold text-white mb-3 font-heading group-hover:text-accent transition-colors">
                4. Pipeline manuali fragili, latenza nei dati e integrazioni complesse
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-4">
                Sostituiamo script manuali e fogli Excel con pipeline automatizzate e fault-tolerant in <strong class="text-white">Python, Kafka, CDC e SQL</strong>, portando i dati operativi su data lakehouse S3/Parquet e su un semantic layer certificato pronto per BI e automazione.
              </p>
              <a href="/course/kafka-streaming/" class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1">
                Scopri l&apos;architettura di Event Streaming con Kafka <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </article>
          </div>
        </section>

        {/* Banner Verticale ClickHouse Certified Developer */}
        <section class="mb-24 rounded-[2rem] border border-accent/35 bg-gradient-to-br from-accent/10 via-white/[0.03] to-transparent p-8 md:p-10" aria-labelledby="clickhouse-certified-banner">
          <div class="grid lg:grid-cols-[1fr_auto] gap-8 items-center">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/15 px-3.5 py-1 text-xs font-mono font-semibold uppercase tracking-wider text-accent mb-4">
                <Award className="w-4 h-4" /> Credenziale Ufficiale Verificata
              </div>
              <h2 id="clickhouse-certified-banner" class="font-heading text-2xl md:text-3xl font-bold text-white mb-3">
                Cerchi uno specialista certificato ClickHouse in Italia?
              </h2>
              <p class="text-slate-300 leading-relaxed mb-5 max-w-3xl">
                Sono <strong class="text-white">ClickHouse Certified Developer</strong>. Supporto team engineering e CTO nella progettazione di tabelle <code class="text-accent">MergeTree</code>, <code class="text-accent">Materialized Views</code> incrementali, pipeline streaming <code class="text-accent">Kafka → ClickHouse</code>, integrazione <code class="text-accent">dbt-clickhouse</code> e migrazioni da BigQuery, Snowflake o PostgreSQL.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="/consulenza/clickhouse"
                  class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-6 py-3 font-ui text-sm font-bold text-black transition hover:brightness-110"
                >
                  Esplora la Consulenza ClickHouse
                  <ArrowRight className="w-4 h-4" />
                </a>
                <a
                  href={CREDLY_CLICKHOUSE_BADGE_URL}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-3 font-ui text-sm font-semibold text-white transition hover:border-accent/50 hover:text-accent"
                >
                  Verifica Badge su Credly
                  <ArrowUpRight className="w-4 h-4" />
                </a>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 sm:w-80">
              <div class="rounded-2xl border border-white/10 bg-black/40 p-4 text-center">
                <Gauge className="w-6 h-6 text-accent mx-auto mb-1.5" />
                <div class="font-heading text-lg font-bold text-white">Sub-100ms</div>
                <div class="text-xs text-slate-400">Query OLAP su miliardi di righe</div>
              </div>
              <div class="rounded-2xl border border-white/10 bg-black/40 p-4 text-center">
                <ShieldCheck className="w-6 h-6 text-accent mx-auto mb-1.5" />
                <div class="font-heading text-lg font-bold text-white">Certified</div>
                <div class="text-xs text-slate-400">ClickHouse Inc. Hands-on Exam</div>
              </div>
            </div>
          </div>
        </section>

        {/* Pacchetti di Intervento */}
        <section class="mb-24" aria-labelledby="pacchetti-consulenza">
          <div class="text-center max-w-3xl mx-auto mb-12">
            <h2 id="pacchetti-consulenza" class="text-2xl md:text-3xl font-bold text-white font-heading mb-3">
              3 Modalità di Collaborazione
            </h2>
            <p class="text-slate-400">
              Flessibilità totale: puoi attivare un intervento verticale su un singolo collo di bottiglia o costruire insieme l&apos;intero stack dati.
            </p>
          </div>

          <div class="grid lg:grid-cols-3 gap-6">
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 flex flex-col justify-between">
              <div>
                <div class="text-xs font-mono uppercase tracking-widest text-accent mb-2">Pacchetto 1 · 1-2 Settimane</div>
                <h3 class="text-xl font-bold text-white font-heading mb-3">Audit Architetturale &amp; Roadmap</h3>
                <p class="text-sm text-slate-400 leading-relaxed mb-5">
                  Ideale per capire perché i numeri non tornano, perché il database è lento o come ridurre la spesa cloud prima di scrivere nuovo codice.
                </p>
                <ul class="space-y-2.5 text-sm text-slate-300 mb-6">
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Mappatura completa di fonti, tracking e flussi SQL</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Diagnosi colli di bottiglia (query, costi, data quality)</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Piano esecutivo prioritizzato con architettura target</span></li>
                </ul>
              </div>
              <a href={BOOKING_URL} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 hover:border-accent/50 hover:text-accent px-5 py-3 text-sm font-semibold text-white transition">
                Richiedi un Audit <ArrowRight className="w-4 h-4" />
              </a>
            </div>

            <div class="rounded-2xl border border-accent/40 bg-gradient-to-b from-accent/[0.08] to-white/[0.02] p-7 flex flex-col justify-between">
              <div>
                <div class="text-xs font-mono uppercase tracking-widest text-accent mb-2">Pacchetto 2 · 3-6 Settimane</div>
                <h3 class="text-xl font-bold text-white font-heading mb-3">Sprint di Implementazione &amp; Migrazione</h3>
                <p class="text-sm text-slate-300 leading-relaxed mb-5">
                  Progettazione e rilascio in produzione di data warehouse, modelli dbt, cluster ClickHouse o sistemi di Product Analytics.
                </p>
                <ul class="space-y-2.5 text-sm text-slate-200 mb-6">
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Setup completo (ClickHouse / BigQuery + dbt + pipeline)</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Test automatici di qualità dati e documentazione</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Handover completo e formazione pratica al team</span></li>
                </ul>
              </div>
              <a href={BOOKING_URL} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--color-accent)] hover:brightness-110 px-5 py-3 text-sm font-bold text-black transition">
                Prenota call gratuita <ArrowRight className="w-4 h-4" />
              </a>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 flex flex-col justify-between">
              <div>
                <div class="text-xs font-mono uppercase tracking-widest text-accent mb-2">Pacchetto 3 · Continuativo</div>
                <h3 class="text-xl font-bold text-white font-heading mb-3">Fractional Analytics Engineer</h3>
                <p class="text-sm text-slate-400 leading-relaxed mb-5">
                  Un senior tecnico nel tuo team per guidare l&apos;evoluzione dello stack dati, fare code review e affiancare analisti e sviluppatori.
                </p>
                <ul class="space-y-2.5 text-sm text-slate-300 mb-6">
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Sparring settimanale per CTO, Head of Data e Growth</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Review continua di schema ClickHouse, modelli dbt e KPI</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Crescita delle competenze interne senza dipendenza da agenzie</span></li>
                </ul>
              </div>
              <a href={BOOKING_URL} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 hover:border-accent/50 hover:text-accent px-5 py-3 text-sm font-semibold text-white transition">
                Verifica disponibilità <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>
        </section>

        {/* Vantaggi + Come Funziona */}
        <div class="grid md:grid-cols-2 gap-8 mb-24">
          <div class="bg-white/5 border border-white/10 p-8 rounded-2xl">
            <div class="w-12 h-12 bg-accent/20 rounded-lg flex items-center justify-center text-accent mb-6">
              <Target className="w-6 h-6" />
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 font-heading">Competenza che resta in azienda</h3>
            <p class="text-slate-300 leading-relaxed font-sans text-sm md:text-base">
              Risolviamo il problema insieme al tuo team. Ogni query, modello dbt o configurazione ClickHouse è documentata e spiegata passo-passo, così la tua azienda diventa autonoma.
            </p>
          </div>
          <div class="bg-white/5 border border-white/10 p-8 rounded-2xl">
            <div class="w-12 h-12 bg-accent/20 rounded-lg flex items-center justify-center text-accent mb-6">
              <Zap className="w-6 h-6" />
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 font-heading">Zero overhead di agenzia</h3>
            <p class="text-slate-300 leading-relaxed font-sans text-sm md:text-base">
              Parli sempre e solo con chi progetta l&apos;architettura e scrive il codice. Analisi rapida del contesto, decisioni tecniche nette e tempi di esecuzione ridotti.
            </p>
          </div>
        </div>

        {/* FAQ Strutturate */}
        <section class="max-w-4xl mx-auto mb-20" aria-labelledby="faq-consulenza">
          <h2 id="faq-consulenza" class="text-2xl md:text-3xl font-bold text-white text-center mb-10 font-heading">
            Domande Frequenti sulla Consulenza
          </h2>

          <div class="space-y-4">
            {faqs.map((item) => (
              <details class="group rounded-2xl border border-white/10 bg-white/[0.03] px-6 py-5 open:border-accent/40 transition">
                <summary class="cursor-pointer list-none font-heading text-lg font-bold text-white flex items-center justify-between gap-4">
                  <span>{item.q}</span>
                  <span class="text-accent text-xl leading-none group-open:rotate-45 transition-transform">+</span>
                </summary>
                <p class="mt-3 text-sm md:text-base text-slate-300 leading-relaxed">
                  {item.a}
                </p>
              </details>
            ))}
          </div>
        </section>

        {/* CTA Finale */}
        <section class="max-w-4xl mx-auto rounded-2xl border border-white/10 bg-white/[0.03] p-8 md:p-10 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 font-heading">
            Vuoi discutere il tuo caso o vedere prima come lavoro?
          </h2>
          <p class="text-slate-300 mb-6 max-w-2xl mx-auto">
            Prenota una call conoscitiva di 15 minuti su Calendly, scrivimi a <a href={`mailto:${CONTACT_EMAIL}`} class="text-accent underline">{CONTACT_EMAIL}</a> oppure esplora gratuitamente i 10 moduli tecnici del corso.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-accent text-black font-bold hover:brightness-110 transition font-ui"
            >
              Prenota una Call Gratuita
              <ArrowRight className="w-4 h-4" />
            </a>
            <a
              href="/#corsi"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-white/5 border border-white/15 text-white hover:border-accent/50 hover:text-accent transition font-ui"
            >
              Vedi il percorso formativo gratuito
            </a>
          </div>
        </section>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
