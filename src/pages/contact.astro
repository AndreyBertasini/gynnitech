---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
---

<Layout title="Contatti - GinnyTech" description="Contatta Andrii Dyshkantiuk per domande, collaborazioni o consulenze in Data Analytics. LinkedIn, email, GitHub e call gratuita.">
  <Navbar client:load />
  
  <main id="main-content" class="relative min-h-screen bg-[#050505] overflow-hidden selection:bg-neon-mint/30 selection:text-white">
    <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-mint-900/10 to-transparent pointer-events-none"></div>

    <div class="container mx-auto px-6 pt-32 pb-20 relative z-10">
      <div class="max-w-3xl mx-auto">
        
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 font-heading">Contatti</h1>
        
        <p class="text-lg text-slate-300 leading-relaxed font-sans mb-12">
          Hai una domanda, una proposta o vuoi semplicemente fare due chiacchiere sull'analisi dati? Ecco come raggiungermi.
        </p>

        <div class="grid md:grid-cols-2 gap-6">
          <a href="https://www.linkedin.com/in/andrii-dyshkantiuk/" target="_blank" rel="noreferrer" class="group bg-white/5 border border-white/10 rounded-2xl p-8 hover:border-[#0077B5]/50 hover:bg-white/[0.07] transition-all">
            <div class="text-2xl mb-4">💬</div>
            <h3 class="text-xl font-bold text-white mb-2 font-heading group-hover:text-[#0077B5] transition-colors">LinkedIn</h3>
            <p class="text-slate-400 text-sm font-sans">Scrivimi un messaggio diretto. Rispondo sempre.</p>
          </a>

          <a href="https://tidycal.com/andrii-d/15-minute-meeting" target="_blank" rel="noreferrer" class="group bg-white/5 border border-white/10 rounded-2xl p-8 hover:border-[#ccff00]/50 hover:bg-white/[0.07] transition-all">
            <div class="text-2xl mb-4">📅</div>
            <h3 class="text-xl font-bold text-white mb-2 font-heading group-hover:text-[#ccff00] transition-colors">Prenota una Call</h3>
            <p class="text-slate-400 text-sm font-sans">15 minuti gratuiti per discutere il tuo progetto o le tue domande.</p>
          </a>

          <a href="https://github.com/AndreyBertasini" target="_blank" rel="noreferrer" class="group bg-white/5 border border-white/10 rounded-2xl p-8 hover:border-white/30 hover:bg-white/[0.07] transition-all">
            <div class="text-2xl mb-4">🐙</div>
            <h3 class="text-xl font-bold text-white mb-2 font-heading group-hover:text-white transition-colors">GitHub</h3>
            <p class="text-slate-400 text-sm font-sans">Contribuisci al progetto, apri issue o esplora il codice sorgente.</p>
          </a>

          <a href="mailto:info@ginnytech.it" class="group bg-white/5 border border-white/10 rounded-2xl p-8 hover:border-cyan-400/50 hover:bg-white/[0.07] transition-all">
            <div class="text-2xl mb-4">✉️</div>
            <h3 class="text-xl font-bold text-white mb-2 font-heading group-hover:text-cyan-400 transition-colors">Email</h3>
            <p class="text-slate-400 text-sm font-sans">Per collaborazioni e proposte formali.</p>
          </a>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
