---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { BOOKING_URL, CONTACT_EMAIL, GITHUB_REPO_URL, LINKEDIN_URL } from '../consts';
---

<Layout title="Contatti - GinnyTech" description="Contatta Andrii Dyshkantiuk per domande, collaborazioni o consulenze in Data Analytics. LinkedIn, email, GitHub e call gratuita.">
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main id="main-content" class="relative flex-1 bg-[var(--sl-color-bg)] overflow-hidden selection:bg-neon-mint/30 selection:text-white">
    <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-mint-900/10 to-transparent pointer-events-none"></div>

    <div class="container mx-auto px-6 pt-32 pb-20 relative z-10">
      <div class="max-w-3xl mx-auto">
        
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 font-heading">Contatti</h1>
        
        <p class="text-lg text-slate-300 leading-relaxed font-sans mb-12">
          Hai una domanda, una proposta o vuoi semplicemente fare due chiacchiere sull'analisi dati? Ecco come raggiungermi.
        </p>

        <div class="grid md:grid-cols-2 gap-6">
          <a href={LINKEDIN_URL} target="_blank" rel="noreferrer" class="group bg-white/5 border border-white/10 rounded-2xl p-8 hover:-translate-y-1 hover:border-[#0077B5]/50 hover:bg-white/[0.07] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B5] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]">
            <div class="text-2xl mb-4">💬</div>
            <h3 class="text-xl font-bold text-white mb-2 font-heading group-hover:text-[#0077B5] transition-colors">LinkedIn</h3>
            <p class="text-slate-300 text-sm font-sans">Scrivimi un messaggio diretto. Rispondo sempre.</p>
          </a>

          <a href={BOOKING_URL} target="_blank" rel="noreferrer" class="group bg-white/5 border border-white/10 rounded-2xl p-8 hover:-translate-y-1 hover:border-[#ccff00]/50 hover:bg-white/[0.07] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]">
            <div class="text-2xl mb-4">📅</div>
            <h3 class="text-xl font-bold text-white mb-2 font-heading group-hover:text-[#ccff00] transition-colors">Prenota una Call</h3>
            <p class="text-slate-300 text-sm font-sans">15 minuti gratuiti per discutere il tuo progetto o le tue domande.</p>
          </a>

          <a href={GITHUB_REPO_URL} target="_blank" rel="noreferrer" class="group bg-white/5 border border-white/10 rounded-2xl p-8 hover:-translate-y-1 hover:border-white/30 hover:bg-white/[0.07] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]">
            <div class="text-2xl mb-4">🐙</div>
            <h3 class="text-xl font-bold text-white mb-2 font-heading group-hover:text-white transition-colors">GitHub</h3>
            <p class="text-slate-300 text-sm font-sans">Contribuisci al progetto, apri issue o esplora il codice sorgente.</p>
          </a>

          <a href={`mailto:${CONTACT_EMAIL}`} class="group bg-white/5 border border-white/10 rounded-2xl p-8 hover:-translate-y-1 hover:border-cyan-400/50 hover:bg-white/[0.07] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]">
            <div class="text-2xl mb-4">✉️</div>
            <h3 class="text-xl font-bold text-white mb-2 font-heading group-hover:text-cyan-400 transition-colors">Email</h3>
            <p class="text-slate-300 text-sm font-sans">Per collaborazioni e proposte formali.</p>
          </a>
        </div>

        <div class="mt-10 rounded-2xl border border-white/10 bg-white/[0.03] p-8">
          <h2 class="text-2xl font-bold text-white mb-3 font-heading">Non sai da dove iniziare?</h2>
          <p class="text-slate-300 mb-5">Raccontami il tuo scenario: preparo una direzione chiara in 15 minuti.</p>
          <a href={BOOKING_URL} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#ccff00] text-black font-semibold hover:brightness-110 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]">
            Prenota una Call gratuita
          </a>
        </div>
      </div>
    </div>
    </main>

    <Footer />
  </div>
</Layout>
