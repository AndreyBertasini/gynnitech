---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { COURSE_MODULES } from '../data/course-modules';
import { getCollection } from 'astro:content';
import { ProgressDashboard } from '../components/ProgressDashboard';

const courseDocs = await getCollection('corso');

const moduleProgress = COURSE_MODULES.map((mod) => {
  const lessonCount = courseDocs.filter((doc) => {
    const mId = doc.id.split('/')[0];
    return mId === mod.id && typeof doc.data.order === 'number';
  }).length;

  return {
    id: mod.id,
    title: mod.title,
    icon: mod.icon,
    color: mod.color,
    totalLessons: lessonCount,
  };
});

const totalLessons = moduleProgress.reduce((sum, m) => sum + m.totalLessons, 0);
---

<Layout
  title="Il tuo Progresso — GinnyTech"
  description="Dashboard del tuo percorso di apprendimento su GinnyTech. Tieni traccia delle lezioni completate e dei moduli in corso."
  keywords={['progresso corso', 'dashboard apprendimento', 'ginnytech progress', 'tracking studio']}
>
  <Navbar client:idle />

  <main id="main-content" style="min-height: 100vh; background: #050505; padding-top: 6rem; padding-bottom: 5rem;">
    <div class="container mx-auto px-6 relative z-10" style="max-width: 800px;">

      <div style="text-align: center; margin-bottom: 3rem;">
        <span style="font-size: 3rem; display: block; margin-bottom: 0.5rem;">📊</span>
        <h1 style="color: white; font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem;">
          Il tuo percorso su GinnyTech
        </h1>
        <p style="color: #94a3b8; font-size: 0.95rem; margin: 0;">
          {totalLessons} lezioni in {COURSE_MODULES.length} moduli.
          I progressi sono salvati localmente sul tuo browser.
        </p>
      </div>

      <ProgressDashboard modules={moduleProgress} client:load />

      <div style={{
        marginTop: '3rem',
        padding: '1.25rem 1.5rem',
        borderRadius: '14px',
        border: '1px solid rgba(255,255,255,0.06)',
        background: 'rgba(255,255,255,0.02)',
      }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '0.75rem' }}>
          <span style={{ fontSize: '1.2rem' }}>💡</span>
          <span style={{ color: '#cbd5e1', fontWeight: 600, fontSize: '0.9rem' }}>
            Vuoi mantenere il progresso anche su altri dispositivi?
          </span>
        </div>
        <p style={{ color: '#64748b', fontSize: '0.84rem', margin: '0 0 0.75rem', lineHeight: 1.5 }}>
          Iscriviti alla newsletter di GinnyTech e ti invieremo un link per sincronizzare
          i tuoi progressi. Riceverai anche la guida SQL gratuita per marketer.
        </p>
        <a
          href="/#"
          onclick="document.querySelector('.email-capture-trigger')?.click()"
          style={{
            display: 'inline-flex',
            alignItems: 'center',
            gap: '0.35rem',
            color: '#ccff00',
            fontWeight: 600,
            fontSize: '0.85rem',
            textDecoration: 'none',
          }}
        >
          Iscriviti alla newsletter →
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
