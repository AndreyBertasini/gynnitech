---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRightIcon, StackIcon, BarChartIcon, MixIcon, LightningBoltIcon, DashboardIcon, MagicWandIcon, DiscIcon, ActivityLogIcon, CheckCircledIcon, ReaderIcon, CodeIcon, ArrowTopRightIcon, BackpackIcon, Component1Icon, PieChartIcon } from '@radix-ui/react-icons';
import { StarField } from '../components/StarField';
import { Image } from 'astro:assets';
import ginniImage from '../assets/ginni.png';
import andriiImage from '../assets/andrii.jpg';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
---

<Layout title="Corso MarTech Open Source: Data Engineering & Analytics per il Marketing" description="GinnyTech è una piattaforma di formazione gratuita per imparare a costruire infrastrutture dati reali. Tutorial pratici su SQL, Python, Kafka e Data Science.">
  <Navbar client:idle />

  <main id="main-content">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_NAME,
      "url": SITE_URL,
      "description": SITE_DESCRIPTION,
      "author": {
        "@type": "Person",
        "name": "Andrii Dyshkantiuk",
        "url": "https://ginnytech.it",
        "sameAs": [
          "https://www.linkedin.com/in/andrii-dyshkantiuk/",
          "https://github.com/AndreyBertasini"
        ]
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${SITE_URL}/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image
          src={ginniImage}
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering"
          class="w-full h-full object-cover opacity-60"
          loading="eager"
          decoding="async"
          quality={80}
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/50 to-brand-dark"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>

      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none z-0 mix-blend-screen"></div>

      <div class="container mx-auto px-6 relative z-50 text-center flex flex-col items-center">
        {/* Glass Lights */}
        <div class="absolute top-20 left-[15%] w-24 h-24 bg-neon-blue/20 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(0,243,255,0.3)] animate-pulse pointer-events-none -z-10 mix-blend-screen"></div>
        <div class="absolute bottom-20 right-[15%] w-32 h-32 bg-acid-yellow/10 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(204,255,0,0.2)] animate-pulse delay-700 pointer-events-none -z-10 mix-blend-screen"></div>

        <div class="inline-flex items-center justify-center gap-2 px-4 py-2 mx-auto rounded-full bg-brand-dark/80 border border-[#ccff00]/50 text-[#ccff00] text-sm font-bold mb-6 shadow-[0_0_20px_rgba(204,255,0,0.2)] backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ccff00] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#ccff00] shadow-[0_0_10px_rgba(204,255,0,1)]"></span>
          </span>
          Corso gratuito · Nessun paywall ❤️
        </div>

        <h1 class="text-5xl md:text-7xl font-bold text-white text-center tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-heading drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
          Il <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-lime-400 to-yellow-400 text-glow">MarTech</span><br/>
          che usi davvero.
        </h1>

        <p class="text-xl text-slate-200 text-center max-w-2xl mx-auto mb-8 leading-relaxed font-sans font-medium drop-shadow-md">
          Marketing e Data Engineering insieme, finalmente.<br class="hidden sm:block"/>
          Lezioni dai problemi reali che affronto ogni giorno — non da libri.
        </p>

        <div class="flex flex-col items-center justify-center gap-4 relative z-50">
          <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-[#ccff00] hover:bg-[#b3e600] text-black font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
            Inizia a studiare ora
            <ArrowRightIcon className="w-5 h-5" />
          </a>
          <p class="text-sm text-slate-300 font-medium">12 Moduli · 90+ Lezioni · 100% Gratis</p>
        </div>
      </div>
    </section>

    {/* Social Proof / Numbers Strip */}
    <section class="relative z-20 mt-10">
      <div class="container mx-auto px-6">
        <div class="glass-panel border border-white/10 p-8 md:p-10">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-acid-yellow font-heading mb-1">12</div>
              <div class="text-sm text-slate-400 font-medium">Moduli completi</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-blue font-heading mb-1">90+</div>
              <div class="text-sm text-slate-400 font-medium">Lezioni pratiche</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-pink font-heading mb-1">€0</div>
              <div class="text-sm text-slate-400 font-medium">Nessun paywall</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-green font-heading mb-1">10+</div>
              <div class="text-sm text-slate-400 font-medium">Anni sul campo</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Value Proposition Section */}
    <section class="py-12 bg-brand-dark relative overflow-hidden">
      {/* Background decoration */}
      <div class="absolute top-1/2 left-0 w-96 h-96 bg-neon-blue/5 rounded-full blur-[120px] -translate-y-1/2 pointer-events-none"></div>
      <div class="absolute top-1/3 right-0 w-80 h-80 bg-acid-yellow/5 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-neon-blue/10 border border-neon-blue/20 text-neon-blue text-xs font-bold uppercase tracking-wider mb-6">
            Il problema
          </div>
          <h2 class="text-3xl md:text-5xl font-bold text-white font-heading mb-6 max-w-3xl mx-auto leading-tight">
            La formazione è rimasta indietro di 10 anni.
          </h2>
          <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
            Il mercato cerca persone che sappiano fare entrambe le cose: capire le campagne e costruire i dati che le misurano. Ma nessuno te lo insegna insieme.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 md:gap-8 max-w-5xl mx-auto">
          {/* Problem Card 1 */}
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-b from-red-500/10 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative glass-panel p-8 h-full border border-white/5 group-hover:border-red-500/20 transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center mb-6">
                <BackpackIcon className="w-6 h-6 text-red-400" />
              </div>
              <h3 class="text-lg font-bold text-white mb-3 font-heading">Dataset perfetti che non esistono</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Nei corsi i dati sono già puliti e pronti. Nel mondo reale un evento di tracciamento si rompe alle 2 di notte e devi capire perché. Nessuno ti prepara a questo.</p>
            </div>
          </div>
          {/* Problem Card 2 */}
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-b from-orange-500/10 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative glass-panel p-8 h-full border border-white/5 group-hover:border-orange-500/20 transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center mb-6">
                <Component1Icon className="w-6 h-6 text-orange-400" />
              </div>
              <h3 class="text-lg font-bold text-white mb-3 font-heading">Marketing da una parte, tech dall'altra</h3>
              <p class="text-slate-400 text-sm leading-relaxed">C'è chi ti insegna le campagne e chi ti insegna a scrivere codice. Ma nessuno ti spiega come usarli insieme — come calcolare l'attribuzione reale con SQL o ottimizzare un budget con Python.</p>
            </div>
          </div>
          {/* Problem Card 3 */}
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-b from-yellow-500/10 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative glass-panel p-8 h-full border border-white/5 group-hover:border-yellow-500/20 transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center mb-6">
                <PieChartIcon className="w-6 h-6 text-yellow-400" />
              </div>
              <h3 class="text-lg font-bold text-white mb-3 font-heading">Master da migliaia di euro per cosa?</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Per imparare questi stack devi spendere €3.000–€10.000 in master. Chi vuole davvero imparare non dovrebbe essere bloccato da un paywall.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Solution / What You Get Section */}
    <section class="py-12 bg-brand-darker relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(204,255,0,0.03)_0%,transparent_70%)]"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-acid-yellow/10 border border-acid-yellow/20 text-acid-yellow text-xs font-bold uppercase tracking-wider mb-6">
            La soluzione
          </div>
          <h2 class="text-3xl md:text-5xl font-bold text-white font-heading mb-6 max-w-4xl mx-auto leading-tight">
            Dal primo evento tracciato alla pipeline in produzione.
          </h2>
          <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
            12 moduli costruiti per farti usare gli stessi stack che le aziende usano davvero — non toy examples, non dataset puliti, non teoria fine a se stessa.
          </p>
        </div>

        {/* Feature Grid */}
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-6xl mx-auto mb-10">
          <div class="group glass-panel p-7 border border-white/5 hover:border-cyan-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <StackIcon className="w-8 h-8 text-cyan-400 mb-4" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Raccolta & Tracking</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Event tracking dalla progettazione al debug. Privacy-first, SDK reali, niente "installa GA e basta".</p>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-emerald-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/5 rounded-full blur-2xl group-hover:bg-emerald-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <BarChartIcon className="w-8 h-8 text-emerald-400 mb-4" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Analytics & SQL</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Query che rispondono a domande di business reali. Non esercizi su tabelle inventate.</p>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-purple-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-purple-500/5 rounded-full blur-2xl group-hover:bg-purple-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <MixIcon className="w-8 h-8 text-purple-400 mb-4" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Analisi di Prodotto</h4>
              <p class="text-slate-400 text-sm leading-relaxed">A/B test, analisi di coorte, NPS, retention. Come misurare se il prodotto funziona davvero.</p>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-orange-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-orange-500/5 rounded-full blur-2xl group-hover:bg-orange-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <LightningBoltIcon className="w-8 h-8 text-orange-400 mb-4" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Marketing Analytics</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Attribuzione reale, unit economics, LTV e ROAS calcolati sui tuoi dati, non sui benchmark.</p>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-blue-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-full blur-2xl group-hover:bg-blue-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <DashboardIcon className="w-8 h-8 text-blue-400 mb-4" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Dashboard & Visualization</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Dashboard che il business capisce e usa. Non grafici a torta che nessuno guarda.</p>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-pink-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-pink-500/5 rounded-full blur-2xl group-hover:bg-pink-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <MagicWandIcon className="w-8 h-8 text-pink-400 mb-4" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Data Science & Python</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Cluster analysis, modelli predittivi e segmentazione su dati marketing reali, con Python.</p>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-slate-400/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-slate-400/5 rounded-full blur-2xl group-hover:bg-slate-400/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <DiscIcon className="w-8 h-8 text-slate-300 mb-4" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Data Engineering</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Kafka, ClickHouse, S3 — l'infrastruttura che le scale-up usano in produzione, spiegata dall'interno.</p>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-red-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-red-500/5 rounded-full blur-2xl group-hover:bg-red-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <ActivityLogIcon className="w-8 h-8 text-red-400 mb-4" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Kafka & Streaming</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Pipeline real-time da zero: producers, consumers, Schema Registry e CDC con esempi funzionanti.</p>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-yellow-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-yellow-500/5 rounded-full blur-2xl group-hover:bg-yellow-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <ArrowTopRightIcon className="w-8 h-8 text-yellow-400 mb-4" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Real-Time Analytics</h4>
              <p class="text-slate-400 text-sm leading-relaxed">ClickHouse + Materialized Views per metriche live su milioni di eventi. Monitoring incluso.</p>
            </div>
          </div>
        </div>

        {/* Tech Stack Strip */}
        <div class="max-w-4xl mx-auto text-center">
          <p class="text-xs text-slate-500 uppercase tracking-widest font-bold mb-6">Stack tecnologico del corso</p>
          <div class="flex flex-wrap justify-center gap-3">
            {['SQL', 'Python', 'ClickHouse', 'Kafka', 'S3', 'Terraform', 'dbt', 'Metabase', 'BigQuery', 'GA4'].map((tech) => (
              <span class="px-4 py-2 rounded-lg bg-white/[0.03] border border-white/[0.06] text-slate-400 text-sm font-medium hover:border-acid-yellow/30 hover:text-slate-200 transition-all duration-300">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Who Is This For */}
    <section class="py-12 bg-brand-dark relative overflow-hidden">
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-neon-blue/[0.03] rounded-full blur-[150px] pointer-events-none"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-neon-blue/10 border border-neon-blue/20 text-neon-blue text-xs font-bold uppercase tracking-wider mb-6">
            Per chi è
          </div>
          <h2 class="text-3xl md:text-5xl font-bold text-white font-heading mb-6 max-w-3xl mx-auto leading-tight">
            Per chi vuole fare, non solo sapere.
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="glass-panel p-8 border border-white/5 text-center group hover:border-acid-yellow/20 transition-all duration-500">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-acid-yellow/20 to-acid-yellow/5 border border-acid-yellow/20 flex items-center justify-center mx-auto mb-6 group-hover:shadow-[0_0_25px_rgba(204,255,0,0.2)] transition-shadow duration-500">
              <ReaderIcon className="w-7 h-7 text-acid-yellow" />
            </div>
            <h3 class="text-xl font-bold text-white mb-3 font-heading">Professionisti Marketing & Tech</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Sei nel marketing ma dipendi sempre dal dev per i dati? O sei un analyst che non capisce le logiche di business? Questo corso colma esattamente quel gap.</p>
          </div>

          <div class="glass-panel p-8 border border-white/5 text-center group hover:border-neon-blue/20 transition-all duration-500">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-neon-blue/20 to-neon-blue/5 border border-neon-blue/20 flex items-center justify-center mx-auto mb-6 group-hover:shadow-[0_0_25px_rgba(0,243,255,0.2)] transition-shadow duration-500">
              <CodeIcon className="w-7 h-7 text-neon-blue" />
            </div>
            <h3 class="text-xl font-bold text-white mb-3 font-heading">Studenti e Neolaureati</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Vuoi arrivare a un colloquio con roba reale in mano? Qui impari gli stack che compaiono negli annunci di lavoro — Kafka, ClickHouse, SQL avanzato — non quelli dei libri universitari.</p>
          </div>
        </div>
      </div>
    </section>

    {/* About the Instructor */}
    <section class="py-12 bg-brand-darker relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/[0.04] rounded-full blur-[120px] pointer-events-none"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="grid md:grid-cols-[auto_1fr] gap-12 items-start">
            {/* Avatar */}
            <div class="flex flex-col items-center md:items-start gap-4">
              <div class="w-24 h-24 rounded-full overflow-hidden shadow-[0_0_40px_rgba(6,182,212,0.3)] border-2 border-cyan-400/30">
                <Image
                  src={andriiImage}
                  alt="Andrii Dyshkantiuk - Instructor"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width={96}
                  height={96}
                />
              </div>
              <div class="flex gap-3">
                <a href="https://www.linkedin.com/in/andrii-dyshkantiuk/" target="_blank" rel="noreferrer" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-neon-blue hover:border-neon-blue/30 transition-all">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
                <a href="https://github.com/AndreyBertasini" target="_blank" rel="noreferrer" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-white/30 transition-all">
