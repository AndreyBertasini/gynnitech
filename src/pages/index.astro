---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRightIcon, StackIcon, BarChartIcon, MixIcon, LightningBoltIcon, DashboardIcon, MagicWandIcon, DiscIcon, ActivityLogIcon, CheckCircledIcon, ReaderIcon, CodeIcon, ArrowTopRightIcon, BackpackIcon, Component1Icon, PieChartIcon } from '@radix-ui/react-icons';
import { StarField } from '../components/StarField';
import { Image } from 'astro:assets';
import ginniImage from '../assets/ginni.png';
import andriiImage from '../assets/andrii.jpg';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
---

<Layout title="Corso MarTech Open Source: Data Engineering & Analytics per il Marketing" description="GinnyTech è una piattaforma di formazione gratuita per imparare a costruire infrastrutture dati reali. Tutorial pratici su SQL, Python, Kafka e Data Science.">
  <Navbar client:idle />

  <main id="main-content">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_NAME,
      "url": SITE_URL,
      "description": SITE_DESCRIPTION,
      "author": {
        "@type": "Person",
        "name": "Andrii Dyshkantiuk",
        "url": "https://ginnytech.it",
        "sameAs": [
          "https://www.linkedin.com/in/andrii-dyshkantiuk/",
          "https://github.com/AndreyBertasini"
        ]
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${SITE_URL}/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image
          src={ginniImage}
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering"
          class="w-full h-full object-cover opacity-60"
          loading="eager"
          decoding="async"
          quality={80}
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/50 to-brand-dark"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>

      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none z-0 mix-blend-screen"></div>

      <div class="container mx-auto px-6 relative z-50 text-center flex flex-col items-center">
        {/* Glass Lights */}
        <div class="absolute top-20 left-[15%] w-24 h-24 bg-neon-blue/20 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(0,243,255,0.3)] animate-pulse pointer-events-none -z-10 mix-blend-screen"></div>
        <div class="absolute bottom-20 right-[15%] w-32 h-32 bg-acid-yellow/10 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(204,255,0,0.2)] animate-pulse delay-700 pointer-events-none -z-10 mix-blend-screen"></div>

        <div class="inline-flex items-center justify-center gap-2 px-4 py-2 mx-auto rounded-full bg-brand-dark/80 border border-[#ccff00]/50 text-[#ccff00] text-sm font-bold mb-6 shadow-[0_0_20px_rgba(204,255,0,0.2)] backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ccff00] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#ccff00] shadow-[0_0_10px_rgba(204,255,0,1)]"></span>
          </span>
          Corso gratuito · Nessun paywall ❤️
        </div>

        <h1 class="text-5xl md:text-7xl font-bold text-white text-center tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-heading drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
          Il <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-lime-400 to-yellow-400 text-glow">MarTech</span><br/>
          che usi davvero.
        </h1>

        <p class="text-xl text-slate-200 text-center max-w-2xl mx-auto mb-8 leading-relaxed font-sans font-medium drop-shadow-md">
          Marketing e Data Engineering insieme, finalmente.<br class="hidden sm:block"/>
          Lezioni dai problemi reali che affronto ogni giorno — non da libri.
        </p>

        <div class="flex flex-col items-center justify-center gap-4 relative z-50">
          <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-[#ccff00] hover:bg-[#b3e600] text-black font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
            Inizia a studiare ora
            <ArrowRightIcon className="w-5 h-5" />
          </a>
          <p class="text-sm text-slate-300 font-medium">12 Moduli · 90+ Lezioni · 100% Gratis</p>
        </div>
      </div>
    </section>

    {/* Social Proof / Numbers Strip */}
    <section class="relative z-20 mt-10">
      <div class="container mx-auto px-6">
        <div class="glass-panel border border-white/10 p-8 md:p-10">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-acid-yellow font-heading mb-1">12</div>
              <div class="text-sm text-slate-400 font-medium">Moduli completi</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-blue font-heading mb-1">90+</div>
              <div class="text-sm text-slate-400 font-medium">Lezioni pratiche</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-pink font-heading mb-1">€0</div>
              <div class="text-sm text-slate-400 font-medium">Nessun paywall</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-green font-heading mb-1">15+</div>
              <div class="text-sm text-slate-400 font-medium">Anni sul campo</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Value Proposition Section */}
    <section class="py-12 bg-brand-dark relative overflow-hidden">
      {/* Background decoration */}
      <div class="absolute top-1/2 left-0 w-96 h-96 bg-neon-blue/5 rounded-full blur-[120px] -translate-y-1/2 pointer-events-none"></div>
      <div class="absolute top-1/3 right-0 w-80 h-80 bg-acid-yellow/5 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-12">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-bold uppercase tracking-wider mb-6">
            Il problema
          </div>
          <h2 class="text-3xl md:text-5xl font-bold text-white font-heading mb-6 max-w-3xl mx-auto leading-tight">
            I corsi ti insegnano gli strumenti.<br class="hidden md:block" /> Nessuno ti insegna a usarli insieme.
          </h2>
          <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
            Il mercato vuole persone che capiscano sia le campagne che i dati che le misurano. Ma la formazione è ancora organizzata per silos separati.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 md:gap-8 max-w-5xl mx-auto">
          {/* Problem Card 1 */}
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-b from-red-500/10 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative glass-panel p-8 h-full border border-white/5 group-hover:border-red-500/20 transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center mb-6">
                <BackpackIcon className="w-6 h-6 text-red-400" />
              </div>
              <h3 class="text-lg font-bold text-white mb-3 font-heading">Il tracciamento si rompe. I corsi no.</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Venerdì sera, le conversioni calano a zero. Non è la campagna — è un evento rotto nel layer di dati. Nessun corso ti prepara a trovarlo in 10 minuti invece di 2 giorni.</p>
            </div>
          </div>
          {/* Problem Card 2 */}
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-b from-orange-500/10 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative glass-panel p-8 h-full border border-white/5 group-hover:border-orange-500/20 transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center mb-6">
                <Component1Icon className="w-6 h-6 text-orange-400" />
              </div>
              <h3 class="text-lg font-bold text-white mb-3 font-heading">"Chiedo al dev" non è una strategia.</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Aspetti 3 giorni una query che potresti scrivere tu in 20 minuti. O la scrivi sbagliata, ottimizzi sulla metrica errata e non lo scopri mai.</p>
            </div>
          </div>
          {/* Problem Card 3 */}
          <div class="group relative">
            <div class="absolute inset-0 bg-gradient-to-b from-yellow-500/10 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="relative glass-panel p-8 h-full border border-white/5 group-hover:border-yellow-500/20 transition-all duration-500">
              <div class="w-12 h-12 rounded-xl bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center mb-6">
                <PieChartIcon className="w-6 h-6 text-yellow-400" />
              </div>
              <h3 class="text-lg font-bold text-white mb-3 font-heading">€8.000 per una slide su Google Analytics.</h3>
              <p class="text-slate-400 text-sm leading-relaxed">I master insegnano gli stack di 3 anni fa. Kafka, ClickHouse e dbt — quelli che compaiono in ogni annuncio di lavoro — raramente li trovi in un syllabus.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Solution / Curriculum Path Section */}
    <section class="py-16 bg-brand-darker relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(204,255,0,0.03)_0%,transparent_70%)]"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-14">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-acid-yellow/10 border border-acid-yellow/20 text-acid-yellow text-xs font-bold uppercase tracking-wider mb-6">
            Il Percorso
          </div>
          <h2 class="text-3xl md:text-5xl font-bold text-white font-heading mb-6 max-w-4xl mx-auto leading-tight">
            12 moduli. Un filo dal dato grezzo<br class="hidden md:block" /> alla decisione di business.
          </h2>
          <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
            Ogni modulo costruisce sul precedente. Niente salti logici, niente teoria senza pratica immediata.
          </p>
        </div>

        {/* Curriculum Grid — 6 grouped modules */}
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-6xl mx-auto mb-12">

          <div class="group glass-panel p-7 border border-white/5 hover:border-cyan-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <div class="text-[11px] font-bold text-cyan-400/50 uppercase tracking-widest mb-3 font-ui">Modulo 01 – 02</div>
              <StackIcon className="w-7 h-7 text-cyan-400 mb-3" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Fondamenti & Raccolta Dati</h4>
              <p class="text-slate-400 text-sm leading-relaxed mb-4">Come si misura davvero. Dal primo evento tracciato all'architettura del dato — GDPR e privacy inclusi.</p>
              <div class="flex flex-wrap gap-1.5">
                {['Metriche', 'GTM', 'Event Tracking', 'GDPR'].map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-white/[0.04] border border-white/[0.06] text-slate-500">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-emerald-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-emerald-500/5 rounded-full blur-2xl group-hover:bg-emerald-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <div class="text-[11px] font-bold text-emerald-400/50 uppercase tracking-widest mb-3 font-ui">Modulo 03 – 04</div>
              <BarChartIcon className="w-7 h-7 text-emerald-400 mb-3" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">SQL, Python & Pipeline</h4>
              <p class="text-slate-400 text-sm leading-relaxed mb-4">Le query che i data team usano davvero. ETL, dbt e analisi in Python — non su dataset inventati.</p>
              <div class="flex flex-wrap gap-1.5">
                {['SQL', 'dbt', 'Python', 'ETL'].map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-white/[0.04] border border-white/[0.06] text-slate-500">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-orange-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-orange-500/5 rounded-full blur-2xl group-hover:bg-orange-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <div class="text-[11px] font-bold text-orange-400/50 uppercase tracking-widest mb-3 font-ui">Modulo 05 – 06</div>
              <LightningBoltIcon className="w-7 h-7 text-orange-400 mb-3" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Product & Marketing Analytics</h4>
              <p class="text-slate-400 text-sm leading-relaxed mb-4">A/B test reali, cohort analysis, attribuzione e unit economics calcolati sui tuoi dati.</p>
              <div class="flex flex-wrap gap-1.5">
                {['A/B Test', 'Cohort', 'LTV', 'Attribution'].map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-white/[0.04] border border-white/[0.06] text-slate-500">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-purple-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-purple-500/5 rounded-full blur-2xl group-hover:bg-purple-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <div class="text-[11px] font-bold text-purple-400/50 uppercase tracking-widest mb-3 font-ui">Modulo 07 – 08</div>
              <MagicWandIcon className="w-7 h-7 text-purple-400 mb-3" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Dashboard & Data Science</h4>
              <p class="text-slate-400 text-sm leading-relaxed mb-4">Dashboard che il business apre davvero. ML, clustering e churn prediction su dati marketing reali.</p>
              <div class="flex flex-wrap gap-1.5">
                {['Metabase', 'Grafana', 'Python', 'sklearn'].map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-white/[0.04] border border-white/[0.06] text-slate-500">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-blue-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-blue-500/5 rounded-full blur-2xl group-hover:bg-blue-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <div class="text-[11px] font-bold text-blue-400/50 uppercase tracking-widest mb-3 font-ui">Modulo 09 – 10</div>
              <DiscIcon className="w-7 h-7 text-blue-400 mb-3" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Data Engineering in Produzione</h4>
              <p class="text-slate-400 text-sm leading-relaxed mb-4">Kafka, ClickHouse, S3 e streaming real-time — l'infrastruttura delle scale-up, dall'interno.</p>
              <div class="flex flex-wrap gap-1.5">
                {['Kafka', 'ClickHouse', 'S3', 'Streaming'].map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-white/[0.04] border border-white/[0.06] text-slate-500">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="group glass-panel p-7 border border-white/5 hover:border-yellow-500/30 transition-all duration-500 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-yellow-500/5 rounded-full blur-2xl group-hover:bg-yellow-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <div class="text-[11px] font-bold text-yellow-400/50 uppercase tracking-widest mb-3 font-ui">Modulo 11 – 12</div>
              <ReaderIcon className="w-7 h-7 text-yellow-400 mb-3" />
              <h4 class="text-lg font-bold text-white mb-2 font-heading">Infrastruttura & Strategia</h4>
              <p class="text-slate-400 text-sm leading-relaxed mb-4">CI/CD per dati, IaC con Terraform, OKR e come costruire un team veramente data-driven.</p>
              <div class="flex flex-wrap gap-1.5">
                {['Terraform', 'GitHub Actions', 'OKR', 'dbt'].map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-white/[0.04] border border-white/[0.06] text-slate-500">{tag}</span>
                ))}
              </div>
            </div>
          </div>

        </div>

        {/* CTA + Tech Stack */}
        <div class="max-w-4xl mx-auto text-center">
          <a href="/course" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/10 text-slate-300 hover:text-white hover:border-white/20 transition-all text-sm font-medium mb-10">
            Esplora tutti i 12 moduli
            <ArrowRightIcon className="w-4 h-4" />
          </a>
          <p class="text-xs text-slate-500 uppercase tracking-widest font-bold mb-4">Stack tecnologico del corso</p>
          <div class="flex flex-wrap justify-center gap-3">
            {['SQL', 'Python', 'ClickHouse', 'Kafka', 'S3', 'Terraform', 'dbt', 'Metabase', 'BigQuery', 'GA4'].map((tech) => (
              <span class="px-4 py-2 rounded-lg bg-white/[0.03] border border-white/[0.06] text-slate-400 text-sm font-medium hover:border-acid-yellow/30 hover:text-slate-200 transition-all duration-300">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Who Is This For */}
    <section class="py-12 bg-brand-dark relative overflow-hidden">
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-neon-blue/[0.03] rounded-full blur-[150px] pointer-events-none"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-12">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-neon-blue/10 border border-neon-blue/20 text-neon-blue text-xs font-bold uppercase tracking-wider mb-6">
            Per chi è
          </div>
          <h2 class="text-3xl md:text-5xl font-bold text-white font-heading mb-4 max-w-3xl mx-auto leading-tight">
            Riconosci questa situazione?
          </h2>
          <p class="text-lg text-slate-500 max-w-xl mx-auto">
            Se almeno uno di questi ti descrive, sei nel posto giusto.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <div class="glass-panel p-8 border border-white/5 group hover:border-acid-yellow/20 transition-all duration-500 relative overflow-hidden">
            <div class="absolute -top-8 -right-8 w-32 h-32 bg-acid-yellow/5 rounded-full blur-2xl group-hover:bg-acid-yellow/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <div class="text-3xl mb-5">📊</div>
              <h3 class="text-lg font-bold text-white mb-3 font-heading">Il Marketing Manager che aspetta i dati</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Le campagne girano. Ma per capire perché il ROAS è calato devi aspettare il dev. O il report del lunedì. Vuoi rispondere alle domande tu, adesso.</p>
            </div>
          </div>

          <div class="glass-panel p-8 border border-white/5 group hover:border-neon-blue/20 transition-all duration-500 relative overflow-hidden">
            <div class="absolute -top-8 -right-8 w-32 h-32 bg-neon-blue/5 rounded-full blur-2xl group-hover:bg-neon-blue/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <div class="text-3xl mb-5">🔍</div>
              <h3 class="text-lg font-bold text-white mb-3 font-heading">L'Analyst che vuole più impatto</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Sei bravo con i numeri. Ma le analisi finiscono in un report che nessuno legge. Vuoi costruire pipeline reali, non solo fogli Excel. Vuoi che i dati diventino decisioni.</p>
            </div>
          </div>

          <div class="glass-panel p-8 border border-white/5 group hover:border-neon-pink/20 transition-all duration-500 relative overflow-hidden">
            <div class="absolute -top-8 -right-8 w-32 h-32 bg-pink-500/5 rounded-full blur-2xl group-hover:bg-pink-500/10 transition-colors duration-500"></div>
            <div class="relative z-10">
              <div class="text-3xl mb-5">🎓</div>
              <h3 class="text-lg font-bold text-white mb-3 font-heading">Il Junior che vuole distinguersi</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Gli annunci chiedono Kafka, ClickHouse, SQL avanzato. L'università ti ha insegnato Excel e SPSS. Vuoi arrivare al colloquio con roba reale nel portfolio.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* About the Instructor */}
    <section class="py-12 bg-brand-darker relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/[0.04] rounded-full blur-[120px] pointer-events-none"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto">
          <div class="grid md:grid-cols-[auto_1fr] gap-12 items-start">
            {/* Avatar */}
            <div class="flex flex-col items-center md:items-start gap-4">
              <div class="w-24 h-24 rounded-full overflow-hidden shadow-[0_0_40px_rgba(6,182,212,0.3)] border-2 border-cyan-400/30">
                <Image
                  src={andriiImage}
                  alt="Andrii Dyshkantiuk - Instructor"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width={96}
