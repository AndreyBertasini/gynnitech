---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Footer from '../components/Footer.astro';
import { ArrowRight } from 'lucide-react';
import { StarField } from '../components/StarField';
---

<Layout title="GYNNITECH - Analisi Dati e Marketing">
  <Navbar client:load />
  
  <main>
    {/* Hero Section */}
    <section class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <img 
          src="/ginni.png" 
          alt="Background" 
          class="w-full h-full object-cover opacity-80"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/60 via-brand-dark/30 to-brand-dark"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>
      
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-mint-500/20 blur-[120px] rounded-full opacity-30 pointer-events-none z-0"></div>
      
      <div class="container mx-auto px-6 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-white text-sm font-medium mb-8">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-white shadow-[0_0_10px_rgba(255,255,255,0.8)]"></span>
          </span>
          Analisi Marketing & Data Science ❤️
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6 leading-tight max-w-4xl mx-auto">
          Agisci sui fatti, <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-mint-300 to-mint-500">non sulle supposizioni</span>
        </h1>
        
        <p class="text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
          Analisi dati, statistica e ricerche di marketing per guidare la crescita del tuo business. Trasformiamo i dati in decisioni strategiche.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-mint-500 hover:bg-mint-400 text-white font-bold rounded-full transition-all shadow-[0_0_20px_rgba(2,86,155,0.4)] hover:shadow-[0_0_30px_rgba(2,86,155,0.6)] flex items-center justify-center gap-2">
            Inizia ad Imparare
            <ArrowRight class="w-5 h-5" />
          </a>
          <a href="/consulting" class="w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-full border border-white/10 transition-all backdrop-blur-sm">
            Richiedi Consulenza
          </a>
        </div>
      </div>
    </section>

    <FeatureGrid />
    
    {/* CTA Section */}
    <section class="py-32 bg-brand-dark relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-t from-mint-500/10 to-transparent pointer-events-none"></div>
      <div class="container mx-auto px-6 text-center relative z-10">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">Pronto a far crescere il tuo business?</h2>
        <p class="text-xl text-slate-400 mb-10 max-w-2xl mx-auto">Unisciti alle aziende che prendono decisioni basate sui dati con GYNNITECH.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/consulting" class="px-8 py-4 bg-mint-500 hover:bg-mint-400 text-white font-bold rounded-full transition-all shadow-lg hover:shadow-mint-500/50">
            Parla con un Esperto
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
