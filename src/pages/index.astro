---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRightIcon } from '@radix-ui/react-icons';
import { getImage } from 'astro:assets';
import ginniImage from '../assets/174_deep_sky_fix.webp';
import { getCollection } from 'astro:content';
import { COURSE_MODULES, COURSE_PHASES } from '../data/course-modules';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
import { CourseCard } from '../components/ui/CourseCard';
import { CoursePath } from '../components/ui/CoursePath';
import StarField from '../components/StarField.astro';
import { getModuleCoverAlt, getModuleCoverImage } from '../lib/module-covers';

const courseDocs = await getCollection('corso');

const lessonCounts = new Map<string, number>();
for (const doc of courseDocs) {
  const moduleId = doc.id.split('/')[0];
  lessonCounts.set(moduleId, (lessonCounts.get(moduleId) || 0) + 1);
}

const heroImage = await getImage({ src: ginniImage, quality: 80, format: 'webp' });

---

<Layout
  title="GinnyTech - MarTech, Analytics Engineering e A/B Testing"
  description="Corso gratuito di MarTech e Analytics Engineering: SQL, Python, Kafka, ClickHouse, A/B testing e statistica applicata, con contenuti basati su problemi reali."
  keywords={['martech', 'analytics engineering', 'ab testing', 'significativita statistica', 'sql', 'python', 'kafka', 'clickhouse']}
  image={heroImage.src}
  preloadImage
  preloadImageHref={heroImage.src}
>
  <Navbar client:idle />

  <main id="main-content" data-pagefind-body>
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${SITE_URL}/#andrii-dyshkantiuk`,
          "name": "Andrii Dyshkantiuk",
          "url": `${SITE_URL}/about`,
          "jobTitle": "MarTech Expert & Data Engineering Consultant",
          "description": "Andrii Dyshkantiuk è un esperto di MarTech in Italia con oltre 15 anni di esperienza in marketing analytics, data engineering, attribution modeling e CDP.",
          "knowsAbout": [
            "MarTech", "Marketing Analytics", "Data Engineering", "Attribution Modeling",
            "Customer Data Platform", "SQL", "Python", "Apache Kafka", "Marketing Data Science"
          ],
          "sameAs": ["https://www.linkedin.com/in/andrii-dyshkantiuk/", "https://github.com/AndreyBertasini"]
        },
        {
          "@type": "EducationalOrganization",
          "@id": `${SITE_URL}/#ginnytech`,
          "name": SITE_NAME,
          "url": SITE_URL,
          "description": SITE_DESCRIPTION,
          "founder": { "@id": `${SITE_URL}/#andrii-dyshkantiuk` },
          "potentialAction": {
            "@type": "SearchAction",
            "target": `${SITE_URL}/?q={search_term_string}`,
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} is:inline />

    {/* Hero Section */}
    <section class="home-hero relative isolate min-h-screen flex items-center justify-center pt-16 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <img
          src={heroImage.src}
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering"
          class="home-hero-image w-full h-full object-cover opacity-60 scale-[1.02]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width={heroImage.attributes.width}
          height={heroImage.attributes.height}
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/70 via-brand-dark/40 to-brand-dark"></div>
      </div>

      <StarField />

      <div class="home-comet" aria-hidden="true">
        <span class="home-comet__trail"></span>
        <span class="home-comet__wake"></span>
        <span class="home-comet__core"></span>
      </div>

      <div class="container mx-auto px-6 relative z-10 text-center flex flex-col items-center">
        <h1 class="stellar-vision-title max-w-4xl text-balance font-heading text-4xl font-bold leading-tight tracking-tight text-white md:text-5xl">
          <span class="stellar-vision-title__plain">Dove finiscono i numeri,</span>
          <span class="stellar-vision-title__vision">inizia la visione</span>
        </h1>

        <p class="mt-5 text-lg text-text-secondary text-center max-w-[30ch] sm:max-w-xl mx-auto mb-10 leading-relaxed font-sans [overflow-wrap:anywhere]">
          Marketing e Data Engineering nello stesso percorso.<br class="hidden sm:block"/>
          Lezioni pratiche, nate da problemi reali e strumenti usati sul campo.
        </p>

        <a href="#percorso" class="w-full max-w-[17rem] sm:w-auto sm:max-w-none px-6 sm:px-8 py-4 bg-accent hover:bg-accent-hover text-black font-bold rounded-full transition-transform transition-colors hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
          Inizia a studiare ora
          <ArrowRightIcon className="w-5 h-5" />
        </a>
      </div>
    </section>

    {/* Percorso in 5 fasi (stile Duolingo) */}
    <section id="percorso" class="relative z-10 py-24">
      <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-4 font-heading">
            Il tuo percorso in 5 fasi
          </h2>
          <p class="text-lg text-text-secondary leading-relaxed font-sans">
            Segui le fasi in ordine: ogni modulo si sblocca quando completi il precedente.
            I moduli avanzati restano accessibili dal catalogo qui sotto.
          </p>
        </div>

        <CoursePath
          phases={COURSE_PHASES.map((phase) => ({
            id: phase.id,
            title: phase.title,
            description: phase.description,
            modules: COURSE_MODULES.filter((m) => m.phase === phase.id).map((m) => ({
              id: m.id,
              title: m.title,
              href: `/course/${m.id}/`,
              icon: m.icon,
              color: m.color,
              lessonCount: lessonCounts.get(m.id) || 0,
            })),
          }))}
          client:load
        />
      </div>
    </section>

    {/* Course Grid Section */}
    <section id="corsi" class="relative z-10 py-24 border-t border-white/5">
      <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-4 font-heading">
            Marketing Data &amp; Analytics Engineering
          </h2>
          <p class="text-lg text-text-secondary leading-relaxed font-sans">
            Parti dalle basi e costruisci un percorso pratico: tracking, KPI, SQL, dashboard,
            esperimenti, AI e infrastruttura dati. Ogni modulo risponde a un problema reale.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
          {COURSE_MODULES.map((module, index) => {
            const lessonCount = lessonCounts.get(module.id) || 0;
            const coverImage = getModuleCoverImage(module.id);
            return (
              <CourseCard
                id={module.id}
                title={module.title}
                description={module.description}
                icon={module.icon}
                color={module.color}
                lessonCount={lessonCount}
                index={index}
                imageSrc={coverImage?.src}
                imageWidth={coverImage?.width}
                imageHeight={coverImage?.height}
                imageAlt={getModuleCoverAlt(module.title)}
              />
            );
          })}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(.home-hero-image) {
    object-position: 50% 34%;
  }

  @media (max-width: 640px) {
    :global(.home-hero-image) {
      object-position: 34% 34%;
    }
  }

  .home-comet {
    --comet-start: translate3d(-44vw, -12vh, 0) rotate(28deg) scale(0.88);
    --comet-mid: translate3d(76vw, 43vh, 0) rotate(28deg) scale(1.02);
    --comet-end: translate3d(132vw, 73vh, 0) rotate(28deg) scale(1.08);
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: clamp(18rem, 38vw, 42rem);
    height: clamp(3.5rem, 7vw, 5.5rem);
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: screen;
    filter: saturate(1.12);
    transform: var(--comet-start);
    transform-origin: 88% 50%;
    will-change: transform, opacity;
    animation: home-comet-flight 26s cubic-bezier(0.34, 0.02, 0.18, 1) 1.4s infinite;
  }

  .home-comet::before,
  .home-comet::after,
  .home-comet__trail,
  .home-comet__wake,
  .home-comet__core {
    position: absolute;
    pointer-events: none;
  }

  .home-comet::before {
    content: '';
    inset: 13% 0 10%;
    border-radius: 999px;
    background:
      radial-gradient(ellipse at 88% 50%, rgba(255, 255, 255, 0.18), transparent 18%),
      linear-gradient(90deg, transparent, rgba(108, 180, 255, 0.03) 34%, rgba(204, 255, 0, 0.08) 76%, transparent);
    filter: blur(18px);
    opacity: 0.58;
  }

  .home-comet::after {
    content: '';
    right: 1.9%;
    top: 50%;
    width: clamp(2.6rem, 5vw, 5.4rem);
    aspect-ratio: 1;
    border-radius: 999px;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.36) 0 6%, rgba(204, 255, 0, 0.2) 13%, rgba(112, 190, 255, 0.06) 38%, transparent 68%);
    filter: blur(9px);
    opacity: 0.46;
    transform: translate(50%, -50%);
  }

  .home-comet__trail {
    inset: 41% 5% 41% 0;
    border-radius: 999px;
    background:
      linear-gradient(90deg, transparent 0%, rgba(110, 190, 255, 0.025) 22%, rgba(255, 255, 255, 0.1) 66%, rgba(204, 255, 0, 0.26) 86%, rgba(255, 255, 255, 0.42) 100%);
    filter: blur(1.1px);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.58) 24%, #000 70%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.58) 24%, #000 70%, #000 100%);
  }

  .home-comet__trail::after {
    content: '';
    position: absolute;
    inset: -55% -1% -55% 28%;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.14), rgba(204, 255, 0, 0.15), transparent);
    filter: blur(3px);
    opacity: 0.2;
    animation: home-comet-trail-breathe 4.8s ease-in-out infinite;
  }

  .home-comet__wake {
    right: 0;
    top: 50%;
    width: 34%;
    height: 76%;
    border-radius: 999px;
    background:
      radial-gradient(circle at 76% 45%, rgba(255, 255, 255, 0.28) 0 1.5px, transparent 2.4px),
      radial-gradient(circle at 42% 58%, rgba(204, 255, 0, 0.13) 0 1px, transparent 2px),
      radial-gradient(circle at 22% 38%, rgba(126, 201, 255, 0.13) 0 1.2px, transparent 2px);
    filter: blur(0.25px);
    opacity: 0.48;
    transform: translateY(-50%);
  }

  .home-comet__core {
    right: 0;
    top: 50%;
    width: clamp(0.32rem, 0.78vw, 0.66rem);
    aspect-ratio: 1;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow:
      0 0 10px rgba(255, 255, 255, 0.34),
      0 0 22px rgba(204, 255, 0, 0.22),
      0 0 42px rgba(102, 179, 255, 0.16);
    transform: translate(50%, -50%);
  }

  @keyframes home-comet-flight {
    0%,
    13% {
      opacity: 0;
      transform: var(--comet-start);
    }
    20% {
      opacity: 0.13;
    }
    37% {
      opacity: 0.38;
    }
    57% {
      opacity: 0.3;
      transform: var(--comet-mid);
    }
    72% {
      opacity: 0;
      transform: var(--comet-end);
    }
    100% {
      opacity: 0;
      transform: var(--comet-end);
    }
  }

  @keyframes home-comet-trail-breathe {
    0%,
    100% {
      opacity: 0.12;
      transform: translateX(-3%) scaleX(0.9);
    }
    50% {
      opacity: 0.24;
      transform: translateX(2%) scaleX(1);
    }
  }

  .stellar-vision-title {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 0.08em;
    text-shadow:
      0 2px 28px rgba(0, 0, 0, 0.42),
      0 0 30px rgba(204, 255, 0, 0.08);
  }

  .stellar-vision-title::before,
  .stellar-vision-title::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
    opacity: 0.68;
    transform-origin: center;
    will-change: transform, opacity;
  }

  .stellar-vision-title::before {
    inset: -0.48em 12% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.42), rgba(204, 255, 0, 0.32), transparent);
    filter: blur(0.2px);
    animation: stellar-line-drift 12s ease-in-out infinite;
  }

  .stellar-vision-title::after {
    inset: -0.55em 6% -0.4em;
    background-image:
      radial-gradient(circle, rgba(255, 255, 255, 0.72) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgba(204, 255, 0, 0.5) 0 1px, transparent 1.5px);
    background-position: 8% 22%, 86% 78%;
    background-size: 10.5rem 6rem, 13rem 7rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 24%, #000 76%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 24%, #000 76%, transparent);
    animation: stellar-points-breathe 9s ease-in-out infinite;
  }

  .stellar-vision-title__plain,
  .stellar-vision-title__vision {
    display: block;
  }

  .stellar-vision-title__vision {
    position: relative;
    color: transparent;
    background:
      linear-gradient(100deg, #f8fff0 0%, #ccff00 28%, #ffffff 48%, #c7d0dc 70%, #ccff00 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stellar-vision-title__vision::before {
    content: '';
    position: absolute;
    inset: 18% -4% 32%;
    border-radius: 999px;
    background: linear-gradient(100deg, transparent 8%, rgba(255, 255, 255, 0.24) 48%, transparent 82%);
    mix-blend-mode: screen;
    opacity: 0.16;
    transform-origin: center;
    transform: translateX(-0.35em);
    will-change: transform, opacity;
    animation: stellar-text-glint 9s ease-in-out infinite;
  }

  .stellar-vision-title__vision::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.18em;
    width: min(9rem, 52%);
    height: 1px;
    transform: translateX(-50%);
    transform-origin: center;
    background: linear-gradient(90deg, transparent, rgba(204, 255, 0, 0.72), transparent);
    box-shadow: 0 0 18px rgba(204, 255, 0, 0.18);
    will-change: transform, opacity;
    animation: stellar-underline-breathe 7s ease-in-out infinite;
  }

  @keyframes stellar-text-glint {
    0%,
    100% {
      opacity: 0.08;
      transform: translateX(-0.35em);
    }
    50% {
      opacity: 0.28;
      transform: translateX(0.35em);
    }
  }

  @keyframes stellar-line-drift {
    0%,
    100% {
      transform: translateX(-2%) scaleX(0.82);
      opacity: 0.32;
    }
    50% {
      transform: translateX(2%) scaleX(1);
      opacity: 0.62;
    }
  }

  @keyframes stellar-points-breathe {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.26;
    }
    50% {
      transform: translateY(-4px);
      opacity: 0.52;
    }
  }

  @keyframes stellar-underline-breathe {
    0%,
    100% {
      opacity: 0.28;
      transform: translateX(-50%) scaleX(0.78);
    }
    50% {
      opacity: 0.72;
      transform: translateX(-50%) scaleX(1);
    }
  }

  @media (max-width: 640px) {
    .stellar-vision-title {
      gap: 0.1em;
    }

    .home-comet {
      --comet-start: translate3d(-58vw, -8vh, 0) rotate(31deg) scale(0.82);
      --comet-mid: translate3d(58vw, 38vh, 0) rotate(31deg) scale(0.95);
      --comet-end: translate3d(124vw, 66vh, 0) rotate(31deg) scale(1);
      width: 20rem;
      height: 3.7rem;
      animation-duration: 29s;
    }

    .stellar-vision-title::after {
      inset-inline: -4%;
      background-size: 8rem 5rem, 9rem 5.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stellar-vision-title::before,
    .stellar-vision-title::after,
    .stellar-vision-title__vision::before,
    .stellar-vision-title__vision::after,
    .home-comet,
    .home-comet__trail::after {
      animation: none;
    }

    .home-comet {
      display: none;
    }
  }
</style>
