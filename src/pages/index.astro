---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRightIcon } from '@radix-ui/react-icons';
import { StarField } from '../components/StarField';
import { Image } from 'astro:assets';
import ginniImage from '../assets/174_deep_sky_fix.png';
import { getCollection } from 'astro:content';
import { COURSE_MODULES } from '../data/course-modules';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
import { BookOpen, Activity, Database, GitMerge, Zap, BrainCircuit, Server, FlaskConical, BarChart, HardDrive, Radio, LayoutDashboard, Map as MapIcon } from 'lucide-react';
import { CourseCard } from '../components/ui/CourseCard';

const courseDocs = await getCollection('corso');

const lessonCounts = new Map<string, number>();
for (const doc of courseDocs) {
  const moduleId = doc.id.split('/')[0];
  lessonCounts.set(moduleId, (lessonCounts.get(moduleId) || 0) + 1);
}

const IconMap = {
  Activity, Database, GitMerge, Zap, BrainCircuit, Server, FlaskConical, BarChart, HardDrive, Radio, LayoutDashboard, Map: MapIcon
};

const moduleImages: Record<string, string> = {
  panoramica: '/course-module-images/panoramica.webp',
  'data-collection': '/course-module-images/data-collection.webp',
  'metriche-fondamenti': '/course-module-images/metriche-fondamenti.webp',
  'gestione-data-driven': '/course-module-images/gestione-data-driven.webp',
  'analisi-prodotto': '/course-module-images/analisi-prodotto.webp',
  'analisi-marketing': '/course-module-images/analisi-marketing.webp',
  'dashboard-visualizzazione': '/course-module-images/dashboard-visualizzazione.webp',
  'marketing-data-science': '/course-module-images/marketing-data-science.webp',
  'data-warehousing': '/course-module-images/data-warehousing.webp',
  's3-data-lake': '/course-module-images/s3-data-lake.webp',
  'kafka-streaming': '/course-module-images/kafka-streaming.webp',
  'real-time-analytics': '/course-module-images/real-time-analytics.webp',
  'infrastructure-ops': '/course-module-images/infrastructure-ops.webp',
  'advanced-sql': '/course-module-images/advanced-sql.webp',
  'matematica-analisi-dati': '/course-module-images/matematica-analisi-dati.webp',
  'analytics-engineering': '/course-module-images/analytics-engineering.webp',
  'significativita-statistica': '/course-module-images/significativita-statistica.webp',
  'direzioni-analitica': '/course-module-images/direzioni-analitica.webp',
  'filosofia-analisi-dati': '/course-module-images/filosofia-analisi-dati.webp',
};
---

<Layout
  title="GinnyTech — MarTech, Analytics Engineering e A/B Testing"
  description="Corso gratuito di MarTech e Analytics Engineering: SQL, Python, Kafka, ClickHouse, A/B testing e statistica applicata, con contenuti basati su problemi reali."
  keywords={['martech', 'analytics engineering', 'ab testing', 'significativita statistica', 'sql', 'python', 'kafka', 'clickhouse']}
  image={ginniImage.src}
>
  <Navbar client:idle />

  <main id="main-content">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${SITE_URL}/#andrii-dyshkantiuk`,
          "name": "Andrii Dyshkantiuk",
          "url": `${SITE_URL}/about`,
          "jobTitle": "MarTech Expert & Data Engineering Consultant",
          "description": "Andrii Dyshkantiuk è un esperto di MarTech in Italia con oltre 15 anni di esperienza in marketing analytics, data engineering, attribution modeling e CDP.",
          "knowsAbout": [
            "MarTech",
            "Marketing Analytics",
            "Data Engineering",
            "Attribution Modeling",
            "Customer Data Platform",
            "SQL",
            "Python",
            "Apache Kafka",
            "Marketing Data Science"
          ],
          "sameAs": [
            "https://www.linkedin.com/in/andrii-dyshkantiuk/",
            "https://github.com/AndreyBertasini"
          ]
        },
        {
          "@type": "EducationalOrganization",
          "@id": `${SITE_URL}/#ginnytech`,
          "name": SITE_NAME,
          "url": SITE_URL,
          "description": SITE_DESCRIPTION,
          "founder": { "@id": `${SITE_URL}/#andrii-dyshkantiuk` },
          "potentialAction": {
            "@type": "SearchAction",
            "target": `${SITE_URL}/?q={search_term_string}`,
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} is:inline />
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image
          src={ginniImage}
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering"
          class="w-full h-full object-cover opacity-75 scale-[1.02]"
          style="object-position: 50% 34%;"
          loading="eager"
          decoding="async"
          quality={80}
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/60 via-brand-dark/35 to-brand-dark/90"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>

      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none z-0 mix-blend-screen"></div>

      <div class="container mx-auto px-6 relative z-50 text-center flex flex-col items-center">
        {/* Glass Lights */}
        <div class="absolute top-20 left-[15%] w-24 h-24 bg-neon-blue/20 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(0,243,255,0.3)] animate-pulse pointer-events-none -z-10 mix-blend-screen"></div>
        <div class="absolute bottom-20 right-[15%] w-32 h-32 bg-acid-yellow/10 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(204,255,0,0.2)] animate-pulse delay-700 pointer-events-none -z-10 mix-blend-screen"></div>

        <h1 class="text-5xl md:text-7xl font-bold text-white text-center tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-heading drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
          Il <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-lime-400 to-yellow-400 text-glow">MarTech</span><br/>
          che usi davvero.
        </h1>

        <p class="text-xl text-slate-200 text-center max-w-2xl mx-auto mb-8 leading-relaxed font-sans font-medium drop-shadow-md">
          Marketing e Data Engineering insieme, finalmente.<br class="hidden sm:block"/>
          Lezioni dai problemi reali che affronto ogni giorno — non da libri.
        </p>

        <div class="flex flex-col items-center justify-center gap-4 relative z-50">
          <a href="#corsi" class="w-full sm:w-auto px-8 py-4 bg-[#ccff00] hover:bg-[#b3e600] text-black font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
            Inizia a studiare ora
            <ArrowRightIcon className="w-5 h-5" />
          </a>
        </div>
      </div>
    </section>

    {/* Course Grid Section */}
    <section id="corsi" class="relative z-20 py-24 overflow-hidden">
      {/* Background blobs */}
      <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-neon-blue/5 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute bottom-[-10%] left-[-5%] w-[600px] h-[600px] bg-neon-purple/5 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="container mx-auto px-6 relative z-10">

        {/* Header */}
        <div class="text-center max-w-4xl mx-auto mb-16">
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 tracking-tight leading-tight animate-fade-in-up [animation-delay:100ms] font-heading">
            Marketing Data &amp; <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00ffa3] via-[#ffffff] to-[#00f3ff] drop-shadow-[0_0_10px_rgba(0,255,163,0.5)] font-heading">
              Analytics Engineering
            </span>
          </h2>

          <p class="text-xl text-slate-400 mb-10 leading-relaxed max-w-2xl mx-auto animate-fade-in-up [animation-delay:200ms] font-sans">
            Dalla raccolta dati alla decisione: KPI, dashboard, analisi marketing, regressioni,
            causalità, forecasting, sperimentazione statistica e stack moderni per lavorare sui dati con rigore.
          </p>

        </div>

        {/* Modules Grid */}
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {COURSE_MODULES.map((module, index) => {
            const Icon = IconMap[module.icon as keyof typeof IconMap] || BookOpen;
            const lessonCount = lessonCounts.get(module.id) || 0;
            return (
              <CourseCard
                id={module.id}
                title={module.title}
                description={module.description}
                icon={Icon}
                color={module.color}
                lessonCount={lessonCount}
                index={index}
                imageSrc={moduleImages[module.id]}
                imageAlt={`${module.title} - visual editoriale GinnyTech`}
              />
            );
          })}
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

