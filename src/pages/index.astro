---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRight } from 'lucide-react';
import { StarField } from '../components/StarField';
import { Image } from 'astro:assets';
import ginniImage from '../assets/ginni.png';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
---

<Layout title="GinnyTech - Analisi Dati e Marketing" description="Corso gratuito e open-source di Data Analytics e Marketing Engineering. Impara SQL, Python, ClickHouse e data science con lezioni pratiche.">
  <Navbar client:load />
  
  <main id="main-content">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_NAME,
      "url": SITE_URL,
      "description": SITE_DESCRIPTION,
      "author": {
        "@type": "Person",
        "name": "Andrii Dyshkantiuk"
      }
    })} />
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image 
          src={ginniImage} 
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering" 
          class="w-full h-full object-cover opacity-60"
          loading="eager"
          decoding="async"
          quality="high"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/50 to-brand-dark"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>
      
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none z-0 mix-blend-screen"></div>
      
      <div class="container mx-auto px-6 relative z-50 text-center flex flex-col items-center">
        {/* Glass Lights Test */}
        <div class="absolute top-20 left-[15%] w-24 h-24 bg-neon-blue/20 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(0,243,255,0.3)] animate-pulse pointer-events-none -z-10 mix-blend-screen"></div>
        <div class="absolute bottom-20 right-[15%] w-32 h-32 bg-acid-yellow/10 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(204,255,0,0.2)] animate-pulse delay-700 pointer-events-none -z-10 mix-blend-screen"></div>

        <div class="inline-flex items-center justify-center gap-2 px-4 py-2 mx-auto rounded-full bg-brand-dark/80 border border-[#ccff00]/50 text-[#ccff00] text-sm font-bold mb-10 shadow-[0_0_20px_rgba(204,255,0,0.2)] backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ccff00] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#ccff00] shadow-[0_0_10px_rgba(204,255,0,1)]"></span>
          </span>
          Analisi Marketing & Data Science ❤️
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-white text-center tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-heading drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
          Primo corso <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-lime-400 to-yellow-400 text-glow">MarTech</span> <br/>
          in Italia
        </h1>
        
        <p class="text-xl text-slate-200 text-center max-w-2xl mx-auto mb-10 leading-relaxed font-sans font-medium drop-shadow-md">
          Oltre la teoria: lezioni di Data Analysis nate dalla pratica reale.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 relative z-50">
          <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-[#ccff00] hover:bg-[#b3e600] text-black font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
            Inizia ad Imparare
            <ArrowRight className="w-5 h-5" />
          </a>
          <a href="/perche-questo-corso" class="w-full sm:w-auto px-8 py-4 bg-brand-dark/50 hover:bg-brand-dark/80 text-white font-semibold rounded-full border border-white/20 transition-all backdrop-blur-md hover:border-cyan-400 hover:shadow-[0_0_15px_rgba(0,243,255,0.3)] font-ui text-lg">
            Informazioni
          </a>
        </div>
      </div>
    </section>

    {/* Why Start Section */}
    <section class="py-20 bg-brand-dark relative z-20">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <div class="glass-panel p-8 md:p-12 border border-white/10 relative overflow-hidden group hover:border-acid-yellow/30 transition-colors duration-500">
            {/* Ambient Glow */}
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-neon-blue/10 rounded-full blur-3xl group-hover:bg-neon-blue/20 transition-colors duration-500"></div>
            
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 font-heading relative z-10">
              Il Ponte tra <span class="text-neon-blue">Marketing</span> e <span class="text-acid-yellow">Ingegneria</span>
            </h2>
            
            <p class="text-lg text-slate-300 leading-relaxed mb-6 font-sans relative z-10">
              Il mercato non cerca solo chi sa scrivere codice, ma chi sa <strong class="text-white">risolvere problemi di business</strong>. 
            </p>
            
            <p class="text-lg text-slate-300 leading-relaxed font-sans relative z-10">
              La maggior parte dei corsi di Data Science si ferma alla teoria o a dataset puliti e irrealistici. 
              Questo corso nasce per colmare il vuoto tra l'analisi accademica e le esigenze reali, caotiche e veloci dei team di crescita moderni.
              Imparerai a sporcarti le mani con infrastrutture vere, pipeline che si rompono e dati che devono generare fatturato.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Stats Bar */}
    <section class="border-y border-white/10 bg-brand-dark/50 backdrop-blur-sm relative z-30">
      <div class="container mx-auto px-6 py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="text-center">
            <p class="text-3xl font-bold text-white font-heading">10+</p>
            <p class="text-sm text-slate-400 uppercase tracking-wider font-semibold">Moduli</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white font-heading">70+</p>
            <p class="text-sm text-slate-400 uppercase tracking-wider font-semibold">Lezioni Pratiche</p>
          </div>
           <div class="text-center">
            <p class="text-3xl font-bold text-white font-heading">100%</p>
            <p class="text-sm text-slate-400 uppercase tracking-wider font-semibold">Open Source</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-white font-heading">Zero</p>
            <p class="text-sm text-slate-400 uppercase tracking-wider font-semibold">Costi Nascosti</p>
          </div>
        </div>
      </div>
    </section>

    {/* Zero to Marketing Engineer Roadmap */}
    <section class="py-24 bg-brand-dark relative overflow-hidden">
      {/* Background Elements */}
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-cyan-500/50 to-transparent"></div>
      <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-purple-500/50 to-transparent"></div>
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-20">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-900/30 border border-cyan-500/30 text-cyan-400 text-xs font-bold uppercase tracking-widest mb-4">
            Percorso Completo
          </div>
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 font-heading">
            Da Zero a <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Data Analyst</span>
          </h2>
          <p class="text-xl text-slate-300 leading-relaxed">
            10 moduli, +70 lezioni. Un percorso strutturato che ti porta dalle basi fino all'analisi avanzata.
          </p>
        </div>

        <div class="relative max-w-5xl mx-auto">
          {/* Connector Line */}
          <div class="absolute left-[20px] md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-cyan-500 via-purple-500 to-pink-500 md:-translate-x-1/2 h-full opacity-30"></div>

          {/* Step 1 */}
          <div class="relative grid md:grid-cols-2 gap-8 md:gap-16 mb-16 group">
            <div class="md:text-right md:pr-8 pt-2">
              <h3 class="text-2xl font-bold text-white mb-2 font-heading group-hover:text-cyan-400 transition-colors">Fondamenti & Raccolta Dati</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Riceverai il metodo per progettare piani di tracciamento infallibili. Imparerai a strutturare i dati alla fonte garantendo qualità e privacy fin dal primo evento.</p>
            </div>
            <div class="absolute left-[11px] md:left-1/2 top-2 w-[18px] h-[18px] rounded-full bg-brand-dark border-2 border-cyan-500 md:-translate-x-1/2 z-20 shadow-[0_0_15px_rgba(6,182,212,0.5)] group-hover:scale-125 transition-transform duration-300"></div>
            <div class="pl-12 md:pl-0 md:col-start-2 pt-1">
               <span class="text-cyan-500 font-mono text-sm font-bold tracking-widest uppercase">Step 01</span>
            </div>
          </div>

          {/* Step 2 */}
          <div class="relative grid md:grid-cols-2 gap-8 md:gap-16 mb-16 group">
             <div class="pl-12 md:pl-8 md:col-start-2 pt-2 md:text-left">
              <h3 class="text-2xl font-bold text-white mb-2 font-heading group-hover:text-blue-400 transition-colors">SQL, Python & Pipeline</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Costruirai da zero il tuo stack tecnologico. Dominerai SQL e Python per creare pipeline automatizzate che portano i dati grezzi fino alla dashboard finale.</p>
            </div>
            <div class="absolute left-[11px] md:left-1/2 top-2 w-[18px] h-[18px] rounded-full bg-brand-dark border-2 border-blue-500 md:-translate-x-1/2 z-20 shadow-[0_0_15px_rgba(59,130,246,0.5)] group-hover:scale-125 transition-transform duration-300"></div>
             <div class="d-none md:block md:text-right md:pr-8 md:row-start-1 pt-1">
               <span class="text-blue-500 font-mono text-sm font-bold tracking-widest uppercase">Step 02</span>
            </div>
          </div>

          {/* Step 3 */}
          <div class="relative grid md:grid-cols-2 gap-8 md:gap-16 mb-16 group">
            <div class="md:text-right md:pr-8 pt-2">
              <h3 class="text-2xl font-bold text-white mb-2 font-heading group-hover:text-indigo-400 transition-colors">Metriche & Visualizzazione</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Svilupperai la sensibilità per distinguere le vanity metrics dai KPI reali. Creerai dashboard che non solo mostrano numeri, ma guidano le decisioni strategiche.</p>
            </div>
            <div class="absolute left-[11px] md:left-1/2 top-2 w-[18px] h-[18px] rounded-full bg-brand-dark border-2 border-indigo-500 md:-translate-x-1/2 z-20 shadow-[0_0_15px_rgba(99,102,241,0.5)] group-hover:scale-125 transition-transform duration-300"></div>
            <div class="pl-12 md:pl-0 md:col-start-2 pt-1">
               <span class="text-indigo-500 font-mono text-sm font-bold tracking-widest uppercase">Step 03</span>
            </div>
          </div>

           {/* Step 4 */}
          <div class="relative grid md:grid-cols-2 gap-8 md:gap-16 mb-16 group">
             <div class="pl-12 md:pl-8 md:col-start-2 pt-2 md:text-left">
              <h3 class="text-2xl font-bold text-white mb-2 font-heading group-hover:text-purple-400 transition-colors">Real-Time & ClickHouse</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Otterrai le competenze per gestire Big Data in tempo reale. Imparerai a configurare ClickHouse e viste materializzate per analisi istantanee su grandi volumi.</p>
            </div>
            <div class="absolute left-[11px] md:left-1/2 top-2 w-[18px] h-[18px] rounded-full bg-brand-dark border-2 border-purple-500 md:-translate-x-1/2 z-20 shadow-[0_0_15px_rgba(168,85,247,0.5)] group-hover:scale-125 transition-transform duration-300"></div>
             <div class="d-none md:block md:text-right md:pr-8 md:row-start-1 pt-1">
               <span class="text-purple-500 font-mono text-sm font-bold tracking-widest uppercase">Step 04</span>
            </div>
          </div>

          {/* Step 5 */}
          <div class="relative grid md:grid-cols-2 gap-8 md:gap-16 mb-16 group">
            <div class="md:text-right md:pr-8 pt-2">
              <h3 class="text-2xl font-bold text-white mb-2 font-heading group-hover:text-pink-400 transition-colors">Data Science & Sperimentazione</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Acquisirai gli strumenti del Data Scientist applicati al business. A/B testing, modelli di attribuzione e clustering per trasformare le ipotesi in certezze matematiche.</p>
            </div>
            <div class="absolute left-[11px] md:left-1/2 top-2 w-[18px] h-[18px] rounded-full bg-brand-dark border-2 border-pink-500 md:-translate-x-1/2 z-20 shadow-[0_0_15px_rgba(236,72,153,0.5)] group-hover:scale-125 transition-transform duration-300"></div>
            <div class="pl-12 md:pl-0 md:col-start-2 pt-1">
               <span class="text-pink-500 font-mono text-sm font-bold tracking-widest uppercase">Step 05</span>
            </div>
          </div>

           {/* Step 6 */}
          <div class="relative grid md:grid-cols-2 gap-8 md:gap-16 mb-16 group">
             <div class="pl-12 md:pl-8 md:col-start-2 pt-2 md:text-left">
              <h3 class="text-2xl font-bold text-white mb-2 font-heading group-hover:text-rose-400 transition-colors">Strategia & Management</h3>
              <p class="text-slate-400 text-sm leading-relaxed">Riceverai i framework di management per guidare team e progetti. Imparerai a comunicare con gli stakeholder e a tradurre l'analisi tecnica in impatto di business.</p>
            </div>
            <div class="absolute left-[11px] md:left-1/2 top-2 w-[18px] h-[18px] rounded-full bg-brand-dark border-2 border-rose-500 md:-translate-x-1/2 z-20 shadow-[0_0_15px_rgba(244,63,94,0.5)] group-hover:scale-125 transition-transform duration-300"></div>
             <div class="d-none md:block md:text-right md:pr-8 md:row-start-1 pt-1">
               <span class="text-rose-500 font-mono text-sm font-bold tracking-widest uppercase">Step 06</span>
            </div>
          </div>

          <div class="text-center mt-12">
             <a href="/course" class="inline-flex items-center gap-2 px-8 py-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/30 text-white font-bold rounded-full transition-all backdrop-blur-md">
                Esplora tutti i moduli
                <ArrowRight className="w-5 h-5" />
             </a>
          </div>

        </div>
      </div>
    </section>

    {/* New Professional Profile Section */}
    <section class="py-24 bg-brand-darker relative overflow-hidden">
        {/* Background blobs */}
        <div class="absolute top-1/4 left-0 w-96 h-96 bg-neon-purple/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-1/4 right-0 w-96 h-96 bg-neon-mint/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 font-heading">
                    Il Tuo Nuovo <span class="text-neon-purple">Profilo Professionale</span>
                </h2>
                <p class="text-slate-400 text-lg">
                    Non sarai solo un analista. Diventerai un Marketing Engineer completo.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                {/* Card 1 */}
                <div class="glass-panel p-8 hover:border-neon-purple/50 transition-colors duration-300 group hover:-translate-y-2 transform transition-transform">
                    <div class="w-14 h-14 bg-neon-purple/10 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 border border-neon-purple/20 shadow-[0_0_20px_rgba(168,85,247,0.15)]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neon-purple"><path d="M2 12h20"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6"/><path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v2h20V6z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-heading">Engineering Mindset</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Smetterai di fare analisi "usa e getta". Imparerai a costruire infrastrutture solide, scalabili e automatizzate che lavorano per te mentre dormi.
                    </p>
                </div>

                {/* Card 2 */}
                <div class="glass-panel p-8 hover:border-acid-yellow/50 transition-colors duration-300 group hover:-translate-y-2 transform transition-transform">
                    <div class="w-14 h-14 bg-acid-yellow/10 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 border border-acid-yellow/20 shadow-[0_0_20px_rgba(204,255,0,0.15)]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-acid-yellow"><path d="M22 22h-6a4 4 0 0 1-4-4V6a4 4 0 0 0-4-4H2"/><path d="M12 2v17c0 1.66 1.34 3 3 3h7"/><path d="M11.96 11.96 2 2"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-heading">Business Fluent</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Imparerai a parlare la lingua dei marketer e dei manager. Trasformerai query SQL complesse in indicazioni strategiche chiare che impattano il fatturato.
                    </p>
                </div>

                {/* Card 3 */}
                <div class="glass-panel p-8 hover:border-neon-mint/50 transition-colors duration-300 group hover:-translate-y-2 transform transition-transform">
                    <div class="w-14 h-14 bg-neon-mint/10 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 border border-neon-mint/20 shadow-[0_0_20px_rgba(0,250,154,0.15)]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neon-mint"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-heading">Real-World Ready</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Lavorerai su dataset sporchi, incompleti e reali. Affronterai i problemi che nessun tutorial ti mostra, preparandoti per le sfide vere del mercato del lavoro.
                    </p>
                </div>
            </div>
        </div>
    </section>
    
    {/* CTA Section */}
    <section class="pt-4 pb-16 bg-brand-dark relative">
      <div class="container mx-auto px-6 text-center">
        <p class="text-xl text-slate-400 max-w-xl mx-auto font-sans leading-relaxed">
          Il corso è completamente gratuito e open-source. Inizia il tuo percorso di apprendimento oggi stesso.
        </p>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
