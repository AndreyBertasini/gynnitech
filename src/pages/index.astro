---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRight } from 'lucide-react';
import { StarField } from '../components/StarField';
import { Image } from 'astro:assets';
import ginniImage from '../assets/ginni.png';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
---

<Layout title="GinnyTech - Analisi Dati e Marketing" description="Corso gratuito e open-source di Data Analytics e Marketing Engineering. Impara SQL, Python, ClickHouse e data science con lezioni pratiche.">
  <Navbar client:load />
  
  <main id="main-content">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_NAME,
      "url": SITE_URL,
      "description": SITE_DESCRIPTION,
      "author": {
        "@type": "Person",
        "name": "Andrii Dyshkantiuk",
        "url": "https://ginnytech.it",
        "sameAs": [
          "https://www.linkedin.com/in/andrii-dyshkantiuk/",
          "https://github.com/AndreyBertasini"
        ]
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${SITE_URL}/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image 
          src={ginniImage} 
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering" 
          class="w-full h-full object-cover opacity-60"
          loading="eager"
          decoding="async"
          quality="high"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/50 to-brand-dark"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>
      
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none z-0 mix-blend-screen"></div>
      
      <div class="container mx-auto px-6 relative z-50 text-center flex flex-col items-center">
        {/* Glass Lights Test */}
        <div class="absolute top-20 left-[15%] w-24 h-24 bg-neon-blue/20 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(0,243,255,0.3)] animate-pulse pointer-events-none -z-10 mix-blend-screen"></div>
        <div class="absolute bottom-20 right-[15%] w-32 h-32 bg-acid-yellow/10 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(204,255,0,0.2)] animate-pulse delay-700 pointer-events-none -z-10 mix-blend-screen"></div>

        <div class="inline-flex items-center justify-center gap-2 px-4 py-2 mx-auto rounded-full bg-brand-dark/80 border border-[#ccff00]/50 text-[#ccff00] text-sm font-bold mb-10 shadow-[0_0_20px_rgba(204,255,0,0.2)] backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ccff00] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#ccff00] shadow-[0_0_10px_rgba(204,255,0,1)]"></span>
          </span>
          Analisi Marketing & Data Science ❤️
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-white text-center tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-heading drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
          Primo corso <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-lime-400 to-yellow-400 text-glow">MarTech</span> <br/>
          in Italia
        </h1>
        
        <p class="text-xl text-slate-200 text-center max-w-2xl mx-auto mb-10 leading-relaxed font-sans font-medium drop-shadow-md">
          Oltre la teoria: lezioni di Data Analysis nate dalla pratica reale.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 relative z-50">
          <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-[#ccff00] hover:bg-[#b3e600] text-black font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
            Inizia ad Imparare
            <ArrowRight className="w-5 h-5" />
          </a>
          <a href="/perche-questo-corso" class="w-full sm:w-auto px-8 py-4 bg-brand-dark/50 hover:bg-brand-dark/80 text-white font-semibold rounded-full border border-white/20 transition-all backdrop-blur-md hover:border-cyan-400 hover:shadow-[0_0_15px_rgba(0,243,255,0.3)] font-ui text-lg">
            Informazioni
          </a>
        </div>
      </div>
    </section>

    {/* Why Start Section */}
    <section class="py-20 bg-brand-dark relative z-20">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <div class="glass-panel p-8 md:p-12 border border-white/10 relative overflow-hidden group hover:border-acid-yellow/30 transition-colors duration-500">
            {/* Ambient Glow */}
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-neon-blue/10 rounded-full blur-3xl group-hover:bg-neon-blue/20 transition-colors duration-500"></div>
            
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 font-heading relative z-10">
              Il Ponte tra <span class="text-neon-blue">Marketing</span> e <span class="text-acid-yellow">Ingegneria</span>
            </h2>
            
            <p class="text-lg text-slate-300 leading-relaxed mb-6 font-sans relative z-10">
              Il mercato non cerca solo chi sa scrivere codice, ma chi sa <strong class="text-white">risolvere problemi di business</strong>. 
            </p>
            
            <p class="text-lg text-slate-300 leading-relaxed font-sans relative z-10">
              La maggior parte dei corsi di Data Science si ferma alla teoria o a dataset puliti e irrealistici. 
              Questo corso nasce per colmare il vuoto tra l'analisi accademica e le esigenze reali, caotiche e veloci dei team di crescita moderni.
              Imparerai a sporcarti le mani con infrastrutture vere, pipeline che si rompono e dati che devono generare fatturato.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Meet the Instructor & Philosophy */}
    <section class="py-24 bg-brand-darker relative overflow-hidden">
      <div class="container mx-auto px-6 relative z-10">
        
        {/* Author Intro */}
        <div class="max-w-4xl mx-auto mb-20 text-center">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-cyan-400 to-blue-600 mb-8 shadow-[0_0_30px_rgba(6,182,212,0.5)]">
               <span class="text-3xl">👨‍💻</span>
            </div>
            <h2 class="text-3xl md:text-5xl font-bold text-white mb-6 font-heading">
              Mi chiamo <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Andrii</span>.
            </h2>
            <p class="text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto">
              Lavoro nel MarTech da anni — analisi dati, advertising, business intelligence, tracking in tempo reale.
              Ogni giorno costruisco pipeline, analizzo prodotti e trasformo dati in decisioni di business.
            </p>
             <p class="text-lg text-slate-400 mt-6 max-w-2xl mx-auto">
              Ho deciso di mettere tutto quello che so in un corso. <strong class="text-white">E di renderlo completamente gratuito.</strong>
            </p>
        </div>

        {/* The Course USP */}
        <div class="grid md:grid-cols-2 gap-12 mb-24 items-center">
           <div class="glass-panel p-8 md:p-12 border-l-4 border-l-acid-yellow relative overflow-hidden group">
              <div class="absolute -right-20 -top-20 w-64 h-64 bg-acid-yellow/10 rounded-full blur-3xl group-hover:bg-acid-yellow/20 transition-colors duration-500"></div>
              <h3 class="text-2xl font-bold text-white mb-4 font-heading">Il primo corso MarTech in Italia. <br/><span class="text-acid-yellow">Gratuito. Basato su esperienza reale.</span></h3>
              <p class="text-slate-400 leading-relaxed mb-4">
                 In Italia trovi corsi di marketing. Trovi corsi di programmazione. Trovi corsi di analytics. Ma nessuno li unisce come il mercato li richiede davvero.
              </p>
              <p class="text-slate-300 font-medium leading-relaxed">
                 Questo corso lo fa. Impari a costruire un prodotto, tracciarlo con stack moderni come <span class="text-white">ClickHouse</span>, analizzare il comportamento degli utenti in tempo reale e prendere decisioni basate sui dati — non sulle opinioni.
              </p>
           </div>
           
           <div class="space-y-8">
              <div class="glass-panel p-8 border-l-4 border-l-neon-purple hover:border-l-neon-purple/80 transition-all">
                  <h4 class="text-xl font-bold text-white mb-2 font-heading">Perché è gratuito?</h4>
                  <p class="text-slate-400 leading-relaxed">
                     Perché voglio restituire quello che ho imparato. A chi ha la voglia di crescere ma non sempre ha le risorse o la guida giusta. Online c'è tanto rumore — questo corso vuole essere il contrario: lezioni strutturate, chiare, con il rigore che serve davvero.
                  </p>
              </div>
              <div class="glass-panel p-8 border-l-4 border-l-neon-mint hover:border-l-neon-mint/80 transition-all">
                  <h4 class="text-xl font-bold text-white mb-2 font-heading">Per chi è?</h4>
                  <p class="text-slate-400 leading-relaxed">
                     Per studenti, neolaureati, professionisti junior — e per chiunque sia curioso di capire come funzionano i dati dietro il marketing moderno. <strong class="text-white">Non serve un background tecnico. Serve voglia di imparare.</strong>
                  </p>
              </div>
           </div>
        </div>

        {/* What You Learn Grid */}
        <div class="text-center mb-16">
           <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 font-heading">Cosa impari concretamente</h2>
        </div>
        
        <div class="grid md:grid-cols-3 gap-6">
           <div class="glass-panel p-6 hover:-translate-y-1 transition-transform duration-300 border-t-2 border-t-cyan-500/50">
              <h4 class="text-lg font-bold text-white mb-3">Dal Prodotto ai Dati</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Come si costruisce, come si traccia, come si analizza un prodotto digitale.</p>
           </div>
           <div class="glass-panel p-6 hover:-translate-y-1 transition-transform duration-300 border-t-2 border-t-blue-500/50">
              <h4 class="text-lg font-bold text-white mb-3">Data Analysis & Real-Time</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Analytics avanzata, SQL, Python e architetture real-time moderne.</p>
           </div>
           <div class="glass-panel p-6 hover:-translate-y-1 transition-transform duration-300 border-t-2 border-t-indigo-500/50">
              <h4 class="text-lg font-bold text-white mb-3">Dashboard Operative</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Creazione di dashboard che guidano le decisioni quotidiane, non solo vanity metrics.</p>
           </div>
           <div class="glass-panel p-6 hover:-translate-y-1 transition-transform duration-300 border-t-2 border-t-purple-500/50">
               <h4 class="text-lg font-bold text-white mb-3">Campagne Misurate</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Misurazione reale delle performance di marketing con attribuzione dati.</p>
           </div>
           <div class="glass-panel p-6 hover:-translate-y-1 transition-transform duration-300 border-t-2 border-t-pink-500/50">
              <h4 class="text-lg font-bold text-white mb-3">Zero Teoria Inutile</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Non slide teoriche — strumenti e metodi che uso ogni giorno nel mio lavoro.</p>
           </div>
           <div class="glass-panel p-6 hover:-translate-y-1 transition-transform duration-300 border-t-2 border-t-rose-500/50">
              <h4 class="text-lg font-bold text-white mb-3">Mentorship Open Source</h4>
              <p class="text-slate-400 text-sm leading-relaxed">Una guida strutturata per crescere professionalmente senza costi nascosti.</p>
           </div>
        </div>

      </div>


    
    {/* CTA Section */}
    <section class="pt-4 pb-16 bg-brand-dark relative">
      <div class="container mx-auto px-6 text-center">
        <p class="text-xl text-slate-400 max-w-xl mx-auto font-sans leading-relaxed">
          Il corso è completamente gratuito e open-source. Inizia il tuo percorso di apprendimento oggi stesso.
        </p>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
