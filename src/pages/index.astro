---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRightIcon } from '@radix-ui/react-icons';
import { Image } from 'astro:assets';
import ginniImage from '../assets/174_deep_sky_fix.webp';
import { getCollection } from 'astro:content';
import { COURSE_MODULES } from '../data/course-modules';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
import { CourseCard } from '../components/ui/CourseCard';
import { StarField } from '../components/StarField';
import { getModuleCoverAlt, getModuleCoverImage } from '../lib/module-covers';

const courseDocs = await getCollection('corso');

const lessonCounts = new Map<string, number>();
for (const doc of courseDocs) {
  const moduleId = doc.id.split('/')[0];
  lessonCounts.set(moduleId, (lessonCounts.get(moduleId) || 0) + 1);
}

---

<Layout
  title="GinnyTech - MarTech, Analytics Engineering e A/B Testing"
  description="Corso gratuito di MarTech e Analytics Engineering: SQL, Python, Kafka, ClickHouse, A/B testing e statistica applicata, con contenuti basati su problemi reali."
  keywords={['martech', 'analytics engineering', 'ab testing', 'significativita statistica', 'sql', 'python', 'kafka', 'clickhouse']}
  image={ginniImage.src}
  preloadImage
>
  <Navbar client:only="react" />

  <main id="main-content" data-pagefind-body>
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${SITE_URL}/#andrii-dyshkantiuk`,
          "name": "Andrii Dyshkantiuk",
          "url": `${SITE_URL}/about`,
          "jobTitle": "MarTech Expert & Data Engineering Consultant",
          "description": "Andrii Dyshkantiuk è un esperto di MarTech in Italia con oltre 15 anni di esperienza in marketing analytics, data engineering, attribution modeling e CDP.",
          "knowsAbout": [
            "MarTech", "Marketing Analytics", "Data Engineering", "Attribution Modeling",
            "Customer Data Platform", "SQL", "Python", "Apache Kafka", "Marketing Data Science"
          ],
          "sameAs": ["https://www.linkedin.com/in/andrii-dyshkantiuk/", "https://github.com/AndreyBertasini"]
        },
        {
          "@type": "EducationalOrganization",
          "@id": `${SITE_URL}/#ginnytech`,
          "name": SITE_NAME,
          "url": SITE_URL,
          "description": SITE_DESCRIPTION,
          "founder": { "@id": `${SITE_URL}/#andrii-dyshkantiuk` },
          "potentialAction": {
            "@type": "SearchAction",
            "target": `${SITE_URL}/?q={search_term_string}`,
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} is:inline />

    {/* Hero Section */}
    <section class="relative isolate min-h-screen flex items-center justify-center pt-16 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image
          src={ginniImage}
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering"
          class="home-hero-image w-full h-full object-cover opacity-60 scale-[1.02]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          quality={80}
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/70 via-brand-dark/40 to-brand-dark"></div>
      </div>

      <StarField client:only="react" />

      <div class="container mx-auto px-6 relative z-10 text-center flex flex-col items-center">
        <h1 class="stellar-vision-title max-w-4xl text-balance font-heading text-4xl font-bold leading-tight tracking-tight text-white md:text-5xl">
          <span class="stellar-vision-title__plain">Dove finiscono i numeri,</span>
          <span class="stellar-vision-title__vision">inizia la visione</span>
        </h1>

        <p class="mt-5 text-lg text-text-secondary text-center max-w-[30ch] sm:max-w-xl mx-auto mb-10 leading-relaxed font-sans [overflow-wrap:anywhere]">
          Marketing e Data Engineering nello stesso percorso.<br class="hidden sm:block"/>
          Lezioni pratiche, nate da problemi reali e strumenti usati sul campo.
        </p>

        <a href="#corsi" class="w-full max-w-[17rem] sm:w-auto sm:max-w-none px-6 sm:px-8 py-4 bg-accent hover:bg-accent-hover text-black font-bold rounded-full transition-transform transition-colors hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
          Inizia a studiare ora
          <ArrowRightIcon className="w-5 h-5" />
        </a>
      </div>
    </section>

    {/* Course Grid Section */}
    <section id="corsi" class="relative z-10 py-24">
      <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-4 font-heading">
            Marketing Data &amp; Analytics Engineering
          </h2>
          <p class="text-lg text-text-secondary leading-relaxed font-sans">
            Parti dalle basi e costruisci un percorso pratico: tracking, KPI, SQL, dashboard,
            esperimenti, AI e infrastruttura dati. Ogni modulo risponde a un problema reale.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
          {COURSE_MODULES.map((module, index) => {
            const lessonCount = lessonCounts.get(module.id) || 0;
            const coverImage = getModuleCoverImage(module.id);
            return (
              <CourseCard
                id={module.id}
                title={module.title}
                description={module.description}
                icon={module.icon}
                color={module.color}
                lessonCount={lessonCount}
                index={index}
                imageSrc={coverImage?.src}
                imageAlt={getModuleCoverAlt(module.title)}
              />
            );
          })}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  :global(.home-hero-image) {
    object-position: 50% 34%;
  }

  @media (max-width: 640px) {
    :global(.home-hero-image) {
      object-position: 34% 34%;
    }
  }

  .stellar-vision-title {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 0.08em;
    text-shadow:
      0 2px 28px rgba(0, 0, 0, 0.42),
      0 0 30px rgba(204, 255, 0, 0.08);
  }

  .stellar-vision-title::before,
  .stellar-vision-title::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
    opacity: 0.68;
    transform-origin: center;
    will-change: transform, opacity;
  }

  .stellar-vision-title::before {
    inset: -0.48em 12% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.42), rgba(204, 255, 0, 0.32), transparent);
    filter: blur(0.2px);
    animation: stellar-line-drift 12s ease-in-out infinite;
  }

  .stellar-vision-title::after {
    inset: -0.55em 6% -0.4em;
    background-image:
      radial-gradient(circle, rgba(255, 255, 255, 0.72) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgba(204, 255, 0, 0.5) 0 1px, transparent 1.5px);
    background-position: 8% 22%, 86% 78%;
    background-size: 10.5rem 6rem, 13rem 7rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 24%, #000 76%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 24%, #000 76%, transparent);
    animation: stellar-points-breathe 9s ease-in-out infinite;
  }

  .stellar-vision-title__plain,
  .stellar-vision-title__vision {
    display: block;
  }

  .stellar-vision-title__vision {
    position: relative;
    color: transparent;
    background:
      linear-gradient(100deg, #f8fff0 0%, #ccff00 28%, #ffffff 48%, #c7d0dc 70%, #ccff00 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stellar-vision-title__vision::before {
    content: '';
    position: absolute;
    inset: 18% -4% 32%;
    border-radius: 999px;
    background: linear-gradient(100deg, transparent 8%, rgba(255, 255, 255, 0.24) 48%, transparent 82%);
    mix-blend-mode: screen;
    opacity: 0.16;
    transform-origin: center;
    transform: translateX(-0.35em);
    will-change: transform, opacity;
    animation: stellar-text-glint 9s ease-in-out infinite;
  }

  .stellar-vision-title__vision::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.18em;
    width: min(9rem, 52%);
    height: 1px;
    transform: translateX(-50%);
    transform-origin: center;
    background: linear-gradient(90deg, transparent, rgba(204, 255, 0, 0.72), transparent);
    box-shadow: 0 0 18px rgba(204, 255, 0, 0.18);
    will-change: transform, opacity;
    animation: stellar-underline-breathe 7s ease-in-out infinite;
  }

  @keyframes stellar-text-glint {
    0%,
    100% {
      opacity: 0.08;
      transform: translateX(-0.35em);
    }
    50% {
      opacity: 0.28;
      transform: translateX(0.35em);
    }
  }

  @keyframes stellar-line-drift {
    0%,
    100% {
      transform: translateX(-2%) scaleX(0.82);
      opacity: 0.32;
    }
    50% {
      transform: translateX(2%) scaleX(1);
      opacity: 0.62;
    }
  }

  @keyframes stellar-points-breathe {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.26;
    }
    50% {
      transform: translateY(-4px);
      opacity: 0.52;
    }
  }

  @keyframes stellar-underline-breathe {
    0%,
    100% {
      opacity: 0.28;
      transform: translateX(-50%) scaleX(0.78);
    }
    50% {
      opacity: 0.72;
      transform: translateX(-50%) scaleX(1);
    }
  }

  @media (max-width: 640px) {
    .stellar-vision-title {
      gap: 0.1em;
    }

    .stellar-vision-title::after {
      inset-inline: -4%;
      background-size: 8rem 5rem, 9rem 5.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stellar-vision-title::before,
    .stellar-vision-title::after,
    .stellar-vision-title__vision::before,
    .stellar-vision-title__vision::after {
      animation: none;
    }
  }
</style>
