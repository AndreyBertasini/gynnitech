---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Footer from '../components/Footer.astro';
import { ArrowRight } from 'lucide-react';
import { StarField } from '../components/StarField';
---

<Layout title="GYNNITECH - Analisi Dati e Marketing">
  <Navbar client:load />
  
  <main>
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <img 
          src="/ginni.png" 
          alt="Background" 
          class="w-full h-full object-cover opacity-60"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/50 to-brand-dark"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>
      
      <div className="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none z-0 mix-blend-screen"></div>
      
      <div className="container mx-auto px-6 relative z-10 text-center flex flex-col items-center">
        <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-acid-yellow text-sm font-medium mb-8 shadow-[0_0_15px_rgba(204,255,0,0.1)] backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-acid-yellow opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-acid-yellow shadow-[0_0_10px_rgba(204,255,0,0.8)]"></span>
          </span>
          Analisi Marketing & Data Science ❤️
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-audiowide">
          Agisci sui fatti, <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-blue via-neon-green to-acid-yellow text-glow">non sulle supposizioni</span>
        </h1>
        
        <p class="text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-sans">
          Analisi dati, statistica e ricerche di marketing per guidare la crescita del tuo business. Trasformiamo i dati in decisioni strategiche.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-acid-yellow hover:bg-acid-yellow/90 text-brand-dark font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-orbitron">
            Inizia ad Imparare
            <ArrowRight class="w-5 h-5" />
          </a>
          <a href="/consulting" class="w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-full border border-white/10 transition-all backdrop-blur-sm hover:border-neon-blue hover:shadow-[0_0_15px_rgba(0,243,255,0.3)] font-orbitron">
            Richiedi Consulenza
          </a>
        </div>
      </div>
    </section>

    <FeatureGrid />
    
    {/* CTA Section */}
    <section class="py-32 bg-brand-dark relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-t from-neon-blue/10 to-transparent pointer-events-none"></div>
      <div class="container mx-auto px-6 text-center relative z-10">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 font-audiowide text-glow-blue">Pronto a far crescere il tuo business?</h2>
        <p class="text-xl text-slate-400 mb-10 max-w-2xl mx-auto font-sans">Unisciti alle aziende che prendono decisioni basate sui dati con GinnyTech.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/consulting" class="px-8 py-4 bg-neon-blue hover:bg-neon-blue/80 text-brand-dark font-bold rounded-full transition-all shadow-[0_0_20px_rgba(0,243,255,0.4)] hover:shadow-[0_0_30px_rgba(0,243,255,0.6)] font-orbitron">
            Parla con un Esperto
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
