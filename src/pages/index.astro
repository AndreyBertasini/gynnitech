---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Mintlify - Beautiful Documentation that Converts">
  <Navbar client:load />
  
  <main>
    <Hero />
    <FeatureGrid />
    
    {/* CTA Section */}
    <section class="py-32 bg-brand-dark relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-t from-mint-500/10 to-transparent pointer-events-none"></div>
      <div class="container mx-auto px-6 text-center relative z-10">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">Ready to upgrade your docs?</h2>
        <p class="text-xl text-slate-400 mb-10 max-w-2xl mx-auto">Join thousands of developers building the next generation of software with Mintlify.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/docs/introduction" class="px-8 py-4 bg-mint-500 hover:bg-mint-400 text-brand-dark font-bold rounded-full transition-all shadow-lg hover:shadow-mint-500/50">
            Get Started for Free
          </a>
          <a href="#" class="px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-full border border-white/10 transition-all">
            Contact Sales
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
