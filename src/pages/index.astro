---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRightIcon, StackIcon, BarChartIcon, MixIcon, LightningBoltIcon, DashboardIcon, MagicWandIcon, DiscIcon, ActivityLogIcon, CheckCircledIcon, ReaderIcon, CodeIcon, ArrowTopRightIcon, BackpackIcon, Component1Icon, PieChartIcon } from '@radix-ui/react-icons';
import { StarField } from '../components/StarField';
import { Image } from 'astro:assets';
import ginniImage from '../assets/ginni.png';
import andriiImage from '../assets/andrii.jpg';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
---

<Layout title="Corso MarTech Open Source: Data Engineering & Analytics per il Marketing" description="GinnyTech è una piattaforma di formazione gratuita per imparare a costruire infrastrutture dati reali. Tutorial pratici su SQL, Python, Kafka e Data Science.">
  <Navbar client:idle />

  <main id="main-content">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_NAME,
      "url": SITE_URL,
      "description": SITE_DESCRIPTION,
      "author": {
        "@type": "Person",
        "name": "Andrii Dyshkantiuk",
        "url": "https://ginnytech.it",
        "sameAs": [
          "https://www.linkedin.com/in/andrii-dyshkantiuk/",
          "https://github.com/AndreyBertasini"
        ]
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${SITE_URL}/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image
          src={ginniImage}
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering"
          class="w-full h-full object-cover opacity-60"
          loading="eager"
          decoding="async"
          quality={80}
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/50 to-brand-dark"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>

      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none z-0 mix-blend-screen"></div>

      <div class="container mx-auto px-6 relative z-50 text-center flex flex-col items-center">
        {/* Glass Lights */}
        <div class="absolute top-20 left-[15%] w-24 h-24 bg-neon-blue/20 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(0,243,255,0.3)] animate-pulse pointer-events-none -z-10 mix-blend-screen"></div>
        <div class="absolute bottom-20 right-[15%] w-32 h-32 bg-acid-yellow/10 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(204,255,0,0.2)] animate-pulse delay-700 pointer-events-none -z-10 mix-blend-screen"></div>

        <div class="inline-flex items-center justify-center gap-2 px-4 py-2 mx-auto rounded-full bg-brand-dark/80 border border-[#ccff00]/50 text-[#ccff00] text-sm font-bold mb-6 shadow-[0_0_20px_rgba(204,255,0,0.2)] backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ccff00] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#ccff00] shadow-[0_0_10px_rgba(204,255,0,1)]"></span>
          </span>
          Corso gratuito · Nessun paywall ❤️
        </div>

        <h1 class="text-5xl md:text-7xl font-bold text-white text-center tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-heading drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
          Il <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-lime-400 to-yellow-400 text-glow">MarTech</span><br/>
          che usi davvero.
        </h1>

        <p class="text-xl text-slate-200 text-center max-w-2xl mx-auto mb-8 leading-relaxed font-sans font-medium drop-shadow-md">
          Marketing e Data Engineering insieme, finalmente.<br class="hidden sm:block"/>
          Lezioni dai problemi reali che affronto ogni giorno — non da libri.
        </p>

        <div class="flex flex-col items-center justify-center gap-4 relative z-50">
          <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-[#ccff00] hover:bg-[#b3e600] text-black font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
            Inizia a studiare ora
            <ArrowRightIcon className="w-5 h-5" />
          </a>
          <p class="text-sm text-slate-300 font-medium">12 Moduli · 90+ Lezioni · 100% Gratis</p>
        </div>
      </div>
    </section>

    {/* Social Proof / Numbers Strip */}
    <section class="relative z-20 mt-10">
      <div class="container mx-auto px-6">
        <div class="glass-panel border border-white/10 p-8 md:p-10">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-acid-yellow font-heading mb-1">12</div>
              <div class="text-sm text-slate-400 font-medium">Moduli completi</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-blue font-heading mb-1">90+</div>
              <div class="text-sm text-slate-400 font-medium">Lezioni pratiche</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-pink font-heading mb-1">€0</div>
              <div class="text-sm text-slate-400 font-medium">Nessun paywall</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-green font-heading mb-1">15+</div>
              <div class="text-sm text-slate-400 font-medium">Anni sul campo</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ===== IL PROBLEMA ===== */}
    <section class="py-20 bg-brand-dark border-t border-white/[0.05]">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto">
          <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-red-500/50 mb-14 font-ui">Il problema</p>
          <div class="divide-y divide-white/[0.06]">
            <div class="py-7 flex items-baseline justify-between gap-8 group cursor-default">
              <p class="text-xl md:text-2xl font-bold text-white font-heading group-hover:text-red-100 transition-colors duration-300">Il tracciamento si rompe il venerdì sera.</p>
              <p class="text-slate-600 text-sm shrink-0 text-right hidden md:block">Nessuno ti insegna a ripararlo.</p>
            </div>
            <div class="py-7 flex items-baseline justify-between gap-8 group cursor-default">
              <p class="text-xl md:text-2xl font-bold text-white font-heading group-hover:text-orange-100 transition-colors duration-300">"Chiedo al dev." Aspetti 3 giorni.</p>
              <p class="text-slate-600 text-sm shrink-0 text-right hidden md:block">La query? 20 minuti, se sai SQL.</p>
            </div>
            <div class="py-7 flex items-baseline justify-between gap-8 group cursor-default">
              <p class="text-xl md:text-2xl font-bold text-white font-heading group-hover:text-amber-100 transition-colors duration-300">Hai fatto il master da €8.000.</p>
              <p class="text-slate-600 text-sm shrink-0 text-right hidden md:block">Insegnava stack del 2020.</p>
            </div>
          </div>
          <div class="mt-14 pt-10 border-t border-white/[0.06]">
            <p class="text-3xl md:text-4xl font-bold text-white font-heading leading-[1.1]">
              Non ti mancano gli strumenti.<br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-acid-yellow to-lime-400">Ti manca il filo tra loro.</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ===== IL PERCORSO ===== */}
    <section class="py-20 bg-brand-darker border-t border-white/[0.04]">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto">
          <div class="flex items-baseline justify-between mb-14">
            <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-acid-yellow/50 font-ui">Il Percorso · 12 moduli</p>
            <a href="/course" class="text-xs text-slate-600 hover:text-slate-300 transition-colors flex items-center gap-1 font-medium">
              Esplora tutti <ArrowRightIcon className="w-3 h-3" />
            </a>
          </div>
          <div class="space-y-8">

            <div>
              <p class="text-[9px] font-bold uppercase tracking-[0.3em] text-cyan-400/40 mb-3 font-ui">01–02 · Fondamenta</p>
              <div class="grid md:grid-cols-2 gap-px bg-white/[0.04] rounded-xl overflow-hidden">
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-cyan-400/60 transition-colors">01</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Metriche & Fondamenti</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">KPI, statistica, north star vs vanity</p>
                  </div>
                </a>
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-cyan-400/60 transition-colors">02</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Raccolta Dati</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">GTM, server-side, event schema, GDPR</p>
                  </div>
                </a>
              </div>
            </div>

            <div>
              <p class="text-[9px] font-bold uppercase tracking-[0.3em] text-emerald-400/40 mb-3 font-ui">03–04 · Dato grezzo → utile</p>
              <div class="grid md:grid-cols-2 gap-px bg-white/[0.04] rounded-xl overflow-hidden">
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-emerald-400/60 transition-colors">03</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">SQL & Analisi</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">Window functions, CTEs, cohort SQL</p>
                  </div>
                </a>
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-emerald-400/60 transition-colors">04</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Python & Pipeline</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">Pandas, dbt, ETL automatizzato</p>
                  </div>
                </a>
              </div>
            </div>

            <div>
              <p class="text-[9px] font-bold uppercase tracking-[0.3em] text-orange-400/40 mb-3 font-ui">05–06 · Analisi che decide</p>
              <div class="grid md:grid-cols-2 gap-px bg-white/[0.04] rounded-xl overflow-hidden">
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-orange-400/60 transition-colors">05</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Product Analytics</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">A/B test, cohort, retention, significatività</p>
                  </div>
                </a>
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-orange-400/60 transition-colors">06</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Marketing Analytics</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">Attribuzione, LTV, CAC payback, MMM</p>
                  </div>
                </a>
              </div>
            </div>

            <div>
              <p class="text-[9px] font-bold uppercase tracking-[0.3em] text-purple-400/40 mb-3 font-ui">07–08 · Visualizzare e predire</p>
              <div class="grid md:grid-cols-2 gap-px bg-white/[0.04] rounded-xl overflow-hidden">
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-purple-400/60 transition-colors">07</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Dashboard & Viz</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">Metabase, Grafana, design del dato</p>
                  </div>
                </a>
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-purple-400/60 transition-colors">08</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Data Science</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">Clustering, churn prediction, sklearn</p>
                  </div>
                </a>
              </div>
            </div>

            <div>
              <p class="text-[9px] font-bold uppercase tracking-[0.3em] text-blue-400/40 mb-3 font-ui">09–10 · Infrastruttura reale</p>
              <div class="grid md:grid-cols-2 gap-px bg-white/[0.04] rounded-xl overflow-hidden">
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-blue-400/60 transition-colors">09</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Real-Time & Streaming</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">Kafka, ClickHouse, OLAP in produzione</p>
                  </div>
                </a>
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-blue-400/60 transition-colors">10</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Data Engineering</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">S3, BigQuery, pipeline cloud</p>
                  </div>
                </a>
              </div>
            </div>

            <div>
              <p class="text-[9px] font-bold uppercase tracking-[0.3em] text-yellow-400/40 mb-3 font-ui">11–12 · Strategia e leadership</p>
              <div class="grid md:grid-cols-2 gap-px bg-white/[0.04] rounded-xl overflow-hidden">
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-yellow-400/60 transition-colors">11</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Infrastruttura & DevOps</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">Terraform, GitHub Actions, CI/CD</p>
                  </div>
                </a>
                <a href="/course" class="group flex items-center gap-4 px-5 py-4 bg-brand-darker hover:bg-white/[0.03] transition-colors">
                  <span class="text-xs font-black text-white/10 font-heading tabular-nums shrink-0 group-hover:text-yellow-400/60 transition-colors">12</span>
                  <div>
                    <p class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors leading-snug">Gestione Data-Driven</p>
                    <p class="text-[11px] text-slate-700 mt-0.5">OKR, team, cultura del dato</p>
                  </div>
                </a>
              </div>
            </div>

          </div>
          <div class="mt-10 pt-8 border-t border-white/[0.04] flex flex-wrap gap-1.5">
            {['SQL', 'Python', 'ClickHouse', 'Kafka', 'dbt', 'Terraform', 'BigQuery', 'Grafana', 'sklearn', 'GA4'].map((tech) => (
              <span class="px-2.5 py-1 text-[10px] text-slate-700 border border-white/[0.05] rounded font-medium cursor-default hover:text-slate-400 hover:border-white/10 transition-colors">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ===== PER CHI È ===== */}
    <section class="py-20 bg-brand-dark border-t border-white/[0.04]">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto">
          <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-neon-blue/40 mb-14 font-ui">Per chi è</p>
          <div class="divide-y divide-white/[0.06]">
            <div class="py-6 md:grid md:grid-cols-[180px_1fr] gap-10 items-baseline">
              <p class="text-sm font-bold text-white mb-1.5 md:mb-0 font-heading">Marketing Manager</p>
              <p class="text-slate-500 text-sm leading-relaxed">Le campagne girano. Ma per capire il ROAS devi aspettare il dev — o il report del lunedì.</p>
            </div>
            <div class="py-6 md:grid md:grid-cols-[180px_1fr] gap-10 items-baseline">
              <p class="text-sm font-bold text-white mb-1.5 md:mb-0 font-heading">Data Analyst</p>
              <p class="text-slate-500 text-sm leading-relaxed">Le analisi sono corrette. Ma finiscono in un deck che nessuno apre. Vuoi che diventino decisioni.</p>
            </div>
            <div class="py-6 md:grid md:grid-cols-[180px_1fr] gap-10 items-baseline">
              <p class="text-sm font-bold text-white mb-1.5 md:mb-0 font-heading">Junior ambizioso</p>
              <p class="text-slate-500 text-sm leading-relaxed">Le job description chiedono Kafka e ClickHouse. L'università ti ha dato Excel. Vuoi un portfolio reale.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ===== CHI INSEGNA ===== */}
    <section class="py-20 bg-brand-darker border-t border-white/[0.04]">
      <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto">
          <div class="flex gap-7 items-start">
            <div class="w-14 h-14 rounded-xl overflow-hidden border border-white/[0.08] shrink-0 mt-1">
              <Image
                src={andriiImage}
                alt="Andrii Dyshkantiuk"
                class="w-full h-full object-cover"
                loading="lazy"
                width={56}
                height={56}
              />
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-cyan-400/40 mb-3 font-ui">Chi insegna</p>
              <p class="text-xl md:text-2xl font-bold text-white font-heading mb-3 leading-snug">
                Andrii Dyshkantiuk — <span class="text-slate-400 font-normal">15 anni di MarTech sul campo.</span>
              </p>
              <p class="text-slate-500 text-sm leading-relaxed mb-5 max-w-lg">
                Ho costruito pipeline, gestito budget pubblicitari, riparato tracciamenti rotti alle 11 di sera. GinnyTech è quello che avrei voluto trovare quando ho iniziato.
              </p>
              <div class="flex gap-2">
                <a href="https://www.linkedin.com/in/andrii-dyshkantiuk/" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-xs text-slate-600 hover:text-slate-300 transition-colors border border-white/[0.07] rounded px-3 py-1.5 hover:border-white/15">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  LinkedIn
                </a>
                <a href="https://github.com/AndreyBertasini" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-xs text-slate-600 hover:text-slate-300 transition-colors border border-white/[0.07] rounded px-3 py-1.5 hover:border-white/15">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
