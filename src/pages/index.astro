---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import FeatureGrid from '../components/FeatureGrid.astro';
import Footer from '../components/Footer.astro';
import { ArrowRight } from 'lucide-react';
import { StarField } from '../components/StarField';
import { Image } from 'astro:assets';
import ginniImage from '../assets/ginni.png';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
---

<Layout title="GinnyTech - Analisi Dati e Marketing" description="Corso gratuito e open-source di Data Analytics e Marketing Engineering. Impara SQL, Python, ClickHouse e data science con lezioni pratiche.">
  <Navbar client:load />
  
  <main id="main-content">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_NAME,
      "url": SITE_URL,
      "description": SITE_DESCRIPTION,
      "author": {
        "@type": "Person",
        "name": "Andrii Dyshkantiuk"
      }
    })} />
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image 
          src={ginniImage} 
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering" 
          class="w-full h-full object-cover opacity-60"
          loading="eager"
          decoding="async"
          quality="high"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/50 to-brand-dark"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>
      
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none z-0 mix-blend-screen"></div>
      
      <div class="container mx-auto px-6 relative z-50 text-center flex flex-col items-center">
        {/* Glass Lights Test */}
        <div class="absolute top-20 left-[15%] w-24 h-24 bg-neon-blue/20 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(0,243,255,0.3)] animate-pulse pointer-events-none -z-10 mix-blend-screen"></div>
        <div class="absolute bottom-20 right-[15%] w-32 h-32 bg-acid-yellow/10 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(204,255,0,0.2)] animate-pulse delay-700 pointer-events-none -z-10 mix-blend-screen"></div>

        <div class="inline-flex items-center justify-center gap-2 px-4 py-2 mx-auto rounded-full bg-brand-dark/80 border border-[#ccff00]/50 text-[#ccff00] text-sm font-bold mb-10 shadow-[0_0_20px_rgba(204,255,0,0.2)] backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ccff00] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#ccff00] shadow-[0_0_10px_rgba(204,255,0,1)]"></span>
          </span>
          Analisi Marketing & Data Science ❤️
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-white text-center tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-heading drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
          Primo corso MarTech <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-lime-400 to-yellow-400 text-glow">in Italia</span>
        </h1>
        
        <p class="text-xl text-slate-200 text-center max-w-2xl mx-auto mb-10 leading-relaxed font-sans font-medium drop-shadow-md">
          Oltre la teoria: lezioni di Data Analysis nate dalla pratica reale.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 relative z-50">
          <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-[#ccff00] hover:bg-[#b3e600] text-black font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
            Inizia ad Imparare
            <ArrowRight className="w-5 h-5" />
          </a>
          <a href="/perche-questo-corso" class="w-full sm:w-auto px-8 py-4 bg-brand-dark/50 hover:bg-brand-dark/80 text-white font-semibold rounded-full border border-white/20 transition-all backdrop-blur-md hover:border-cyan-400 hover:shadow-[0_0_15px_rgba(0,243,255,0.3)] font-ui text-lg">
            Informazioni
          </a>
        </div>
      </div>
    </section>

    {/* Why Start Section */}
    <section class="py-20 bg-brand-dark relative z-20">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <div class="glass-panel p-8 md:p-12 border border-white/10 relative overflow-hidden group hover:border-acid-yellow/30 transition-colors duration-500">
            {/* Ambient Glow */}
            <div class="absolute -right-20 -top-20 w-64 h-64 bg-neon-blue/10 rounded-full blur-3xl group-hover:bg-neon-blue/20 transition-colors duration-500"></div>
            
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 font-heading relative z-10">
              Il Ponte tra <span class="text-neon-blue">Marketing</span> e <span class="text-acid-yellow">Ingegneria</span>
            </h2>
            
            <p class="text-lg text-slate-300 leading-relaxed mb-6 font-sans relative z-10">
              Il mercato non cerca solo chi sa scrivere codice, ma chi sa <strong class="text-white">risolvere problemi di business</strong>. 
            </p>
            
            <p class="text-lg text-slate-300 leading-relaxed font-sans relative z-10">
              La maggior parte dei corsi di Data Science si ferma alla teoria o a dataset puliti e irrealistici. 
              Questo corso nasce per colmare il vuoto tra l'analisi accademica e le esigenze reali, caotiche e veloci dei team di crescita moderni.
              Imparerai a sporcarti le mani con infrastrutture vere, pipeline che si rompono e dati che devono generare fatturato.
            </p>
          </div>
        </div>
      </div>
    </section>

    <FeatureGrid />

    {/* What You Learn Section */}
    <section class="py-20 bg-brand-darker relative overflow-hidden">
        {/* Background blobs */}
        <div class="absolute top-1/4 left-0 w-96 h-96 bg-neon-purple/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-1/4 right-0 w-96 h-96 bg-neon-mint/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 font-heading">
                    Il Tuo Nuovo <span class="text-neon-purple">Profilo Professionale</span>
                </h2>
                <p class="text-slate-400 text-lg">
                    Non sarai solo un analista. Diventerai un Marketing Engineer completo.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                {/* Card 1 */}
                <div class="glass-panel p-8 hover:border-neon-purple/50 transition-colors duration-300 group">
                    <div class="w-12 h-12 bg-neon-purple/10 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 border border-neon-purple/20">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neon-purple"><path d="M2 12h20"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6"/><path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v2h20V6z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-heading">Engineering Mindset</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Smetterai di fare analisi "usa e getta". Imparerai a costruire infrastrutture solide, scalabili e automatizzate che lavorano per te mentre dormi.
                    </p>
                </div>

                {/* Card 2 */}
                <div class="glass-panel p-8 hover:border-acid-yellow/50 transition-colors duration-300 group">
                    <div class="w-12 h-12 bg-acid-yellow/10 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 border border-acid-yellow/20">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-acid-yellow"><path d="M22 22h-6a4 4 0 0 1-4-4V6a4 4 0 0 0-4-4H2"/><path d="M12 2v17c0 1.66 1.34 3 3 3h7"/><path d="M11.96 11.96 2 2"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-heading">Business Fluent</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Imparerai a parlare la lingua dei marketer e dei manager. Trasformerai query SQL complesse in indicazioni strategiche chiare che impattano il fatturato.
                    </p>
                </div>

                {/* Card 3 */}
                <div class="glass-panel p-8 hover:border-neon-mint/50 transition-colors duration-300 group">
                    <div class="w-12 h-12 bg-neon-mint/10 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 border border-neon-mint/20">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neon-mint"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-heading">Real-World Ready</h3>
                    <p class="text-slate-400 leading-relaxed text-sm">
                        Lavorerai su dataset sporchi, incompleti e reali. Affronterai i problemi che nessun tutorial ti mostra, preparandoti per le sfide vere del mercato del lavoro.
                    </p>
                </div>
            </div>
        </div>
    </section>
    
    {/* CTA Section */}
    <section class="pt-4 pb-16 bg-brand-dark relative">
      <div class="container mx-auto px-6 text-center">
        <p class="text-xl text-slate-400 max-w-xl mx-auto font-sans leading-relaxed">
          Il corso è completamente gratuito e open-source. Inizia il tuo percorso di apprendimento oggi stesso.
        </p>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>
