---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRightIcon } from '@radix-ui/react-icons';
import { Image } from 'astro:assets';
import ginniImage from '../assets/174_deep_sky_fix.webp';
import { getCollection } from 'astro:content';
import { COURSE_MODULES } from '../data/course-modules';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
import { CourseCard } from '../components/ui/CourseCard';

const courseDocs = await getCollection('corso');

const lessonCounts = new Map<string, number>();
for (const doc of courseDocs) {
  const moduleId = doc.id.split('/')[0];
  lessonCounts.set(moduleId, (lessonCounts.get(moduleId) || 0) + 1);
}

const moduleImages: Record<string, string> = {
  panoramica: '/course-module-images/panoramica.webp',
  'data-collection': '/course-module-images/data-collection.webp',
  'metriche-fondamenti': '/course-module-images/metriche-fondamenti.webp',
  'gestione-data-driven': '/course-module-images/gestione-data-driven.webp',
  'analisi-prodotto': '/course-module-images/analisi-prodotto.webp',
  'analisi-marketing': '/course-module-images/analisi-marketing.webp',
  'dashboard-visualizzazione': '/course-module-images/dashboard-visualizzazione.webp',
  'marketing-data-science': '/course-module-images/marketing-data-science.webp',
  'data-warehousing': '/course-module-images/data-warehousing.webp',
  's3-data-lake': '/course-module-images/s3-data-lake.webp',
  'kafka-streaming': '/course-module-images/kafka-streaming.webp',
  'real-time-analytics': '/course-module-images/real-time-analytics.webp',
  'infrastructure-ops': '/course-module-images/infrastructure-ops.webp',
  'advanced-sql': '/course-module-images/advanced-sql.webp',
  'matematica-analisi-dati': '/course-module-images/matematica-analisi-dati.webp',
  'analytics-engineering': '/course-module-images/analytics-engineering.webp',
  'significativita-statistica': '/course-module-images/significativita-statistica.webp',
  'direzioni-analitica': '/course-module-images/direzioni-analitica.webp',
  'filosofia-analisi-dati': '/course-module-images/filosofia-analisi-dati.webp',
};
---

<Layout
  title="GinnyTech — MarTech, Analytics Engineering e A/B Testing"
  description="Corso gratuito di MarTech e Analytics Engineering: SQL, Python, Kafka, ClickHouse, A/B testing e statistica applicata, con contenuti basati su problemi reali."
  keywords={['martech', 'analytics engineering', 'ab testing', 'significativita statistica', 'sql', 'python', 'kafka', 'clickhouse']}
  image={ginniImage.src}
>
  <Navbar client:only="react" />

  <main id="main-content">
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": `${SITE_URL}/#andrii-dyshkantiuk`,
          "name": "Andrii Dyshkantiuk",
          "url": `${SITE_URL}/about`,
          "jobTitle": "MarTech Expert & Data Engineering Consultant",
          "description": "Andrii Dyshkantiuk è un esperto di MarTech in Italia con oltre 15 anni di esperienza in marketing analytics, data engineering, attribution modeling e CDP.",
          "knowsAbout": [
            "MarTech", "Marketing Analytics", "Data Engineering", "Attribution Modeling",
            "Customer Data Platform", "SQL", "Python", "Apache Kafka", "Marketing Data Science"
          ],
          "sameAs": ["https://www.linkedin.com/in/andrii-dyshkantiuk/", "https://github.com/AndreyBertasini"]
        },
        {
          "@type": "EducationalOrganization",
          "@id": `${SITE_URL}/#ginnytech`,
          "name": SITE_NAME,
          "url": SITE_URL,
          "description": SITE_DESCRIPTION,
          "founder": { "@id": `${SITE_URL}/#andrii-dyshkantiuk` },
          "potentialAction": {
            "@type": "SearchAction",
            "target": `${SITE_URL}/?q={search_term_string}`,
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} is:inline />

    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-16 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image
          src={ginniImage}
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering"
          class="w-full h-full object-cover opacity-60 scale-[1.02]"
          style="object-position: 50% 34%;"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          quality={80}
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/70 via-brand-dark/40 to-brand-dark"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10 text-center flex flex-col items-center">
        <h1 class="text-4xl md:text-6xl font-bold text-white text-center tracking-tight mb-6 leading-tight max-w-3xl mx-auto font-heading">
          Il <span class="text-accent">MarTech</span> che usi davvero.
        </h1>

        <p class="text-lg text-text-secondary text-center max-w-xl mx-auto mb-10 leading-relaxed font-sans">
          Marketing e Data Engineering insieme, finalmente.<br class="hidden sm:block"/>
          Lezioni dai problemi reali che affronto ogni giorno — non da libri.
        </p>

        <a href="#corsi" class="px-8 py-4 bg-accent hover:bg-accent-hover text-black font-bold rounded-full transition-all hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
          Inizia a studiare ora
          <ArrowRightIcon className="w-5 h-5" />
        </a>
      </div>
    </section>

    {/* Course Grid Section */}
    <section id="corsi" class="relative z-10 py-24">
      <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-4 font-heading">
            Marketing Data &amp; Analytics Engineering
          </h2>
          <p class="text-lg text-text-secondary leading-relaxed font-sans">
            Dalla raccolta dati alla decisione: KPI, dashboard, analisi marketing, regressioni,
            causalità, forecasting, sperimentazione statistica e stack moderni per lavorare sui dati con rigore.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
          {COURSE_MODULES.map((module, index) => {
            const lessonCount = lessonCounts.get(module.id) || 0;
            return (
              <CourseCard
                id={module.id}
                title={module.title}
                description={module.description}
                icon={module.icon}
                color={module.color}
                lessonCount={lessonCount}
                index={index}
                imageSrc={moduleImages[module.id]}
                imageAlt={`${module.title} - visual editoriale GinnyTech`}
              />
            );
          })}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
