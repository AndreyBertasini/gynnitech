---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Problem from '../components/home/Problem.astro';
import Solution from '../components/home/Solution.astro';
import SocialProof from '../components/home/SocialProof.astro';
import CoursePreview from '../components/home/CoursePreview.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
---

<Layout title="GinnyTech - Il primo corso MarTech open-source in Italia">
  <Navbar client:load />
  <main class="overflow-hidden">
    <Hero />
    <Problem />
    <Solution />
    <SocialProof />
    <CoursePreview />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
