---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { ArrowRightIcon, StackIcon, BarChartIcon, MixIcon, LightningBoltIcon, DashboardIcon, MagicWandIcon, DiscIcon, ActivityLogIcon, CheckCircledIcon, ReaderIcon, CodeIcon, ArrowTopRightIcon, BackpackIcon, Component1Icon, PieChartIcon } from '@radix-ui/react-icons';
import { StarField } from '../components/StarField';
import { Image } from 'astro:assets';
import ginniImage from '../assets/ginni.png';
import andriiImage from '../assets/andrii.jpg';
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
---

<Layout title="Corso MarTech Open Source: Data Engineering & Analytics per il Marketing" description="GinnyTech è una piattaforma di formazione gratuita per imparare a costruire infrastrutture dati reali. Tutorial pratici su SQL, Python, Kafka e Data Science.">
  <Navbar client:idle />

  <main id="main-content">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_NAME,
      "url": SITE_URL,
      "description": SITE_DESCRIPTION,
      "author": {
        "@type": "Person",
        "name": "Andrii Dyshkantiuk",
        "url": "https://ginnytech.it",
        "sameAs": [
          "https://www.linkedin.com/in/andrii-dyshkantiuk/",
          "https://github.com/AndreyBertasini"
        ]
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${SITE_URL}/?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })} />
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0 z-0">
        <Image
          src={ginniImage}
          alt="GinnyTech - piattaforma di formazione Data Analytics e Marketing Engineering"
          class="w-full h-full object-cover opacity-60"
          loading="eager"
          decoding="async"
          quality={80}
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 via-brand-dark/50 to-brand-dark"></div>
        {/* Star Field Overlay */}
        <StarField client:only="react" />
      </div>

      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none z-0 mix-blend-screen"></div>

      <div class="container mx-auto px-6 relative z-50 text-center flex flex-col items-center">
        {/* Glass Lights */}
        <div class="absolute top-20 left-[15%] w-24 h-24 bg-neon-blue/20 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(0,243,255,0.3)] animate-pulse pointer-events-none -z-10 mix-blend-screen"></div>
        <div class="absolute bottom-20 right-[15%] w-32 h-32 bg-acid-yellow/10 rounded-full blur-xl border border-white/10 backdrop-blur-sm shadow-[0_0_30px_rgba(204,255,0,0.2)] animate-pulse delay-700 pointer-events-none -z-10 mix-blend-screen"></div>

        <div class="inline-flex items-center justify-center gap-2 px-4 py-2 mx-auto rounded-full bg-brand-dark/80 border border-[#ccff00]/50 text-[#ccff00] text-sm font-bold mb-6 shadow-[0_0_20px_rgba(204,255,0,0.2)] backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ccff00] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#ccff00] shadow-[0_0_10px_rgba(204,255,0,1)]"></span>
          </span>
          Corso gratuito · Nessun paywall ❤️
        </div>

        <h1 class="text-5xl md:text-7xl font-bold text-white text-center tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-heading drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
          Il <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-lime-400 to-yellow-400 text-glow">MarTech</span><br/>
          che usi davvero.
        </h1>

        <p class="text-xl text-slate-200 text-center max-w-2xl mx-auto mb-8 leading-relaxed font-sans font-medium drop-shadow-md">
          Marketing e Data Engineering insieme, finalmente.<br class="hidden sm:block"/>
          Lezioni dai problemi reali che affronto ogni giorno — non da libri.
        </p>

        <div class="flex flex-col items-center justify-center gap-4 relative z-50">
          <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-[#ccff00] hover:bg-[#b3e600] text-black font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-ui text-lg">
            Inizia a studiare ora
            <ArrowRightIcon className="w-5 h-5" />
          </a>
          <p class="text-sm text-slate-300 font-medium">12 Moduli · 90+ Lezioni · 100% Gratis</p>
        </div>
      </div>
    </section>

    {/* Social Proof / Numbers Strip */}
    <section class="relative z-20 mt-10">
      <div class="container mx-auto px-6">
        <div class="glass-panel border border-white/10 p-8 md:p-10">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-acid-yellow font-heading mb-1">12</div>
              <div class="text-sm text-slate-400 font-medium">Moduli completi</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-blue font-heading mb-1">90+</div>
              <div class="text-sm text-slate-400 font-medium">Lezioni pratiche</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-pink font-heading mb-1">€0</div>
              <div class="text-sm text-slate-400 font-medium">Nessun paywall</div>
            </div>
            <div class="text-center">
              <div class="text-3xl md:text-4xl font-bold text-neon-green font-heading mb-1">15+</div>
              <div class="text-sm text-slate-400 font-medium">Anni sul campo</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ===== IL PROBLEMA ===== */}
    <section class="py-24 bg-brand-dark relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>

      <div class="container mx-auto px-6 relative z-10">

        {/* Section header — left-aligned, editorial */}
        <div class="max-w-4xl mx-auto mb-16">
          <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-red-500/70 mb-5 font-ui">Il problema</p>
          <h2 class="text-4xl md:text-[3.5rem] font-bold text-white font-heading leading-[1.08] mb-6">
            Non ti mancano<br/>gli strumenti.<br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-orange-400 to-amber-400">Ti manca il filo.</span>
          </h2>
          <p class="text-lg text-slate-500 max-w-2xl leading-relaxed">
            Il mercato vuole persone che abitino i dati <em class="text-slate-300 not-italic font-medium">e</em> capiscano il business. La formazione italiana vende strumenti separati — mai la connessione tra loro.
          </p>
        </div>

        {/* Problems — editorial numbered list */}
        <div class="max-w-4xl mx-auto divide-y divide-white/[0.05]">

          {/* Problem 01 */}
          <div class="py-12 md:py-14 grid md:grid-cols-[88px_1fr] gap-4 md:gap-10 group cursor-default">
            <div class="flex md:justify-end pt-1">
              <span class="text-6xl md:text-7xl font-black text-red-500/12 font-heading leading-none group-hover:text-red-500/30 transition-colors duration-700 tabular-nums select-none">01</span>
            </div>
            <div>
              <div class="flex items-center gap-3 mb-5">
                <div class="w-7 h-7 rounded-lg bg-red-500/10 border border-red-500/20 flex items-center justify-center shrink-0">
                  <BackpackIcon className="w-3.5 h-3.5 text-red-400" />
                </div>
                <span class="text-[11px] font-bold uppercase tracking-widest text-red-400/70 font-ui">Tracciamento & Debug</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white font-heading mb-4 leading-snug group-hover:text-red-50 transition-colors duration-300">
                Il tracciamento si rompe alle 23:00 di venerdì.
              </h3>
              <p class="text-slate-400 text-[15px] md:text-base leading-relaxed mb-3">
                Le conversioni calano a zero. Non è la campagna — è un evento rotto nel layer di dati. Il pixel che fa un loop. Un parametro UTM che sovrascrive la sessione. Cose che succedono ogni settimana in produzione.
              </p>
              <p class="text-slate-600 text-sm leading-relaxed">
                I corsi insegnano a <span class="text-slate-400">usare GA4</span>. Nessuno ti insegna a capire <span class="text-slate-400">perché GA4 sta mentendo</span> — e dove trovare il dato vero.
              </p>
            </div>
          </div>

          {/* Problem 02 */}
          <div class="py-12 md:py-14 grid md:grid-cols-[88px_1fr] gap-4 md:gap-10 group cursor-default">
            <div class="flex md:justify-end pt-1">
              <span class="text-6xl md:text-7xl font-black text-orange-500/12 font-heading leading-none group-hover:text-orange-500/30 transition-colors duration-700 tabular-nums select-none">02</span>
            </div>
            <div>
              <div class="flex items-center gap-3 mb-5">
                <div class="w-7 h-7 rounded-lg bg-orange-500/10 border border-orange-500/20 flex items-center justify-center shrink-0">
                  <Component1Icon className="w-3.5 h-3.5 text-orange-400" />
                </div>
                <span class="text-[11px] font-bold uppercase tracking-widest text-orange-400/70 font-ui">Autonomia & SQL</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white font-heading mb-4 leading-snug group-hover:text-orange-50 transition-colors duration-300">
                "Chiedo al dev" non è una strategia. È una bottleneck.
              </h3>
              <p class="text-slate-400 text-[15px] md:text-base leading-relaxed mb-3">
                Aspetti 3 giorni una query che potresti scrivere in 20 minuti. O la scrivi sbagliata — ottimizzi sulla metrica errata e non lo scopri mai. O peggio: il dev scrive quello che capisce lui, non quello che ti serve a te.
              </p>
              <p class="text-slate-600 text-sm leading-relaxed">
                I dati che ti servono esistono già nel tuo warehouse. Il problema è che <span class="text-slate-400">non sai dove guardare</span> e non hai il linguaggio per chiederli.
              </p>
            </div>
          </div>

          {/* Problem 03 */}
          <div class="py-12 md:py-14 grid md:grid-cols-[88px_1fr] gap-4 md:gap-10 group cursor-default">
            <div class="flex md:justify-end pt-1">
              <span class="text-6xl md:text-7xl font-black text-amber-500/12 font-heading leading-none group-hover:text-amber-500/30 transition-colors duration-700 tabular-nums select-none">03</span>
            </div>
            <div>
              <div class="flex items-center gap-3 mb-5">
                <div class="w-7 h-7 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shrink-0">
                  <PieChartIcon className="w-3.5 h-3.5 text-amber-400" />
                </div>
                <span class="text-[11px] font-bold uppercase tracking-widest text-amber-400/70 font-ui">Formazione & Stack</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white font-heading mb-4 leading-snug group-hover:text-amber-50 transition-colors duration-300">
                €8.000 per un corso su uno stack del 2020.
              </h3>
              <p class="text-slate-400 text-[15px] md:text-base leading-relaxed mb-3">
                I master universitari insegnano Universal Analytics e Excel avanzato. I bootcamp vendono certificazioni Google che le aziende non cercano più. Nel frattempo, ogni job description cita Kafka, dbt e ClickHouse.
              </p>
              <p class="text-slate-600 text-sm leading-relaxed">
                Hai speso soldi per formazione. Ma <span class="text-slate-400">il gap con il mercato si allarga ogni anno</span> — non perché studi poco, ma perché studi le cose sbagliate.
              </p>
            </div>
          </div>

        </div>

        {/* Bridge statement */}
        <div class="max-w-4xl mx-auto mt-4 pt-12 border-t border-white/[0.05]">
          <div class="md:grid md:grid-cols-[88px_1fr]">
            <div></div>
            <div class="flex items-start gap-4">
              <div class="w-[3px] h-14 bg-gradient-to-b from-acid-yellow to-acid-yellow/0 rounded-full shrink-0 mt-1"></div>
              <div>
                <p class="text-xl md:text-2xl font-bold text-white font-heading leading-snug mb-2">
                  La risposta non è un corso in più.
                </p>
                <p class="text-slate-500 text-base leading-relaxed">
                  È imparare a pensare come un ingegnere del dato <em class="text-slate-300 not-italic font-medium">e</em> misurare come un marketer — nello stesso workflow, sugli stessi strumenti che trovi in produzione.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    {/* ===== IL PERCORSO ===== */}
    <section class="py-24 bg-brand-darker relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(204,255,0,0.03)_0%,transparent_60%)]"></div>
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto">

          {/* Header */}
          <div class="mb-16">
            <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-acid-yellow/60 mb-5 font-ui">Il Percorso</p>
            <h2 class="text-4xl md:text-[3.5rem] font-bold text-white font-heading leading-[1.08] mb-6">
              12 moduli.<br/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-acid-yellow to-lime-400">Un percorso, non una lista.</span>
            </h2>
            <p class="text-lg text-slate-500 max-w-xl leading-relaxed">
              Ogni modulo costruisce sul precedente. Dall'evento grezzo alla decisione di business — senza salti logici, senza teoria senza contesto.
            </p>
          </div>

          {/* Module grid by phase */}
          <div class="space-y-10">

            {/* Phase 1 */}
            <div>
              <div class="flex items-center gap-4 mb-4">
                <span class="text-[10px] font-bold uppercase tracking-[0.25em] text-slate-600 font-ui whitespace-nowrap">Fase 1 — Fondamenta</span>
                <div class="flex-1 h-px bg-white/[0.05]"></div>
              </div>
              <div class="grid md:grid-cols-2 gap-3">
                <a href="/course" class="group glass-panel p-6 border border-white/5 hover:border-cyan-500/25 transition-all duration-300 flex gap-5 items-start">
                  <span class="text-3xl font-black text-cyan-400/15 font-heading leading-none shrink-0 tabular-nums group-hover:text-cyan-400/40 transition-colors duration-300 mt-0.5">01</span>
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <StackIcon className="w-3.5 h-3.5 text-cyan-400" />
                      <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider font-ui">Metriche & Fondamenti</span>
                    </div>
                    <p class="text-sm font-bold text-white mb-1.5 font-heading leading-snug group-hover:text-cyan-50 transition-colors duration-300">Come si misura davvero</p>
                    <p class="text-[13px] text-slate-500 leading-relaxed">KPI che contano, statistica applicata, north star vs vanity metric.</p>
                  </div>
                </a>
                <a href="/course" class="group glass-panel p-6 border border-white/5 hover:border-cyan-500/25 transition-all duration-300 flex gap-5 items-start">
                  <span class="text-3xl font-black text-cyan-400/15 font-heading leading-none shrink-0 tabular-nums group-hover:text-cyan-400/40 transition-colors duration-300 mt-0.5">02</span>
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <ActivityLogIcon className="w-3.5 h-3.5 text-cyan-400" />
                      <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider font-ui">Raccolta Dati</span>
                    </div>
                    <p class="text-sm font-bold text-white mb-1.5 font-heading leading-snug group-hover:text-cyan-50 transition-colors duration-300">Dall'evento al warehouse</p>
                    <p class="text-[13px] text-slate-500 leading-relaxed">GTM, server-side tracking, event schema, GDPR e privacy by design.</p>
                  </div>
                </a>
              </div>
            </div>

            {/* Phase 2 */}
            <div>
              <div class="flex items-center gap-4 mb-4">
                <span class="text-[10px] font-bold uppercase tracking-[0.25em] text-slate-600 font-ui whitespace-nowrap">Fase 2 — Dato grezzo → Dato utile</span>
                <div class="flex-1 h-px bg-white/[0.05]"></div>
              </div>
              <div class="grid md:grid-cols-2 gap-3">
                <a href="/course" class="group glass-panel p-6 border border-white/5 hover:border-emerald-500/25 transition-all duration-300 flex gap-5 items-start">
                  <span class="text-3xl font-black text-emerald-400/15 font-heading leading-none shrink-0 tabular-nums group-hover:text-emerald-400/40 transition-colors duration-300 mt-0.5">03</span>
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <CodeIcon className="w-3.5 h-3.5 text-emerald-400" />
                      <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider font-ui">SQL & Analisi</span>
                    </div>
                    <p class="text-sm font-bold text-white mb-1.5 font-heading leading-snug group-hover:text-emerald-50 transition-colors duration-300">Le query che usano i data team</p>
                    <p class="text-[13px] text-slate-500 leading-relaxed">Window functions, CTEs, cohort SQL — su dati reali, non inventati.</p>
                  </div>
                </a>
                <a href="/course" class="group glass-panel p-6 border border-white/5 hover:border-emerald-500/25 transition-all duration-300 flex gap-5 items-start">
                  <span class="text-3xl font-black text-emerald-400/15 font-heading leading-none shrink-0 tabular-nums group-hover:text-emerald-400/40 transition-colors duration-300 mt-0.5">04</span>
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <MixIcon className="w-3.5 h-3.5 text-emerald-400" />
                      <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider font-ui">Python & Pipeline</span>
                    </div>
                    <p class="text-sm font-bold text-white mb-1.5 font-heading leading-snug group-hover:text-emerald-50 transition-colors duration-300">ETL, dbt e automazione</p>
                    <p class="text-[13px] text-slate-500 leading-relaxed">Pandas, dbt models, pipeline schedulabili — da CSV ad analisi riproducibile.</p>
                  </div>
                </a>
              </div>
            </div>

            {/* Phase 3 */}
            <div>
              <div class="flex items-center gap-4 mb-4">
                <span class="text-[10px] font-bold uppercase tracking-[0.25em] text-slate-600 font-ui whitespace-nowrap">Fase 3 — Analisi che decide</span>
                <div class="flex-1 h-px bg-white/[0.05]"></div>
              </div>
              <div class="grid md:grid-cols-2 gap-3">
                <a href="/course" class="group glass-panel p-6 border border-white/5 hover:border-orange-500/25 transition-all duration-300 flex gap-5 items-start">
                  <span class="text-3xl font-black text-orange-400/15 font-heading leading-none shrink-0 tabular-nums group-hover:text-orange-400/40 transition-colors duration-300 mt-0.5">05</span>
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <BarChartIcon className="w-3.5 h-3.5 text-orange-400" />
                      <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider font-ui">Product Analytics</span>
                    </div>
                    <p class="text-sm font-bold text-white mb-1.5 font-heading leading-snug group-hover:text-orange-50 transition-colors duration-300">A/B test, cohort, retention</p>
                    <p class="text-[13px] text-slate-500 leading-relaxed">Significatività statistica applicata — analisi che convinci il board.</p>
                  </div>
                </a>
                <a href="/course" class="group glass-panel p-6 border border-white/5 hover:border-orange-500/25 transition-all duration-300 flex gap-5 items-start">
                  <span class="text-3xl font-black text-orange-400/15 font-heading leading-none shrink-0 tabular-nums group-hover:text-orange-400/40 transition-colors duration-300 mt-0.5">06</span>
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <LightningBoltIcon className="w-3.5 h-3.5 text-orange-400" />
                      <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider font-ui">Marketing Analytics</span>
                    </div>
                    <p class="text-sm font-bold text-white mb-1.5 font-heading leading-snug group-hover:text-orange-50 transition-colors duration-300">Attribuzione, LTV, unit economics</p>
                    <p class="text-[13px] text-slate-500 leading-relaxed">MMM, data-driven attribution, CAC payback — sui tuoi dati, non demo.</p>
                  </div>
                </a>
              </div>
            </div>

            {/* Phase 4 */}
            <div>
              <div class="flex items-center gap-4 mb-4">
                <span class="text-[10px] font-bold uppercase tracking-[0.25em] text-slate-600 font-ui whitespace-nowrap">Fase 4 — Visualizzare e predire</span>
                <div class="flex-1 h-px bg-white/[0.05]"></div>
              </div>
              <div class="grid md:grid-cols-2 gap-3">
                <a href="/course" class="group glass-panel p-6 border border-white/5 hover:border-purple-500/25 transition-all duration-300 flex gap-5 items-start">
                  <span class="text-3xl font-black text-purple-400/15 font-heading leading-none shrink-0 tabular-nums group-hover:text-purple-400/40 transition-colors duration-300 mt-0.5">07</span>
                  <div>
                    <div class="flex items-center gap-2 mb-2">
                      <DashboardIcon className="w-3.5 h-3.5 text-purple-400" />
                      <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider font-ui">Dashboard & Viz</span>
                    </div>
                    <p class="text-sm font-bold text-white mb-1.5 font-heading leading-snug group-hover:text-purple-50 transition-colors duration-300">Dashboard che il business usa davvero</p>
                    <p class="text-[13px] text-slate-500 leading-relaxed">Metabase, Grafana, design del dato — report che non finiscono nel cestino.</p>
                  </div>
                </a>
                <a href="/course" class="group glass-panel p-6 border border-white/5 hover:border-purple-500/25 transition-all duration-300 flex gap-5 items-start">
                  <span class="text-3xl font-black text-purple-400/15 font-heading leading-none shrink-0 tabular-nums group-hover:text-purple-400/40 transition-colors duration-300 mt-0.5">08</span>
                  <div>
                    <div class="flex items-center gap-2 mb-2">
