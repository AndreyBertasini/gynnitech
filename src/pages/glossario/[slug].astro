---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { COURSE_MODULES } from '../../data/course-modules';
import { glossaryTerms, contextModuleIds, termPath, termTitle, termUrl } from '../../lib/glossary';
import { getGlossaryLessonIndex } from '../../lib/glossary-links';
import { breadcrumbListNode } from '../../lib/entity';
import { serializeJsonLd } from '../../utils/jsonld';
import { SITE_URL } from '../../consts';

export function getStaticPaths() {
  return glossaryTerms.map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

const { term } = Astro.props;
const { body } = term;
const bySlug = new Map(glossaryTerms.map((t) => [t.slug, t]));
const related = body.related.map((slug) => bySlug.get(slug)).filter((t) => t !== undefined);

// Lezioni: calcolate dal contenuto + eventuali id espliciti; in più i moduli citati nel contesto.
const lessonCollection = await getCollection('corso');
const lessonById = new Map(lessonCollection.map((l) => [l.id.replace(/\.[^/.]+$/, ''), l]));
const computed = (await getGlossaryLessonIndex()).lessonsForPost(term.slug, 3, 22);
const explicit = (body.lessons ?? [])
  .map((id) => lessonById.get(id))
  .filter((l) => l !== undefined)
  .map((l) => ({ href: `/course/${l.id.replace(/\.[^/.]+$/, '')}/`, title: l.data.title }));
const lessons = [...explicit, ...computed.filter((c) => !explicit.some((e) => e.href === c.href))].slice(0, 4);
const modules = contextModuleIds(term.context, COURSE_MODULES.map((m) => m.id)).map((id) => COURSE_MODULES.find((m) => m.id === id)!);

const url = termUrl(term.slug);
const jsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DefinedTerm',
      '@id': `${url}#term`,
      name: term.short,
      alternateName: term.name !== term.short ? term.name : undefined,
      description: term.definition,
      url,
      inLanguage: 'it-IT',
      inDefinedTermSet: { '@type': 'DefinedTermSet', '@id': `${SITE_URL}/glossario/#glossario`, name: 'Glossario GinnyTech', url: `${SITE_URL}/glossario/` },
    },
    breadcrumbListNode([
      { name: 'Home', url: '/' },
      { name: 'Glossario', url: '/glossario/' },
      { name: term.short, url },
    ]),
  ],
});
const description = term.definition.length <= 155 ? term.definition : `${term.definition.slice(0, 152).replace(/\s+\S*$/, '')}…`;
---

<PageLayout title={termTitle(term)} description={description}>
  <script type="application/ld+json" set:html={jsonLd} is:inline />
  <nav aria-label="Percorso" class="glossary-crumbs"><a href="/">Home</a> / <a href="/glossario/">Glossario</a> / <span>{term.short}</span></nav>
  <h1>{term.name}</h1>
  <p class="glossary-def"><strong>Definizione.</strong> {term.definition}</p>

  <h2>Perché conta</h2>
  <p>{body.why}</p>

  <h2>Come si usa</h2>
  <p>{body.how}</p>

  {body.formula && (<><h2>Formula</h2><p><code>{body.formula}</code></p></>)}

  <h2>Esempio</h2>
  <p>{body.example}</p>
  <p class="glossary-note">Esempio illustrativo: i numeri sono di fantasia e servono a mostrare il calcolo, non sono dati reali.</p>

  {body.sql && (<><h2>{body.codeLabel ?? 'Esempio in SQL (ClickHouse)'}</h2><pre><code>{body.sql}</code></pre></>)}

  <h2>Errori tipici</h2>
  <p>{body.pitfalls}</p>

  <h2>Dove lo usiamo nel corso</h2>
  {lessons.length > 0 && (
    <ul>
      {lessons.map((l) => (<li><a href={l.href}>{l.title}</a></li>))}
    </ul>
  )}
  {modules.length > 0 && (
    <p>Moduli: {modules.map((m, i) => (<><a href={`/course/${m.id}/`}>{m.title}</a>{i < modules.length - 1 ? ' · ' : ''}</>))}</p>
  )}

  {related.length > 0 && (
    <>
      <h2>Termini correlati</h2>
      <ul>
        {related.map((r) => (<li><a href={termPath(r.slug)}>{r.short}</a></li>))}
      </ul>
    </>
  )}
  <p class="glossary-back"><a href="/glossario/">← Tutti i termini del glossario</a></p>
</PageLayout>

<style>
  .glossary-crumbs { font-size: 0.8rem; color: #94a3b8; margin-bottom: 1rem; }
  .glossary-def { font-size: 1.1rem; }
  .glossary-note { font-size: 0.8rem; color: #94a3b8; font-style: italic; }
  pre { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 1rem; overflow-x: auto; font-size: 0.85rem; line-height: 1.6; color: #e2e8f0; }
  pre code { background: none; border: none; padding: 0; color: inherit; }
  .glossary-back { margin-top: 2.5rem; }
</style>
