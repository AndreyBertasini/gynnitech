---
import PageLayout from '../../layouts/PageLayout.astro';
import { glossaryTerms, termPath, termUrl } from '../../lib/glossary';
import { breadcrumbListNode } from '../../lib/entity';
import { serializeJsonLd } from '../../utils/jsonld';
import { SITE_URL } from '../../consts';

const title = 'Glossario dati, marketing e analytics | GinnyTech';
const description = `${glossaryTerms.length} termini di analytics, data engineering e marketing spiegati con esempi, formule e SQL: KPI, retention, ClickHouse, Kafka.`;

// Raggruppo per iniziale (A–Z) ignorando maiuscole e accenti.
const letter = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').charAt(0).toUpperCase();
const groups = new Map<string, typeof glossaryTerms>();
for (const t of glossaryTerms) groups.set(letter(t.short), [...(groups.get(letter(t.short)) ?? []), t]);
const letters = [...groups.keys()].sort();

const jsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DefinedTermSet',
      '@id': `${SITE_URL}/glossario/#glossario`,
      name: 'Glossario GinnyTech',
      description,
      url: `${SITE_URL}/glossario/`,
      inLanguage: 'it-IT',
      isPartOf: { '@type': 'WebSite', name: 'GinnyTech', url: `${SITE_URL}/` },
      hasDefinedTerm: glossaryTerms.map((t) => ({
        '@type': 'DefinedTerm',
        '@id': `${termUrl(t.slug)}#term`,
        name: t.short,
        description: t.definition,
        url: termUrl(t.slug),
      })),
    },
    breadcrumbListNode([
      { name: 'Home', url: '/' },
      { name: 'Glossario', url: '/glossario/' },
    ]),
  ],
});
---

<PageLayout title={title} description={description}>
  <script type="application/ld+json" set:html={jsonLd} is:inline />
  <h1>Glossario dati, marketing e analytics</h1>
  <p>
    Ogni termine ha la sua pagina: definizione, perché conta, come si calcola o si applica, un esempio con numeri,
    gli errori tipici e le lezioni del corso che lo usano. Parti da qui quando incontri una sigla, una metrica o un concetto tecnico.
  </p>
  <p>Per un ordine di studio, guarda il <a href="/course/learning-path/">learning path</a> o l'<a href="/course/">elenco dei moduli</a>.</p>

  <nav aria-label="Indice alfabetico" class="glossary-letters">
    {letters.map((l) => (<a href={`#lettera-${l.toLowerCase()}`}>{l}</a>))}
  </nav>

  {letters.map((l) => (
    <section>
      <h2 id={`lettera-${l.toLowerCase()}`}>{l}</h2>
      <ul class="glossary-list">
        {groups.get(l)!.map((t) => (
          <li><a href={termPath(t.slug)}><strong>{t.short}</strong></a>: {t.definition}</li>
        ))}
      </ul>
    </section>
  ))}
</PageLayout>

<style>
  .glossary-letters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0 2rem; }
  .glossary-letters a { padding: 0.25rem 0.6rem; border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; text-decoration: none; }
  .glossary-list { list-style: none; padding-left: 0; }
  .glossary-list li { margin-bottom: 0.9rem; }
</style>
