---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/Navbar';
import Footer from '../../../components/Footer.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { serializeJsonLd } from '../../../utils/jsonld';
import { SITE_URL } from '../../../consts';
import { organizationRef, personRef } from '../../../lib/entity';
import { getArticleCoverAlt, getArticleCoverPath } from '../../../lib/article-covers';

const posts = (await getCollection('blogEn')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function calcReadingTime(body: string): number {
  const words = body.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 180));
}

function getSlug(id: string) {
  return id.replace(/\.[^/.]+$/, "");
}

const blogListingJsonLd = serializeJsonLd({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Articles on data, marketing, and AI | GinnyTech",
      "description": "Practical notes on tracking, dashboards, data engineering, experiments, and AI applied to marketing.",
      "url": `${SITE_URL}/en/blog`,
      "author": personRef(),
      "publisher": organizationRef(),
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": posts.map((post, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": `${SITE_URL}/en/blog/${getSlug(post.id)}`,
          "name": post.data.title,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/en/` },
        { "@type": "ListItem", "position": 2, "name": "Articles", "item": `${SITE_URL}/en/blog` },
      ],
    },
  ],
});
---

<Layout title="Articles on data, marketing, and AI | GinnyTech" description="Practical notes on tracking, dashboards, data engineering, experiments, and AI applied to marketing." lang="en">
  <script type="application/ld+json" set:html={blogListingJsonLd} is:inline />
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle lang="en" />

    <main id="main-content" class="relative flex-1 bg-[var(--sl-color-bg)] overflow-hidden" data-pagefind-body>
      <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-accent/10 to-transparent pointer-events-none"></div>

      <div class="container mx-auto px-6 pt-32 pb-24 relative z-10">
        <div class="max-w-3xl mx-auto text-center mb-20">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-accent text-xs font-ui font-medium tracking-wider mb-8 backdrop-blur-sm animate-fade-in-up">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            INSIGHTS & UPDATES
          </div>

          <h1 class="text-4xl font-bold text-white mb-8 font-heading drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
            Latest <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent via-white to-accent drop-shadow-[0_0_10px_rgba(204,255,0,0.8)] brightness-125">
              GinnyTech articles
            </span>
          </h1>

          <p class="text-lg text-slate-400 leading-relaxed font-sans">
            Practical guides on tracking, dashboards, experiments, data engineering, and AI applied to marketing.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch auto-rows-fr">
          {posts.map(post => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              category={post.data.category}
              date={post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              isoDate={post.data.date.toISOString()}
              slug={getSlug(post.id)}
              imageSrc={getArticleCoverPath(getSlug(post.id), post.data.image)}
              imageAlt={getArticleCoverAlt(post.data.title)}
              readingTime={calcReadingTime(post.body || '')}
              basePath="/en/blog"
              readLabel="Read article"
            />
          ))}
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
