---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { Home, Search } from 'lucide-react';
---

<Layout
  title="404 - Pagina Non Trovata | GinnyTech"
  description="Ops! La pagina che stai cercando non esiste. Torna alla home o esplora il corso."
  noindex={true}
>
  <Navbar client:idle />
  
  <main id="main-content" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-brand-dark">
    {/* Background Elements */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-accent/10 blur-[150px] rounded-full opacity-30 pointer-events-none z-0"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-acid-yellow/5 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10 text-center">
      
      {/* 404 Glitch Effect */}
      <h1 class="text-9xl md:text-[12rem] font-bold text-transparent bg-clip-text bg-gradient-to-r from-accent via-white to-acid-yellow font-heading mb-4 tracking-tighter drop-shadow-[0_0_30px_rgba(255,255,255,0.2)] animate-pulse">
        404
      </h1>
      
      <h2 class="text-2xl md:text-4xl font-bold text-white mb-8 font-heading">
        Pagina Non Trovata
      </h2>
      
      <p class="text-slate-400 text-lg max-w-2xl mx-auto mb-12 font-sans leading-relaxed">
        Sembra che tu abbia seguito un link rotto o digitato un URL errato. 
        Non preoccuparti, anche i migliori dati a volte si perdono.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="px-8 py-3 bg-white text-brand-dark font-bold rounded-full transition-all hover:bg-acid-yellow hover:scale-105 flex items-center gap-2 shadow-[0_0_20px_rgba(255,255,255,0.2)]">
          <Home className="w-5 h-5" />
          Torna alla Home
        </a>
        
        <a href="/#corsi" class="px-8 py-3 bg-white/10 text-white font-semibold rounded-full border border-white/20 transition-all hover:border-acid-yellow/50 hover:bg-white/20 flex items-center gap-2 backdrop-blur-md">
          <Search className="w-5 h-5" />
          Vai al Corso
        </a>
      </div>
      
    </div>
  </main>
  
  <Footer />
</Layout>
