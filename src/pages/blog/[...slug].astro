---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { organizationRef, personRef } from '../../lib/entity';
import { SITE_URL } from '../../consts';
import { serializeJsonLd } from '../../utils/jsonld';
import { extractCitations } from '../../utils/citations';
import { getArticleCoverAlt, getArticleCoverPath } from '../../lib/article-covers';
import { RelatedArticles } from '../../components/RelatedArticles';
import { SocialShare } from '../../components/SocialShare';
import { blogAlternates } from '../../lib/i18n-pages';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.[^/.]+$/, "") },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const postSlug = post.id.replace(/\.[^/.]+$/, '');
const alternates = await blogAlternates(postSlug);

const formattedDate = post.data.date.toLocaleDateString('it-IT', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postUrl = new URL(Astro.url.pathname, Astro.site || SITE_URL).href;
const postImagePath = getArticleCoverPath(postSlug, post.data.image);
const postImage = new URL(postImagePath, Astro.site || SITE_URL).href;

const citations = extractCitations(post.body ?? '', new URL(SITE_URL).hostname);

const jsonLd = serializeJsonLd({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": post.data.title,
      "description": post.data.description,
      "datePublished": post.data.date.toISOString(),
      "dateModified": (post.data.dateModified ?? post.data.date).toISOString(),
      "url": postUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl },
      "image": { "@type": "ImageObject", "url": postImage },
      "inLanguage": "it-IT",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["article"],
      },
      ...(citations.length > 0 ? {
        "citation": citations.map((url) => ({ "@type": "CreativeWork", "url": url })),
      } : {}),
      "author": personRef(),
      "publisher": organizationRef(),
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
        { "@type": "ListItem", "position": 2, "name": "Articoli", "item": `${SITE_URL}/blog` },
        { "@type": "ListItem", "position": 3, "name": post.data.title, "item": postUrl },
      ],
    },
    ...(post.data.faqSchema && post.data.faqSchema.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": post.data.faqSchema.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer,
        },
      })),
    }] : []),
  ],
});---

<Layout title={`${post.data.title} | Articoli GinnyTech`} description={post.data.description} type="article" image={postImagePath} preloadImage markdownAlternate={`/blog/${postSlug}.md`} alternates={alternates}>
  <Navbar client:idle />

  <main id="main-content" class="min-h-screen pt-32 pb-24 bg-[var(--sl-color-bg)]" data-pagefind-body>
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={jsonLd} is:inline />
    
    {/* Hero Section */}
    <div class="container mx-auto px-6 mb-16">
      <div class="max-w-4xl mx-auto text-center">
        <div class="mb-8 overflow-hidden rounded-[28px] border border-white/10 bg-[var(--color-brand-surface)] shadow-[0_20px_60px_rgba(0,0,0,0.35)]">
          <img
            src={postImagePath}
            alt={getArticleCoverAlt(post.data.title)}
            width="1200"
            height="630"
            class="h-auto w-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="flex items-center justify-center gap-2 text-sm text-slate-400 mb-6">
          <a href="/blog" class="hover:text-accent transition-colors">Articoli</a>
          <span>/</span>
          <span class="text-accent">{post.data.category}</span>
        </div>
        
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
          {post.data.title}
        </h1>
        
        <div class="flex items-center justify-center gap-4 text-slate-400">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center text-accent font-bold text-xs">
              AD
            </div>
            <a href="/about/" rel="author" class="hover:text-white transition-colors">
              {post.data.author}
            </a>
          </div>
          <span>/</span>
          <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        </div>
      </div>
    </div>

    {/* Content Section */}
    <article class="container mx-auto px-6">
      <div class="sl-markdown-content max-w-3xl mx-auto prose prose-invert prose-lg 
        prose-headings:text-white prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight
        prose-p:text-slate-200 prose-p:leading-relaxed prose-p:mb-6
        prose-li:text-slate-200 prose-li:marker:text-accent
        prose-a:text-accent hover:prose-a:text-accent prose-a:no-underline hover:prose-a:underline
        prose-strong:text-white prose-strong:font-bold
        prose-code:text-accent prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
        prose-pre:bg-[var(--color-brand-elevated)] prose-pre:border prose-pre:border-white/10 prose-pre:rounded-xl
        prose-blockquote:border-l-accent prose-blockquote:bg-white/5 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-blockquote:text-slate-300 prose-blockquote:not-italic">
        <Content />
      </div>
    </article>
    
    <SocialShare url={postUrl} title={post.data.title} client:only="react" />
    <RelatedArticles currentPost={post} allPosts={allPosts} />

    {/* Back to Articles */}
    <div class="container mx-auto px-6 mt-20">
      <div class="max-w-3xl mx-auto pt-8 border-t border-white/10 text-center">
        <a href="/blog" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors">
          Torna agli articoli
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
