---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { serializeJsonLd } from '../../utils/jsonld';
import { BOOKING_URL, SITE_URL, SITE_NAME } from '../../consts';
import { getArticleCoverAlt, getArticleCoverPath } from '../../lib/article-covers';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function calcReadingTime(body: string): number {
  const words = body.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 180));
}

function getSlug(id: string) {
  return id.replace(/\.[^/.]+$/, "");
}

const blogListingJsonLd = serializeJsonLd({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Articoli su dati, marketing e AI | GinnyTech",
      "description": "Guide pratiche su tracking, dashboard, data engineering, esperimenti e AI applicata al marketing.",
      "url": `${SITE_URL}/blog`,
      "author": {
        "@type": "Person",
        "@id": `${SITE_URL}/#andrii-dyshkantiuk`,
        "name": "Andrii Dyshkantiuk",
      },
      "publisher": {
        "@type": "Organization",
        "name": SITE_NAME,
        "url": SITE_URL,
      },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": posts.map((post, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": `${SITE_URL}/blog/${getSlug(post.id)}`,
          "name": post.data.title,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
        { "@type": "ListItem", "position": 2, "name": "Articoli", "item": `${SITE_URL}/blog` },
      ],
    },
  ],
});
---

<Layout title="Articoli su dati, marketing e AI | GinnyTech" description="Guide pratiche su tracking, dashboard, data engineering, esperimenti e AI applicata al marketing.">
  <script type="application/ld+json" set:html={blogListingJsonLd} is:inline />
  <div class="min-h-screen flex flex-col">
    <Navbar client:only="react" />

    <main id="main-content" class="relative flex-1 bg-[var(--sl-color-bg)] overflow-hidden">
    {/* Background Effects */}
    <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-accent/10 to-transparent pointer-events-none"></div>
    <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-accent/5 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[600px] h-[600px] bg-accent/5 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="container mx-auto px-6 pt-32 pb-24 relative z-10">
      <div class="max-w-3xl mx-auto text-center mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-accent text-xs font-ui font-medium tracking-wider mb-8 backdrop-blur-sm animate-fade-in-up">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          INSIGHTS & UPDATES
        </div>

        <h1 class="text-5xl md:text-6xl font-bold text-white mb-8 font-heading drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
          Gli ultimi <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent via-white to-accent drop-shadow-[0_0_10px_rgba(204,255,0,0.8)] brightness-125">
            Articoli GinnyTech
          </span>
        </h1>
        
        <p class="text-xl text-slate-400 leading-relaxed font-sans">
          Guide pratiche per capire tracking, dashboard, esperimenti, data engineering e AI applicata al marketing.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch auto-rows-fr">
        {posts.map(post => (
          <BlogCard 
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            date={post.data.date.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })}
            isoDate={post.data.date.toISOString()}
            slug={getSlug(post.id)}
            imageSrc={getArticleCoverPath(getSlug(post.id), post.data.image)}
            imageAlt={getArticleCoverAlt(post.data.title)}
            readingTime={calcReadingTime(post.body || '')}
          />
        ))}
      </div>
      <section class="mt-16 max-w-4xl mx-auto">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 text-center backdrop-blur-sm">
          <h2 class="text-2xl md:text-3xl font-bold text-white font-heading mb-3">Vuoi portare questi principi nel tuo progetto?</h2>
          <p class="text-slate-300 mb-6">Prenota una call breve: guardiamo tracking, dati e dashboard e troviamo il primo intervento utile.</p>
          <a href={BOOKING_URL} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[var(--color-accent)] text-black font-semibold hover:brightness-110 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]">
            Prenota una call di 15 minuti
          </a>
        </div>
      </section>
    </div>
    </main>

    <Footer />
  </div>
</Layout>
