---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function getSlug(id: string) {
  return id.replace(/\.[^/.]+$/, "");
}
---

<Layout title="Blog - GynniTech">
  <Navbar client:load />
  
  <main class="pt-32 pb-24 min-h-screen">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Latest from GynniTech</h1>
        <p class="text-xl text-slate-400">
          Product updates, best practices, and insights from the team.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch auto-rows-fr">
        {posts.map(post => (
          <BlogCard 
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            date={post.data.date.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })}
            slug={getSlug(post.id)}
          />
        ))}
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
