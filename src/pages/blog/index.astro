---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getBlogPosts } from '../../lib/blog';

const posts = await getBlogPosts();
---

<Layout title="Blog - Mintlify">
  <Navbar client:load />
  
  <main class="pt-32 pb-24 min-h-screen">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Latest from Mintlify</h1>
        <p class="text-xl text-slate-400">
          Product updates, best practices, and insights from the team.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch auto-rows-fr">
        {posts.map(post => (
          <BlogCard 
            title={post.title}
            description={post.description}
            category={post.category}
            date={post.date}
            slug={post.slug}
          />
        ))}
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
