---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { serializeJsonLd } from '../../utils/jsonld';
import { BOOKING_URL, SITE_URL, SITE_NAME } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function getSlug(id: string) {
  return id.replace(/\.[^/.]+$/, "");
}

const blogListingJsonLd = serializeJsonLd({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Blog GinnyTech — Analytics, Marketing Science, Data Engineering",
      "description": "Articoli, guide operative e analisi tecniche su Data Analytics, Marketing Science e Data Engineering.",
      "url": `${SITE_URL}/blog`,
      "publisher": {
        "@type": "Organization",
        "name": SITE_NAME,
        "url": SITE_URL,
      },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": posts.map((post, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": `${SITE_URL}/blog/${getSlug(post.id)}`,
          "name": post.data.title,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${SITE_URL}/blog` },
      ],
    },
  ],
});
---

<Layout title="Blog - GinnyTech" description="Articoli, guide operative e analisi tecniche su Data Analytics, Marketing Science e Data Engineering dal team GinnyTech.">
  <script type="application/ld+json" set:html={blogListingJsonLd} is:inline />
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main id="main-content" class="relative flex-1 bg-[#050505] overflow-hidden">
    {/* Background Effects */}
    <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-mint-900/10 to-transparent pointer-events-none"></div>
    <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-neon-blue/5 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[600px] h-[600px] bg-neon-purple/5 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="container mx-auto px-6 pt-32 pb-24 relative z-10">
      <div class="max-w-3xl mx-auto text-center mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-neon-mint text-xs font-ui font-medium tracking-wider mb-8 backdrop-blur-sm animate-fade-in-up">
          <span class="w-2 h-2 rounded-full bg-neon-mint animate-pulse"></span>
          INSIGHTS & UPDATES
        </div>

        <h1 class="text-5xl md:text-6xl font-bold text-white mb-8 font-heading drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
          Ultimi articoli dal <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-blue via-white to-neon-purple drop-shadow-[0_0_10px_rgba(0,243,255,0.8)] brightness-125">
            Blog GinnyTech
          </span>
        </h1>
        
        <p class="text-xl text-slate-400 leading-relaxed font-sans">
          Analisi tecniche, guide operative e riflessioni sul mondo dei dati e del marketing.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch auto-rows-fr">
        {posts.map(post => (
          <BlogCard 
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            date={post.data.date.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })}
            isoDate={post.data.date.toISOString()}
            slug={getSlug(post.id)}
          />
        ))}
      </div>
      {/* Chi sono */}
      <section class="mt-16 max-w-4xl mx-auto">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 backdrop-blur-sm">
          <p class="text-xs font-bold tracking-widest text-[#ccff00] uppercase mb-5">Chi scrive</p>
          <div class="flex flex-col md:flex-row md:items-start gap-6">
            <div class="flex-1 space-y-4 text-slate-300 leading-relaxed text-sm">
              <p>
                Mi chiamo <strong class="text-white">Andrii Dyshkantiuk</strong>, sono un esperto di <strong class="text-white">MarTech in Italia</strong>
                con oltre 15 anni di esperienza in <strong class="text-white">marketing analytics</strong>, data engineering e soluzioni tecnologiche per il marketing.
              </p>
              <p>
                Scrivo su questo blog per condividere ciò che imparo sul campo: analisi pratiche,
                framework operativi e riflessioni su come <strong class="text-white">dati e tecnologia</strong> cambiano il modo di fare marketing.
                Niente teoria fine a sé stessa — solo contenuti che puoi applicare.
              </p>
              <div class="pt-2 flex flex-wrap gap-2">
                {['MarTech', 'Marketing Analytics', 'Data Engineering', 'Attribution Modeling', 'SQL', 'Python'].map(tag => (
                  <span class="px-3 py-1 rounded-full text-xs border border-white/10 bg-white/5 text-slate-400">{tag}</span>
                ))}
              </div>
            </div>
            <div class="md:flex-shrink-0 flex flex-col gap-3 md:w-44">
              <a href="/about" class="block w-full text-center px-4 py-2.5 rounded-full border border-[#ccff00]/50 text-[#ccff00] text-sm font-semibold hover:bg-[#ccff00]/10 transition">
                Chi sono
              </a>
              <a href="/course" class="block w-full text-center px-4 py-2.5 rounded-full bg-[#ccff00] text-black text-sm font-semibold hover:brightness-110 transition">
                Inizia il corso
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-8 max-w-4xl mx-auto">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 text-center backdrop-blur-sm">
          <h2 class="text-2xl md:text-3xl font-bold text-white font-heading mb-3">Vuoi applicare questi contenuti al tuo progetto?</h2>
          <p class="text-slate-300 mb-6">Prenota una call breve e ricevi indicazioni pratiche su tracking, analisi e dashboard.</p>
          <a href={BOOKING_URL} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#ccff00] text-black font-semibold hover:brightness-110 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00] focus-visible:ring-offset-2 focus-visible:ring-offset-[#050505]">
            Prenota una call di 15 minuti
          </a>
        </div>
      </section>
    </div>
    </main>

    <Footer />
  </div>
</Layout>
