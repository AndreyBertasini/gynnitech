---
import { getCollection } from 'astro:content';
import {
  ArrowRight,
  BookOpenCheck,
  CheckCircle2,
  Compass,
  Database,
  GitBranch,
  LineChart,
  Sparkles,
  Target,
  XCircle,
} from 'lucide-react';
import Footer from '../components/Footer.astro';
import { Navbar } from '../components/Navbar';
import { BOOKING_URL, SITE_NAME, SITE_URL } from '../consts';
import { COURSE_MODULES } from '../data/course-modules';
import Layout from '../layouts/Layout.astro';
import { serializeJsonLd } from '../utils/jsonld';

const courseDocs = await getCollection('corso');
const coreCourseDocs = courseDocs.filter((doc) => doc.id.includes('/') && typeof doc.data.order === 'number');
const totalModules = COURSE_MODULES.length;
const totalLessons = coreCourseDocs.length;

const pageTitle = 'Perché questo corso | GinnyTech';
const pageDescription =
  'Perché GinnyTech esiste: un percorso gratuito e pratico per imparare Data Analytics, Marketing Engineering e decisioni basate sui dati.';

const stats = [
  { value: totalModules, label: 'moduli', detail: 'dal metodo al capstone finale' },
  { value: totalLessons, label: 'lezioni core', detail: 'con ordine di studio chiaro' },
  { value: '0€', label: 'paywall', detail: 'formazione aperta, servizi separati' },
];

const pillars = [
  {
    icon: Database,
    label: 'Dati',
    title: 'Misura prima di decidere',
    copy: 'Tracking, KPI, qualità del dato e dashboard servono a capire cosa sta succedendo, non a decorare report.',
  },
  {
    icon: LineChart,
    label: 'Marketing',
    title: 'Collega numeri e crescita',
    copy: 'Funnel, campagne, retention, LTV e budget diventano leggibili quando le metriche sono costruite bene.',
  },
  {
    icon: GitBranch,
    label: 'Tecnologia',
    title: 'Costruisci sistemi affidabili',
    copy: 'Pipeline, warehouse, real-time analytics e AI agentica sono spiegati come parti di un sistema operativo per decidere.',
  },
];

const methodSteps = [
  {
    title: 'Parti dalla domanda',
    copy: 'Prima viene il problema di business: cosa vuoi capire, quale decisione dipende dalla risposta e chi la userà.',
  },
  {
    title: 'Disegna la misura',
    copy: 'Definisci eventi, KPI, denominatori, qualità del dato e controlli prima di fidarti di un grafico.',
  },
  {
    title: 'Costruisci il sistema',
    copy: 'Modelli, pipeline e dashboard devono rendere il dato riutilizzabile, verificabile e leggibile dal team.',
  },
  {
    title: 'Chiudi con una scelta',
    copy: 'L’output non è “un insight”: è una raccomandazione chiara, con limiti, trade-off e prossima azione.',
  },
];

const comparisonRows = [
  {
    weak: 'Un elenco di tool da imparare a memoria.',
    strong: 'Un metodo per passare da domanda, misura e modello a una decisione.',
  },
  {
    weak: 'Marketing separato da analytics e tecnologia.',
    strong: 'Un percorso unico dove campagna, tracking, pipeline e dashboard parlano tra loro.',
  },
  {
    weak: 'Teoria generica senza contesto operativo.',
    strong: 'Esempi e casi pensati per il lavoro reale: budget, funnel, qualità e responsabilità.',
  },
];

const audienceCards = [
  {
    title: 'Studenti e junior',
    need: 'Hai bisogno di basi pratiche, non solo definizioni.',
    result: 'Costruisci un percorso ordinato e materiali da portfolio.',
  },
  {
    title: 'Marketer',
    need: 'Vuoi leggere meglio campagne, funnel e conversioni.',
    result: 'Impari a usare metriche e dashboard per scegliere la prossima azione.',
  },
  {
    title: 'Analyst',
    need: 'Sai lavorare sui dati ma vuoi capire meglio il contesto business.',
    result: 'Colleghi analisi, stakeholder, decision memo e impatto economico.',
  },
  {
    title: 'Founder e team',
    need: 'Devi mettere ordine tra tracking, KPI e reporting.',
    result: 'Ottieni un linguaggio comune tra marketing, prodotto e tecnologia.',
  },
];

const pageJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE_URL}/perche-questo-corso/`,
  name: pageTitle,
  description: pageDescription,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
  },
  inLanguage: 'it',
});
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar client:only="react" />

  <main id="main-content" class="relative min-h-screen overflow-hidden bg-[var(--sl-color-bg)] text-slate-100 selection:bg-accent/30 selection:text-white" data-pagefind-body>
    <script type="application/ld+json" set:html={pageJsonLd} is:inline />
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[44rem] bg-[linear-gradient(180deg,rgba(204,255,0,0.16),rgba(204,255,0,0.04)_32%,rgba(8,9,13,0)_72%)]"></div>

    <div class="container relative z-10 mx-auto max-w-6xl px-6 pb-20 pt-28 md:pt-32">
      <article>
        <section class="grid gap-10 border-b border-white/10 pb-14 lg:grid-cols-[minmax(0,1.12fr)_minmax(320px,0.88fr)] lg:items-center">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-1.5 text-xs font-semibold uppercase text-accent">
              <Sparkles className="h-4 w-4" aria-hidden="true" />
              Perché esiste
            </div>

            <h1 class="mt-6 max-w-4xl text-balance font-heading text-3xl font-bold leading-tight text-white md:text-4xl">
              Un corso gratuito per imparare a trasformare dati, marketing e tecnologia in decisioni migliori.
            </h1>

            <p class="mt-6 max-w-3xl text-pretty text-lg leading-8 text-slate-300 md:text-xl">
              GinnyTech nasce per chi non vuole studiare strumenti isolati. Il punto è imparare come si collega una domanda
              di business a un sistema di misura, a un modello dati e a una scelta operativa.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href="/course/learning-path"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-accent px-6 text-sm font-bold text-black transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]"
              >
                Apri la learning path
                <ArrowRight className="h-4 w-4" aria-hidden="true" />
              </a>
              <a
                href="/course/"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-6 text-sm font-semibold text-white transition-colors hover:border-accent/40 hover:bg-white/[0.08] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]"
              >
                Esplora i moduli
                <ArrowRight className="h-4 w-4" aria-hidden="true" />
              </a>
            </div>

            <dl class="mt-10 grid gap-3 sm:grid-cols-3">
              {stats.map((stat) => (
                <div class="rounded-lg border border-white/10 bg-white/[0.035] p-4">
                  <dt class="text-sm font-semibold text-slate-400">{stat.label}</dt>
                  <dd class="mt-2 font-heading text-3xl font-bold text-white">{stat.value}</dd>
                  <p class="mt-2 text-sm leading-6 text-slate-500">{stat.detail}</p>
                </div>
              ))}
            </dl>
          </div>

          <aside class="rounded-lg border border-accent/20 bg-[#0b0d11]/80 p-6 shadow-2xl shadow-black/30" aria-label="Metodo GinnyTech in quattro passaggi">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase text-accent">Metodo</p>
                <h2 class="mt-3 font-heading text-2xl font-bold text-white">Dal rumore alla decisione</h2>
              </div>
              <Compass className="h-6 w-6 shrink-0 text-accent" aria-hidden="true" />
            </div>

            <ol class="mt-7 divide-y divide-white/10">
              {methodSteps.map((step, index) => (
                <li class="grid gap-4 py-5 first:pt-0 last:pb-0 sm:grid-cols-[3rem_minmax(0,1fr)]">
                  <span class="flex h-10 w-10 items-center justify-center rounded-full border border-accent/30 bg-accent/10 text-sm font-bold tabular-nums text-accent">
                    {index + 1}
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-heading text-base font-semibold text-white">{step.title}</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-400">{step.copy}</p>
                  </div>
                </li>
              ))}
            </ol>
          </aside>
        </section>

        <section class="py-14 md:py-16">
          <div class="max-w-3xl">
            <p class="text-xs font-semibold uppercase text-accent">La tesi</p>
            <h2 class="mt-3 text-balance font-heading text-3xl font-bold text-white md:text-3xl">
              Il mercato non premia chi conosce solo tool. Premia chi sa trasformare dati in scelte.
            </h2>
            <p class="mt-4 text-base leading-7 text-slate-400 md:text-lg">
              Per questo il corso tiene insieme analytics, marketing engineering e data engineering: nel lavoro reale una
              campagna genera dati, i dati entrano in una pipeline, una dashboard mostra un problema e qualcuno deve decidere.
            </p>
          </div>

          <div class="mt-8 grid gap-5 lg:grid-cols-3">
            {pillars.map(({ icon: Icon, ...pillar }) => (
              <article class="rounded-lg border border-white/10 bg-white/[0.03] p-6 transition-colors hover:border-accent/30 hover:bg-white/[0.05]">
                <div class="flex items-center gap-3 text-accent">
                  <Icon className="h-5 w-5" aria-hidden="true" />
                  <p class="text-xs font-semibold uppercase">{pillar.label}</p>
                </div>
                <h3 class="mt-5 font-heading text-xl font-bold text-white">{pillar.title}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-400">{pillar.copy}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="grid gap-8 border-t border-white/10 py-14 md:py-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
          <div>
            <p class="text-xs font-semibold uppercase text-accent">Posizionamento</p>
            <h2 class="mt-3 text-balance font-heading text-3xl font-bold text-white md:text-3xl">
              Non un corso generico. Un percorso per ragionare meglio sul lavoro.
            </h2>
            <p class="mt-4 text-base leading-7 text-slate-400">
              La differenza è nel filo logico: non parti dal software, parti dal problema. Gli strumenti entrano quando
              aiutano a misurare, verificare e comunicare una scelta.
            </p>
          </div>

          <div class="grid gap-4">
            {comparisonRows.map((row) => (
              <article class="grid gap-0 overflow-hidden rounded-lg border border-white/10 bg-white/[0.025] md:grid-cols-2">
                <div class="border-b border-white/10 p-5 md:border-b-0 md:border-r">
                  <div class="flex items-center gap-2 text-slate-500">
                    <XCircle className="h-4 w-4" aria-hidden="true" />
                    <p class="text-xs font-semibold uppercase">Non così</p>
                  </div>
                  <p class="mt-3 text-sm leading-6 text-slate-400">{row.weak}</p>
                </div>
                <div class="p-5">
                  <div class="flex items-center gap-2 text-accent">
                    <CheckCircle2 className="h-4 w-4" aria-hidden="true" />
                    <p class="text-xs font-semibold uppercase">Qui invece</p>
                  </div>
                  <p class="mt-3 text-sm leading-6 text-slate-200">{row.strong}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="border-t border-white/10 py-14 md:py-16">
          <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div class="max-w-3xl">
              <p class="text-xs font-semibold uppercase text-accent">Metodo di studio</p>
              <h2 class="mt-3 text-balance font-heading text-3xl font-bold text-white md:text-3xl">
                Ogni blocco deve produrre chiarezza, non solo conoscenza passiva.
              </h2>
            </div>
            <a
              href="/course/learning-path"
              class="inline-flex items-center gap-2 text-sm font-semibold text-accent transition-colors hover:text-accent/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40"
            >
              Vedi ordine consigliato
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </a>
          </div>

          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
            {methodSteps.map((step, index) => (
              <article class="rounded-lg border border-white/10 bg-[#0b1017] p-5">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-accent/30 bg-accent/10 text-xs font-bold tabular-nums text-accent">
                  {index + 1}
                </span>
                <h3 class="mt-5 font-heading text-lg font-semibold text-white">{step.title}</h3>
                <p class="mt-3 text-sm leading-6 text-slate-400">{step.copy}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="grid gap-8 border-t border-white/10 py-14 md:py-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
          <div>
            <p class="text-xs font-semibold uppercase text-accent">Per chi è utile</p>
            <h2 class="mt-3 text-balance font-heading text-3xl font-bold text-white md:text-3xl">
              Serve a chi deve collegare apprendimento, ruolo e decisioni reali.
            </h2>
            <p class="mt-4 text-base leading-7 text-slate-400">
              La pagina non prova a parlare a tutti: è pensata per chi vuole usare i dati come disciplina operativa,
              che stia iniziando o che debba rimettere ordine in un team.
            </p>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            {audienceCards.map((card) => (
              <article class="rounded-lg border border-white/10 bg-white/[0.03] p-5">
                <h3 class="font-heading text-lg font-semibold text-white">{card.title}</h3>
                <p class="mt-3 text-sm leading-6 text-slate-400">{card.need}</p>
                <p class="mt-4 border-t border-white/10 pt-4 text-sm leading-6 text-slate-200">{card.result}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="grid gap-6 border-t border-white/10 py-14 md:py-16 lg:grid-cols-2">
          <article class="rounded-lg border border-accent/20 bg-accent/[0.07] p-6 md:p-7">
            <div class="flex items-center gap-2 text-accent">
              <BookOpenCheck className="h-5 w-5" aria-hidden="true" />
              <p class="text-xs font-semibold uppercase">Perché è gratuito</p>
            </div>
            <h2 class="mt-4 font-heading text-2xl font-bold text-white">La barriera non deve essere il paywall.</h2>
            <p class="mt-4 text-sm leading-7 text-slate-300">
              Il corso è gratuito per ridurre la distanza tra curiosità e competenza reale. Chi studia deve poter vedere
              un percorso serio prima di comprare consulenza, tool o formazione avanzata.
            </p>
          </article>

          <article class="rounded-lg border border-white/10 bg-white/[0.03] p-6 md:p-7">
            <div class="flex items-center gap-2 text-accent">
              <Target className="h-5 w-5" aria-hidden="true" />
              <p class="text-xs font-semibold uppercase">Confine chiaro</p>
            </div>
            <h2 class="mt-4 font-heading text-2xl font-bold text-white">Formazione aperta, lavoro su progetto separato.</h2>
            <p class="mt-4 text-sm leading-7 text-slate-400">
              Le lezioni costruiscono cultura e basi solide. Le consulenze restano un servizio distinto, utile quando
              serve applicare il metodo a un sistema reale, con vincoli, dati e priorità già presenti.
            </p>
          </article>
        </section>

        <section class="rounded-lg border border-white/10 bg-[linear-gradient(135deg,rgba(255,255,255,0.06),rgba(255,255,255,0.03),rgba(204,255,0,0.06))] p-6 md:p-8">
          <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
            <div class="max-w-3xl">
              <p class="text-xs font-semibold uppercase text-accent">Prossimo passo</p>
              <h2 class="mt-3 text-balance font-heading text-3xl font-bold text-white md:text-3xl">
                Se vuoi imparare dal lavoro reale, parti dalla mappa del percorso.
              </h2>
              <p class="mt-4 text-base leading-7 text-slate-300">
                Segui l’ordine consigliato se parti da zero. Apri il catalogo se sai già dove vuoi entrare. Prenota una
                call solo quando hai un progetto concreto da chiarire.
              </p>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
              <a
                href="/course/learning-path"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-accent px-6 text-sm font-bold text-black transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]"
              >
                Vai alla learning path
                <ArrowRight className="h-4 w-4" aria-hidden="true" />
              </a>
              <a
                href={BOOKING_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-6 text-sm font-semibold text-white transition-colors hover:border-accent/40 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]"
              >
                Parla del tuo progetto
                <ArrowRight className="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </section>
      </article>
    </div>
  </main>

  <Footer />
</Layout>
