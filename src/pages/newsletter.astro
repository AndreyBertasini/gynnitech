---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { serializeJsonLd } from '../utils/jsonld';
import { SITE_URL, SITE_NAME } from '../consts';
import { getArticleCoverAlt, getArticleCoverPath } from '../lib/article-covers';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function getSlug(id: string) {
  return id.replace(/\.[^/.]+$/, '');
}

// Group posts by month for newsletter-style display
const monthlyGroups = posts.reduce((acc, post) => {
  const monthKey = post.data.date.toLocaleDateString('it-IT', { year: 'numeric', month: 'long' });
  if (!acc.has(monthKey)) acc.set(monthKey, []);
  acc.get(monthKey)!.push(post);
  return acc;
}, new Map<string, typeof posts>());

const newsletterJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Newsletter GinnyTech — Archivio',
      description: 'Archivio delle newsletter di GinnyTech: articoli, guide e approfondimenti su MarTech, Data Analytics e Data Engineering.',
      url: `${SITE_URL}/newsletter`,
      publisher: {
        '@type': 'Organization',
        name: SITE_NAME,
        url: SITE_URL,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: 'Newsletter', item: `${SITE_URL}/newsletter` },
      ],
    },
  ],
});
---

<Layout
  title="Newsletter GinnyTech — Archivio"
  description="Archivio delle newsletter di GinnyTech: articoli, guide e approfondimenti su MarTech, Data Analytics e Data Engineering."
  keywords={['newsletter ginnytech', 'archivio newsletter', 'martech newsletter', 'data analytics newsletter']}
>
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main id="main-content" class="relative flex-1 bg-[var(--sl-color-bg)] overflow-hidden selection:bg-accent/30 selection:text-white">
      <script type="application/ld+json" set:html={newsletterJsonLd} is:inline />

      <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-accent/10 to-transparent pointer-events-none"></div>
      <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-accent/5 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute bottom-[-10%] left-[-5%] w-[600px] h-[600px] bg-accent/5 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="container mx-auto px-6 pt-32 pb-20 relative z-10">
        <div class="max-w-4xl mx-auto text-center mb-20">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-accent text-xs font-ui font-medium tracking-wider mb-8 backdrop-blur-sm animate-fade-in-up">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            ARCHIVIO
          </div>

          <h1 class="text-5xl md:text-6xl font-bold text-white mb-8 font-heading drop-shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
            Newsletter <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent via-white to-accent drop-shadow-[0_0_10px_rgba(204,255,0,0.8)] brightness-125">
              GinnyTech
            </span>
          </h1>

          <p class="text-xl text-slate-400 leading-relaxed font-sans max-w-2xl mx-auto">
            Ogni settimana un articolo approfondito su MarTech, Data Analytics e Data Engineering.
            Niente spam — solo contenuti che ti aiutano a lavorare meglio con i dati.
          </p>

          <div class="mt-8">
            <button
              class="email-capture-trigger inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-8 py-3.5 font-ui text-sm font-bold text-black transition hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]"
            >
              Iscriviti alla newsletter
              <span class="text-lg">→</span>
            </button>
            <p class="mt-3 text-sm text-slate-500">
              Ricevi la guida SQL gratuita per marketer quando ti iscrivi
            </p>
          </div>
        </div>

        {/* Archive by month */}
        <div class="max-w-3xl mx-auto">
          {
            Array.from(monthlyGroups.entries()).map(([monthLabel, monthPosts]) => (
              <section class="mb-16">
                <h2 class="text-2xl font-heading font-bold text-white mb-8 flex items-center gap-3">
                  <span class="h-px flex-1 bg-gradient-to-r from-accent/50 to-transparent"></span>
                  <span class="text-accent uppercase tracking-[0.15em] text-sm font-ui">
                    {monthLabel}
                  </span>
                  <span class="h-px flex-1 bg-gradient-to-l from-accent/50 to-transparent"></span>
                </h2>

                <div class="space-y-4">
                  {monthPosts.map((post, idx) => {
                    const slug = getSlug(post.id);
                    const coverPath = getArticleCoverPath(slug, post.data.image);
                    const coverAlt = getArticleCoverAlt(post.data.title);
                    const formattedDate = post.data.date.toLocaleDateString('it-IT', {
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric',
                    });

                    return (
                      <article class="group rounded-2xl border border-white/[0.06] bg-white/[0.02] hover:bg-white/[0.04] hover:border-accent/20 transition-all duration-300 overflow-hidden">
                        <a href={`/blog/${slug}`} class="flex flex-col sm:flex-row gap-0 p-0">
                          {/* Cover image */}
                          <div class="sm:w-48 sm:shrink-0 overflow-hidden">
                            <img
                              src={coverPath}
                              alt={coverAlt}
                              class="h-36 sm:h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                              loading="lazy"
                              decoding="async"
                            />
                          </div>

                          {/* Content */}
                          <div class="flex-1 p-5 sm:p-6 flex flex-col justify-center">
                            <div class="flex items-center gap-3 mb-2">
                              <span class="inline-flex items-center rounded-full border border-accent/20 bg-accent/[0.06] px-2.5 py-0.5 text-[11px] font-semibold text-accent font-ui uppercase tracking-wider">
                                Edizione #{posts.length - posts.indexOf(post)}
                              </span>
                              <span class="text-xs text-slate-500 font-mono">{formattedDate}</span>
                            </div>

                            <h3 class="text-lg font-heading font-bold text-white group-hover:text-accent transition-colors mb-1.5 leading-snug">
                              {post.data.title}
                            </h3>

                            <p class="text-sm text-slate-400 leading-relaxed line-clamp-2">
                              {post.data.description}
                            </p>

                            <div class="mt-3 flex items-center gap-2">
                              <span class="text-xs text-slate-500 bg-white/5 px-2 py-0.5 rounded-md border border-white/5 font-mono">
                                {post.data.category}
                              </span>
                              <span class="text-xs text-accent/70 font-ui group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                                Leggi l'articolo <span class="text-sm">→</span>
                              </span>
                            </div>
                          </div>
                        </a>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))
          }
        </div>

        {/* Bottom CTA */}
        <div class="mt-20 max-w-3xl mx-auto">
          <div class="rounded-2xl border border-white/10 bg-gradient-to-br from-accent/[0.04] via-white/[0.02] to-accent/[0.03] p-8 md:p-10 text-center">
            <div class="text-4xl mb-4">📬</div>
            <h2 class="text-2xl md:text-3xl font-heading font-bold text-white mb-3">
              Non perdere i prossimi articoli
            </h2>
            <p class="text-slate-400 mb-6 max-w-lg mx-auto">
              Ricevi contenuti selezionati direttamente nella tua casella email.
              Ogni edizione include un articolo approfondito e risorse pratiche.
            </p>
            <button
              class="email-capture-trigger inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-8 py-3.5 font-ui text-sm font-bold text-black transition hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]"
            >
              Iscriviti ora
              <span class="text-lg">→</span>
            </button>
            <p class="mt-3 text-xs text-slate-500">
              Zero spam. Puoi cancellarti quando vuoi. Ricevi anche la guida SQL gratuita.
            </p>
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
