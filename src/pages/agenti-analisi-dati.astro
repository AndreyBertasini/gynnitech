---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import AgentPipeline from '../components/AgentPipeline.astro';
import { ArrowRight, CheckCircle2, ExternalLink } from 'lucide-react';
import { BOOKING_URL, SITE_NAME, SITE_URL } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';

const pageTitle = 'Agenti AI per Analisi Dati e Decisioni Aziendali | GinnyTech';
const pageDescription =
  'Agenti AI per analisi dati aziendali: colleghiamo database, documenti e feedback per trovare insight nascosti e accelerare decisioni verificabili.';
const ogTitle = 'Agenti AI per analisi dati aziendali e decision intelligence | GinnyTech';
const ogDescription =
  'Sistemi multi-agente che collegano dati, documenti e segnali di mercato per trovare insight nascosti, validare le fonti e accelerare decisioni operative.';
const canonical = `${SITE_URL}/agenti-analisi-dati/`;
const heroImage = '/agenti-analisi-dati-hero-v2.webp';
const heroImageAlt =
  'Agenti AI per analisi dati aziendali in una città futuristica con sistemi multi-agente e decision intelligence.';

const problemCards = [
  {
    title: 'Frammentazione delle fonti',
    text: 'Warehouse, CRM, ERP, file system, email, log applicativi. Ogni analisi cross-fonte richiede estrazioni manuali, riconciliazioni e giorni di lavoro analista - non riproducibili e non scalabili.',
  },
  {
    title: 'Latenza decisionale strutturale',
    text: 'Il ciclo report -> riunione -> decisione opera su cadenza settimanale o mensile. I segnali di mercato - pricing dei competitor, notizie di settore, anomalie nei funnel - operano su cadenza oraria.',
  },
  {
    title: "L'inaffidabilità dei sistemi AI single-shot",
    text: 'Un singolo LLM interrogato su dati che non controlla produce errori non rilevabili: nessuna scomposizione del problema, nessuna verifica incrociata, nessuna citazione delle fonti. Un output non validato non può sostenere una decisione con impatto economico.',
  },
];

const architectureSteps = [
  {
    label: '01',
    title: 'Ingestion layer: raccolta continua multi-fonte',
    text: 'Connettori verso database relazionali e analitici, API, file system e fonti esterne. Il sistema acquisisce dati strutturati e non strutturati - tabelle, PDF, Excel, email, log, pagine web, feed di notizie - con pipeline idempotenti che operano in continuo, senza intervento umano.',
    stack: ['n8n', 'connettori API', 'web monitoring', 'RSS / news ingestion', 'scheduling'],
  },
  {
    label: '02',
    title: 'Memory layer: OLAP colonnare + memoria semantica',
    text: 'I dati strutturati confluiscono in ClickHouse, database colonnare progettato per query analitiche su miliardi di righe con latenza al millisecondo. Documenti e testi vengono trasformati in embedding e indicizzati in un vector store: il retrieval è semantico, non lessicale - il sistema recupera per significato, non per keyword.',
    stack: ['ClickHouse', 'vector store', 'embedding', 'dbt', 'data contracts'],
  },
  {
    label: '03',
    title: 'Orchestration layer: subagenti specializzati in parallelo',
    text: "Un agente orchestratore applica task decomposition: la richiesta viene scomposta in sotto-compiti assegnati a subagenti con ruolo, strumenti e perimetro definiti - query analitiche, retrieval documentale, analisi delle fonti esterne, confronto temporale. L'esecuzione è parallela; i risultati intermedi vengono aggregati e riconciliati.",
    stack: ['orchestrazione multi-agente', 'LLM multi-modello', 'routing per task', 'state management'],
  },
  {
    label: '04',
    title: 'Validation layer: verifica prima della consegna',
    text: "Ogni claim viene confrontato con le fonti di origine; le divergenze tra subagenti vengono segnalate, non nascoste; ogni output dichiara fonti, limiti e livello di confidenza. Sotto soglia di confidenza il sistema esegue fallback verso revisione umana. Le azioni ad alto impatto richiedono approvazione esplicita: human-in-the-loop by design.",
    stack: ['cross-validation tra agenti', 'source attribution', 'confidence scoring', 'approval workflow'],
  },
];

const outputs = [
  {
    title: 'Decision brief giornaliero',
    text: 'Sintesi strutturata a inizio giornata: KPI con scostamenti spiegati, anomalie con ipotesi causali già verificate sui segmenti, movimenti rilevanti dei competitor, rischi e opportunità prioritizzati.',
  },
  {
    title: 'Market e competitive intelligence continua',
    text: "Monitoraggio di notizie, comunicati, listini e segnali pubblici dei concorrenti. Classificazione automatica per rilevanza e impatto: l'alert arriva solo quando il segnale interseca il tuo business.",
  },
  {
    title: 'Interrogazione in linguaggio naturale su tutto il patrimonio dati',
    text: '"Quale segmento sta erodendo margine, da quando, e con quale driver?" - il sistema scompone la domanda, interroga milioni di righe e migliaia di documenti, risponde con fonti citate e query ispezionabili.',
  },
  {
    title: 'Alert con diagnosi, non semafori',
    text: "A ogni deviazione di metrica l'agente confronta baseline, segmenti e finestre temporali e consegna un'ipotesi causale già sottoposta a verifica - riducendo il tempo di investigazione da ore a minuti.",
  },
];

const governancePoints = [
  'Permessi granulari per fonte, ruolo e ambiente: ogni agente accede solo alle risorse autorizzate',
  'Source attribution obbligatoria: ogni output cita le fonti e dichiara i limiti del proprio perimetro',
  "Cross-validation: i subagenti verificano reciprocamente i risultati prima dell'aggregazione",
  'Approval workflow: nessuna azione ad alto impatto senza autorizzazione umana esplicita',
  'Fallback automatico a revisione umana sotto soglia di confidenza',
  'Observability completa: log di accessi, costi, errori, latenza e drift del sistema',
];

const useCases = [
  {
    title: 'Direzione e finance',
    text: 'Decision brief su ricavi, marginalità, cassa e scostamenti vs. budget, con analisi causale già eseguita e scenari confrontabili. Il management parte dalle risposte, non dalla raccolta dati.',
  },
  {
    title: 'Marketing e competitive intelligence',
    text: 'Sorveglianza continua di campagne, funnel, pricing e comunicazione dei competitor da fonti pubbliche e flussi di notizie. Segnali classificati e consegnati il giorno in cui emergono.',
  },
  {
    title: 'Operations e data platform',
    text: 'Controlli automatici su pipeline, freshness, contratti dati e file in ingresso. Documenti non strutturati - contratti, report, email - convertiti in patrimonio informativo interrogabile via RAG.',
  },
];

const proofPoints = [
  {
    value: 'Potenza di calcolo',
    label: 'Agenti e modelli aggiornati leggono grandi volumi di dati e trovano segnali utili.',
  },
  {
    value: 'Processi più veloci',
    label: 'Automatizziamo ricerche, controlli e report per ridurre passaggi manuali e tempi morti.',
  },
  {
    value: 'Decisioni sotto controllo',
    label: 'Portiamo alla luce informazioni nascoste con fonti verificabili e priorità chiare.',
  },
];

const flowSteps = [
  {
    label: '01',
    title: 'Connetti',
    text: 'Database, API, PDF, Excel, email, news e feed entrano in pipeline continue.',
  },
  {
    label: '02',
    title: 'Memorizzi',
    text: 'ClickHouse serve i dati strutturati; RAG e vector store recuperano contesto testuale.',
  },
  {
    label: '03',
    title: 'Deleghi',
    text: 'Subagenti specializzati analizzano in parallelo query, documenti e segnali esterni.',
  },
  {
    label: '04',
    title: 'Validi',
    text: 'Il sistema riconcilia risultati, cita fonti e passa a revisione umana quando serve.',
  },
];

const deliverySteps = [
  {
    label: '01',
    title: 'Assessment di dati e decisioni',
    text: "Mappatura di fonti, volumi, formati e dei processi decisionali con maggiore latenza. Output: il caso d'uso a più alto rapporto valore/complessità per il primo deploy.",
  },
  {
    label: '02',
    title: 'System design',
    text: 'Progettazione di memoria, connettori, ruoli dei subagenti, criteri di validazione, permessi e approval workflow - prima di qualunque implementazione. Il design precede il codice.',
  },
  {
    label: '03',
    title: 'Pilot in produzione controllata',
    text: 'Primo sistema operativo su un processo reale, con metriche di valutazione definite ex ante: precisione, falsi positivi, latenza, costo per analisi.',
  },
  {
    label: '04',
    title: 'Rollout incrementale',
    text: "Estensione di fonti, agenti e scope solo a fronte di metriche verificate: utilità misurata, tasso di falsi positivi sotto soglia, tempo risparmiato documentato.",
  },
];

const faqs = [
  {
    question: 'Quando conviene usare agenti AI per analisi dati aziendali?',
    answer:
      'Conviene quando le decisioni dipendono da più fonti: database, CRM, ERP, file Excel, PDF, email, ticket, feedback clienti e segnali di mercato. Se oggi il team perde ore a cercare dati, riconciliare numeri e preparare report manuali, un sistema multi-agente può automatizzare raccolta, analisi, controllo e sintesi decisionale.',
  },
  {
    question: 'Quali fonti dati può collegare un sistema multi-agente?',
    answer:
      'Il sistema può leggere database relazionali e analitici, warehouse, CRM, ERP, API, fogli Excel, documenti PDF, email, log applicativi, feed di notizie e pagine web monitorate. I dati strutturati vengono interrogati con query analitiche; testi e documenti entrano in memoria semantica tramite RAG.',
  },
  {
    question: "Che differenza c'è tra un agente AI autonomo e un chatbot sui dati?",
    answer:
      'Un chatbot risponde a una domanda alla volta interrogando un modello. Un agente autonomo opera in continuo: raccoglie dati da più fonti, mantiene memoria persistente, scompone i problemi in sotto-compiti delegati a subagenti, e valida i risultati prima di consegnarli. Il chatbot conversa; l’agente esegue un processo analitico completo.',
  },
  {
    question: 'Il sistema richiede la sostituzione dei nostri sistemi attuali?',
    answer:
      "No. L'architettura si integra con database, gestionali e file system esistenti tramite connettori dedicati. Nessuna migrazione: il sistema legge le fonti dove si trovano e costruisce la propria memoria analitica in parallelo.",
  },
  {
    question: 'Dove risiedono i dati e chi ne ha il controllo?',
    answer:
      "L'intera architettura è installabile su infrastruttura di proprietà del cliente - cloud privato o server dedicati. Permessi, retention, log e policy sui dati sensibili sono definiti in fase di system design, prima del deploy.",
  },
  {
    question: "Come viene garantita l'affidabilità delle analisi generate dagli agenti?",
    answer:
      'Attraverso quattro meccanismi architetturali: task decomposition (problemi complessi scomposti in verifiche semplici), cross-validation tra subagenti indipendenti, source attribution obbligatoria su ogni claim, e fallback a revisione umana sotto soglia di confidenza. Le azioni ad alto impatto richiedono sempre approvazione umana.',
  },
  {
    question: 'Quali volumi di dati gestisce il sistema?',
    answer:
      'Il memory layer analitico è costruito su ClickHouse, database colonnare progettato per query su miliardi di righe con latenza al millisecondo. Milioni di record e di documenti non rappresentano un limite: sono il dimensionamento di riferimento dell’architettura.',
  },
  {
    question: 'In quanto tempo il sistema è operativo?',
    answer:
      "Il pilot su un processo reale è tipicamente in produzione controllata in 4-8 settimane dall'assessment, con metriche di valutazione definite prima del deploy.",
  },
  {
    question: "Come viene misurato il ritorno dell'investimento?",
    answer:
      "Su metriche definite ex ante nel pilot: ore analista risparmiate, riduzione della latenza segnale->decisione, tasso di falsi positivi, costo marginale per analisi. Il rollout successivo è condizionato ai risultati misurati.",
  },
];

const pageJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      logo: `${SITE_URL}/ginni.webp`,
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'it-IT',
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${SITE_URL}/#website`,
        name: SITE_NAME,
        url: SITE_URL,
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: `${SITE_URL}${heroImage}`,
        caption: heroImageAlt,
      },
      about: {
        '@id': `${canonical}#service`,
      },
      breadcrumb: {
        '@id': `${canonical}#breadcrumb`,
      },
    },
    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: 'Agenti AI per analisi dati aziendali',
      provider: {
        '@id': `${SITE_URL}/#organization`,
      },
      areaServed: 'Italia',
      serviceType: 'Sistemi multi-agente per analisi dati aziendali con AI',
      category: 'Decision intelligence e automazione analisi dati',
      url: canonical,
      image: `${SITE_URL}${heroImage}`,
      description: pageDescription,
      audience: {
        '@type': 'BusinessAudience',
        audienceType: 'Direzione, finance, marketing, operations e data platform team',
      },
      serviceOutput:
        'Decision brief, competitive intelligence, interrogazione RAG del patrimonio dati, automazione report e alert con diagnosi validata.',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Percorso di implementazione agenti AI per analisi dati',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Assessment dati e decisioni',
              description:
                'Mappatura di fonti dati, processi decisionali e casi d\'uso con maggiore potenziale di automazione.',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Pilot multi-agente in produzione controllata',
              description:
                'Implementazione di un primo sistema su un processo reale con metriche, controlli e validazione umana.',
            },
          },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: SITE_URL,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Agenti AI autonomi',
          item: canonical,
        },
      ],
    },
  ],
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  image={heroImage}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt={heroImageAlt}
  keywords={[
    'agenti AI per analisi dati',
    "agenti autonomi per l'analisi dei dati",
    'agenti AI aziendali',
    'sistemi multi-agente',
    'agentic AI enterprise',
    'decision intelligence',
    'automazione analisi dati',
    'AI per business intelligence',
    'RAG aziendale',
    'ClickHouse',
    'orchestrazione di agenti',
    'analisi dati con AI',
  ]}
  preloadImage
>
  <Navbar client:idle />

  <main id="main-content" class="agents-page" data-pagefind-body>
    <script type="application/ld+json" set:html={pageJsonLd} is:inline />

    <section class="a-hero" aria-labelledby="hero-title">
      <img
        class="hero-image"
        src={heroImage}
        alt={heroImageAlt}
        width="2400"
        height="1024"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="hero-mesh" aria-hidden="true"></div>

      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="kicker kicker-inline">
            <span>Agentic AI</span>
            <span>Analisi dati aziendale</span>
            <span>Decision intelligence</span>
          </p>
          <h1 id="hero-title">Agenti AI per analisi dati aziendali, insight nascosti e decisioni più veloci.</h1>
          <p class="hero-lede">
            Oggi non si resta avanti con processi lenti, report sparsi e decisioni basate solo sull'esperienza personale. Colleghiamo database, documenti, feedback dei clienti e segnali di mercato a sistemi multi-agente che usano modelli di nuova generazione, fino alla scala dei trilioni di parametri.
          </p>
          <p class="hero-sub">
            Con dati vivi e contesto continuo, il modello diventa un super-cervello operativo: più rapido e coerente di qualsiasi manager lasciato solo davanti a report manuali, capace di vedere pattern nascosti e trasformarli in decisioni più controllate.
          </p>
          <div class="cta-row" aria-label="Azioni principali">
            <a
              class="button button-primary"
              href={BOOKING_URL}
              target="_blank"
              rel="noopener"
              data-cta-position="hero"
              aria-label="Prenota un assessment di 15 minuti"
            >
              Prenota un assessment di 15 minuti
              <ArrowRight className="button-icon" aria-hidden="true" />
            </a>
            <a class="button button-secondary" href="#architettura" aria-label="Vai all'architettura del sistema">
              Architettura del sistema
            </a>
          </div>
        </div>

        <dl class="hero-proof" aria-label="Punti chiave del servizio">
          {proofPoints.map((point) => (
            <div>
              <dt>{point.value}</dt>
              <dd>{point.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section band" aria-labelledby="problem-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker"><span class="kicker-index">01</span><span>Il vincolo reale</span></p>
          <h2 id="problem-title">Analisi dati aziendali: il vero collo di bottiglia è trasformare segnali dispersi in decisioni rapide.</h2>
          <p class="section-lede">
            Un'azienda mid-market produce e riceve ogni giorno più informazione di quanta qualunque team possa processare: transazioni nel warehouse, contratti e report in PDF, segnali nei sistemi operativi, mosse dei competitor nelle fonti pubbliche. Il deficit non è informativo - è di throughput analitico. E ogni giorno di latenza tra segnale e decisione ha un costo misurabile.
          </p>
        </div>

        <div class="card-grid three">
          {problemCards.map((card, index) => (
            <article class="a-card reveal">
              <p class="card-index">0{index + 1}</p>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="architettura" class="section" aria-labelledby="architecture-title">
      <div class="container wide">
        <div class="section-head narrow reveal">
          <p class="kicker"><span class="kicker-index">02</span><span>Come funzionano gli agenti AI autonomi</span></p>
          <h2 id="architecture-title">Come funziona un sistema multi-agente per analisi dati aziendali.</h2>
        </div>

        <ol class="flow reveal" aria-label="Flusso operativo degli agenti">
          {flowSteps.map((step) => (
            <li>
              <span class="flow-index">{step.label}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>

        <ol class="layers" aria-label="Livelli architetturali del sistema">
          {architectureSteps.map((step) => (
            <li class="layer reveal">
              <div class="layer-head">
                <span class="layer-index" aria-hidden="true">{step.label}</span>
                <h3>{step.title}</h3>
              </div>
              {step.label === '02' ? (
                <p>
                  I dati strutturati confluiscono in ClickHouse, database colonnare progettato per <a href="/blog/sql-per-marketing/">query analitiche</a> su miliardi di righe con latenza al millisecondo. Documenti e testi vengono trasformati in embedding e indicizzati in un vector store: il retrieval è semantico, non lessicale - il sistema recupera per significato, non per keyword.
                </p>
              ) : (
                <p>{step.text}</p>
              )}
              <ul class="stack-chips" aria-label="Stack tecnologico del livello">
                {step.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>

        <figure class="pipeline-panel reveal">
          <div class="pipeline-scroll">
            <AgentPipeline />
          </div>
          <figcaption>Dalla fonte alla decisione validata: percorso completo di un task agentico.</figcaption>
        </figure>

        <div class="closing-note reveal">
          <p>
            L'output non è "la risposta di un modello". È un'analisi riproducibile e tracciabile - fonti citate, limiti dichiarati, confidenza quantificata - progettata per sostenere decisioni con impatto economico.
          </p>
          <a
            class="button button-primary"
            href={BOOKING_URL}
            target="_blank"
            rel="noopener"
            data-cta-position="mid"
            aria-label="Prenota un assessment di 15 minuti dopo aver letto l'architettura"
          >
            Prenota un assessment di 15 minuti
            <ArrowRight className="button-icon" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section class="section band" aria-labelledby="outputs-title">
      <div class="container">
        <div class="split-head reveal">
          <div>
            <p class="kicker"><span class="kicker-index">03</span><span>Cosa produce il sistema</span></p>
            <h2 id="outputs-title">Cosa producono gli agenti AI per l'analisi dati: decision intelligence quotidiana.</h2>
          </div>
          <p class="side-note">
            La data governance resta visibile: ogni output espone fonti, limiti, costo di esecuzione e stato di validazione.
          </p>
        </div>

        <div class="card-grid two">
          {outputs.map((card, index) => (
            <article class="a-card reveal">
              <p class="card-index">0{index + 1}</p>
              {index === 1 ? (
                <h3><a href="/blog/ai-marketing-2026/">{card.title}</a></h3>
              ) : (
                <h3>{card.title}</h3>
              )}
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="governance-title">
      <div class="container wide">
        <div class="split-head reveal">
          <div>
            <p class="kicker"><span class="kicker-index">04</span><span>Controllo e auditabilità</span></p>
            <h2 id="governance-title">Autonomia operativa degli agenti. Perimetri, log e approvazioni progettati prima del deploy.</h2>
          </div>
          <p class="side-note">
            L'autonomia senza governance è un rischio operativo. Ogni agente del sistema opera entro un perimetro formale definito in fase di design - non come patch successiva.
          </p>
        </div>

        <ul class="rule-list reveal">
          {governancePoints.map((item) => (
            <li>
              <CheckCircle2 className="check-icon" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section band" aria-labelledby="usecase-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="kicker"><span class="kicker-index">05</span><span>Dove i sistemi multi-agente generano valore</span></p>
          <h2 id="usecase-title">Casi d'uso degli agenti AI per dati, marketing, finance e operations.</h2>
        </div>
        <div class="card-grid three">
          {useCases.map((card) => (
            <article class="a-card card-domain reveal">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="delivery-title">
      <div class="container">
        <div class="delivery-grid">
          <div class="section-head sticky-head reveal">
            <p class="kicker"><span class="kicker-index">06</span><span>Dal design alla produzione</span></p>
            <h2 id="delivery-title">Dall'assessment iniziale a un sistema in produzione controllata.</h2>
          </div>
          <ol class="timeline">
            {deliverySteps.map((step) => (
              <li class="timeline-step reveal">
                <span class="timeline-index" aria-hidden="true">{step.label}</span>
                <div>
                  {step.label === '01' ? (
                    <h3><a href="/consulting">Assessment di dati e decisioni</a></h3>
                  ) : (
                    <h3>{step.title}</h3>
                  )}
                  <p>{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="section band" aria-labelledby="faq-title">
      <div class="container narrow-container">
        <div class="section-head narrow reveal">
          <p class="kicker"><span class="kicker-index">07</span><span>Domande frequenti</span></p>
          <h2 id="faq-title">Domande frequenti sugli agenti AI autonomi</h2>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item reveal">
              <summary>{faq.question}</summary>
              <div class="faq-answer"><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section final-cta-section" aria-labelledby="final-cta-title">
      <div class="container">
        <div class="final-cta reveal">
          <div class="final-cta-copy">
            <p class="kicker"><span>Assessment iniziale</span></p>
            <h2 id="final-cta-title">Porta un processo decisionale che oggi richiede giorni. Definiamo l'architettura che lo porta a minuti.</h2>
            <p>
              In 15 minuti identifichiamo le fonti da collegare per prime e il caso d'uso a maggior valore: decision brief, competitive intelligence o interrogazione del patrimonio dati.
            </p>
          </div>
          <div class="cta-row final-actions">
            <a
              class="button button-primary"
              href={BOOKING_URL}
              target="_blank"
              rel="noopener"
              data-cta-position="footer"
              aria-label="Prenota un assessment di 15 minuti"
            >
              Prenota un assessment di 15 minuti
              <ArrowRight className="button-icon" aria-hidden="true" />
            </a>
            <a class="button button-secondary" href="/course/" aria-label="Esplora il corso dati">
              Esplora il corso dati
              <ExternalLink className="button-icon" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    const revealItems = Array.from(document.querySelectorAll('.reveal'));
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReduced && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -4% 0px' }
      );
      revealItems.forEach((item) => observer.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    }

    document.querySelectorAll('[data-cta-position]').forEach((link) => {
      link.addEventListener('click', () => {
        window.gtag?.('event', 'cta_click', {
          position: link.getAttribute('data-cta-position'),
        });
      });
    });
  </script>
</Layout>

