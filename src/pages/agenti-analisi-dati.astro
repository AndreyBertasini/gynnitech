---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import {
  ArrowRight,
  BellRing,
  Bot,
  CheckCircle2,
  Clock3,
  DatabaseZap,
  FileCheck2,
  Gauge,
  GitBranch,
  Layers3,
  LineChart,
  LockKeyhole,
  Route,
  ShieldCheck,
  TriangleAlert,
  Users,
  Workflow,
} from 'lucide-react';
import { BOOKING_URL, SITE_NAME, SITE_URL } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';

const pageTitle = 'Agenti AI per Analytics Operations Enterprise | GinnyTech';
const pageDescription =
  'GinnyTech progetta agenti AI per analytics operations: KPI monitoring, data quality, daily brief, query controllate, governance e human approval per team aziendali.';
const heroImage = '/agenti-analisi-dati.webp';

const serviceJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Agenti AI per analytics operations enterprise',
  provider: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
  },
  areaServed: 'Italia',
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Marketing, product, finance and data teams',
  },
  serviceType: 'AI data analytics agents',
  description: pageDescription,
  serviceOutput:
    'Workflow agentici per monitoraggio KPI, data quality, daily brief, query controllate, decision memo e alert operativi.',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    url: `${SITE_URL}/agenti-analisi-dati`,
  },
});

const trustSignals = [
  { label: 'Fonti', value: 'Warehouse, BI, docs' },
  { label: 'Controllo', value: 'Approval umano' },
  { label: 'Output', value: 'Brief decisionale' },
  { label: 'Governance', value: 'Log, eval, policy' },
];

const operatingSignals = [
  {
    icon: Gauge,
    title: 'KPI che cambiano senza una spiegazione pronta',
    text: 'L agente confronta baseline, segmenti e finestre temporali prima di portare un alert al team.',
  },
  {
    icon: DatabaseZap,
    title: 'Dashboard corrette ma poco usate nel lavoro quotidiano',
    text: 'Il sistema trasforma numeri sparsi in un brief operativo leggibile da marketing, prodotto, finance e data team.',
  },
  {
    icon: TriangleAlert,
    title: 'Incidenti dati scoperti quando la decisione e gia partita',
    text: 'Freshness, null, duplicati, tracking e cambi schema vengono controllati prima di finire nei report.',
  },
];

const agentTypes = [
  {
    icon: LineChart,
    title: 'KPI analyst agent',
    eyebrow: 'Performance monitoring',
    text: 'Monitora revenue, funnel, retention, CAC, LTV, margine e metriche operative. Evidenzia anomalie, segmenti e driver probabili.',
  },
  {
    icon: DatabaseZap,
    title: 'Data quality agent',
    eyebrow: 'Affidabilita dati',
    text: 'Controlla freshness, join fragili, null, duplicati, naming, tracking e cambi schema prima che entrino nei report decisionali.',
  },
  {
    icon: BellRing,
    title: 'Daily brief agent',
    eyebrow: 'Rituale operativo',
    text: 'Prepara una sintesi giornaliera con numeri chiave, rischi, opportunita e domande da portare allo standup o al comitato.',
  },
  {
    icon: Bot,
    title: 'Decision support agent',
    eyebrow: 'Human-in-the-loop',
    text: 'Risponde su metriche e documentazione interna con fonti, limiti dichiarati e passaggi che richiedono approvazione umana.',
  },
];

const architectureLayers = [
  {
    icon: Layers3,
    title: 'Semantic layer',
    text: 'Metriche, grain, filtri, finestre temporali, esclusioni e definizioni condivise prima dei prompt.',
  },
  {
    icon: Route,
    title: 'Tool controllati',
    text: 'Accesso a query, dashboard, documenti e ticket con permessi, rate limit, policy e blocchi per azioni rischiose.',
  },
  {
    icon: FileCheck2,
    title: 'Eval e review',
    text: 'Esempi reali, casi limite, criteri di accettazione e revisione umana per gli output che guidano decisioni.',
  },
  {
    icon: LockKeyhole,
    title: 'Trace e sicurezza',
    text: 'Log, fonti, costi, confidenza, fallback manuale e policy per dati sensibili o raccomandazioni ad alto impatto.',
  },
];

const deliverySteps = [
  {
    label: '01',
    title: 'Audit di decisioni e dati',
    text: 'Partiamo da dashboard, KPI, owner, frequenza delle decisioni, incidenti ricorrenti e domande che oggi arrivano troppo tardi.',
  },
  {
    label: '02',
    title: 'Design del workflow agentico',
    text: 'Disegniamo ruoli, strumenti, stati, criteri di stop, approval, log e output finale prima di scrivere automazioni.',
  },
  {
    label: '03',
    title: 'Pilot controllato',
    text: 'Costruiamo un primo agente su un processo reale: KPI monitoring, data quality, daily brief o analytics operations.',
  },
  {
    label: '04',
    title: 'Rollout con governance',
    text: 'Misuriamo utilita, falsi positivi, costi, tempi risparmiati e qualita degli handoff prima di ampliare lo scope.',
  },
];

const safeguards = [
  'Permessi per ruolo, fonte e ambiente',
  'Nessuna azione critica senza approval',
  'Metriche definite prima dei prompt',
  'Output con fonti e limiti dichiarati',
  'Fallback manuale se la confidenza e bassa',
  'Monitoraggio di costi, errori e drift',
];

const fitItems = [
  {
    title: 'Marketing e growth',
    text: 'Alert su funnel, campagne, canali, anomalie di tracking e variazioni nei segmenti ad alto valore.',
  },
  {
    title: 'Product e customer analytics',
    text: 'Brief su activation, retention, adoption, cohort, feature usage e impatto dei rilasci.',
  },
  {
    title: 'Data platform',
    text: 'Controlli su pipeline, freshness, contratti dati, incidenti, runbook e impatto sui report downstream.',
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={[
    'agenti ai analisi dati',
    'analytics operations',
    'data analytics agent',
    'agentic ai enterprise',
    'kpi monitoring',
    'data quality agent',
  ]}
  image={heroImage}
  preloadImage
>
  <Navbar client:only="react" />

  <main id="main-content" class="bg-[var(--sl-color-bg)] text-white">
    <script type="application/ld+json" set:html={serviceJsonLd} is:inline />

    <section class="relative isolate overflow-hidden border-b border-white/10 pt-24 pb-10 md:pt-28 md:pb-16 lg:pt-32" aria-labelledby="agents-hero-title">
      <div class="absolute inset-0 -z-30 bg-[#07090d]"></div>
      <img
        src={heroImage}
        alt=""
        class="absolute inset-x-0 top-16 -z-20 h-80 w-full object-cover opacity-35 md:hidden"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        aria-hidden="true"
      />
      <div class="absolute inset-0 -z-20 bg-[linear-gradient(180deg,rgba(255,255,255,0.04),rgba(255,255,255,0)_34%),linear-gradient(90deg,rgba(204,255,0,0.08),rgba(96,165,250,0.07)_44%,rgba(255,255,255,0)_76%)]"></div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:72px_72px] opacity-30"></div>

      <div class="container mx-auto px-6">
        <div class="grid gap-9 md:gap-12 lg:grid-cols-[0.98fr_1.02fr] lg:items-center">
          <div class="max-w-3xl">
            <div class="mb-7 inline-flex items-center gap-3 rounded-lg border border-white/15 bg-white/[0.04] px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-accent">
              <Clock3 className="h-4 w-4" />
              Analytics operations con agenti AI
            </div>
            <h1 id="agents-hero-title" class="font-heading text-3xl font-bold leading-[1.08] text-white md:text-5xl xl:text-6xl">
              Agenti AI che trasformano dati aziendali in decisioni controllate.
            </h1>
            <p class="mt-6 max-w-2xl text-base leading-7 text-slate-300 md:mt-7 md:text-xl md:leading-8">
              Progettiamo workflow agentici collegati a warehouse, dashboard e documenti interni:
              monitorano KPI, verificano la qualita dei dati, preparano brief e chiedono approval quando una scelta e rischiosa.
            </p>

            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a
                href={BOOKING_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 font-bold text-black transition hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-black"
              >
                Prenota una call
                <ArrowRight className="h-5 w-5" />
              </a>
              <a
                href="#architettura"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-white/[0.18] bg-white/[0.04] px-6 py-3 font-semibold text-white transition hover:border-accent/60 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black"
              >
                Vedi architettura
                <Workflow className="h-5 w-5" />
              </a>
            </div>

            <dl class="mt-11 hidden gap-3 sm:grid sm:grid-cols-2 xl:grid-cols-4">
              {trustSignals.map((signal) => (
                <div class="rounded-lg border border-white/10 bg-black/[0.24] p-4">
                  <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">{signal.label}</dt>
                  <dd class="mt-2 text-sm font-semibold leading-6 text-white">{signal.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <figure class="relative hidden md:block">
            <div class="absolute -inset-px -z-10 rounded-lg bg-[linear-gradient(135deg,rgba(204,255,0,0.45),rgba(96,165,250,0.22),rgba(255,255,255,0.08))] opacity-80"></div>
            <img
              src={heroImage}
              alt="Sistema agentico per analytics operations con monitoraggio KPI, data quality e daily brief"
              width="1600"
              height="900"
              class="block aspect-[16/10] w-full rounded-lg border border-white/[0.12] bg-[#0d1117] object-cover shadow-[0_24px_80px_rgba(0,0,0,0.45)]"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <figcaption class="mt-4 grid gap-3 text-sm text-slate-300 sm:grid-cols-3">
              <span class="rounded-lg border border-white/10 bg-white/[0.04] px-4 py-3">KPI watch</span>
              <span class="rounded-lg border border-white/10 bg-white/[0.04] px-4 py-3">Quality checks</span>
              <span class="rounded-lg border border-white/10 bg-white/[0.04] px-4 py-3">Daily brief</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="border-b border-white/10 bg-[#0a0d12] py-14" aria-labelledby="signals-title">
      <div class="container mx-auto px-6">
        <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">quando serve</p>
            <h2 id="signals-title" class="mt-3 max-w-2xl font-heading text-3xl font-bold leading-tight text-white md:text-4xl">
              Il valore non e fare piu report. E ridurre il ritardo tra segnale, controllo e decisione.
            </h2>
          </div>
          <p class="max-w-xl text-base leading-7 text-slate-400">
            Un agente serio non sostituisce governance, definizioni e ownership. Le rende operative ogni giorno.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          {operatingSignals.map((item) => {
            const Icon = item.icon;
            return (
              <article class="rounded-lg border border-white/10 bg-white/[0.035] p-6">
                <Icon className="mb-5 h-7 w-7 text-accent" />
                <h3 class="font-heading text-xl font-bold leading-tight text-white">{item.title}</h3>
                <p class="mt-4 leading-7 text-slate-300">{item.text}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="py-20 md:py-24" aria-labelledby="agents-title">
      <div class="container mx-auto px-6">
        <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
          <div class="lg:sticky lg:top-24">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">cosa costruiamo</p>
            <h2 id="agents-title" class="mt-3 font-heading text-3xl font-bold leading-tight text-white md:text-5xl">
              Un sistema di agenti per analytics operations, non un chatbot sui dati.
            </h2>
            <p class="mt-6 text-lg leading-8 text-slate-300">
              Ogni agente ha fonti consentite, compiti chiari, metriche definite, limiti, log e output revisionabili.
              La domanda non e solo "cosa dice il modello", ma "quale decisione puo sostenere questo output".
            </p>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            {agentTypes.map((item) => {
              const Icon = item.icon;
              return (
                <article class="rounded-lg border border-white/10 bg-white/[0.035] p-6 transition hover:border-accent/[0.35] hover:bg-white/[0.055]">
                  <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-lg border border-accent/20 bg-accent/10 text-accent">
                    <Icon className="h-6 w-6" />
                  </div>
                  <p class="mb-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">{item.eyebrow}</p>
                  <h3 class="font-heading text-2xl font-bold leading-tight text-white">{item.title}</h3>
                  <p class="mt-4 leading-7 text-slate-300">{item.text}</p>
                </article>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <section id="architettura" class="border-y border-white/10 bg-[#0e131a] py-20 md:py-24" aria-labelledby="architecture-title">
      <div class="container mx-auto px-6">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">architettura</p>
          <h2 id="architecture-title" class="mt-3 font-heading text-3xl font-bold leading-tight text-white md:text-5xl">
            Prima il sistema di fiducia, poi il modello.
          </h2>
          <p class="mt-6 text-lg leading-8 text-slate-300">
            Gli agenti funzionano in azienda quando dati, metriche, strumenti, approval e responsabilita sono progettati insieme.
          </p>
        </div>

        <div class="mt-14 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {architectureLayers.map((item) => {
            const Icon = item.icon;
            return (
              <article class="rounded-lg border border-white/10 bg-[#111720] p-6">
                <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-lg bg-white/[0.06] text-cyan-300">
                  <Icon className="h-6 w-6" />
                </div>
                <h3 class="font-heading text-xl font-bold text-white">{item.title}</h3>
                <p class="mt-4 leading-7 text-slate-300">{item.text}</p>
              </article>
            );
          })}
        </div>

        <div class="mt-12 rounded-lg border border-white/10 bg-black/[0.24] p-5 md:p-6">
          <div class="grid gap-4 text-sm text-slate-300 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:items-center">
            <div class="rounded-lg border border-white/10 bg-white/[0.035] p-4">
              <p class="font-semibold text-white">Dati e documenti</p>
              <p class="mt-2 leading-6">Warehouse, BI, metriche, runbook, ticket, CRM, campagne.</p>
            </div>
            <GitBranch className="mx-auto hidden h-6 w-6 text-accent md:block" />
            <div class="rounded-lg border border-white/10 bg-white/[0.035] p-4">
              <p class="font-semibold text-white">Agente con policy</p>
              <p class="mt-2 leading-6">Tool consentiti, stato, memoria, eval, limiti e trace.</p>
            </div>
            <ArrowRight className="mx-auto hidden h-6 w-6 text-accent md:block" />
            <div class="rounded-lg border border-white/10 bg-white/[0.035] p-4">
              <p class="font-semibold text-white">Output approvabile</p>
              <p class="mt-2 leading-6">Alert, brief, decision memo, escalation o ticket operativo.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-24" aria-labelledby="method-title">
      <div class="container mx-auto px-6">
        <div class="grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">metodo di delivery</p>
            <h2 id="method-title" class="mt-3 font-heading text-3xl font-bold leading-tight text-white md:text-5xl">
              Dal primo audit al primo agente utile in produzione controllata.
            </h2>
            <p class="mt-6 text-lg leading-8 text-slate-300">
              Non partiamo da una demo generica. Partiamo dal punto in cui il team perde tempo, fiducia o velocita:
              metriche non spiegate, report fragili, incidenti dati, decisioni lente.
            </p>
          </div>

          <div class="space-y-4">
            {deliverySteps.map((step) => (
              <article class="rounded-lg border border-white/10 bg-white/[0.035] p-6">
                <div class="flex gap-5">
                  <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-sm font-bold text-accent">
                    {step.label}
                  </div>
                  <div>
                    <h3 class="font-heading text-xl font-bold text-white">{step.title}</h3>
                    <p class="mt-3 leading-7 text-slate-300">{step.text}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#090c11] py-20 md:py-24" aria-labelledby="governance-title">
      <div class="container mx-auto px-6">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-lg border border-accent/25 bg-accent/10 text-accent">
              <ShieldCheck className="h-7 w-7" />
            </div>
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">governance</p>
            <h2 id="governance-title" class="mt-3 font-heading text-3xl font-bold leading-tight text-white md:text-5xl">
              Agenti veloci, ma con confini chiari.
            </h2>
            <p class="mt-6 text-lg leading-8 text-slate-300">
              L agente puo cercare pattern, preparare ipotesi e suggerire controlli. Le decisioni ad alto impatto restano tracciate,
              approvabili e collegate a fonti verificabili.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {safeguards.map((item) => (
              <div class="flex gap-3 rounded-lg border border-white/10 bg-white/[0.035] p-5">
                <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-accent" />
                <p class="text-sm leading-6 text-slate-200">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-24" aria-labelledby="fit-title">
      <div class="container mx-auto px-6">
        <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">dove porta valore</p>
            <h2 id="fit-title" class="mt-3 font-heading text-3xl font-bold leading-tight text-white md:text-4xl">
              Tre aree dove un agente dati puo diventare operativo subito.
            </h2>
          </div>

          <div class="grid gap-4 md:grid-cols-3">
            {fitItems.map((item) => (
              <article class="rounded-lg border border-white/10 bg-white/[0.035] p-6">
                <h3 class="font-heading text-xl font-bold text-white">{item.title}</h3>
                <p class="mt-4 leading-7 text-slate-300">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24" aria-labelledby="cta-title">
      <div class="container mx-auto px-6">
        <div class="relative overflow-hidden rounded-lg border border-accent/25 bg-[#10150d] p-8 md:p-12">
          <div class="absolute inset-0 -z-10 bg-[linear-gradient(110deg,rgba(204,255,0,0.12),rgba(96,165,250,0.08),rgba(255,255,255,0))]"></div>
          <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div class="max-w-3xl">
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-accent">prima call</p>
              <h2 id="cta-title" class="mt-3 font-heading text-3xl font-bold leading-tight text-white md:text-5xl">
                Porta una dashboard, un problema dati ricorrente o una metrica che non ti fidi ancora a delegare.
              </h2>
              <p class="mt-6 text-lg leading-8 text-slate-300">
                In 15 minuti capiamo se conviene partire da KPI monitoring, data quality, daily brief o analytics operations agentiche.
              </p>
            </div>

            <div class="flex flex-col gap-3">
              <a
                href={BOOKING_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-accent px-7 py-4 font-bold text-black transition hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-black"
              >
                Prenota una call
                <ArrowRight className="h-5 w-5" />
              </a>
              <a
                href="/course/"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg border border-white/[0.16] bg-white/[0.04] px-7 py-4 font-semibold text-white transition hover:border-accent/60 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black"
              >
                Esplora il corso dati
                <Users className="h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
