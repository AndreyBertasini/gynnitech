    background: rgba(232, 236, 244, 0.03);
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.73rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  /* ---------- pipeline ---------- */

  .pipeline-panel {
    margin: 16px 0 0;
    padding: 26px 26px 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background:
      linear-gradient(180deg, rgba(232, 236, 244, 0.025), transparent 60%),
      var(--surface);
  }

  .pipeline-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .pipeline-panel figcaption {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 0.73rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  :global(.pipeline-svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  :global(.pipeline-track) {
    fill: none;
    stroke: rgba(232, 236, 244, 0.16);
    stroke-width: 2;
  }

  :global(.pipeline-pulse) {
    fill: none;
    stroke-width: 3;
    stroke-dasharray: 42 260;
    stroke-linecap: round;
    animation: pipeline-flow 4.8s linear infinite;
  }

  :global(.pipeline-pulse.delayed) {
    animation-delay: -2.1s;
  }

  :global(.pipeline-node rect) {
    fill: rgba(13, 15, 20, 0.94);
    stroke: rgba(232, 236, 244, 0.14);
    stroke-width: 1;
  }

  :global(.pipeline-node circle) {
    fill: var(--accent);
  }

  :global(.pipeline-node text) {
    fill: var(--text);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
  }

  :global(.pipeline-node .node-detail) {
    fill: var(--text-dim);
    font-size: 7.8px;
    font-weight: 400;
  }

  @keyframes pipeline-flow {
    to {
      stroke-dashoffset: -302;
    }
  }

  /* ---------- nota di chiusura + CTA intermedia ---------- */

  .closing-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    margin-top: 16px;
    padding: 28px;
    border: 1px solid rgba(204, 255, 0, 0.22);
    border-radius: var(--r-md);
    background:
      linear-gradient(90deg, rgba(204, 255, 0, 0.07), rgba(204, 255, 0, 0.015) 55%, transparent),
      var(--surface);
  }

  .closing-note p {
    max-width: 70ch;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.72;
  }

  /* ---------- lista con filetti (governance) ---------- */

  .rule-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

