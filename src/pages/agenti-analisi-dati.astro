---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import {
  ArrowRight,
  BellRing,
  Bot,
  CheckCircle2,
  Clock3,
  DatabaseZap,
  Gauge,
  LineChart,
  LockKeyhole,
  MessageSquareText,
  RefreshCcw,
  ShieldCheck,
  Workflow,
} from 'lucide-react';
import { BOOKING_URL, SITE_NAME, SITE_URL } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';

const pageTitle = 'Agenti AI per Analisi Dati Aziendali | GinnyTech';
const pageDescription =
  'Servizio GinnyTech per creare agenti AI che monitorano dati aziendali 24/7, studiano KPI, anomalie e numeri, e preparano suggerimenti operativi per il team.';
const heroImage = '/agenti-analisi-dati.webp';

const serviceJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Agenti AI per analisi dati aziendali',
  provider: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
  },
  areaServed: 'Italia',
  serviceType: 'AI data analytics agents',
  description: pageDescription,
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    url: `${SITE_URL}/agenti-analisi-dati`,
  },
});

const painPoints = [
  {
    icon: Gauge,
    title: 'Dashboard che nessuno legge ogni giorno',
    text: 'Gli agenti controllano le metriche quando il team non e dentro il tool e portano in evidenza solo cio che cambia davvero.',
  },
  {
    icon: RefreshCcw,
    title: 'Numeri che cambiano senza spiegazione',
    text: 'Ogni alert deve includere baseline, segmento, ipotesi e prossima verifica. Non basta dire che una metrica e salita o scesa.',
  },
  {
    icon: MessageSquareText,
    title: 'Decisioni lente tra marketing, prodotto e finance',
    text: 'Il sistema prepara brief leggibili per chi decide: cosa e successo, perche potrebbe contare, cosa controllare prima di agire.',
  },
];

const agentTypes = [
  {
    icon: LineChart,
    title: 'KPI analyst agent',
    text: 'Monitora revenue, funnel, retention, CAC, LTV, margine e metriche operative. Segnala variazioni, segmenti anomali e possibili driver.',
  },
  {
    icon: DatabaseZap,
    title: 'Data quality agent',
    text: 'Controlla freshness, null, duplicati, join fragili, cambi schema e rotture di tracking prima che entrino nei report decisionali.',
  },
  {
    icon: BellRing,
    title: 'Daily brief agent',
    text: 'Prepara ogni mattina un riepilogo breve con numeri chiave, rischi, opportunita e domande da portare allo standup.',
  },
  {
    icon: Bot,
    title: 'Decision support agent',
    text: 'Risponde su metriche e documentazione aziendale con citazioni interne, limiti dichiarati e passaggi che richiedono approvazione umana.',
  },
];

const deliverySteps = [
  {
    title: 'Mappa dei dati e delle decisioni',
    text: 'Identifichiamo fonti, owner, KPI, definizioni, dashboard esistenti e decisioni che oggi arrivano troppo tardi.',
  },
  {
    title: 'Semantic layer e regole di fiducia',
    text: "Definiamo metriche, grain, filtri, finestre temporali, esclusioni e casi in cui l'agente deve fermarsi.",
  },
  {
    title: 'Agente con tool, eval e approval',
    text: 'Costruiamo workflow con modelli aggiornabili, strumenti controllati, test di qualita, logging e human review.',
  },
  {
    title: 'Monitoraggio 24/7 e miglioramento',
    text: "L'agente studia i numeri in modo continuo, ma ogni raccomandazione importante resta tracciabile e approvabile.",
  },
];

const safeguards = [
  'Accesso ai dati limitato per ruolo e fonte',
  'Nessuna azione rischiosa senza approval',
  'Metriche definite prima dei prompt',
  'Log, eval e test su esempi reali',
  'Fallback manuale quando la confidenza e bassa',
  'Cost control e monitoraggio degli errori',
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={['agenti ai', 'analisi dati aziendali', 'data analytics agent', 'automazione analytics', 'agentic ai']}
  image={heroImage}
>
  <Navbar client:only="react" />

  <main id="main-content" class="bg-[var(--sl-color-bg)] text-white">
    <script type="application/ld+json" set:html={serviceJsonLd} is:inline />

    <section class="relative isolate min-h-[88vh] overflow-hidden pt-24 pb-20" aria-labelledby="agents-hero-title">
      <img
        src={heroImage}
        alt="Dashboard operativa con agente AI che monitora KPI, qualita dati e brief giornalieri"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(8,9,13,0.94),rgba(8,9,13,0.72)_48%,rgba(8,9,13,0.42))]"></div>
      <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-[var(--sl-color-bg)] to-transparent"></div>

      <div class="container mx-auto flex min-h-[70vh] items-center px-6">
        <div class="max-w-3xl">
          <div class="mb-6 inline-flex items-center gap-3 border border-white/15 bg-black/25 px-4 py-2 text-xs font-semibold uppercase text-accent backdrop-blur">
            <Clock3 className="h-4 w-4" />
            agenti dati operativi 24/7
          </div>
          <h1 id="agents-hero-title" class="max-w-3xl font-heading text-4xl font-bold leading-[1.05] text-white md:text-6xl">
            Agenti AI che leggono i numeri della tua azienda ogni giorno
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-200 md:text-xl">
            Progettiamo agenti collegati a warehouse, dashboard e documenti aziendali:
            monitorano KPI, trovano anomalie, preparano suggerimenti e portano al team le domande giuste prima della riunione.
          </p>
          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-4 font-bold text-black transition hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-black"
            >
              Prenota una call
              <ArrowRight className="h-5 w-5" />
            </a>
            <a
              href="#metodo"
              class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-white/5 px-6 py-4 font-semibold text-white transition hover:border-accent/60 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black"
            >
              Vedi il metodo
            </a>
          </div>
          <dl class="mt-12 grid max-w-2xl grid-cols-3 gap-5 border-y border-white/12 py-5">
            <div>
              <dt class="text-xs uppercase text-slate-400">Scope</dt>
              <dd class="mt-1 font-semibold text-white">KPI, quality, brief</dd>
            </div>
            <div>
              <dt class="text-xs uppercase text-slate-400">Controllo</dt>
              <dd class="mt-1 font-semibold text-white">Human approval</dd>
            </div>
            <div>
              <dt class="text-xs uppercase text-slate-400">Output</dt>
              <dd class="mt-1 font-semibold text-white">Decision memo</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#0b0f14] py-16">
      <div class="container mx-auto px-6">
        <div class="grid gap-5 md:grid-cols-3">
          {painPoints.map((item) => {
            const Icon = item.icon;
            return (
              <article class="rounded-lg border border-white/10 bg-white/[0.04] p-6">
                <Icon className="mb-5 h-7 w-7 text-accent" />
                <h2 class="font-heading text-xl font-bold text-white">{item.title}</h2>
                <p class="mt-4 leading-7 text-slate-300">{item.text}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="py-24">
      <div class="container mx-auto px-6">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold uppercase text-accent">cosa costruiamo</p>
          <h2 class="mt-3 font-heading text-3xl font-bold text-white md:text-5xl">
            Non un chatbot generico. Un sistema di lavoro sui dati.
          </h2>
          <p class="mt-6 text-lg leading-8 text-slate-300">
            Ogni agente ha un compito, fonti consentite, metriche definite, limiti chiari e output revisionabili.
            L'obiettivo non e automatizzare opinioni, ma ridurre il tempo tra segnale, controllo e decisione.
          </p>
        </div>

        <div class="mt-14 grid gap-5 md:grid-cols-2">
          {agentTypes.map((item) => {
            const Icon = item.icon;
            return (
              <article class="rounded-lg border border-white/10 bg-white/[0.035] p-7">
                <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-lg bg-accent/12 text-accent">
                  <Icon className="h-6 w-6" />
                </div>
                <h3 class="font-heading text-2xl font-bold text-white">{item.title}</h3>
                <p class="mt-4 leading-7 text-slate-300">{item.text}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section id="metodo" class="bg-[#10151c] py-24">
      <div class="container mx-auto px-6">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase text-accent">metodo di delivery</p>
            <h2 class="mt-3 font-heading text-3xl font-bold text-white md:text-5xl">
              Dal primo audit al primo agente utile in produzione controllata.
            </h2>
            <p class="mt-6 text-lg leading-8 text-slate-300">
              Il servizio parte dai processi decisionali dell'azienda, non dal modello. Prima definiamo
              cosa vale come evidenza, poi scegliamo strumenti e automazioni.
            </p>
          </div>

          <div class="space-y-4">
            {deliverySteps.map((step, index) => (
              <article class="rounded-lg border border-white/10 bg-white/[0.04] p-6">
                <div class="flex gap-5">
                  <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 font-bold text-accent">
                    {index + 1}
                  </div>
                  <div>
                    <h3 class="font-heading text-xl font-bold text-white">{step.title}</h3>
                    <p class="mt-3 leading-7 text-slate-300">{step.text}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-24">
      <div class="container mx-auto px-6">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
          <div>
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-lg bg-cyan-400/12 text-cyan-300">
              <Workflow className="h-7 w-7" />
            </div>
            <h2 class="font-heading text-3xl font-bold text-white md:text-5xl">
              Ultimi modelli, ma sempre con governance.
            </h2>
            <p class="mt-6 text-lg leading-8 text-slate-300">
              Il sistema puo usare modelli aggiornati e scegliere il modello piu adatto al compito:
              ragionamento, classificazione, sintesi, SQL, estrazione o alerting. Ma ogni passaggio critico
              resta misurabile: eval, log, costi, fonti e approvazioni.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {safeguards.map((item) => (
              <div class="flex gap-3 rounded-lg border border-white/10 bg-white/[0.035] p-5">
                <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0 text-accent" />
                <p class="text-sm leading-6 text-slate-200">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-[#0b0f14] py-20">
      <div class="container mx-auto px-6">
        <div class="grid gap-5 md:grid-cols-3">
          <article class="rounded-lg border border-white/10 bg-white/[0.04] p-7">
            <ShieldCheck className="mb-5 h-7 w-7 text-accent" />
            <h3 class="font-heading text-xl font-bold text-white">Sicurezza e limiti</h3>
            <p class="mt-4 leading-7 text-slate-300">
              L'agente non deve vedere tutto e non deve fare tutto. Definiamo policy, permessi, dati vietati e azioni bloccate.
            </p>
          </article>
          <article class="rounded-lg border border-white/10 bg-white/[0.04] p-7">
            <LockKeyhole className="mb-5 h-7 w-7 text-cyan-300" />
            <h3 class="font-heading text-xl font-bold text-white">Fonti tracciabili</h3>
            <p class="mt-4 leading-7 text-slate-300">
              Ogni risposta importante deve indicare da quali dati nasce e quale controllo serve prima di agire.
            </p>
          </article>
          <article class="rounded-lg border border-white/10 bg-white/[0.04] p-7">
            <Clock3 className="mb-5 h-7 w-7 text-amber-300" />
            <h3 class="font-heading text-xl font-bold text-white">Operativita continua</h3>
            <p class="mt-4 leading-7 text-slate-300">
              Il valore arriva quando l'agente lavora anche fuori dagli orari di meeting e prepara contesto per chi decide.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="py-24">
      <div class="container mx-auto px-6">
        <div class="mx-auto max-w-4xl rounded-lg border border-accent/25 bg-accent/[0.07] p-8 text-center md:p-12">
          <p class="text-sm font-semibold uppercase text-accent">prima call</p>
          <h2 class="mt-3 font-heading text-3xl font-bold text-white md:text-5xl">
            Porta una dashboard, un problema ricorrente o una metrica che non ti fidi a delegare.
          </h2>
          <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            In 15 minuti capiamo se ha senso partire da KPI monitoring, data quality, daily brief o agentic analytics operations.
          </p>
          <a
            href={BOOKING_URL}
            target="_blank"
            rel="noreferrer"
            class="mt-9 inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-7 py-4 font-bold text-black transition hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-black"
          >
            Prenota una call
            <ArrowRight className="h-5 w-5" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
