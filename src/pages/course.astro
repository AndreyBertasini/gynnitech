---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { BookOpen, BarChart, Users, Check, Lock } from 'lucide-react';

---

<Layout title="Corso Analisi Dati - GYNNITECH">
  <Navbar client:load />
  
  <main class="pt-32 pb-20">
    <div class="container mx-auto px-6">
      
      {/* Header Corso */}
      <div class="text-center max-w-4xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mint-500/10 border border-mint-500/20 text-mint-400 text-sm font-medium mb-6">
          Corso Analisi Dati
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
          Analisi Dati per <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-mint-300 to-mint-500">Marketing Manager</span>
        </h1>
        <p class="text-xl text-slate-400 mb-10 leading-relaxed">
          Un manuale non noioso su come creare prodotti eccellenti e gestire il marketing in modo efficace basandosi sui dati.
        </p>
      </div>

      {/* Per chi è questo corso */}
      <div class="grid md:grid-cols-3 gap-8 mb-20">
        <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h3 class="text-xl font-bold text-white mb-3">Data-Driven Mgmt</h3>
            <ul class="space-y-2 text-slate-400 text-sm">
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> HADI Cycles</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> JTBD Framework</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> UX Research</li>
            </ul>
        </div>
        <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h3 class="text-xl font-bold text-white mb-3">Product Analytics</h3>
            <ul class="space-y-2 text-slate-400 text-sm">
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Product Market Fit</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Retention & Cohorts</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> A/B Testing</li>
            </ul>
        </div>
        <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h3 class="text-xl font-bold text-white mb-3">Marketing Analytics</h3>
            <ul class="space-y-2 text-slate-400 text-sm">
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Funnel & Unit Econ</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Brand Health</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Dashboards</li>
            </ul>
        </div>
      </div>

      {/* CTA Principale */}
      <div class="max-w-2xl mx-auto text-center mt-12">
        <a href="/docs/corso/getting-started/introduction/" class="inline-flex items-center gap-2 bg-mint-500 hover:bg-mint-400 text-white px-8 py-4 rounded-full text-lg font-bold transition-all shadow-[0_0_20px_rgba(61,177,134,0.3)] hover:shadow-[0_0_30px_rgba(61,177,134,0.5)] hover:-translate-y-1">
          <BookOpen className="w-5 h-5" />
          Inizia il Corso
        </a>
        <p class="text-slate-500 text-sm mt-4">
          Accesso gratuito alla documentazione completa.
        </p>
      </div>

    </div>
  </main>
  
  <Footer />
</Layout>
