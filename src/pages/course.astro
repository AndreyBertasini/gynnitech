---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { COURSE_CAPSTONE, COURSE_MODULES, COURSE_TRACKS } from '../data/course-modules';
import { CourseCard } from '../components/ui/CourseCard';
import { SITE_URL, SITE_NAME } from '../consts';
import { serializeJsonLd } from '../utils/jsonld';
import { getModuleCoverAlt, getModuleCoverImage } from '../lib/module-covers';
import { ArrowRight, Route, Trophy } from 'lucide-react';

const courseDocs = await getCollection('corso');
const coreCourseDocs = courseDocs.filter((doc) => doc.id.includes('/') && typeof doc.data.order === 'number');
const totalLessons = coreCourseDocs.length;
const courseDescription = `Corso gratuito di Marketing Data e Analytics Engineering: ${COURSE_MODULES.length} moduli e ${totalLessons} lezioni core per imparare tracking, KPI, dashboard, esperimenti e decisioni basate sui dati.`;

const lessonCounts = new Map<string, number>();
for (const doc of coreCourseDocs) {
  const moduleId = doc.id.split('/')[0];
  lessonCounts.set(moduleId, (lessonCounts.get(moduleId) || 0) + 1);
}

const trackCards = COURSE_TRACKS.map((track) => ({
  ...track,
  totalLessons: track.moduleIds.reduce((sum, moduleId) => sum + (lessonCounts.get(moduleId) || 0), 0),
  firstModuleHref: `/course/${track.moduleIds[0]}/`,
}));
---

<Layout
  title="Corso MarTech e Analytics Engineering | GinnyTech"
  description={courseDescription}
  keywords={['martech', 'analytics engineering', 'ab testing', 'significativita statistica', 'data engineering', 'sql', 'python', 'kafka', 'clickhouse']}
>
  <div class="min-h-screen flex flex-col">
    <Navbar client:only="react" />

    <main id="main-content" class="relative flex-1 bg-[var(--sl-color-bg)] overflow-hidden selection:bg-accent/30 selection:text-white">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Marketing Data, Analytics Engineering e Sperimentazione Statistica",
      "description": courseDescription,
      "provider": {
        "@type": "Organization",
        "name": SITE_NAME,
        "url": SITE_URL
      },
      "isAccessibleForFree": true,
      "inLanguage": "it"
    })} is:inline />
    
    {/* Background Effects */}
    <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-accent/10 to-transparent pointer-events-none"></div>
    <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-accent/5 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[600px] h-[600px] bg-accent/5 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="container mx-auto px-6 pt-32 pb-20 relative z-10">
      
      {/* Header Corso */}
      <div class="text-center max-w-4xl mx-auto mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-accent text-xs font-mono font-medium tracking-wider mb-8 backdrop-blur-sm animate-fade-in-up">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          PERCORSO COMPLETO 2026
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-8 tracking-tight leading-tight animate-fade-in-up [animation-delay:100ms] font-heading">
          Marketing Data & <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] via-[#ffffff] to-[var(--color-accent)] drop-shadow-[0_0_10px_rgba(204,255,0,0.5)] font-heading">
            Analytics Engineering
          </span>
        </h1>
        
        <p class="text-xl text-slate-400 mb-12 leading-relaxed max-w-2xl mx-auto animate-fade-in-up [animation-delay:200ms] font-sans">
          Un percorso pratico da {totalLessons} lezioni core in {COURSE_MODULES.length} moduli:
          parti dal tracking, costruisci metriche e dashboard, poi arrivi a esperimenti, causalità e stack dati moderni.
        </p>

        <div class="flex flex-wrap justify-center gap-4 animate-fade-in-up [animation-delay:300ms]">
           <div class="flex items-center gap-2 text-sm text-slate-300 bg-white/5 px-4 py-2 rounded-lg border border-white/5 font-ui">
              <span class="w-1.5 h-1.5 rounded-full bg-accent"></span> {COURSE_MODULES.length} moduli
           </div>
           <div class="flex items-center gap-2 text-sm text-slate-300 bg-white/5 px-4 py-2 rounded-lg border border-white/5 font-ui">
              <span class="w-1.5 h-1.5 rounded-full bg-accent"></span> {totalLessons} lezioni core
           </div>
        </div>
      </div>

      {/* Course Grid */}
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-24">
        {COURSE_MODULES.map((module, index) => {
            const lessonCount = lessonCounts.get(module.id) || 0;
            const coverImage = getModuleCoverImage(module.id);
            
            return (
                <CourseCard 
                    id={module.id}
                    title={module.title}
                    description={module.description}
                    icon={module.icon}
                    color={module.color}
                    lessonCount={lessonCount}
                    index={index}
                    imageSrc={coverImage?.src}
                    imageAlt={getModuleCoverAlt(module.title)}
                />
            );
        })}
      </div>

      <section class="mb-10">
        <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">
              <Route className="h-4 w-4" />
              Track finali
            </p>
            <h2 class="mt-3 text-3xl font-semibold text-white">Tre track per arrivare al progetto finale</h2>
          </div>
          <a href="/course/learning-path" class="inline-flex items-center gap-2 text-sm font-medium text-accent transition hover:text-accent/80">
            Apri learning path
            <ArrowRight className="h-4 w-4" />
          </a>
        </div>

        <div class="grid gap-5 lg:grid-cols-3">
          {trackCards.map((track) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
              <p class="text-[11px] uppercase tracking-[0.22em] text-slate-500">Track</p>
              <h3 class="mt-2 text-2xl font-semibold text-white">{track.title}</h3>
              <p class="mt-4 text-sm leading-7 text-slate-400">{track.summary}</p>
              <ul class="mt-5 space-y-3">
                {track.outcomes.slice(0, 2).map((outcome) => (
                  <li class="text-sm leading-6 text-slate-300">{outcome}</li>
                ))}
              </ul>
              <div class="mt-6 flex items-center justify-between text-sm text-slate-400">
                <span>{track.moduleIds.length} moduli</span>
                <span>{track.totalLessons} lezioni</span>
              </div>
              <a href={track.firstModuleHref} class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-accent transition hover:text-accent/80">
                Primo modulo
                <ArrowRight className="h-4 w-4" />
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="rounded-2xl border border-accent/20 bg-accent/10 p-6 md:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-3xl">
            <p class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">
              <Trophy className="h-4 w-4" />
              Capstone
            </p>
            <h2 class="mt-3 text-3xl font-semibold text-white">{COURSE_CAPSTONE.title}</h2>
            <p class="mt-4 text-sm leading-7 text-slate-300">{COURSE_CAPSTONE.summary}</p>
          </div>
          <a href="/course/learning-path" class="inline-flex items-center justify-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-5 py-3 text-sm font-semibold text-accent transition hover:border-accent/50 hover:bg-accent/15">
            Vedi milestone e mappa
            <ArrowRight className="h-4 w-4" />
          </a>
        </div>
      </section>

    </div>
    </main>

    <Footer />
  </div>
</Layout>
