---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { BookOpen, BarChart, Users, Check, Lock } from 'lucide-react';

---

<Layout title="Corso - GYNNITECH">
  <Navbar client:load />
  
  <main class="pt-32 pb-20">
    <div class="container mx-auto px-6">
      
      {/* Header Corso */}
      <div class="text-center max-w-4xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mint-500/10 border border-mint-500/20 text-mint-400 text-sm font-medium mb-6">
          Corso Online
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
          Analisi Dati per <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-mint-300 to-mint-500">Marketing Manager</span>
        </h1>
        <p class="text-xl text-slate-400 mb-10 leading-relaxed">
          Un manuale non noioso su come creare prodotti eccellenti e gestire il marketing in modo efficace basandosi sui dati.
        </p>
      </div>

      {/* Per chi è questo corso */}
      <div class="grid md:grid-cols-3 gap-8 mb-20">
        <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h3 class="text-xl font-bold text-white mb-3">Data-Driven Mgmt</h3>
            <ul class="space-y-2 text-slate-400 text-sm">
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> HADI Cycles</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> JTBD Framework</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> UX Research</li>
            </ul>
        </div>
        <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h3 class="text-xl font-bold text-white mb-3">Product Analytics</h3>
            <ul class="space-y-2 text-slate-400 text-sm">
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Product Market Fit</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Retention & Cohorts</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> A/B Testing</li>
            </ul>
        </div>
        <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h3 class="text-xl font-bold text-white mb-3">Marketing Analytics</h3>
            <ul class="space-y-2 text-slate-400 text-sm">
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Funnel & Unit Econ</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Brand Health</li>
                <li class="flex gap-2"><Check class="w-4 h-4 text-mint-500" /> Dashboards</li>
            </ul>
        </div>
      </div>

      {/* Pricing */}
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-8 items-start">
        {/* Free Tier */}
        <div class="bg-brand-darker border border-white/10 p-8 rounded-2xl">
            <h3 class="text-2xl font-bold text-white mb-2">Accesso Limitato</h3>
            <div class="text-3xl font-bold text-mint-400 mb-6">Gratis</div>
            <p class="text-slate-400 text-sm mb-8">Accesso trial a una parte dei contenuti per valutare il corso.</p>
            <a href="/docs/corso/1-introduzione/" class="block w-full py-3 px-4 rounded-lg border border-white/20 text-white text-center hover:bg-white/5 transition-colors font-semibold">Inizia Gratis</a>
        </div>

        {/* Full Tier - Featured */}
        <div class="bg-mint-900/20 border border-mint-500/50 p-8 rounded-2xl relative transform md:-translate-y-4 shadow-2xl shadow-mint-500/10">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-mint-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide">Consigliato</div>
            <h3 class="text-2xl font-bold text-white mb-2">Accesso Completo</h3>
            <div class="text-3xl font-bold text-mint-400 mb-6">€ 950</div>
            <p class="text-slate-300 text-sm mb-8">Tutti i contenuti, template scaricabili, esercizi pratici e aggiornamenti.</p>
            <ul class="space-y-3 mb-8 text-sm text-slate-300">
                <li class="flex gap-2"><Check class="w-5 h-5 text-mint-500" /> Accesso illimitato</li>
                <li class="flex gap-2"><Check class="w-5 h-5 text-mint-500" /> Template Excel/Python</li>
                <li class="flex gap-2"><Check class="w-5 h-5 text-mint-500" /> Certificato finale</li>
            </ul>
            <a href="#" class="block w-full py-3 px-4 rounded-lg bg-mint-500 text-white text-center hover:bg-mint-400 transition-colors font-bold shadow-lg shadow-mint-500/20">Acquista Ora</a>
        </div>

        {/* Mentorship Tier */}
        <div class="bg-brand-darker border border-white/10 p-8 rounded-2xl">
            <h3 class="text-2xl font-bold text-white mb-2">Mentorship</h3>
            <div class="text-3xl font-bold text-mint-400 mb-6">€ 9.000</div>
            <p class="text-slate-400 text-sm mb-8">Accesso completo + 8 sessioni individuali di consulenza/mentorship.</p>
            <a href="mailto:info@gynnitech.it" class="block w-full py-3 px-4 rounded-lg border border-white/20 text-white text-center hover:bg-white/5 transition-colors font-semibold">Contattaci</a>
        </div>
      </div>

    </div>
  </main>
  
  <Footer />
</Layout>
