---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { COURSE_MODULES } from '../data/course-modules';
import { getCollection } from 'astro:content';
import { BookOpen, Activity, Database, GitMerge, Zap, BrainCircuit, Server, FlaskConical, BarChart, HardDrive, Radio, LayoutDashboard } from 'lucide-react';
import { CourseCard } from '../components/ui/CourseCard';
import { SITE_URL, SITE_NAME } from '../consts';
import { serializeJsonLd } from '../utils/security';

const courseDocs = await getCollection('corso');

// Helper to get lesson count per module
const getLessonCount = (moduleId: string) => {
  return courseDocs.filter(doc => doc.id.startsWith(`${moduleId}/`)).length;
};

// Map icon string to component
const IconMap = {
  Activity, Database, GitMerge, Zap, BrainCircuit, Server, FlaskConical, BarChart, HardDrive, Radio, LayoutDashboard
};
---

<Layout title="Corsi - GinnyTech" description="Corso completo di Marketing Data & Analytics Engineering. 12 moduli, +90 lezioni pratiche. Dalla raccolta dati all'analisi predittiva con SQL, Python, ClickHouse, Kafka e S3.">
  <Navbar client:load />
  
  <main id="main-content" class="relative min-h-screen bg-[#050505] overflow-hidden selection:bg-neon-mint/30 selection:text-white">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Marketing Data & Analytics Engineering",
      "description": "Corso completo di Marketing Data & Analytics Engineering. 12 moduli, +90 lezioni pratiche.",
      "provider": {
        "@type": "Organization",
        "name": SITE_NAME,
        "url": SITE_URL
      },
      "isAccessibleForFree": true,
      "inLanguage": "it"
    })} />
    
    {/* Background Effects */}
    <div class="absolute top-0 left-0 w-full h-[50vh] bg-gradient-to-b from-mint-900/10 to-transparent pointer-events-none"></div>
    <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-neon-blue/5 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[600px] h-[600px] bg-neon-purple/5 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="container mx-auto px-6 pt-32 pb-20 relative z-10">
      
      {/* Header Corso */}
      <div class="text-center max-w-4xl mx-auto mb-20">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-neon-mint text-xs font-mono font-medium tracking-wider mb-8 backdrop-blur-sm animate-fade-in-up">
          <span class="w-2 h-2 rounded-full bg-neon-mint animate-pulse"></span>
          PERCORSO COMPLETO 2026
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-8 tracking-tight leading-tight animate-fade-in-up [animation-delay:100ms] font-heading">
          Marketing Data & <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00ffa3] via-[#ffffff] to-[#00f3ff] drop-shadow-[0_0_10px_rgba(0,255,163,0.5)] font-heading">
            Analytics Engineering
          </span>
        </h1>
        
        <p class="text-xl text-slate-400 mb-12 leading-relaxed max-w-2xl mx-auto animate-fade-in-up [animation-delay:200ms] font-sans">
          Masterizza l'intersezione tra Marketing e Hard Engineering. 
          Dalla raccolta dati all'analisi predittiva con stack moderni.
        </p>

        <div class="flex flex-wrap justify-center gap-4 animate-fade-in-up [animation-delay:300ms]">
           <div class="flex items-center gap-2 text-sm text-slate-500 bg-white/5 px-4 py-2 rounded-lg border border-white/5 font-ui">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> 12 Moduli
           </div>
           <div class="flex items-center gap-2 text-sm text-slate-500 bg-white/5 px-4 py-2 rounded-lg border border-white/5 font-ui">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> +90 Lezioni
           </div>
           <div class="flex items-center gap-2 text-sm text-slate-500 bg-white/5 px-4 py-2 rounded-lg border border-white/5 font-ui">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span> Progetti Reali
           </div>
        </div>
      </div>

      {/* Course Grid */}
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-24">
        {COURSE_MODULES.map((module, index) => {
            const Icon = IconMap[module.icon as keyof typeof IconMap] || BookOpen;
            const lessonCount = getLessonCount(module.id);
            
            return (
                <CourseCard 
                    id={module.id}
                    title={module.title}
                    description={module.description}
                    icon={Icon}
                    color={module.color}
                    lessonCount={lessonCount}
                    index={index}
                />
            );
        })}
      </div>

    </div>
  </main>
  
  <Footer />
</Layout>
