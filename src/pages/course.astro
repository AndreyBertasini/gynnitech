---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import Footer from '../components/Footer.astro';
import { BookOpen, Check } from 'lucide-react';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');

// Filter only course content
const courseDocs = docs.filter(doc => doc.id.startsWith('docs/corso/'));

// Define section titles mapping
const SECTION_TITLES: Record<string, string> = {
  'data-collection': 'Data Collection & Tracking',
  'data-warehousing': 'Data Warehousing & Architecture',
  'analytics-engineering': 'Analytics Engineering',
  'real-time-analytics': 'Real-Time Analytics & Streaming',
  'data-science': 'Marketing Data Science & Python',
  'infrastructure-ops': 'Infrastructure & Ops'
};

// Define section order
const SECTION_ORDER = [
  'data-collection',
  'data-warehousing',
  'analytics-engineering',
  'real-time-analytics',
  'data-science',
  'infrastructure-ops'
];

// Group by folder
const sections = courseDocs.reduce((acc, doc) => {
  const parts = doc.id.split('/');
  // Expected structure: docs/corso/[section]/[slug]
  if (parts.length < 4) return acc;
  
  const sectionKey = parts[2];
  
  if (!acc[sectionKey]) {
    acc[sectionKey] = [];
  }
  
  acc[sectionKey].push(doc);
  return acc;
}, {} as Record<string, typeof courseDocs>);

// Sort docs within sections by order
Object.keys(sections).forEach(key => {
  sections[key].sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
});
---

<Layout title="Corso Analisi Dati - GYNNITECH">
  <Navbar client:load />
  
  <main class="pt-32 pb-20 min-h-screen">
    <div class="container mx-auto px-6">
      
      {/* Header Corso */}
      <div class="text-center max-w-4xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mint-500/10 border border-mint-500/20 text-mint-400 text-sm font-medium mb-6">
          Corso Analisi Dati
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
          Marketing Data & <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-mint-300 to-mint-500">Analytics Engineering</span>
        </h1>
        <p class="text-xl text-slate-400 mb-10 leading-relaxed">
          Dal tracciamento degli eventi all'infrastruttura real-time. Un percorso completo per profili Senior.
        </p>
      </div>

      {/* Dynamic Course Sections */}
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
        {SECTION_ORDER.map(sectionKey => {
            const sectionDocs = sections[sectionKey];
            if (!sectionDocs || sectionDocs.length === 0) return null;

            return (
                <div class="bg-white/5 border border-white/10 p-6 rounded-2xl hover:bg-white/10 transition-colors group flex flex-col">
                    <h3 class="text-xl font-bold text-white mb-4 group-hover:text-mint-400 transition-colors">
                        {SECTION_TITLES[sectionKey] || sectionKey}
                    </h3>
                    <ul class="space-y-3 text-slate-400 text-sm flex-grow">
                        {sectionDocs.map(doc => (
                            <li class="flex gap-2 items-start">
                                <Check class="w-4 h-4 text-mint-500 mt-0.5 shrink-0" /> 
                                <a href={`/corso/${doc.id.replace(/\.[^/.]+$/, "")}/`} class="hover:text-white transition-colors leading-tight">
                                    {doc.data.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                    <div class="mt-6 pt-4 border-t border-white/5">
                        <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold">
                            {sectionDocs.length} Lezioni
                        </span>
                    </div>
                </div>
            );
        })}
      </div>

      {/* CTA Principale */}
      <div class="max-w-2xl mx-auto text-center mt-12">
        <a href="/docs/corso/data-collection/event-tracking/" class="inline-flex items-center gap-2 bg-mint-500 hover:bg-mint-400 text-white px-8 py-4 rounded-full text-lg font-bold transition-all shadow-[0_0_20px_rgba(61,177,134,0.3)] hover:shadow-[0_0_30px_rgba(61,177,134,0.5)] hover:-translate-y-1">
          <BookOpen className="w-5 h-5" />
          Inizia il Corso
        </a>
        <p class="text-slate-500 text-sm mt-4">
          Accesso gratuito alla documentazione completa.
        </p>
      </div>

    </div>
  </main>
  
  <Footer />
</Layout>
