---
import fs from 'node:fs/promises';
import path from 'node:path';
import matter from 'gray-matter';
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/Navbar';
import Footer from '../../../components/Footer.astro';
import { COURSE_MODULES } from '../../../data/course-modules';
import { getCollection, type CollectionEntry } from 'astro:content';
import { ArrowLeft } from 'lucide-react';
import { LessonCard } from '../../../components/ui/LessonCard';
import { SITE_NAME, SITE_URL } from '../../../consts';
import { serializeJsonLd } from '../../../utils/jsonld';
import { getModuleCoverAlt, getModuleCoverImage } from '../../../lib/module-covers';
import { ProgressBar } from '../../../components/ProgressTracker';
import { buildCourseGraph } from '../../../lib/course-graph';
import { buildModuleCrossLinks, type ModuleCrossLink } from '../../../lib/course-cross-links';

interface LessonThumbnail {
  src: string;
  width?: number;
  height?: number;
}

const resolveLessonThumbnail = (rawValue?: string): LessonThumbnail | undefined => {
  const value = rawValue?.trim();
  if (!value) {
    return undefined;
  }

  if (value.startsWith('/') || /^https?:\/\//.test(value)) {
    return { src: value };
  }

  return undefined;
};

export async function getStaticPaths() {
  const allLessons = await getCollection('corso');
  const COURSE_CONTENT_ROOT = path.join(process.cwd(), 'src/content/corso');
  const courseGraph = buildCourseGraph(allLessons);

  const fallbackDifficulty = (moduleIndex: number): string => {
    if (moduleIndex < 5) return 'Base';
    if (moduleIndex < 10) return 'Intermedio';
    return 'Avanzato';
  };

  const normalizeDifficulty = (rawValue: unknown, fallback: string): string => {
    if (typeof rawValue !== 'string' || rawValue.trim() === '') {
      return fallback;
    }

    const value = rawValue.trim().toLowerCase();
    if (value === 'beginner' || value === 'base') return 'Base';
    if (value === 'intermediate' || value === 'intermedio') return 'Intermedio';
    if (value === 'advanced' || value === 'avanzato') return 'Avanzato';
    return fallback;
  };

  const countPrerequisites = (rawPrerequisites: unknown): number => {
    if (!Array.isArray(rawPrerequisites)) return 0;
    return rawPrerequisites.filter((item) => typeof item === 'string' && item.trim() !== '').length;
  };

  const estimateDurationLabel = async (lessonId: string, explicitDuration: unknown): Promise<string | undefined> => {
    if (typeof explicitDuration === 'string' && explicitDuration.trim() !== '') {
      return explicitDuration.trim();
    }

    try {
      const lessonPath = path.join(COURSE_CONTENT_ROOT, lessonId);
      const raw = await fs.readFile(lessonPath, 'utf-8');
      const { content } = matter(raw);
      const words = content.trim().split(/\s+/).filter(Boolean).length;
      const minutes = Math.max(8, Math.round(words / 180));
      return `${minutes} min`;
    } catch {
      return undefined;
    }
  };

  const lessonsByModule = new Map<string, CollectionEntry<'corso'>[]>();
  for (const lesson of allLessons) {
    const moduleId = lesson.id.split('/')[0];
    if (!lessonsByModule.has(moduleId)) {
      lessonsByModule.set(moduleId, []);
    }
    lessonsByModule.get(moduleId)?.push(lesson);
  }

  return Promise.all(
    COURSE_MODULES.map(async (module, moduleIndex) => {
      const moduleLessonsRaw = (lessonsByModule.get(module.id) || []).filter(
        (lesson) => typeof lesson.data.order === 'number',
      );
      moduleLessonsRaw.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

      const moduleLessons = await Promise.all(
        moduleLessonsRaw.map(async (lesson) => {
          const lessonData = lesson.data as Record<string, unknown>;
          const difficultyFallback = fallbackDifficulty(moduleIndex);

          return {
            id: lesson.id,
            data: {
              title: lesson.data.title,
              description: lesson.data.description,
              order: lesson.data.order,
              duration: await estimateDurationLabel(lesson.id, lessonData.duration),
              difficulty: normalizeDifficulty(lessonData.difficulty, difficultyFallback),
              prerequisitesCount: countPrerequisites(lessonData.prerequisites),
              headerImage: typeof lessonData.headerImage === 'string' ? lessonData.headerImage : undefined,
              headerImageAlt: typeof lessonData.headerImageAlt === 'string' ? lessonData.headerImageAlt : undefined,
            },
          };
        }),
      );

      return {
        params: { module: module.id },
        props: {
          moduleData: module,
          moduleLessons,
          relatedModules: buildModuleCrossLinks(courseGraph, module.id, { maxLinks: 6 }),
        },
      };
    }),
  );
}

const { moduleData, moduleLessons, relatedModules } = Astro.props;

interface LessonInfo {
  id: string;
  data: {
    title: string;
    description: string;
    order?: number;
    duration?: string;
    difficulty: string;
    prerequisitesCount: number;
    headerImage?: string;
    headerImageAlt?: string;
  }
}

interface RelatedModuleInfo extends ModuleCrossLink {}

const orderedLessons = [...moduleLessons].sort(
  (a: LessonInfo, b: LessonInfo) => (a.data.order || 99) - (b.data.order || 99),
);
const lessonCountLabel = `${moduleLessons.length} ${moduleLessons.length === 1 ? 'lezione' : 'lezioni'}`;
const moduleSeoTitle = moduleData.seoTitle || `${moduleData.title} | ${lessonCountLabel} | ${SITE_NAME}`;
const moduleSeoDescription =
  moduleData.seoDescription ||
  `${moduleData.description} Modulo con ${lessonCountLabel} pratiche del corso GinnyTech, con esempi, casi studio e percorso guidato.`;
const moduleSeoKeywords = Array.from(
  new Set(
    moduleData.seoKeywords || [
      'martech',
      'analytics',
      'data engineering',
      'corso ginnytech',
      moduleData.title.toLowerCase(),
      moduleData.id.replace(/-/g, ' '),
    ],
  ),
);
const moduleUrl = `${SITE_URL}/course/${moduleData.id}/`;
const moduleCoverImage = getModuleCoverImage(moduleData.id);
const moduleCoverAlt = getModuleCoverAlt(moduleData.title);
const moduleJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: moduleSeoTitle,
      description: moduleSeoDescription,
      url: moduleUrl,
      inLanguage: 'it-IT',
      keywords: moduleSeoKeywords.join(', '),
      relatedLink: relatedModules.map((module: RelatedModuleInfo) => new URL(module.href, SITE_URL).href),
      isPartOf: {
        '@type': 'Course',
        name: 'Marketing Data, Analytics Engineering e Sperimentazione Statistica',
        url: `${SITE_URL}/course/`,
      },
      mainEntity: {
        '@type': 'ItemList',
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        numberOfItems: orderedLessons.length,
        itemListElement: orderedLessons.map((lesson: LessonInfo, index: number) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: lesson.data.title,
          url: `${SITE_URL}/course/${lesson.id.replace(/\.[^/.]+$/, '')}/`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Corso',
          item: `${SITE_URL}/course/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: moduleData.title,
          item: moduleUrl,
        },
      ],
    },
  ],
});
---

<Layout
  title={moduleSeoTitle}
  description={moduleSeoDescription}
  keywords={moduleSeoKeywords}
  image={moduleCoverImage?.src}
  preloadImage={Boolean(moduleCoverImage?.src)}
>
  <Navbar client:only="react" />

  <main id="main-content" class="min-h-screen bg-[var(--sl-color-bg)] pt-32 pb-20 relative overflow-hidden">
    <script type="application/ld+json" set:html={moduleJsonLd} is:inline />
    {/* Background Glows */}
    <div class={`absolute top-0 right-0 w-[800px] h-[800px] bg-gradient-to-br ${moduleData.color} opacity-[0.03] blur-[150px] pointer-events-none rounded-full translate-x-1/3 -translate-y-1/3`}></div>

    <div class="container mx-auto px-6 relative z-10">
      {/* Breadcrumb */}
      <div class="mb-12">
        <a href="/course" class="inline-flex items-center gap-2 text-slate-500 hover:text-white transition-colors text-sm group">
          <div class="p-1 rounded-md bg-white/5 border border-white/10 group-hover:border-white/20 transition-colors">
            <ArrowLeft className="w-3 h-3" />
          </div>
          Torna ai Corsi
        </a>
      </div>

      {/* Module Header */}
      <div class="max-w-6xl mx-auto mb-24 grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(320px,0.9fr)] lg:items-center">
        <div class="text-center lg:text-left">
          <span class={`inline-block px-4 py-1.5 rounded-full text-xs font-mono font-bold tracking-widest mb-6 border border-white/10 bg-white/5 text-slate-300`}>
            MODULO {COURSE_MODULES.indexOf(moduleData) + 1}
          </span>

          <h1 class="text-4xl md:text-6xl font-bold text-white mb-8 leading-tight">
            {moduleData.title}
          </h1>

          <p class="text-xl text-slate-400 leading-relaxed max-w-2xl lg:max-w-none">
            {moduleData.description}
          </p>
        </div>

        {moduleCoverImage && (
          <figure class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.03] shadow-[0_28px_80px_-42px_rgba(204,255,0,0.45)]">
            <img
              src={moduleCoverImage.src}
              alt={moduleCoverAlt}
              class="h-full w-full object-cover"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <div class={`absolute inset-0 bg-gradient-to-t ${moduleData.color} opacity-15 mix-blend-screen`}></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--sl-color-bg)] via-transparent to-transparent"></div>
          </figure>
        )}
      </div>

      {/* Lessons */}
      <div class="max-w-6xl mx-auto">
        <div class="mb-8">
          <ProgressBar
            moduleId={moduleData.id}
            totalLessons={orderedLessons.length}
            client:only="react"
          />
        </div>

        {orderedLessons.length > 0 ? (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in-up">
            {orderedLessons.map((lesson: LessonInfo, index: number) => (
              <LessonCard
                title={lesson.data.title}
                description={lesson.data.description}
                duration={lesson.data.duration}
                difficulty={lesson.data.difficulty}
                prerequisitesCount={lesson.data.prerequisitesCount}
                index={Math.max(0, (lesson.data.order || index + 1) - 1)}
                href={`/course/${lesson.id.replace(/\.[^/.]+$/, '')}/`}
                imageSrc={resolveLessonThumbnail(lesson.data.headerImage)?.src ?? moduleCoverImage?.src}
                imageAlt={lesson.data.headerImageAlt ?? moduleCoverAlt}
              />
            ))}
          </div>
        ) : (
          <div class="p-20 text-center border border-dashed border-white/10 rounded-2xl bg-white/[0.02]">
            <p class="text-slate-500">Nessuna lezione disponibile al momento.</p>
          </div>
        )}

        {relatedModules.length > 0 && (
          <section class="course-module-crosslinks" aria-labelledby="module-crosslinks-title">
            <div class="course-module-crosslinks-header">
              <p>Collegamenti tra moduli</p>
              <h2 id="module-crosslinks-title">Continua il percorso con questi moduli</h2>
            </div>
            <div class="course-module-crosslinks-grid">
              {relatedModules.map((module: RelatedModuleInfo) => (
                <a href={module.href} class="course-module-crosslink-card">
                  <span>{module.relation}</span>
                  <strong>{module.title}</strong>
                  <small>{module.lessonCount} lezioni</small>
                  <p>{module.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

    </div>
  </main>

  <Footer />
</Layout>
