---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/Navbar';
import Footer from '../../../components/Footer.astro';
import { LessonCard } from '../../../components/ui/LessonCard';
import { COURSE_MODULES } from '../../../data/course-modules';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // Generate a page for each module that has at least one lesson
  const allDocs = await getCollection('docs', (entry) =>
    entry.id.startsWith('course/') && entry.id !== 'course/index'
  );

  // Build a map: moduleId → lessons[]
  const moduleMap = new Map<string, typeof allDocs>();
  for (const doc of allDocs) {
    const parts = doc.id.split('/');
    if (parts.length < 3) continue;
    const moduleId = parts[1];
    if (!moduleMap.has(moduleId)) moduleMap.set(moduleId, []);
    moduleMap.get(moduleId)!.push(doc);
  }

  // Generate paths for all modules defined in COURSE_MODULES
  return COURSE_MODULES.map((mod) => ({
    params: { module: mod.id },
    props: {
      moduleData: mod,
      lessons: (moduleMap.get(mod.id) || []).sort((a, b) => {
        const orderA = (a.data as any).order ?? 999;
        const orderB = (b.data as any).order ?? 999;
        return orderA - orderB;
      }),
    },
  }));
}

const { moduleData, lessons } = Astro.props;
const moduleIndex = COURSE_MODULES.findIndex((m) => m.id === moduleData.id);
---

<Layout
  title={`${moduleData.title} - GinnyTech`}
  description={moduleData.description}
>
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main class="relative flex-1 bg-[#050505] overflow-hidden selection:bg-neon-mint/30 selection:text-white">
      {/* Background */}
      <div class="absolute top-0 left-0 w-full h-[40vh] bg-gradient-to-b from-mint-900/10 to-transparent pointer-events-none"></div>
      <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-neon-blue/5 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="container mx-auto px-6 pt-28 pb-20 relative z-10 max-w-5xl">

        {/* Back link */}
        <a
          href="/course/"
          class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-neon-mint transition-colors mb-10 font-ui"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Torna ai Corsi
        </a>

        {/* Module header */}
        <div class="mb-14">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-400 text-xs font-mono tracking-widest mb-6">
            MODULO {moduleIndex + 1}
          </div>
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 font-heading leading-tight">
            {moduleData.title}
          </h1>
          <p class="text-lg text-slate-400 max-w-2xl font-sans leading-relaxed">
            {moduleData.description}
          </p>
          {lessons.length > 0 && (
            <div class="mt-6 flex items-center gap-2 text-sm text-slate-500 font-ui">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              {lessons.length} {lessons.length === 1 ? 'lezione' : 'lezioni'}
            </div>
          )}
        </div>

        {/* Lessons grid */}
        {lessons.length > 0 ? (
          <div class="grid md:grid-cols-2 gap-5">
            {lessons.map((lesson, i) => {
              const slug = lesson.id.split('/').slice(2).join('/');
              return (
                <LessonCard
                  title={lesson.data.title}
                  description={lesson.data.description || ''}
                  index={i}
                  href={`/course/${moduleData.id}/${slug}/`}
                />
              );
            })}
          </div>
        ) : (
          <div class="rounded-2xl border border-white/10 bg-[#0a0e14]/80 p-12 text-center">
            <p class="text-slate-500 font-sans">Nessuna lezione disponibile al momento.</p>
          </div>
        )}

      </div>
    </main>

    <Footer />
  </div>
</Layout>
