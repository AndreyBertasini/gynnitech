---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/Navbar';
import Footer from '../../../components/Footer.astro';
import { COURSE_MODULES } from '../../../data/course-modules';
import { ArrowLeft, ChevronRight, Menu, X } from 'lucide-react';

export async function getStaticPaths() {
  const courseEntries = await getCollection('corso');
  return courseEntries.map(entry => {
    const [module, slug] = entry.id.split('/');
    return {
      params: { module, slug: slug.replace(/\.[^/.]+$/, "") },
      props: { entry, module },
    };
  });
}

interface Props {
  entry: CollectionEntry<'corso'>;
  module: string;
}

const { entry, module: moduleId } = Astro.props;
const { Content } = await render(entry);

// Get Module Metadata
const moduleData = COURSE_MODULES.find(m => m.id === moduleId);

// Get all lessons for sidebar
const allLessons = await getCollection('corso');
const moduleLessons = allLessons
  .filter(lesson => lesson.id.startsWith(`${moduleId}/`))
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const currentLessonIndex = moduleLessons.findIndex(l => l.id === entry.id);
const prevLesson = moduleLessons[currentLessonIndex - 1];
const nextLesson = moduleLessons[currentLessonIndex + 1];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Course",
  "name": entry.data.title,
  "description": entry.data.description,
  "provider": {
    "@type": "Organization",
    "name": "GinnyTech",
    "sameAs": "https://ginnytech.it"
  },
  "url": new URL(Astro.url.pathname, Astro.site).href,
});
---

<Layout title={`${entry.data.title} - ${moduleData?.title}`} description={entry.data.description}>
  <Navbar client:load />

  <div class="flex min-h-screen pt-20 bg-[#0F1115]">
    {/* JSON-LD Structured Data */}
    <script type="application/ld+json" set:html={jsonLd} />
    
    {/* Desktop Sidebar Toggle Button (Visible when sidebar is closed) */}
    <button 
        id="open-sidebar-btn"
        class="hidden fixed top-24 left-4 z-30 p-2 bg-brand-dark/90 border border-white/10 rounded-lg text-slate-400 hover:text-white hover:border-mint-500/50 transition-all shadow-lg backdrop-blur-sm"
        aria-label="Open Sidebar"
    >
        <Menu className="w-5 h-5" />
    </button>

    {/* Sidebar - Desktop */}
    <aside id="sidebar" class="hidden lg:block w-80 fixed top-20 bottom-0 left-0 overflow-y-auto border-r border-white/10 bg-[#0F1115] z-20 transition-transform duration-300 ease-in-out">
      <div class="p-6">
        <div class="flex items-center justify-between mb-6">
            <a href={`/course/${moduleId}`} class="flex items-center gap-2 text-sm text-slate-400 hover:text-white transition-colors">
                <ArrowLeft className="w-4 h-4" /> Torna al Modulo
            </a>
            <button id="close-sidebar-btn" class="text-slate-500 hover:text-white transition-colors" aria-label="Close Sidebar">
                <X className="w-5 h-5" />
            </button>
        </div>
        
        <h3 class="font-bold text-white mb-4 px-2">{moduleData?.title}</h3>
        
        <nav class="space-y-1">
            {moduleLessons.map((lesson, idx) => {
                const isActive = lesson.id === entry.id;
                // lesson.id format: "module/slug.mdx"
                // We want to extract just the slug part
                const cleanSlug = lesson.id.split('/')[1].replace(/\.[^/.]+$/, "");
                
                return (
                    <a 
                        href={`/course/${moduleId}/${cleanSlug}/`}
                        class={`flex items-start gap-3 p-3 rounded-lg text-sm transition-colors ${isActive ? 'bg-mint-500/10 text-mint-400' : 'text-slate-400 hover:bg-white/5 hover:text-white'}`}
                    >
                        <span class="font-mono opacity-50 mt-0.5">{idx + 1}.</span>
                        <span>{lesson.data.title}</span>
                    </a>
                )
            })}
        </nav>
      </div>
    </aside>

    {/* Main Content Wrapper */}
    <div id="content-wrapper" class="flex-grow w-full lg:ml-80 transition-[margin] duration-300 ease-in-out">
        <main class="w-full" data-pagefind-body>
        <div class="max-w-4xl mx-auto px-6 py-12">
            
            {/* Breadcrumb */}
            <div class="flex items-center gap-2 text-sm text-slate-500 mb-8 overflow-x-auto whitespace-nowrap">
                <a href="/course" class="hover:text-white">Corsi</a>
                <ChevronRight className="w-4 h-4 flex-shrink-0" />
                <a href={`/course/${moduleId}`} class="hover:text-white">{moduleData?.title}</a>
                <ChevronRight className="w-4 h-4 flex-shrink-0" />
                <span class="text-mint-400">{entry.data.title}</span>
            </div>

            <h1 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
                {entry.data.title}
            </h1>

            <div class="sl-markdown-content prose prose-invert prose-lg max-w-none 
                prose-headings:text-white prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight
                prose-p:text-slate-200 prose-p:leading-relaxed prose-p:mb-6
                prose-li:text-slate-200 prose-li:marker:text-mint-400
                prose-a:text-mint-400 hover:prose-a:text-mint-300 prose-a:no-underline hover:prose-a:underline
                prose-strong:text-white prose-strong:font-bold
                prose-code:text-acid-yellow prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
                prose-pre:bg-[#1A1D24] prose-pre:border prose-pre:border-white/10 prose-pre:rounded-xl
                prose-blockquote:border-l-mint-500 prose-blockquote:bg-white/5 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-blockquote:text-slate-300 prose-blockquote:not-italic
                mb-16">
                <Content />
            </div>

            {/* Navigation Footer */}
            <div class="flex flex-col md:flex-row justify-between gap-6 pt-8 border-t border-white/10">
                {prevLesson ? (
                    <a href={`/course/${moduleId}/${prevLesson.id.split('/')[1].replace(/\.[^/.]+$/, "")}/`} class="group flex flex-col items-start gap-2 p-4 rounded-xl border border-white/5 hover:border-white/20 bg-white/5 transition-all w-full md:w-auto">
                        <span class="text-xs text-slate-500 uppercase tracking-wider">Lezione Precedente</span>
                        <span class="text-white font-medium group-hover:text-mint-400 transition-colors">
                            ← {prevLesson.data.title}
                        </span>
                    </a>
                ) : <div></div>}

                {nextLesson ? (
                    <a href={`/course/${moduleId}/${nextLesson.id.split('/')[1].replace(/\.[^/.]+$/, "")}/`} class="group flex flex-col items-end gap-2 p-4 rounded-xl border border-white/5 hover:border-white/20 bg-white/5 transition-all w-full md:w-auto text-right">
                        <span class="text-xs text-slate-500 uppercase tracking-wider">Lezione Successiva</span>
                        <span class="text-white font-medium group-hover:text-mint-400 transition-colors">
                            {nextLesson.data.title} →
                        </span>
                    </a>
                ) : <div></div>}
            </div>

        </div>
        </main>
        
        <Footer />
    </div>

    <script is:inline>
        const sidebar = document.getElementById('sidebar');
        const contentWrapper = document.getElementById('content-wrapper');
        const closeBtn = document.getElementById('close-sidebar-btn');
        const openBtn = document.getElementById('open-sidebar-btn');
        const SIDEBAR_STATE_KEY = 'course_sidebar_state';

        function setSidebarState(isOpen) {
            if (isOpen) {
                sidebar?.classList.remove('-translate-x-full');
                contentWrapper?.classList.add('lg:ml-80');
                contentWrapper?.classList.remove('lg:ml-0');
                openBtn?.classList.remove('lg:flex');
            } else {
                sidebar?.classList.add('-translate-x-full');
                contentWrapper?.classList.remove('lg:ml-80');
                contentWrapper?.classList.add('lg:ml-0');
                openBtn?.classList.add('lg:flex');
            }
            localStorage.setItem(SIDEBAR_STATE_KEY, isOpen ? 'open' : 'closed');
        }


        // Initial state check
        const storedState = localStorage.getItem(SIDEBAR_STATE_KEY);
        // Default to open if no state stored
        const shouldBeOpen = storedState !== 'closed';
        setSidebarState(shouldBeOpen);

        // Event listeners
        closeBtn?.addEventListener('click', () => setSidebarState(false));
        openBtn?.addEventListener('click', () => setSidebarState(true));
        
        // Handle view transitions if enabled
        document.addEventListener('astro:page-load', () => {
            const storedState = localStorage.getItem(SIDEBAR_STATE_KEY);
            const shouldBeOpen = storedState !== 'closed';
            setSidebarState(shouldBeOpen);
        });
    </script>

  </div>
  

</Layout>
