---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/Navbar';
import Footer from '../../../components/Footer.astro';
import { COURSE_MODULES } from '../../../data/course-modules';
import { ArrowLeft, ChevronRight, ChevronLeft, Menu, List, Clock3, GraduationCap, Link2, ListChecks, Route } from 'lucide-react';
import { LINKEDIN_URL, SITE_AUTHOR, SITE_URL, SITE_NAME } from '../../../consts';
import { serializeJsonLd } from '../../../utils/jsonld';
import { CompletionButton } from '../../../components/ProgressTracker';
import { getModuleCoverAlt, getModuleCoverImage } from '../../../lib/module-covers';
import { buildCourseGraph } from '../../../lib/course-graph';
import { buildLessonCrossLinks, type CourseCrossLink } from '../../../lib/course-cross-links';

interface ModuleLesson {
  id: string;
  slug: string;
  data: {
    title: string;
    order?: number;
  }
}

interface LinkedLesson {
  id: string;
  href: string;
  moduleId: string;
  moduleTitle: string;
  data: {
    title: string;
    order?: number;
  }
}

interface LessonPrerequisite {
  slug: string;
  title: string;
  href?: string;
  known: boolean;
}

interface Props {
  entry: CollectionEntry<'corso'>;
  module: string;
  moduleLessons: ModuleLesson[];
  globalPrevLesson?: LinkedLesson;
  globalNextLesson?: LinkedLesson;
  globalLessonPosition: number;
  totalOrderedLessons: number;
  prerequisiteLinks: LessonPrerequisite[];
  relatedLessons: CourseCrossLink[];
}

interface LessonHeaderImage {
  src: string;
  width?: number;
  height?: number;
}

export async function getStaticPaths() {
  const courseEntries = (await getCollection('corso')).filter(entry => entry.id.includes('/'));
  const cleanSlug = (id: string) => id.split('/')[1]?.replace(/\.[^/.]+$/, '') || '';
  const cleanId = (id: string) => id.replace(/\.[^/.]+$/, '');
  const toHref = (id: string) => `/course/${cleanId(id)}/`;

  // Group lessons by module
  const lessonsByModule = courseEntries.reduce((acc, entry) => {
    const [module] = entry.id.split('/');
    if (!acc[module]) acc[module] = [];
    acc[module].push(entry);
    return acc;
  }, {} as Record<string, CollectionEntry<'corso'>[]>);

  // Sort lessons within each module
  Object.values(lessonsByModule).forEach(lessons => {
    lessons.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
  });

  const globalLessons: LinkedLesson[] = COURSE_MODULES.flatMap((courseModule) =>
    (lessonsByModule[courseModule.id] || [])
      .filter((lesson) => typeof lesson.data.order === 'number')
      .map((lesson) => ({
        id: lesson.id,
        href: toHref(lesson.id),
        moduleId: courseModule.id,
        moduleTitle: courseModule.title,
        data: {
          title: lesson.data.title,
          order: lesson.data.order,
        },
      })),
  );
  const lessonBySlug = new Map(globalLessons.map((lesson) => [cleanId(lesson.id), lesson]));
  const courseGraph = buildCourseGraph(courseEntries);

  return courseEntries
    .filter(entry => entry.id.includes('/'))
    .map(entry => {
      const [module, slug] = entry.id.split('/');

      // Get lessons for this module
      const moduleLessons = (lessonsByModule[module] || [])
        .filter((lesson) => typeof lesson.data.order === 'number')
        .map(lesson => ({
        id: lesson.id,
        slug: cleanSlug(lesson.id),
        data: {
          title: lesson.data.title,
          order: lesson.data.order
        }
      }));

      const globalLessonIndex = globalLessons.findIndex((lesson) => lesson.id === entry.id);
      const rawPrerequisites = Array.isArray(entry.data.prerequisites) ? entry.data.prerequisites : [];
      const prerequisiteLinks = rawPrerequisites.map((prerequisite) => {
        const target = lessonBySlug.get(prerequisite);
        return target
          ? {
              slug: prerequisite,
              title: target.data.title,
              href: target.href,
              known: true,
            }
          : {
              slug: prerequisite,
              title: prerequisite,
              known: false,
            };
      });

      return {
        params: { module, slug: slug.replace(/\.[^/.]+$/, "") },
        props: {
          entry,
          module,
          moduleLessons,
          globalPrevLesson: globalLessonIndex > 0 ? globalLessons[globalLessonIndex - 1] : undefined,
          globalNextLesson: globalLessonIndex >= 0 ? globalLessons[globalLessonIndex + 1] : undefined,
          globalLessonPosition: globalLessonIndex >= 0 ? globalLessonIndex + 1 : 0,
          totalOrderedLessons: globalLessons.length,
          prerequisiteLinks,
          relatedLessons: buildLessonCrossLinks(courseGraph, cleanId(entry.id), { maxLinks: 6 }),
        },
      };
    });
}

const {
  entry,
  module: moduleId,
  moduleLessons,
  globalPrevLesson,
  globalNextLesson,
  globalLessonPosition,
  totalOrderedLessons,
  prerequisiteLinks,
  relatedLessons,
} = Astro.props;
const { Content, headings } = await render(entry);
const headerImageValue = entry.data.headerImage?.trim() ?? '';
const isDirectHeaderImage = headerImageValue.startsWith('/') || /^https?:\/\//.test(headerImageValue);

if (headerImageValue && !isDirectHeaderImage) {
  throw new Error(`Header image "${headerImageValue}" must be an absolute public path or URL for course lesson "${entry.id}".`);
}

const lessonHeaderImage: LessonHeaderImage | undefined = isDirectHeaderImage
  ? { src: headerImageValue }
  : undefined;
const lessonHeaderAlt = entry.data.headerImageAlt ?? `Immagine introduttiva per ${entry.data.title}`;

// Get Module Metadata
const moduleData = COURSE_MODULES.find(m => m.id === moduleId);
const moduleCoverImage = moduleData ? getModuleCoverImage(moduleData.id) : undefined;
const moduleCoverAlt = moduleData ? getModuleCoverAlt(moduleData.title) : undefined;
const resolvedLessonHeroImage: LessonHeaderImage | undefined = lessonHeaderImage ?? moduleCoverImage;
const resolvedLessonHeroAlt = lessonHeaderImage
  ? lessonHeaderAlt
  : moduleCoverAlt ?? `Immagine introduttiva per ${entry.data.title}`;
const resolvedLessonImageUrl = resolvedLessonHeroImage?.src;
const absoluteLessonImageUrl = resolvedLessonImageUrl
  ? new URL(resolvedLessonImageUrl, Astro.site || SITE_URL).href
  : undefined;

const isSupplementalLesson = typeof entry.data.order !== 'number';
const prerequisites = Array.isArray(entry.data.prerequisites) ? entry.data.prerequisites : [];
const learningObjectives = Array.isArray(entry.data.learningObjectives)
  ? entry.data.learningObjectives.filter((objective): objective is string => typeof objective === 'string' && objective.trim() !== '')
  : [];

const moduleIndex = COURSE_MODULES.findIndex((module) => module.id === moduleId);
const fallbackDifficulty = moduleIndex < 5 ? 'Base' : moduleIndex < 10 ? 'Intermedio' : 'Avanzato';

const rawDifficulty = entry.data.difficulty?.toLowerCase();
const difficultyLabel = rawDifficulty === 'beginner' || rawDifficulty === 'base'
  ? 'Base'
  : rawDifficulty === 'advanced' || rawDifficulty === 'avanzato'
    ? 'Avanzato'
    : rawDifficulty === 'intermediate' || rawDifficulty === 'intermedio'
      ? 'Intermedio'
      : fallbackDifficulty;

const educationalLevel = difficultyLabel === 'Base'
  ? 'Beginner'
  : difficultyLabel === 'Avanzato'
    ? 'Advanced'
    : 'Intermediate';

// Filter headings for TOC (h2 and h3 only), strip badge markup
const tocHeadings = headings
  .filter(h => h.depth === 2 || h.depth === 3)
  .map(h => ({
    ...h,
    text: h.text.replace(/__SHB__.*$/, '').trim()
  }));

const lessonUrl = new URL(Astro.url.pathname, Astro.site || SITE_URL).href;
const durationMatch = entry.data.duration?.trim().match(/^(\d{1,3})\s*(min|minuti|h|ore)$/i);
const timeRequired = durationMatch
  ? durationMatch[2].toLowerCase().startsWith('h') || durationMatch[2].toLowerCase().startsWith('ore')
    ? `PT${durationMatch[1]}H`
    : `PT${durationMatch[1]}M`
  : undefined;

const jsonLd = serializeJsonLd({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Course",
      "name": entry.data.title,
      "description": entry.data.description,
      "url": lessonUrl,
      "image": absoluteLessonImageUrl,
      "inLanguage": "it-IT",
      "learningResourceType": "Lesson",
      "educationalLevel": educationalLevel,
      "position": globalLessonPosition || undefined,
      "dateModified": entry.data.dateModified?.toISOString(),
      "timeRequired": timeRequired,
      "teaches": learningObjectives.length > 0 ? learningObjectives : undefined,
      "mentions": relatedLessons.length > 0
        ? relatedLessons.map((lesson) => ({
            "@type": "LearningResource",
            "name": lesson.title,
            "url": new URL(lesson.href, SITE_URL).href,
          }))
        : undefined,
      "provider": {
        "@type": "Organization",
        "name": SITE_NAME,
        "sameAs": SITE_URL,
      },
      "instructor": {
        "@type": "Person",
        "name": SITE_AUTHOR,
        "url": LINKEDIN_URL,
      },
      "isPartOf": {
        "@type": "Course",
        "name": moduleData?.title,
        "url": `${SITE_URL}/course/${moduleId}`,
        "provider": {
          "@type": "Organization",
          "name": SITE_NAME,
          "sameAs": SITE_URL,
        },
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
        { "@type": "ListItem", "position": 2, "name": "Corso", "item": `${SITE_URL}/course` },
        { "@type": "ListItem", "position": 3, "name": moduleData?.title, "item": `${SITE_URL}/course/${moduleId}` },
        { "@type": "ListItem", "position": 4, "name": entry.data.title, "item": lessonUrl },
      ],
    },
  ],
});
---

<Layout
  title={`${entry.data.title} - ${moduleData?.title}`}
  description={entry.data.description}
  image={resolvedLessonImageUrl}
  preloadImage={Boolean(resolvedLessonImageUrl)}
>
  <Navbar client:idle />
  <script type="application/ld+json" set:html={jsonLd} is:inline></script>

  {/* Mobile Menu Button */}
  <button
      id="mobile-menu-btn"
      class="course-mobile-menu-btn"
      aria-label="Apri navigazione"
  >
      <Menu className="w-5 h-5" />
  </button>

  {/* Mobile Overlay */}
  <div id="mobile-overlay" class="course-mobile-overlay"></div>

  <div class="course-layout">
    {/* Left Sidebar - Navigation */}
    <aside id="course-sidebar" class="course-sidebar">
      <div class="course-sidebar-inner">
        <a href={`/course/${moduleId}`} class="course-sidebar-back">
            <ArrowLeft className="w-4 h-4" />
            <span>Torna al Modulo</span>
        </a>

        <h3 class="course-sidebar-title">{moduleData?.title}</h3>

        <nav class="course-sidebar-nav">
            {moduleLessons.map((lesson, idx) => {
                const isActive = lesson.id === entry.id;
                const cleanSlug = lesson.slug || lesson.id.split('/')[1].replace(/\.[^/.]+$/, "");

                return (
                    <a
                        href={`/course/${moduleId}/${cleanSlug}/`}
                        class:list={['course-sidebar-link', { 'is-active': isActive }]}
                        aria-current={isActive ? 'page' : undefined}
                    >
                        <span class="course-sidebar-link-number">{idx + 1}</span>
                        <span class="course-sidebar-link-text">{lesson.data.title}</span>
                    </a>
                )
            })}
        </nav>
      </div>
    </aside>

    {/* Main Content Area */}
    <div class="course-content-wrapper">
        <main id="main-content" class="course-main" data-pagefind-body>

            {/* Breadcrumb */}
            <nav class="course-breadcrumb" aria-label="Breadcrumb">
                <a href="/course">Corso</a>
                <ChevronRight className="w-3.5 h-3.5" />
                <a href={`/course/${moduleId}`}>{moduleData?.title}</a>
                <ChevronRight className="w-3.5 h-3.5" />
                <span>{entry.data.title}</span>
            </nav>

            {resolvedLessonHeroImage && (
                <figure class="course-lesson-hero">
                    <img
                        class="course-lesson-hero-image"
                        src={resolvedLessonHeroImage.src}
                        width={resolvedLessonHeroImage.width}
                        height={resolvedLessonHeroImage.height}
                        alt={resolvedLessonHeroAlt}
                        loading="eager"
                        decoding="async"
                        fetchpriority="high"
                    />
                </figure>
            )}

            <h1 class="course-page-title">
                {entry.data.title}
            </h1>

            {entry.data.description && (
                <p class="course-page-description">{entry.data.description}</p>
            )}

            <div class="course-author-tag">
                <div class="course-author-avatar">AD</div>
                <div class="course-author-info">
                    <span class="course-author-label">Creato da</span>
                    <span class="course-author-name">{SITE_AUTHOR}</span>
                </div>
            </div>

            <div class="course-meta-strip">
                {isSupplementalLesson && (
                    <span class="course-meta-pill is-accent">
                        Risorsa supplementare
                    </span>
                )}
                <span class="course-meta-pill">
                    <Route className="w-3.5 h-3.5" />
                    Lezione {globalLessonPosition} / {totalOrderedLessons}
                </span>
                <span class="course-meta-pill">
                    <GraduationCap className="w-3.5 h-3.5" />
                    Livello: {difficultyLabel}
                </span>
                {entry.data.duration && (
                    <span class="course-meta-pill">
                        <Clock3 className="w-3.5 h-3.5" />
                        Durata: {entry.data.duration}
                    </span>
                )}
                {prerequisites.length > 0 && (
                    <span class="course-meta-pill">
                        <Link2 className="w-3.5 h-3.5" />
                        Prerequisiti: {prerequisites.length}
                    </span>
                )}
            </div>

            <section class="course-lesson-context" aria-label="Contesto della lezione">
                <div class="course-context-panel">
                    <h2 class="course-context-title">
                        <ListChecks className="w-4 h-4" />
                        Cosa imparerai
                    </h2>
                    {learningObjectives.length > 0 ? (
                        <ul class="course-objective-list">
                            {learningObjectives.map((objective) => (
                                <li>{objective}</li>
                            ))}
                        </ul>
                    ) : (
                        <p class="course-context-empty">Obiettivi operativi integrati nel corpo della lezione.</p>
                    )}
                </div>

                <div class="course-context-panel">
                    <h2 class="course-context-title">
                        <Link2 className="w-4 h-4" />
                        Collegamenti
                    </h2>
                    <div class="course-prerequisite-list">
                        {prerequisiteLinks.length > 0 ? (
                            prerequisiteLinks.map((prerequisite) => (
                                prerequisite.known && prerequisite.href ? (
                                    <a href={prerequisite.href}>{prerequisite.title}</a>
                                ) : (
                                    <span>{prerequisite.title}</span>
                                )
                            ))
                        ) : (
                            <span>Ingresso diretto nel modulo.</span>
                        )}
                    </div>
                </div>
            </section>

            <div class="sl-markdown-content course-prose">
                <Content />
            </div>

            {relatedLessons.length > 0 && (
                <section class="course-cross-links" aria-labelledby="course-cross-links-title">
                    <div class="course-cross-links-header">
                        <p class="course-cross-links-kicker">Percorso collegato</p>
                        <h2 id="course-cross-links-title">Lezioni da leggere insieme</h2>
                        <p>
                            Questi collegamenti portano la lezione dentro il resto del corso: basi da riprendere,
                            passaggi successivi e connessioni tematiche tra moduli.
                        </p>
                    </div>
                    <div class="course-cross-links-grid">
                        {relatedLessons.map((lesson) => (
                            <a class="course-cross-link-card" href={lesson.href}>
                                <span class="course-cross-link-relation">{lesson.relation}</span>
                                <span class="course-cross-link-module">{lesson.moduleTitle}</span>
                                <strong>{lesson.title}</strong>
                                <span>{lesson.description}</span>
                            </a>
                        ))}
                    </div>
                </section>
            )}

            <CompletionButton
              moduleId={moduleId}
              slug={entry.id.split('/')[1]?.replace(/\.[^/.]+$/, '') || ''}
              client:only="react"
            />

            {/* Navigation Footer */}
            <div class="course-nav-footer">
                {globalPrevLesson ? (
                    <a href={globalPrevLesson.href} class="course-nav-card course-nav-prev">
                        <span class="course-nav-label">
                            <ChevronLeft className="w-4 h-4" />
                            Precedente
                        </span>
                        <span class="course-nav-module">{globalPrevLesson.moduleTitle}</span>
                        <span class="course-nav-title">
                            {globalPrevLesson.data.title}
                        </span>
                    </a>
                ) : <div></div>}

                {globalNextLesson ? (
                    <a href={globalNextLesson.href} class="course-nav-card course-nav-next">
                        <span class="course-nav-label">
                            Successiva
                            <ChevronRight className="w-4 h-4" />
                        </span>
                        <span class="course-nav-module">{globalNextLesson.moduleTitle}</span>
                        <span class="course-nav-title">
                            {globalNextLesson.data.title}
                        </span>
                    </a>
                ) : <div></div>}
            </div>

        </main>

        <Footer />
    </div>
  </div>

  {/* Right Sidebar - Table of Contents */}
  {tocHeadings.length > 0 && (
      <aside class="course-toc">
          <div class="course-toc-inner">
              <h4 class="course-toc-title">
                  <List className="w-4 h-4" />
                  In questa pagina
              </h4>
              <nav class="course-toc-nav">
                  {tocHeadings.map((heading) => (
                      <a
                          href={`#${heading.slug}`}
                          class:list={['course-toc-link', { 'is-h3': heading.depth === 3 }]}
                          data-heading-slug={heading.slug}
                      >
                          {heading.text}
                      </a>
                  ))}
              </nav>
          </div>
      </aside>
  )}

  {/* Scripts */}
  <script is:inline>
      // Mobile sidebar toggle
      const sidebar = document.getElementById('course-sidebar');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const overlay = document.getElementById('mobile-overlay');

      function toggleMobileSidebar() {
          sidebar?.classList.toggle('is-open');
          overlay?.classList.toggle('is-visible');
          document.body.classList.toggle('overflow-hidden');
      }

      mobileBtn?.addEventListener('click', toggleMobileSidebar);
      overlay?.addEventListener('click', toggleMobileSidebar);

      // TOC active state tracking
      function initTocTracking() {
          const tocLinks = document.querySelectorAll('.course-toc-link');
          if (tocLinks.length === 0) return;

          const headingElements = [];
          tocLinks.forEach(link => {
              const slug = link.getAttribute('data-heading-slug');
              const el = document.getElementById(slug);
              if (el) headingElements.push({ el, link });
          });

          if (headingElements.length === 0) return;

          const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                  if (entry.isIntersecting) {
                      tocLinks.forEach(l => l.classList.remove('is-active'));
                      const match = headingElements.find(h => h.el === entry.target);
                      if (match) match.link.classList.add('is-active');
                  }
              });
          }, {
              rootMargin: '-80px 0px -70% 0px',
              threshold: 0
          });

          headingElements.forEach(({ el }) => observer.observe(el));
      }

      initTocTracking();

      // Handle view transitions
      document.addEventListener('astro:page-load', () => {
          initTocTracking();
      });
  </script>
</Layout>
