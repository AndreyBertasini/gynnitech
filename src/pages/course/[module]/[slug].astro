---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/Navbar';
import Footer from '../../../components/Footer.astro';
import { COURSE_MODULES } from '../../../data/course-modules';
import { ArrowLeft, ChevronRight, ChevronLeft, Menu, X, List } from 'lucide-react';
import { SITE_URL, SITE_NAME } from '../../../consts';
import { serializeJsonLd } from '../../../utils/jsonld';

interface ModuleLesson {
  id: string;
  slug: string;
  data: {
    title: string;
    order?: number;
  }
}

interface Props {
  entry: CollectionEntry<'corso'>;
  module: string;
  moduleLessons: ModuleLesson[];
}

export async function getStaticPaths() {
  const courseEntries = await getCollection('corso');

  // Group lessons by module
  const lessonsByModule = courseEntries.reduce((acc, entry) => {
    const [module] = entry.id.split('/');
    if (!acc[module]) acc[module] = [];
    acc[module].push(entry);
    return acc;
  }, {} as Record<string, CollectionEntry<'corso'>[]>);

  // Sort lessons within each module
  Object.values(lessonsByModule).forEach(lessons => {
    lessons.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
  });

  return courseEntries.map(entry => {
    const [module, slug] = entry.id.split('/');

    // Get lessons for this module
    const moduleLessons = (lessonsByModule[module] || []).map(lesson => ({
      id: lesson.id,
      slug: lesson.id.split('/')[1].replace(/\.[^/.]+$/, ""),
      data: {
        title: lesson.data.title,
        order: lesson.data.order
      }
    }));

    return {
      params: { module, slug: slug.replace(/\.[^/.]+$/, "") },
      props: { entry, module, moduleLessons },
    };
  });
}

const { entry, module: moduleId, moduleLessons } = Astro.props;
const { Content, headings } = await render(entry);

// Get Module Metadata
const moduleData = COURSE_MODULES.find(m => m.id === moduleId);

const currentLessonIndex = moduleLessons.findIndex(l => l.id === entry.id);
const prevLesson = moduleLessons[currentLessonIndex - 1];
const nextLesson = moduleLessons[currentLessonIndex + 1];

// Filter headings for TOC (h2 and h3 only), strip badge markup
const tocHeadings = headings
  .filter(h => h.depth === 2 || h.depth === 3)
  .map(h => ({
    ...h,
    text: h.text.replace(/__SHB__.*$/, '').trim()
  }));

const jsonLd = serializeJsonLd({
  "@context": "https://schema.org",
  "@type": "Course",
  "name": entry.data.title,
  "description": entry.data.description,
  "provider": {
    "@type": "Organization",
    "name": SITE_NAME,
    "sameAs": SITE_URL
  },
  "url": new URL(Astro.url.pathname, Astro.site || SITE_URL).href,
  "image": entry.data.image ? new URL(entry.data.image, Astro.site || SITE_URL).href : undefined,
});
---

<Layout title={`${entry.data.title} - ${moduleData?.title}`} description={entry.data.description}>
  <Navbar client:load />
  <script type="application/ld+json" set:html={jsonLd}></script>

  {/* Mobile Menu Button */}
  <button
      id="mobile-menu-btn"
      class="course-mobile-menu-btn"
      aria-label="Apri navigazione"
  >
      <Menu className="w-5 h-5" />
  </button>

  {/* Mobile Overlay */}
  <div id="mobile-overlay" class="course-mobile-overlay"></div>

  <div class="course-layout">
    {/* Left Sidebar - Navigation */}
    <aside id="course-sidebar" class="course-sidebar">
      <div class="course-sidebar-inner">
        <a href={`/course/${moduleId}`} class="course-sidebar-back">
            <ArrowLeft className="w-4 h-4" />
            <span>Torna al Modulo</span>
        </a>

        <h3 class="course-sidebar-title">{moduleData?.title}</h3>

        <nav class="course-sidebar-nav">
            {moduleLessons.map((lesson, idx) => {
                const isActive = lesson.id === entry.id;
                const cleanSlug = lesson.slug || lesson.id.split('/')[1].replace(/\.[^/.]+$/, "");

                return (
                    <a
                        href={`/course/${moduleId}/${cleanSlug}/`}
                        class:list={['course-sidebar-link', { 'is-active': isActive }]}
                        aria-current={isActive ? 'page' : undefined}
                    >
                        <span class="course-sidebar-link-number">{idx + 1}</span>
                        <span class="course-sidebar-link-text">{lesson.data.title}</span>
                    </a>
                )
            })}
        </nav>
      </div>
    </aside>

    {/* Main Content Area */}
    <div class="course-content-wrapper">
        <main id="main-content" class="course-main" data-pagefind-body>

            {/* Breadcrumb */}
            <nav class="course-breadcrumb" aria-label="Breadcrumb">
                <a href="/course">Corso</a>
                <ChevronRight className="w-3.5 h-3.5" />
                <a href={`/course/${moduleId}`}>{moduleData?.title}</a>
                <ChevronRight className="w-3.5 h-3.5" />
                <span>{entry.data.title}</span>
            </nav>

            <h1 class="course-page-title">
                {entry.data.title}
            </h1>

            {entry.data.description && (
                <p class="course-page-description">{entry.data.description}</p>
            )}

            <div class="sl-markdown-content course-prose">
                <Content />
            </div>

            {/* Navigation Footer */}
            <div class="course-nav-footer">
                {prevLesson ? (
                    <a href={`/course/${moduleId}/${prevLesson.slug || prevLesson.id.split('/')[1].replace(/\.[^/.]+$/, "")}/`} class="course-nav-card course-nav-prev">
                        <span class="course-nav-label">
                            <ChevronLeft className="w-4 h-4" />
                            Precedente
                        </span>
                        <span class="course-nav-title">
                            {prevLesson.data.title}
                        </span>
                    </a>
                ) : <div></div>}

                {nextLesson ? (
                    <a href={`/course/${moduleId}/${nextLesson.slug || nextLesson.id.split('/')[1].replace(/\.[^/.]+$/, "")}/`} class="course-nav-card course-nav-next">
                        <span class="course-nav-label">
                            Successiva
                            <ChevronRight className="w-4 h-4" />
                        </span>
                        <span class="course-nav-title">
                            {nextLesson.data.title}
                        </span>
                    </a>
                ) : <div></div>}
            </div>

        </main>

        <Footer />
    </div>
  </div>

  {/* Right Sidebar - Table of Contents */}
  {tocHeadings.length > 0 && (
      <aside class="course-toc">
          <div class="course-toc-inner">
              <h4 class="course-toc-title">
                  <List className="w-4 h-4" />
                  In questa pagina
              </h4>
              <nav class="course-toc-nav">
                  {tocHeadings.map((heading) => (
                      <a
                          href={`#${heading.slug}`}
                          class:list={['course-toc-link', { 'is-h3': heading.depth === 3 }]}
                          data-heading-slug={heading.slug}
                      >
                          {heading.text}
                      </a>
                  ))}
              </nav>
          </div>
      </aside>
  )}

  {/* Scripts */}
  <script is:inline>
      // Mobile sidebar toggle
      const sidebar = document.getElementById('course-sidebar');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const overlay = document.getElementById('mobile-overlay');

      function toggleMobileSidebar() {
          sidebar?.classList.toggle('is-open');
          overlay?.classList.toggle('is-visible');
          document.body.classList.toggle('overflow-hidden');
      }

      mobileBtn?.addEventListener('click', toggleMobileSidebar);
      overlay?.addEventListener('click', toggleMobileSidebar);

      // TOC active state tracking
      function initTocTracking() {
          const tocLinks = document.querySelectorAll('.course-toc-link');
          if (tocLinks.length === 0) return;

          const headingElements = [];
          tocLinks.forEach(link => {
              const slug = link.getAttribute('data-heading-slug');
              const el = document.getElementById(slug);
              if (el) headingElements.push({ el, link });
          });

          if (headingElements.length === 0) return;

          const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                  if (entry.isIntersecting) {
                      tocLinks.forEach(l => l.classList.remove('is-active'));
                      const match = headingElements.find(h => h.el === entry.target);
                      if (match) match.link.classList.add('is-active');
                  }
              });
          }, {
              rootMargin: '-80px 0px -70% 0px',
              threshold: 0
          });

          headingElements.forEach(({ el }) => observer.observe(el));
      }

      initTocTracking();

      // Handle view transitions
      document.addEventListener('astro:page-load', () => {
          initTocTracking();
      });
  </script>
</Layout>

<style is:global>
/* ========================================
   Course Lesson Page - Astro Docs Inspired
   ======================================== */

/* Layout */
.course-layout {
    min-height: 100vh;
    padding-top: 4rem; /* Navbar height (h-16 = 4rem) */
    padding-left: 18rem; /* Sidebar width */
    background-color: var(--color-brand-dark, #050505);
}

@media (min-width: 1280px) {
    .course-layout {
        padding-right: 14rem; /* TOC width */
    }
}

@media (max-width: 1023px) {
    .course-layout {
        padding-left: 0;
    }
}

/* Mobile Menu Button */
.course-mobile-menu-btn {
    display: none;
    position: fixed;
    top: 5rem;
    left: 1rem;
    z-index: 40;
    padding: 0.5rem;
    border-radius: 0.5rem;
    background: #23262d;
    border: 1px solid #343841;
    color: #a0a5b1;
    cursor: pointer;
    transition: all 0.2s;
}

.course-mobile-menu-btn:hover {
    color: #fff;
    border-color: #4f5563;
}

@media (max-width: 1023px) {
    .course-mobile-menu-btn {
        display: flex;
    }
}

/* Mobile Overlay */
.course-mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 29;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s;
}

.course-mobile-overlay.is-visible {
    display: block;
    opacity: 1;
}

/* ========================================
   Left Sidebar
   ======================================== */
.course-sidebar {
    position: fixed;
    top: 4rem;
    bottom: 0;
    left: 0;
    width: 18rem;
    overflow-y: auto;
    background: var(--color-brand-darker, #000000);
    border-right: 1px solid var(--sl-color-hairline, #1f2937);
    z-index: 30;
    scrollbar-width: thin;
    scrollbar-color: #343841 transparent;
}

.course-sidebar::-webkit-scrollbar {
    width: 4px;
}
.course-sidebar::-webkit-scrollbar-track {
    background: transparent;
}
.course-sidebar::-webkit-scrollbar-thumb {
    background: #343841;
    border-radius: 4px;
}

@media (max-width: 1023px) {
    .course-sidebar {
        transform: translateX(-100%);
        transition: transform 0.3s ease;
    }
    .course-sidebar.is-open {
        transform: translateX(0);
    }
}

.course-sidebar-inner {
    padding: 1.5rem 1rem 2rem;
}

.course-sidebar-back {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: #8b8fa7;
    text-decoration: none;
    margin-bottom: 1.25rem;
    padding: 0.3rem 0.5rem;
    border-radius: 0.375rem;
    transition: color 0.2s;
}

.course-sidebar-back:hover {
    color: #c9cbda;
}

.course-sidebar-title {
    font-family: var(--font-montserrat), sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: #c9cbda;
    padding: 0 0.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
}

.course-sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.course-sidebar-link {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.375rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: #8b8fa7;
    text-decoration: none;
    transition: all 0.15s;
    border-left: 2px solid transparent;
}

.course-sidebar-link:hover {
    color: #c9cbda;
    background: rgba(255, 255, 255, 0.04);
}

.course-sidebar-link.is-active {
    color: var(--color-acid-yellow) !important;
    background: rgba(204, 255, 0, 0.05);
    border-left-color: var(--color-acid-yellow);
    font-weight: 600;
    text-shadow: 0 0 10px rgba(204, 255, 0, 0.2);
}

.course-sidebar-link-number {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    opacity: 0.5;
    min-width: 1.2rem;
    margin-top: 1px;
}

.course-sidebar-link-text {
    flex: 1;
}

/* ========================================
   Content Wrapper
   ======================================== */
.course-content-wrapper {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.course-main {
    flex: 1;
    max-width: 52rem;
    width: 100%;
    margin: 0 auto;
    padding: 1.5rem 2.5rem 4rem;
}

@media (max-width: 768px) {
    .course-main {
        padding: 1.5rem 1.25rem 3rem;
    }
}

/* Breadcrumb */
.course-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: #6b6f82;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
}

.course-breadcrumb a {
    color: #8b8fa7;
    text-decoration: none;
    transition: color 0.2s;
}

.course-breadcrumb a:hover {
    color: #c9cbda;
}

.course-breadcrumb > span:last-child {
    color: #c9cbda;
}

/* Page Title */
.course-page-title {
    font-family: var(--font-montserrat), sans-serif;
    font-size: 2.25rem;
    font-weight: 800;
    color: #e8e9f3;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
}

@media (max-width: 768px) {
    .course-page-title {
        font-size: 1.75rem;
    }
}

.course-page-description {
    font-size: 1.05rem;
    color: #8b8fa7;
    line-height: 1.65;
    margin-bottom: 2rem;
    max-width: 42rem;
}

/* Content Prose Overrides */
.course-prose {
    margin-bottom: 3rem;
}

/* Hide the first H1 inside content since we render it as page title */
.course-prose.sl-markdown-content > h1:first-child {
    display: none;
}

.course-prose.sl-markdown-content {
    color: #c1c4d6;
}

.course-prose.sl-markdown-content h1 {
    color: #e8e9f3;
}

.course-prose.sl-markdown-content h2 {
    color: #e0e2f0;
    border-bottom-color: #2a2d37;
    scroll-margin-top: 5rem;
}

.course-prose.sl-markdown-content h3 {
    color: #d1d4e4;
    scroll-margin-top: 5rem;
}

.course-prose.sl-markdown-content h4 {
    color: #c9cbda;
    scroll-margin-top: 5rem;
}

.course-prose.sl-markdown-content p {
    color: #b3b8cc;
}

.course-prose.sl-markdown-content strong {
    color: #e0e2f0;
}

.course-prose.sl-markdown-content a:not([class]) {
    color: var(--color-acid-yellow);
}

.course-prose.sl-markdown-content a:not([class]):hover {
    color: var(--sl-color-accent-high, #f0ffcc);
}

.course-prose.sl-markdown-content li {
    color: #b3b8cc;
}

.course-prose.sl-markdown-content li::marker {
    color: var(--color-acid-yellow);
}

.course-prose.sl-markdown-content :not(pre) > code {
    background: #272a33;
    border-color: #343841;
    color: #c4b5fd;
}

.course-prose.sl-markdown-content table {
    border-color: #2a2d37;
}

.course-prose.sl-markdown-content table thead {
    background: rgba(255, 255, 255, 0.03);
}

.course-prose.sl-markdown-content table th {
    color: #8b8fa7;
    border-bottom-color: #2a2d37;
}

.course-prose.sl-markdown-content table td {
    border-bottom-color: #2a2d37;
}

.course-prose.sl-markdown-content table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
}

.course-prose.sl-markdown-content blockquote {
    border-left-color: var(--color-acid-yellow);
    background: rgba(204, 255, 0, 0.05);
    color: var(--sl-color-gray-3);
}

.course-prose.sl-markdown-content hr {
    border-top-color: #2a2d37;
}

/* ========================================
   Navigation Footer
   ======================================== */
.course-nav-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid #2a2d37;
}

@media (max-width: 640px) {
    .course-nav-footer {
        grid-template-columns: 1fr;
    }
}

.course-nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid #2a2d37;
    background: #1e2028;
    text-decoration: none;
    transition: all 0.2s;
}

.course-nav-card:hover {
    border-color: #4f5563;
    background: #23262d;
}

.course-nav-prev {
    align-items: flex-start;
}

.course-nav-next {
    align-items: flex-end;
    text-align: right;
}

.course-nav-label {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #6b6f82;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.course-nav-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-acid-yellow);
    transition: color 0.2s;
    line-height: 1.35;
}

.course-nav-card:hover .course-nav-title {
    color: var(--sl-color-accent-high);
}

/* ========================================
   Right Sidebar - Table of Contents
   ======================================== */
.course-toc {
    display: none;
    position: fixed;
    top: 4rem;
    right: 0;
    bottom: 0;
    width: 14rem;
    overflow-y: auto;
    scrollbar-width: none;
}

.course-toc::-webkit-scrollbar {
    display: none;
}

@media (min-width: 1280px) {
    .course-toc {
        display: block;
    }
}

.course-toc-inner {
    padding: 1.5rem 1rem 2rem 0.5rem;
}

.course-toc-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-montserrat), sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    color: #c9cbda;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
    padding-left: 0.5rem;
}

.course-toc-nav {
    display: flex;
    flex-direction: column;
    border-left: 1px solid #2a2d37;
}

.course-toc-link {
    display: block;
    padding: 0.3rem 0.75rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.78rem;
    line-height: 1.45;
    color: #6b6f82;
    text-decoration: none;
    transition: all 0.15s;
}

.course-toc-link.is-h3 {
    padding-left: 1.25rem;
    font-size: 0.75rem;
}

.course-toc-link:hover {
    color: #c9cbda;
}

.course-toc-link.is-active {
    color: var(--color-acid-yellow);
    border-left-color: var(--color-acid-yellow);
    text-shadow: 0 0 10px rgba(204, 255, 0, 0.2);
}

/* ========================================
   Aside overrides for course pages
   ======================================== */
.course-prose .starlight-aside {
    background-color: rgba(5, 5, 5, 0.4) !important;
    border: 1px solid var(--sl-color-hairline, #1f2937) !important;
    border-radius: 0.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px);
    padding: 1.25rem 1.5rem !important;
}

.course-prose .starlight-aside--tip {
    border: 1px solid rgba(204, 255, 0, 0.2) !important;
    background: linear-gradient(145deg, rgba(204, 255, 0, 0.03), rgba(204, 255, 0, 0.01)) !important;
    box-shadow: 0 0 15px rgba(204, 255, 0, 0.05);
}

.course-prose .starlight-aside--tip .starlight-aside__title {
    color: var(--color-acid-yellow) !important;
    text-shadow: 0 0 10px rgba(204, 255, 0, 0.2);
}

.course-prose .starlight-aside--note {
    border: 1px solid rgba(0, 243, 255, 0.2) !important;
    background: linear-gradient(145deg, rgba(0, 243, 255, 0.03), rgba(0, 243, 255, 0.01)) !important;
    box-shadow: 0 0 15px rgba(0, 243, 255, 0.05);
}

.course-prose .starlight-aside--note .starlight-aside__title {
    color: var(--color-neon-blue) !important;
    text-shadow: 0 0 10px rgba(0, 243, 255, 0.2);
}

.course-prose .starlight-aside--caution {
    border: 1px solid rgba(255, 165, 0, 0.2) !important;
    background: linear-gradient(145deg, rgba(255, 165, 0, 0.03), rgba(255, 165, 0, 0.01)) !important;
    box-shadow: 0 0 15px rgba(255, 165, 0, 0.05);
}

.course-prose .starlight-aside--caution .starlight-aside__title {
    color: #ffa500 !important;
}

.course-prose .starlight-aside--danger {
    border: 1px solid rgba(255, 0, 255, 0.2) !important;
    background: linear-gradient(145deg, rgba(255, 0, 255, 0.03), rgba(255, 0, 255, 0.01)) !important;
    box-shadow: 0 0 15px rgba(255, 0, 255, 0.05);
}

.course-prose .starlight-aside--danger .starlight-aside__title {
    color: var(--color-neon-pink) !important;
    text-shadow: 0 0 10px rgba(255, 0, 255, 0.2);
}

/* ========================================
   Code blocks in course pages
   ======================================== */
.course-prose pre {
    background: #13151a !important;
    border: 1px solid #2a2d37 !important;
    border-radius: 0.5rem !important;
}

/* ========================================
   Steps in course pages
   ======================================== */
.course-prose .sl-steps > li::before {
    background-color: #1e2028 !important;
    border-color: #818cf8 !important;
    color: #818cf8 !important;
    box-shadow: none;
}

.course-prose .sl-steps > li::after {
    background-color: #818cf8 !important;
    opacity: 0.2;
}
</style>
