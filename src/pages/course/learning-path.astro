---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { COURSE_MODULES } from '../../data/course-modules';
import { ArrowLeft } from 'lucide-react';

const courseDocs = await getCollection('corso');

const lessonCounts = new Map<string, number>();
for (const doc of courseDocs) {
  const moduleId = doc.id.split('/')[0];
  lessonCounts.set(moduleId, (lessonCounts.get(moduleId) || 0) + 1);
}
---

<Layout
  title="Learning Path — Percorso completo | GinnyTech"
  description="Tutti i moduli del corso GinnyTech in sequenza: dalla raccolta dati all'analytics engineering, con link diretti a ogni modulo."
>
  <Navbar client:idle />

  <main id="main-content" class="relative min-h-screen bg-brand-dark pt-28 pb-20">
    <div class="container mx-auto px-6 max-w-4xl">

      {/* Back */}
      <a href="/#corsi" class="inline-flex items-center gap-2 text-slate-500 hover:text-white transition-colors text-sm mb-10 group">
        <div class="p-1 rounded-md bg-white/5 border border-white/10 group-hover:border-white/20 transition-colors">
          <ArrowLeft className="w-3 h-3" />
        </div>
        Torna ai corsi
      </a>

      {/* Header */}
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-accent text-xs font-mono tracking-wider mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          {COURSE_MODULES.length} MODULI
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4 font-heading">
          Learning Path
        </h1>
        <p class="text-slate-400 text-lg max-w-2xl leading-relaxed">
          Il percorso completo dall'inizio alla fine — segui l'ordine o scegli il modulo che ti serve.
        </p>
      </div>

      {/* Modules list */}
      <div class="space-y-3">
        {COURSE_MODULES.map((module, index) => {
          const count = lessonCounts.get(module.id) || 0;
          return (
            <a
              href={`/course/${module.id}/`}
              class="flex items-center gap-5 p-5 rounded-2xl border border-white/10 bg-white/[0.03] hover:bg-white/[0.06] hover:border-white/20 transition-all group"
            >
              <span class="shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-white/5 border border-white/10 text-xs font-mono text-slate-400 group-hover:text-white group-hover:border-white/20 transition-colors">
                {index + 1}
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-white font-semibold group-hover:text-accent transition-colors truncate">
                  {module.title}
                </p>
                <p class="text-slate-500 text-sm mt-0.5 truncate">{module.description}</p>
              </div>
              <span class="shrink-0 text-xs text-slate-600 font-mono">{count} lez.</span>
            </a>
          );
        })}
      </div>

    </div>
  </main>

  <Footer />
</Layout>
