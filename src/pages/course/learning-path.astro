---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { COURSE_CAPSTONE, COURSE_MODULES, COURSE_TRACKS } from '../../data/course-modules';
import { ArrowLeft, ArrowRight, Trophy } from 'lucide-react';
import { CourseGraphExplorer } from '../../components/ui/CourseGraphExplorer';
import { buildCourseGraph } from '../../lib/course-graph';

const courseDocs = await getCollection('corso');
const coreCourseDocs = courseDocs.filter((doc) => doc.id.includes('/') && typeof doc.data.order === 'number');
const courseGraph = buildCourseGraph(courseDocs);
const totalLessons = coreCourseDocs.length;

const compactText = (value: string, maxLength = 150) =>
  value.length > maxLength ? `${value.slice(0, maxLength).trim()}...` : value;

const compactLessons = (lessons: typeof courseGraph.lessons) => lessons.map((lesson) => ({
  id: lesson.id,
  moduleId: lesson.moduleId,
  title: lesson.title,
  description: compactText(lesson.description, 130),
  order: lesson.order,
  category: lesson.category,
  duration: lesson.duration,
  difficulty: lesson.difficulty,
  prerequisites: lesson.prerequisites,
  dependents: lesson.dependents,
  externalPrerequisites: lesson.externalPrerequisites,
  externalDependents: lesson.externalDependents,
}));

const explorerGraph = {
  stats: courseGraph.stats,
  stages: courseGraph.stages.map((stage) => ({
    id: stage.id,
    index: stage.index,
    title: stage.title,
    description: stage.description,
    moduleIds: stage.moduleIds,
    moduleCount: stage.moduleCount,
    lessonCount: stage.lessonCount,
    internalLinkCount: stage.internalLinkCount,
    crossStageIncomingCount: stage.crossStageIncomingCount,
    crossStageOutgoingCount: stage.crossStageOutgoingCount,
  })),
  modules: courseGraph.modules.map((module) => ({
    id: module.id,
    index: module.index,
    title: module.title,
    description: module.description,
    color: module.color,
    stageId: module.stageId,
    stageTitle: module.stageTitle,
    lessonCount: module.lessonCount,
    internalLinkCount: module.internalLinkCount,
    crossModuleIncomingCount: module.crossModuleIncomingCount,
    crossModuleOutgoingCount: module.crossModuleOutgoingCount,
    lessons: compactLessons(module.lessons),
  })),
  lessons: compactLessons(courseGraph.lessons),
  moduleEdges: courseGraph.moduleEdges,
  stageEdges: [],
} as unknown as typeof courseGraph;

const lessonCounts = new Map<string, number>();
for (const doc of coreCourseDocs) {
  const moduleId = doc.id.split('/')[0];
  lessonCounts.set(moduleId, (lessonCounts.get(moduleId) || 0) + 1);
}

const trackCards = COURSE_TRACKS.map((track) => ({
  ...track,
  totalLessons: track.moduleIds.reduce((sum, moduleId) => sum + (lessonCounts.get(moduleId) || 0), 0),
  firstModuleHref: `/course/${track.moduleIds[0]}/`,
}));
---

<Layout
  title="Learning Path - Percorso completo | GinnyTech"
  description="Tutti i moduli del corso GinnyTech in sequenza: fasi, track, capstone, prerequisiti e link diretti a moduli e lezioni."
>
  <Navbar client:only="react" />

  <main id="main-content" class="relative min-h-screen bg-[var(--sl-color-bg)] pt-28 pb-20">
    <div class="container mx-auto px-6 max-w-7xl">

      {/* Back */}
      <a href="/#corsi" class="inline-flex items-center gap-2 text-slate-500 hover:text-white transition-colors text-sm mb-10 group">
        <div class="p-1 rounded-md bg-white/5 border border-white/10 group-hover:border-white/20 transition-colors">
          <ArrowLeft className="w-3 h-3" />
        </div>
        Torna ai corsi
      </a>

      {/* Header */}
      <div class="mb-12 max-w-4xl">
        <div class="inline-flex items-center gap-2 whitespace-nowrap px-3 py-1 rounded-full bg-white/5 border border-white/10 text-accent text-xs font-mono tracking-wider mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          {COURSE_MODULES.length} MODULI / {totalLessons} LEZIONI
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4 font-heading">
          Learning Path
        </h1>
        <p class="text-slate-400 text-lg max-w-2xl leading-relaxed">
          Il percorso completo dall'inizio alla fine: fasi, track specialistiche, lezioni ponte e capstone finale in una mappa navigabile.
        </p>
      </div>

      <section class="mb-10 grid gap-4 lg:grid-cols-3">
        {trackCards.map((track) => (
          <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
            <p class="text-[11px] uppercase tracking-[0.22em] text-accent">Track finale</p>
            <h2 class="mt-2 text-xl font-semibold text-white">{track.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-400">{track.summary}</p>
            <div class="mt-5 flex items-center justify-between text-sm text-slate-400">
              <span>{track.moduleIds.length} moduli</span>
              <span>{track.totalLessons} lezioni</span>
            </div>
            <a href={track.firstModuleHref} class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-accent transition hover:text-accent/80">
              Inizia questa track
              <ArrowRight className="h-4 w-4" />
            </a>
          </article>
        ))}
      </section>

      <section class="mb-12 rounded-2xl border border-accent/20 bg-accent/10 p-6 md:p-7">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-3xl">
            <div class="flex items-center gap-2 text-accent">
              <Trophy className="h-5 w-5" />
              <p class="text-[11px] font-semibold uppercase tracking-[0.22em]">Capstone finale</p>
            </div>
            <h2 class="mt-3 text-2xl font-semibold text-white">{COURSE_CAPSTONE.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-300">{COURSE_CAPSTONE.summary}</p>
          </div>
          <div class="grid grid-cols-2 gap-3 text-center text-sm">
            <div class="rounded-xl border border-white/10 bg-white/[0.05] p-4">
              <p class="text-3xl font-semibold text-white">{COURSE_CAPSTONE.milestones.length}</p>
              <p class="mt-1 text-slate-400">milestone</p>
            </div>
            <div class="rounded-xl border border-white/10 bg-white/[0.05] p-4">
              <p class="text-3xl font-semibold text-white">{COURSE_CAPSTONE.deliverables.length}</p>
              <p class="mt-1 text-slate-400">deliverable</p>
            </div>
          </div>
        </div>
      </section>

      <CourseGraphExplorer
        graph={explorerGraph}
        title="Mappa pubblica del corso GinnyTech"
        description="Naviga fasi, moduli, lezioni ponte e percorsi rapidi con dati ricavati dal catalogo reale del corso."
        client:only="react"
      />

    </div>
  </main>

  <Footer />
</Layout>
