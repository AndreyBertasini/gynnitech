---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { COURSE_CAPSTONE, COURSE_MODULES, COURSE_PHASES, COURSE_TRACKS } from '../../data/course-modules';
import { ArrowLeft, ArrowRight, BookOpen, CheckCircle2, Compass, Trophy } from 'lucide-react';
import { CourseGraphExplorer } from '../../components/ui/CourseGraphExplorer';
import { buildCourseGraph } from '../../lib/course-graph';

const courseDocs = await getCollection('corso');
const coreCourseDocs = courseDocs.filter((doc) => doc.id.includes('/') && typeof doc.data.order === 'number');
const courseGraph = buildCourseGraph(courseDocs);
const totalLessons = coreCourseDocs.length;

const compactText = (value: string, maxLength = 150) =>
  value.length > maxLength ? `${value.slice(0, maxLength).trim()}…` : value;

const compactLessons = (lessons: typeof courseGraph.lessons) => lessons.map((lesson) => ({
  id: lesson.id,
  moduleId: lesson.moduleId,
  title: lesson.title,
  description: compactText(lesson.description, 130),
  order: lesson.order,
  category: lesson.category,
  duration: lesson.duration,
  difficulty: lesson.difficulty,
  headerImage: lesson.headerImage,
  headerImageAlt: lesson.headerImageAlt,
  prerequisites: lesson.prerequisites,
  dependents: lesson.dependents,
  externalPrerequisites: lesson.externalPrerequisites,
  externalDependents: lesson.externalDependents,
}));

const compactLessonRefs = (lessons: typeof courseGraph.lessons) => lessons.map((lesson) => ({
  id: lesson.id,
  moduleId: lesson.moduleId,
}));

const explorerGraph = {
  stats: courseGraph.stats,
  stages: courseGraph.stages.map((stage) => ({
    id: stage.id,
    index: stage.index,
    title: stage.title,
    description: stage.description,
    moduleIds: stage.moduleIds,
    moduleCount: stage.moduleCount,
    lessonCount: stage.lessonCount,
    internalLinkCount: stage.internalLinkCount,
    crossStageIncomingCount: stage.crossStageIncomingCount,
    crossStageOutgoingCount: stage.crossStageOutgoingCount,
  })),
  modules: courseGraph.modules.map((module) => ({
    id: module.id,
    index: module.index,
    title: module.title,
    description: module.description,
    color: module.color,
    stageId: module.stageId,
    stageTitle: module.stageTitle,
    lessonCount: module.lessonCount,
    internalLinkCount: module.internalLinkCount,
    crossModuleIncomingCount: module.crossModuleIncomingCount,
    crossModuleOutgoingCount: module.crossModuleOutgoingCount,
    lessons: compactLessons(module.lessons),
  })),
  lessons: compactLessonRefs(courseGraph.lessons),
  moduleEdges: courseGraph.moduleEdges,
  stageEdges: [],
} as unknown as typeof courseGraph;

const lessonCounts = new Map<string, number>();
for (const doc of coreCourseDocs) {
  const moduleId = doc.id.split('/')[0];
  lessonCounts.set(moduleId, (lessonCounts.get(moduleId) || 0) + 1);
}

const trackCards = COURSE_TRACKS.map((track) => ({
  ...track,
  totalLessons: track.moduleIds.reduce((sum, moduleId) => sum + (lessonCounts.get(moduleId) || 0), 0),
  firstModuleHref: `/course/${track.moduleIds[0]}/`,
}));

const moduleCards = COURSE_MODULES.map((module, index) => {
  return {
    ...module,
    index: index + 1,
    lessonCount: lessonCounts.get(module.id) || 0,
    href: `/course/${module.id}/`,
  };
});

const phaseSections = COURSE_PHASES.map((phase) => ({
  ...phase,
  modules: moduleCards.filter((module) => module.phase === phase.id),
}));

const firstModule = moduleCards[0];

const studySteps = [
  'Se parti da zero, segui l’ordine consigliato dei moduli.',
  'Se hai già esperienza, scegli una track e studia solo i moduli collegati.',
  'Alla fine, usa il capstone per trasformare il percorso in un progetto portfolio.',
];
---

<Layout
  title="Learning Path GinnyTech - Percorso semplice del corso"
  description="Percorso consigliato GinnyTech: ordine dei moduli, track specialistiche e capstone finale per studiare analytics, MarTech e data engineering senza confusione."
>
  <Navbar client:only="react" />

  <main id="main-content" class="relative min-h-screen bg-[var(--sl-color-bg)] pt-28 pb-20 text-slate-100">
    <div class="container mx-auto max-w-6xl px-6">

      {/* Back */}
      <a href="/#corsi" class="mb-10 inline-flex items-center gap-2 text-sm text-slate-500 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40">
        <div class="rounded-md border border-white/10 bg-white/5 p-1 transition-colors">
          <ArrowLeft className="h-3 w-3" aria-hidden="true" />
        </div>
        Torna ai corsi
      </a>

      {/* Header */}
      <section class="grid gap-8 border-b border-white/10 pb-12 lg:grid-cols-[minmax(0,1.2fr)_360px] lg:items-end">
        <div>
          <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-mono tracking-wider text-accent">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
            {COURSE_MODULES.length} moduli / {totalLessons} lezioni
          </div>
          <h1 class="max-w-3xl text-balance font-heading text-3xl font-bold tracking-tight text-white md:text-4xl">
            Studia il corso nel giusto ordine.
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
            Questa pagina serve a scegliere il prossimo passo senza perdersi nel catalogo. Parti dall’ordine consigliato, poi scegli una track quando sai in quale direzione vuoi specializzarti.
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href={firstModule?.href ?? '/course/'} class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-5 py-3 text-sm font-semibold text-black transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50">
              Inizia dal primo modulo
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </a>
            <a href="#track" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-white/20 hover:bg-white/[0.07] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40">
              Scegli una track
            </a>
          </div>
        </div>

        <aside class="rounded-2xl border border-white/10 bg-white/[0.035] p-5">
          <div class="flex items-center gap-2 text-accent">
            <Compass className="h-5 w-5" aria-hidden="true" />
            <h2 class="text-sm font-semibold uppercase tracking-[0.2em]">Come usarla</h2>
          </div>
          <ol class="mt-5 space-y-4">
            {studySteps.map((step, index) => (
              <li class="flex gap-3 text-sm leading-6 text-slate-300">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-accent/30 bg-accent/10 text-xs font-semibold text-accent">{index + 1}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </aside>
      </section>

      <section id="ordine-consigliato" class="py-14">
        <div class="mb-8 max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">Ordine consigliato</p>
          <h2 class="mt-3 text-balance font-heading text-3xl font-bold text-white md:text-3xl">Da basi solide a sistemi avanzati.</h2>
          <p class="mt-4 text-base leading-7 text-slate-400">
            Se vuoi un percorso lineare, segui queste fasi dall’alto verso il basso. Ogni riga è un modulo: aprilo, completa le lezioni principali e passa alla fase successiva.
          </p>
        </div>

        <div class="space-y-5">
          {phaseSections.map((phase, phaseIndex) => (
            <section class="grid gap-4 rounded-2xl border border-white/10 bg-white/[0.025] p-5 lg:grid-cols-[260px_minmax(0,1fr)]">
              <div>
                <span class="inline-flex rounded-full border border-accent/25 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
                  Fase {phaseIndex + 1}
                </span>
                <h3 class="mt-3 text-xl font-semibold text-white">{phase.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-400">{phase.description}</p>
              </div>

              <ol class="space-y-3">
                {phase.modules.map((module) => (
                  <li>
                    <a href={module.href} class="group grid gap-3 rounded-xl border border-white/10 bg-[#0b1017] p-4 transition-colors hover:border-accent/30 hover:bg-[#101722] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 md:grid-cols-[96px_minmax(0,1fr)_auto] md:items-center">
                      <div class="text-sm text-slate-500">
                        Modulo <span class="font-semibold text-slate-200">{module.index}</span>
                      </div>
                      <div class="min-w-0">
                        <h4 class="text-pretty text-base font-semibold text-white group-hover:text-accent">{module.title}</h4>
                        <p class="mt-1 line-clamp-2 text-sm leading-6 text-slate-400">{module.description}</p>
                      </div>
                      <div class="flex items-center gap-3 text-sm text-slate-400 md:justify-end">
                        <span>{module.lessonCount} lezioni</span>
                        <ArrowRight className="h-4 w-4 text-accent" aria-hidden="true" />
                      </div>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </section>

      <section id="track" class="border-t border-white/10 py-14">
        <div class="mb-8 max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">Track specialistiche</p>
          <h2 class="mt-3 text-balance font-heading text-3xl font-bold text-white md:text-3xl">Scegli una direzione quando hai già le basi.</h2>
          <p class="mt-4 text-base leading-7 text-slate-400">
            Le track non sostituiscono l’ordine consigliato: aiutano a filtrare il percorso quando vuoi arrivare a un ruolo o a un tipo di progetto.
          </p>
        </div>

        <div class="grid gap-4 lg:grid-cols-3">
        {trackCards.map((track) => (
          <article class="flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">Track</p>
            <h3 class="mt-2 text-xl font-semibold text-white">{track.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-400">{track.summary}</p>
            <ul class="mt-5 space-y-3">
              {track.outcomes.slice(0, 2).map((outcome) => (
                <li class="flex gap-2 text-sm leading-6 text-slate-300">
                  <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
                  <span>{outcome}</span>
                </li>
              ))}
            </ul>
            <div class="mt-5 flex items-center justify-between border-t border-white/10 pt-4 text-sm text-slate-400">
              <span>{track.moduleIds.length} moduli</span>
              <span>{track.totalLessons} lezioni</span>
            </div>
            <a href={track.firstModuleHref} class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-accent transition-colors hover:text-accent/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40">
              Inizia questa track
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </a>
          </article>
        ))}
        </div>
      </section>

      <section class="rounded-2xl border border-accent/20 bg-accent/10 p-6 md:p-7">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-center">
          <div class="max-w-3xl">
            <div class="flex items-center gap-2 text-accent">
              <Trophy className="h-5 w-5" aria-hidden="true" />
              <p class="text-xs font-semibold uppercase tracking-[0.22em]">Capstone finale</p>
            </div>
            <h2 class="mt-3 text-balance text-2xl font-semibold text-white">{COURSE_CAPSTONE.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-300">
              Il capstone è il progetto finale: raccoglie tracking, KPI, architettura dati, dashboard, esperimento e raccomandazione economica in un unico caso presentabile.
            </p>
            <ul class="mt-5 grid gap-2 text-sm text-slate-300 md:grid-cols-2">
              {COURSE_CAPSTONE.deliverables.slice(0, 4).map((deliverable) => (
                <li class="flex gap-2">
                  <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-accent" aria-hidden="true" />
                  <span>{deliverable}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="grid grid-cols-2 gap-3 text-center text-sm tabular-nums">
            <div class="rounded-xl border border-white/10 bg-white/[0.05] p-4">
              <p class="text-3xl font-semibold text-white">{COURSE_CAPSTONE.milestones.length}</p>
              <p class="mt-1 text-slate-400">milestone</p>
            </div>
            <div class="rounded-xl border border-white/10 bg-white/[0.05] p-4">
              <p class="text-3xl font-semibold text-white">{COURSE_CAPSTONE.deliverables.length}</p>
              <p class="mt-1 text-slate-400">deliverable</p>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-12 border-t border-white/10 pt-10">
        <details class="group rounded-2xl border border-white/10 bg-white/[0.025] p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40">
            <div class="flex items-start gap-3">
              <BookOpen className="mt-1 h-5 w-5 shrink-0 text-accent" aria-hidden="true" />
              <div>
                <h2 class="text-xl font-semibold text-white">Mappa avanzata del corso</h2>
                <p class="mt-1 text-sm leading-6 text-slate-400">
                  Aprila solo quando vuoi cercare moduli, vedere prerequisiti, lezioni ponte e collegamenti tra argomenti.
                </p>
              </div>
            </div>
            <span class="shrink-0 rounded-full border border-white/10 px-3 py-1 text-xs font-semibold text-slate-300 transition-colors group-open:border-accent/30 group-open:text-accent">
              Apri
            </span>
          </summary>

          <div class="mt-8">
            <CourseGraphExplorer
              graph={explorerGraph}
              title="Mappa dettagliata GinnyTech"
              description="Usa questa vista quando vuoi studiare a salti, cercare una lezione specifica o capire quali moduli sono collegati."
              client:only="react"
            />
          </div>
        </details>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
