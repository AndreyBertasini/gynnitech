---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { ArrowLeft, MoveRight } from 'lucide-react';
import { buildCourseGraph, type CourseGraphModule } from '../../lib/course-graph';

const entry = await getEntry('corso', 'learning-path');
const courseEntries = await getCollection('corso');

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);
const courseGraph = buildCourseGraph(courseEntries);

const modulesById = new Map(courseGraph.modules.map((module) => [module.id, module]));

const stageNarrative: Record<string, { focus: string; reason: string }> = {
  foundation: {
    focus: 'Costruisci metodo, linguaggio, tracking e logica delle metriche.',
    reason: 'E la parte che rende leggibili tutti i moduli successivi.',
  },
  application: {
    focus: 'Porti il dato dentro prodotto, marketing, dashboard e primi modelli decisionali.',
    reason: 'Qui il corso smette di essere teoria generale e diventa lavoro reale.',
  },
  stack: {
    focus: 'Entri in warehouse, lake, streaming, realtime e disciplina operativa.',
    reason: 'Serve quando vuoi capire come i dati vengono prodotti, trasportati e mantenuti.',
  },
  rigor: {
    focus: 'Rafforzi SQL, matematica, analytics engineering e sperimentazione.',
    reason: 'E la fase che alza il livello tecnico e quantitativo delle decisioni.',
  },
  direction: {
    focus: 'Chiudi il percorso con traiettorie professionali, causalita e lettura critica dei dati.',
    reason: 'Ti aiuta a collegare il catalogo al lavoro e a una comprensione piu profonda.',
  },
};

const stageBlocks = courseGraph.stages.map((stage) => {
  const modules = stage.moduleIds
    .map((moduleId) => modulesById.get(moduleId))
    .filter((module): module is CourseGraphModule => Boolean(module));

  const firstModule = modules[0];
  const lastModule = modules[modules.length - 1];
  const rangeLabel = firstModule && lastModule
    ? firstModule.id === lastModule.id
      ? `M${firstModule.index + 1}`
      : `M${firstModule.index + 1}-M${lastModule.index + 1}`
    : '';

  return {
    ...stage,
    modules,
    rangeLabel,
    focus: stageNarrative[stage.id]?.focus ?? stage.description,
    reason: stageNarrative[stage.id]?.reason ?? '',
  };
});

interface RecommendedRoute {
  id: string;
  title: string;
  audience: string;
  description: string;
  stageTitles: string[];
  modules: CourseGraphModule[];
  lessonCount: number;
}

const buildRecommendedRoute = (
  id: string,
  title: string,
  audience: string,
  description: string,
  stageIds: string[],
): RecommendedRoute => {
  const includedStages = stageBlocks.filter((stage) => stageIds.includes(stage.id));
  const modules = includedStages.flatMap((stage) => stage.modules);

  return {
    id,
    title,
    audience,
    description,
    stageTitles: includedStages.map((stage) => stage.title),
    modules,
    lessonCount: modules.reduce((sum, module) => sum + module.lessonCount, 0),
  };
};

const recommendedRoutes = [
  buildRecommendedRoute(
    'guided-start',
    'Partenza guidata',
    'Per chi vuole capire il corso senza salti e costruire basi solide.',
    'Segui prima i moduli introduttivi, poi scegli una specializzazione con piu lucidita.',
    ['foundation'],
  ),
  buildRecommendedRoute(
    'business-focus',
    'Focus business',
    'Per chi lavora gia su prodotto, marketing o dashboard e vuole ordine prima di velocita.',
    'Usa la fondazione per non studiare in modo frammentato, poi entra nell applicazione business.',
    ['foundation', 'application'],
  ),
  buildRecommendedRoute(
    'technical-focus',
    'Focus tecnico',
    'Per chi vuole arrivare a tracking, architettura dati, realtime e analytics engineering.',
    'Dopo la base, spostati sullo stack tecnico e poi consolida il rigore quantitativo.',
    ['foundation', 'stack', 'rigor'],
  ),
  buildRecommendedRoute(
    'quantitative-focus',
    'Focus quantitativo',
    'Per chi vuole lavorare meglio su SQL, matematica, testing, causalita e decisioni rigorose.',
    'Parti dalle fondamenta, poi approfondisci rigore quantitativo e lettura critica dei risultati.',
    ['foundation', 'rigor', 'direction'],
  ),
];

const fullPathLabel = stageBlocks
  .map((stage) => `${stage.rangeLabel} ${stage.title}`)
  .join(' -> ');

const moduleSequenceLabel = (modules: CourseGraphModule[]): string =>
  modules.map((module) => `M${module.index + 1}`).join(' -> ');
---

<Layout title={entry.data.title} description={entry.data.description}>
  <Navbar client:idle />

  <main id="main-content" class="relative min-h-screen overflow-hidden bg-[#050505] pt-24 pb-16 sm:pt-28 md:pt-32 md:pb-20">
    <div class="container relative z-10 mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12">
        <a href="/course" class="inline-flex items-center gap-2 text-slate-500 hover:text-white transition-colors text-sm group">
          <div class="p-1 rounded-md bg-white/5 border border-white/10 group-hover:border-white/20 transition-colors">
            <ArrowLeft className="w-3 h-3" />
          </div>
          Torna ai Corsi
        </a>
      </div>

      <div class="mx-auto max-w-6xl space-y-10 md:space-y-14">
        <section class="rounded-[28px] border border-white/10 bg-[radial-gradient(circle_at_top_left,_rgba(0,243,255,0.12),_transparent_35%),linear-gradient(180deg,rgba(13,18,28,0.98),rgba(6,8,14,0.98))] p-5 shadow-[0_32px_90px_-54px_rgba(0,243,255,0.4)] sm:p-7 md:rounded-[32px] md:p-9 xl:p-10">
          <div class="max-w-4xl">
            <div class="inline-flex items-center gap-2 rounded-full border border-neon-blue/20 bg-neon-blue/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-neon-blue">
              Percorso completo
            </div>
            <h1 class="mt-5 font-heading text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl xl:text-6xl">
              {entry.data.title}
            </h1>
            <p class="mt-5 max-w-3xl text-[15px] leading-7 text-slate-300 sm:text-base sm:leading-8 md:text-lg">
              {entry.data.description}
            </p>
            <p class="mt-4 hidden max-w-3xl text-sm leading-7 text-slate-400 sm:block">
              Questa pagina e volutamente semplice: ti mostra l ordine del percorso, le 5 fasi in cui si divide e alcuni ingressi consigliati.
              I dettagli piu tecnici restano dentro i moduli e nelle lezioni.
            </p>
          </div>

          <div class="mt-8 grid grid-cols-3 gap-2 sm:gap-3">
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-3 sm:p-4">
              <p class="text-[10px] uppercase tracking-[0.18em] text-slate-500 sm:text-[11px]">Moduli</p>
              <p class="mt-2 text-2xl font-semibold text-white sm:text-3xl">{courseGraph.stats.totalModules}</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-3 sm:p-4">
              <p class="text-[10px] uppercase tracking-[0.18em] text-slate-500 sm:text-[11px]">Lezioni</p>
              <p class="mt-2 text-2xl font-semibold text-white sm:text-3xl">{courseGraph.stats.totalLessons}</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-3 sm:p-4">
              <p class="text-[10px] uppercase tracking-[0.18em] text-slate-500 sm:text-[11px]">Fasi</p>
              <p class="mt-2 text-2xl font-semibold text-white sm:text-3xl">{stageBlocks.length}</p>
            </div>
          </div>

          <div class="mt-8 rounded-[24px] border border-white/10 bg-white/[0.04] p-4 sm:rounded-[28px] sm:p-5">
            <p class="text-[11px] uppercase tracking-[0.2em] text-slate-500">Lettura rapida del percorso</p>
            <p class="mt-3 text-base font-semibold leading-7 text-white sm:text-lg sm:leading-8">{fullPathLabel}</p>
            <p class="mt-3 text-sm leading-7 text-slate-400">
              La logica generale e lineare: prima basi e metodo, poi applicazione, poi stack, poi rigore, infine direzioni professionali e profondita concettuale.
            </p>
          </div>
        </section>

        <section class="space-y-5">
          <div class="max-w-3xl">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-neon-mint">Le 5 fasi</p>
            <h2 class="mt-2 text-2xl font-semibold text-white sm:text-3xl">Il corso e organizzato come un percorso, non come un archivio</h2>
            <p class="mt-3 text-sm leading-7 text-slate-400">
              Ogni fase ha un ruolo preciso. Se capisci questa sequenza, capisci anche perche ogni modulo sta dove sta.
            </p>
          </div>

          <div class="grid gap-3 sm:gap-4 xl:grid-cols-5">
            {stageBlocks.map((stage, index) => (
              <article class="rounded-[24px] border border-white/10 bg-[#0b1017]/90 p-4 sm:rounded-[28px] sm:p-5">
                <div class="flex items-center justify-between gap-3">
                  <span class="rounded-full border border-white/10 bg-white/[0.05] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-300">
                    Fase {index + 1}
                  </span>
                  <span class="text-xs text-neon-blue">{stage.rangeLabel}</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-white sm:text-xl">{stage.title}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-300">{stage.focus}</p>
                <p class="mt-3 text-sm leading-7 text-slate-400">{stage.reason}</p>
                <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
                  <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-3">
                    <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Moduli</p>
                    <p class="mt-1 text-white">{stage.moduleCount}</p>
                  </div>
                  <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-3">
                    <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Lezioni</p>
                    <p class="mt-1 text-white">{stage.lessonCount}</p>
                  </div>
                </div>
                <div class="mt-5 flex flex-wrap gap-2">
                  {stage.modules.map((module) => (
                    <a href={`/course/${module.id}/`} class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-slate-300 transition hover:border-white/20 hover:text-white">
                      M{module.index + 1} {module.title}
                    </a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="space-y-5">
          <div class="max-w-3xl">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-acid-yellow">Ingressi consigliati</p>
            <h2 class="mt-2 text-2xl font-semibold text-white sm:text-3xl">Prima guarda il percorso completo, poi scegli da dove entrare</h2>
            <p class="mt-3 text-sm leading-7 text-slate-400">
              Questi non sostituiscono il percorso intero. Sono modi pratici per orientarti senza perdere la logica generale del catalogo.
            </p>
          </div>

          <div class="grid gap-3 sm:gap-4 lg:grid-cols-2 xl:grid-cols-4">
            {recommendedRoutes.map((route) => (
              <article class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4 sm:rounded-[28px] sm:p-5">
                <p class="text-[11px] uppercase tracking-[0.2em] text-slate-500">Percorso consigliato</p>
                <h3 class="mt-2 text-lg font-semibold text-white sm:text-xl">{route.title}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-300">{route.audience}</p>
                <p class="mt-3 hidden text-sm leading-7 text-slate-400 sm:block">{route.description}</p>
                <div class="mt-4">
                  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Fasi incluse</p>
                  <div class="mt-2 flex flex-wrap gap-2">
                    {route.stageTitles.map((stageTitle) => (
                      <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-slate-300">
                        {stageTitle}
                      </span>
                    ))}
                  </div>
                </div>
                <div class="mt-4 hidden rounded-2xl border border-white/10 bg-white/[0.04] p-3 sm:block">
                  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Moduli inclusi</p>
                  <p class="mt-2 text-sm leading-7 text-white">{moduleSequenceLabel(route.modules)}</p>
                </div>
                <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
                  <div class="rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-2 text-slate-400">
                    <span>{route.modules.length} moduli</span>
                  </div>
                  <div class="rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-2 text-slate-400">
                    <span>{route.lessonCount} lezioni</span>
                  </div>
                </div>
                {route.modules[0] && (
                  <a href={`/course/${route.modules[0].id}/`} class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-neon-blue transition hover:text-neon-blue/80">
                    Inizia da {route.modules[0].title}
                    <MoveRight className="h-4 w-4" />
                  </a>
                )}
              </article>
            ))}
          </div>
        </section>

        <section class="space-y-6">
          <div class="max-w-3xl">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-neon-blue">Programma completo</p>
            <h2 class="mt-2 text-2xl font-semibold text-white sm:text-3xl">Tutti i moduli, nell ordine reale del percorso</h2>
            <p class="mt-3 text-sm leading-7 text-slate-400">
              Questa e la parte piu importante della pagina: i 19 moduli sono mostrati in sequenza e raggruppati per fase, cosi il percorso intero resta leggibile anche quando il catalogo cresce.
            </p>
          </div>

          <div class="space-y-6">
            {stageBlocks.map((stage) => (
              <section class="rounded-[28px] border border-white/10 bg-[#0b1017]/90 p-5 sm:p-6 md:rounded-[32px] md:p-7">
                <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                  <div class="max-w-3xl">
                    <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-300">
                      {stage.rangeLabel}
                    </div>
                    <h3 class="mt-4 text-xl font-semibold text-white sm:text-2xl">{stage.title}</h3>
                    <p class="mt-3 text-sm leading-7 text-slate-300">{stage.focus}</p>
                  </div>
                  <div class="flex flex-wrap gap-3 text-sm text-slate-400">
                    <span>{stage.moduleCount} moduli</span>
                    <span>{stage.lessonCount} lezioni</span>
                  </div>
                </div>

                <div class="mt-6 grid gap-3 sm:gap-4 lg:grid-cols-2">
                  {stage.modules.map((module) => (
                    <article class="rounded-[24px] border border-white/10 bg-white/[0.03] p-4 sm:rounded-[28px] sm:p-5">
                      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                        <div class="max-w-3xl">
                          <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Modulo {module.index + 1}</p>
                          <h4 class="mt-2 text-lg font-semibold text-white sm:text-xl">{module.title}</h4>
                          <p class="mt-3 text-sm leading-7 text-slate-300">{module.description}</p>
                        </div>
                        <div class="shrink-0 self-start rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-2 text-left sm:text-right">
                          <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Lezioni</p>
                          <p class="mt-1 text-lg font-semibold text-white">{module.lessonCount}</p>
                        </div>
                      </div>

                      {module.lessons[0] && (
                        <div class="mt-4 rounded-2xl border border-white/10 bg-white/[0.04] p-4">
                          <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Prima lezione</p>
                          <p class="mt-2 text-sm font-medium text-white">{module.lessons[0].title}</p>
                          <p class="mt-1 hidden text-sm leading-6 text-slate-400 sm:block">{module.lessons[0].description}</p>
                        </div>
                      )}

                      <div class="mt-5 flex flex-col gap-3 text-sm sm:flex-row sm:flex-wrap sm:gap-4">
                        <a href={`/course/${module.id}/`} class="inline-flex items-center gap-2 text-neon-blue transition hover:text-neon-blue/80">
                          Apri modulo
                          <MoveRight className="h-4 w-4" />
                        </a>
                        {module.lessons[0] && (
                          <a href={`/course/${module.lessons[0].id}/`} class="inline-flex items-center gap-2 text-slate-300 transition hover:text-white">
                            Vai alla prima lezione
                            <MoveRight className="h-4 w-4" />
                          </a>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </section>

        <section class="rounded-[28px] border border-white/10 bg-white/[0.03] p-5 sm:p-6 md:rounded-[32px] md:p-8">
          <div class="mx-auto max-w-4xl">
            <div class="prose prose-invert prose-base max-w-none prose-headings:font-montserrat prose-headings:font-bold prose-h2:text-white prose-h3:text-slate-200 prose-p:text-slate-400 prose-li:text-slate-300 prose-a:text-neon-mint hover:prose-a:text-neon-mint/80 prose-strong:text-white prose-code:text-indigo-300 prose-pre:bg-[#13151a] prose-pre:border prose-pre:border-white/10 sm:prose-lg">
              <Content />
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
