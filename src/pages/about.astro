---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import {
  ArrowRight,
  ArrowUpRight,
  Award,
  BookOpen,
  Briefcase,
  CheckCircle2,
  Database,
  GraduationCap,
} from 'lucide-react';
import Footer from '../components/Footer.astro';
import { Navbar } from '../components/Navbar';
import andriiImage from '../assets/andrii.webp';
import { BOOKING_URL, CREDLY_CLICKHOUSE_BADGE_URL, GITHUB_REPO_URL, LINKEDIN_URL } from '../consts';
import { COURSE_MODULES } from '../data/course-modules';
import Layout from '../layouts/Layout.astro';
import { PERSON_TOPICS, personNode } from '../lib/entity';
import { serializeJsonLd } from '../utils/jsonld';

const totalModules = COURSE_MODULES.length;
const totalLessons = (await getCollection('corso')).filter((entry) => entry.id.includes('/')).length;

const personJsonLd = serializeJsonLd({ '@context': 'https://schema.org', ...personNode() });
---

<Layout
  title="Andrii Dyshkantiuk - Analytics Engineer & ClickHouse Certified Developer | GinnyTech"
  description="Chi è Andrii Dyshkantiuk: Analytics Engineer, ClickHouse Certified Developer ed esperto di MarTech in Italia con oltre 15 anni di esperienza tra data engineering, dbt, Kafka, ClickHouse e consulenza B2B."
  image={andriiImage.src}
  preloadImage
  markdownAlternate="/about.md"
  keywords={[
    'Andrii Dyshkantiuk',
    'ClickHouse Certified Developer',
    'Analytics Engineer Italia',
    'Consulente ClickHouse Italia',
    'Consulente Analytics Engineering',
    'MarTech Expert',
    'Data Engineer',
    'dbt',
    'ClickHouse',
    'Kafka',
  ]}
>
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main id="main-content" class="relative flex-1 overflow-hidden bg-[var(--sl-color-bg)] selection:bg-accent/30 selection:text-white" data-pagefind-body>
      <script type="application/ld+json" set:html={personJsonLd} is:inline />

      <div class="absolute inset-x-0 top-0 h-[42rem] bg-gradient-to-b from-accent/20 via-transparent to-transparent pointer-events-none"></div>

      <div class="container mx-auto px-6 pt-28 pb-20 relative z-10">
        <section class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(320px,0.85fr)] lg:gap-14">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold tracking-[0.24em] text-accent uppercase backdrop-blur-sm">
              <span class="h-2 w-2 rounded-full bg-accent shadow-[0_0_12px_rgba(204,255,0,0.9)]"></span>
              Analytics Engineer · ClickHouse Certified Developer
            </div>

            <h1 class="mt-6 max-w-4xl font-heading text-3xl font-bold leading-tight text-white md:text-4xl">
              Costruisco architetture dati, warehouse real-time e sistemi di analytics che reggono in produzione.
            </h1>

            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300 md:text-xl">
              Sono <strong class="text-white">Andrii Dyshkantiuk</strong> — <strong class="text-accent">Analytics Engineer</strong>, <strong class="text-accent">ClickHouse Certified Developer</strong> ed esperto di MarTech. Con GinnyTech porto oltre 15 anni di progetti reali in un percorso formativo open-source e in servizi di consulenza B2B.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-400 md:text-lg">
              Affianco aziende, SaaS ed e-commerce in Italia nella progettazione di data warehouse su <strong class="text-slate-200">ClickHouse</strong>, modellazione <strong class="text-slate-200">dbt</strong>, pipeline streaming <strong class="text-slate-200">Kafka</strong>, riduzione costi BigQuery/Snowflake e Product Analytics proprietaria.
            </p>

            <div class="mt-8 grid gap-3 sm:grid-cols-3">
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-sm">
                <div class="font-heading text-3xl font-bold text-accent">15+</div>
                <p class="mt-1 text-sm text-slate-400">Anni sul campo tra marketing, BI e infrastruttura dati</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-sm">
                <div class="font-heading text-3xl font-bold text-accent">{totalModules}</div>
                <p class="mt-1 text-sm text-slate-400">Moduli pubblicati nel percorso formativo</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-sm">
                <div class="font-heading text-3xl font-bold text-white">{totalLessons}</div>
                <p class="mt-1 text-sm text-slate-400">Lezioni pratiche già online e consultabili gratis</p>
              </div>
            </div>

            <div class="mt-10 flex flex-wrap gap-4">
              <a
                href={BOOKING_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3 font-ui text-sm font-semibold text-white transition hover:border-accent/50 hover:bg-white/[0.08] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]"
              >
                Prenota una call
                <ArrowUpRight className="h-4 w-4" />
              </a>
            </div>
          </div>

          <aside class="glass-panel rounded-[2rem] p-5 sm:p-6">
            <div class="overflow-hidden rounded-[1.5rem] border border-white/10 bg-black/30">
              <Image
                src={andriiImage}
                alt="Ritratto di Andrii Dyshkantiuk - Analytics Engineer e ClickHouse Certified Developer"
                class="aspect-[3/4] w-full object-cover"
                loading="eager"
                decoding="async"
                quality={88}
              />
            </div>

            <div class="mt-5 flex flex-wrap gap-2">
              <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">ClickHouse Certified Developer</span>
              <span class="rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-xs font-semibold text-accent">Analytics Engineering (dbt)</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-200">MarTech &amp; Product Analytics</span>
            </div>

            <div class="mt-5 rounded-[1.5rem] border border-white/10 bg-white/[0.03] p-5">
              <h2 class="font-heading text-2xl font-bold text-white">Cosa porto nel progetto</h2>
              <ul class="mt-4 space-y-3 text-sm leading-relaxed text-slate-300">
                <li class="flex gap-3">
                  <span class="mt-1 text-accent">●</span>
                  <span>Esperienza diretta con dashboard, tracking, reporting e decisioni operative.</span>
                </li>
                <li class="flex gap-3">
                  <span class="mt-1 text-accent">●</span>
                  <span>Competenza tecnica su pipeline, warehouse, SQL, Python, ClickHouse e Kafka.</span>
                </li>
                <li class="flex gap-3">
                  <span class="mt-1 text-white">●</span>
                  <span>Un approccio didattico che punta a trasferire metodo, non solo nozioni.</span>
                </li>
              </ul>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
              <a
                href={LINKEDIN_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 transition hover:text-accent"
              >
                LinkedIn
                <ArrowUpRight className="h-4 w-4" />
              </a>
              <a
                href={GITHUB_REPO_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 transition hover:text-accent"
              >
                GitHub
                <ArrowUpRight className="h-4 w-4" />
              </a>
            </div>
          </aside>
        </section>

        <section class="mt-16 md:mt-20">
          <div class="max-w-2xl">
            <h2 class="font-heading text-3xl font-bold text-white md:text-3xl">Come lavoro</h2>
            <p class="mt-4 text-lg leading-relaxed text-slate-400">
              Il mio lavoro sta nel punto in cui il marketing smette di essere solo creatività e diventa anche
              infrastruttura, misurazione e disciplina operativa.
            </p>
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-3">
            <article class="group rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm transition hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_0_30px_rgba(204,255,0,0.08)]">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent">
                <Database className="h-5 w-5" />
              </div>
              <h3 class="mt-5 font-heading text-2xl font-bold text-white">Analytics che regge</h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Definisco metriche, sistemi di tracciamento e controlli di qualità per evitare dashboard belle ma inutili.
              </p>
            </article>

            <article class="group rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm transition hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_0_30px_rgba(204,255,0,0.08)]">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-accent/20 bg-accent/10 text-accent">
                <Briefcase className="h-5 w-5" />
              </div>
              <h3 class="mt-5 font-heading text-2xl font-bold text-white">Progetti reali, non demo</h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Lavoro su casi in cui ogni scelta impatta budget, funnel, reporting manageriale e operatività dei team.
              </p>
            </article>

            <article class="group rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm transition hover:-translate-y-1 hover:border-white/25 hover:shadow-[0_0_30px_rgba(255,255,255,0.06)]">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-white/15 bg-white/5 text-white">
                <GraduationCap className="h-5 w-5" />
              </div>
              <h3 class="mt-5 font-heading text-2xl font-bold text-white">Formazione trasferibile</h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Spiego strumenti e logiche in modo che restino utili anche quando cambiano stack, team o piattaforme.
              </p>
            </article>
          </div>

          <!-- Certificazione Ufficiale ClickHouse Certified Developer -->
          <div class="mt-10 rounded-[2rem] border border-accent/30 bg-gradient-to-br from-accent/[0.08] via-white/[0.02] to-transparent p-8 md:p-10">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
              <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 rounded-full border border-accent/35 bg-accent/15 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
                  <Award className="h-4 w-4" />
                  Certificazione Tecnica Ufficiale
                </div>
                <h2 class="mt-4 font-heading text-2xl font-bold text-white md:text-3xl">
                  ClickHouse Certified Developer
                </h2>
                <p class="mt-3 text-base leading-relaxed text-slate-300">
                  Credenziale tecnica ufficiale rilasciata da <strong class="text-white">ClickHouse Inc.</strong> al superamento dell&apos;esame pratico hands-on su architettura colonnare <code class="text-accent">MergeTree</code> (<code class="text-accent">ReplacingMergeTree</code>, <code class="text-accent">AggregatingMergeTree</code>), progettazione di <code class="text-accent">PRIMARY KEY</code> e <code class="text-accent">ORDER BY</code>, Materialized Views incrementali, ingestion da Kafka/S3 e query tuning su miliardi di righe.
                </p>
                <ul class="mt-5 grid gap-2.5 sm:grid-cols-2 text-sm text-slate-300">
                  <li class="flex items-center gap-2">
                    <CheckCircle2 className="h-4 w-4 shrink-0 text-accent" />
                    <span>Migrazione da BigQuery / Snowflake a ClickHouse</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <CheckCircle2 className="h-4 w-4 shrink-0 text-accent" />
                    <span>Offloading analitico da PostgreSQL lento</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <CheckCircle2 className="h-4 w-4 shrink-0 text-accent" />
                    <span>Pipeline Real-Time Kafka + ClickHouse + dbt</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <CheckCircle2 className="h-4 w-4 shrink-0 text-accent" />
                    <span>Audit performance, compressione e cluster sizing</span>
                  </li>
                </ul>
                <div class="mt-6 flex flex-wrap gap-3">
                  <a
                    href={CREDLY_CLICKHOUSE_BADGE_URL}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-3 font-ui text-sm font-semibold text-white transition hover:border-accent/50 hover:text-accent"
                  >
                    Verifica Badge su Credly
                    <ArrowUpRight className="h-4 w-4" />
                  </a>
                </div>
              </div>

              <div class="shrink-0 rounded-[1.5rem] border border-white/10 bg-[#0b0d13] p-6 text-center lg:w-72">
                <div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-2xl border border-accent/35 bg-accent/15 text-accent">
                  <Award className="h-7 w-7" />
                </div>
                <div class="text-xs font-semibold uppercase tracking-widest text-slate-400">Verified Credential</div>
                <div class="mt-1 font-heading text-lg font-bold text-white">ClickHouse Certified Developer</div>
                <div class="mt-1 text-xs text-slate-400">Hands-on Practical Exam · ClickHouse</div>
                <a
                  href="/course/real-time-analytics/"
                  class="mt-4 inline-flex items-center justify-center gap-1.5 text-xs font-semibold text-accent hover:underline"
                >
                  Esplora il modulo ClickHouse gratuito
                  <ArrowRight className="h-3.5 w-3.5" />
                </a>
              </div>
            </div>
          </div>
        </section>

        <section class="mt-16 md:mt-20" aria-labelledby="temi">
          <div class="max-w-2xl">
            <h2 id="temi" class="font-heading text-3xl font-bold text-white md:text-3xl">Temi su cui lavoro e insegno</h2>
            <p class="mt-4 text-lg leading-relaxed text-slate-400">
              Ogni tema porta al modulo del corso in cui lo affronto, con esempi e casi pratici.
            </p>
          </div>

          <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {PERSON_TOPICS.map((topic) => (
              <li>
                <a
                  href={topic.href}
                  class="group flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 font-semibold text-slate-200 backdrop-blur-sm transition hover:border-accent/40 hover:text-accent"
                >
                  {topic.name}
                  <ArrowRight className="h-4 w-4 shrink-0 text-slate-500 transition group-hover:text-accent" />
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="mt-16 grid gap-6 md:mt-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(300px,0.95fr)]">
          <article class="glass-panel rounded-[2rem] p-8 md:p-10">
            <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-accent">
              <BookOpen className="h-4 w-4" />
              Perché esiste GinnyTech
            </div>

            <h2 class="mt-5 font-heading text-3xl font-bold text-white md:text-3xl">
              Ho creato il sito che avrei voluto trovare anni fa.
            </h2>

            <div class="mt-6 space-y-4 text-base leading-relaxed text-slate-300 md:text-lg">
              <p>
                In Italia si trovano corsi di marketing, corsi di programmazione e corsi di analytics. Quasi mai si trovano
                nello stesso posto, con una logica unica e con esempi che somigliano al lavoro vero.
              </p>
              <p>
                GinnyTech nasce per chi deve collegare dati, strumenti, reporting e decisioni. È un progetto
                <strong class="text-white">open-source</strong>, senza paywall, costruito per dare un metodo concreto.
              </p>
              <p>
                Ogni lezione è pensata per ridurre il divario tra “so la teoria” e “so come impostare il lavoro quando nessuno
                mi dice da dove iniziare”.
              </p>
            </div>
          </article>

          <article class="rounded-[2rem] border border-white/10 bg-white/[0.03] p-8 md:p-10">
            <h2 class="font-heading text-2xl font-bold text-white md:text-3xl">Principi del progetto</h2>

            <div class="mt-6 space-y-4">
              <div class="rounded-2xl border border-accent/15 bg-accent/[0.03] p-4">
                <h3 class="font-heading text-lg font-bold text-white">Niente fuffa</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">Solo concetti, strumenti e problemi che tornano davvero nella pratica.</p>
              </div>
              <div class="rounded-2xl border border-accent/15 bg-accent/[0.03] p-4">
                <h3 class="font-heading text-lg font-bold text-white">Metodo prima degli strumenti</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">Gli stack cambiano. Il modo corretto di ragionare sui dati resta.</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <h3 class="font-heading text-lg font-bold text-white">Accesso aperto</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">La conoscenza tecnica utile non dovrebbe essere bloccata dietro un abbonamento.</p>
              </div>
            </div>
          </article>
        </section>

        <section class="mt-16 md:mt-20">
          <div class="max-w-2xl">
            <h2 class="font-heading text-3xl font-bold text-white md:text-3xl">Per chi è utile</h2>
            <p class="mt-4 text-lg leading-relaxed text-slate-400">
              GinnyTech serve sia a chi sta entrando in questo mondo, sia a chi deve rimettere ordine in sistemi già
              esistenti e troppo frammentati.
            </p>
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-2">
            <article class="rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm">
              <h3 class="font-heading text-2xl font-bold text-white">Studenti e professionisti junior</h3>
              <ul class="mt-5 space-y-3 text-slate-400">
                <li class="flex gap-3"><span class="mt-1 text-accent">●</span><span>Per capire come si collegano marketing, analytics e infrastruttura dati.</span></li>
                <li class="flex gap-3"><span class="mt-1 text-accent">●</span><span>Per costruire competenze spendibili, non solo definizioni da memorizzare.</span></li>
                <li class="flex gap-3"><span class="mt-1 text-accent">●</span><span>Per imparare a leggere problemi reali con strumenti reali.</span></li>
              </ul>
            </article>

            <article class="rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm">
              <h3 class="font-heading text-2xl font-bold text-white">Team, founder e aziende</h3>
              <ul class="mt-5 space-y-3 text-slate-400">
                <li class="flex gap-3"><span class="mt-1 text-accent">●</span><span>Per mettere ordine tra tracking, pipeline, KPI e reporting decisionale.</span></li>
                <li class="flex gap-3"><span class="mt-1 text-accent">●</span><span>Per allineare marketing e tecnologia con un linguaggio comune.</span></li>
                <li class="flex gap-3"><span class="mt-1 text-accent">●</span><span>Per trasformare consulenza e formazione in competenza interna, non dipendenza esterna.</span></li>
              </ul>
            </article>
          </div>
        </section>

        <section class="mt-16 rounded-[2rem] border border-white/10 bg-gradient-to-br from-white/[0.05] via-white/[0.03] to-accent/[0.04] p-8 md:mt-20 md:p-10">
          <div class="max-w-3xl">
            <h2 class="font-heading text-3xl font-bold text-white md:text-3xl">
              Se vuoi imparare dal lavoro reale, parti da qui.
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-slate-300">
              Puoi iniziare subito dal corso gratuito, oppure prenotare una call se hai un progetto, un dubbio tecnico o
              una direzione da chiarire.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/#corsi"
              class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3 font-ui text-sm font-semibold text-white transition hover:border-accent/50 hover:text-accent"
            >
              Vai al percorso gratuito
              <ArrowRight className="h-4 w-4" />
            </a>
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3 font-ui text-sm font-semibold text-white transition hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--sl-color-bg)]"
            >
              Prenota una call
              <ArrowUpRight className="h-4 w-4" />
            </a>
          </div>
        </section>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
