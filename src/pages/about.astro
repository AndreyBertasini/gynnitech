---
import { Image } from 'astro:assets';
import Footer from '../components/Footer.astro';
import { Navbar } from '../components/Navbar';
import andriiImage from '../assets/andrii.webp';
import {
  CLICKHOUSE_CERTIFICATE_URL,
  CONFLUENT_CERTIFICATE_URL,
  GITHUB_REPO_URL,
  LINKEDIN_CERTIFICATIONS_URL,
  LINKEDIN_URL,
  SITE_URL,
} from '../consts';
import Layout from '../layouts/Layout.astro';
import { PERSON_URL, personNode } from '../lib/entity';
import { serializeJsonLd } from '../utils/jsonld';

// Il copy segue il design handoff "Chi sono". Non esiste una versione inglese rivista:
// /en/about/ risponde 301 verso questa pagina (scripts/write-i18n-redirects.ts).
const title = 'Andrii Dyshkantiuk · Analytics Engineer e Real-time Analytics | GinnyTech';
const description =
  'Andrii Dyshkantiuk, Analytics Engineer certificato ClickHouse e Confluent: data analytics, analytics engineering e real-time analytics con Kafka, ClickHouse e dbt.';

const specs = [
  { label: 'Esperienza', value: '15+ anni', note: 'tra dati, marketing e prodotto' },
  { label: 'Certificazione', value: 'ClickHouse · Confluent', note: 'Certified Developer · Data Streaming Engineer' },
  { label: 'Specializzazione', value: 'Real-time', note: 'streaming, OLAP, aggregazioni continue' },
  { label: 'Stack', value: 'Kafka · dbt', note: 'ClickHouse, SQL, Python, S3 / Iceberg' },
];

const disciplines = [
  {
    href: '/course/significativita-statistica/',
    title: 'Data Analytics',
    claim: 'Domande giuste, metriche difendibili.',
    text: 'KPI tree, sperimentazione, attribuzione e inferenza causale. Numeri che reggono davanti a un board.',
    tags: 'A/B test · MMM · coorti →',
  },
  {
    href: '/course/analytics-engineering/',
    title: 'Analytics Engineering',
    claim: 'Il dato trattato come codice.',
    text: 'Modelli dbt testati, data contract e semantic layer. Ogni metrica ha una definizione, un proprietario, una storia.',
    tags: 'dbt · data contract · CI/CD →',
  },
  {
    href: '/course/real-time-analytics/',
    title: 'Real-time Analytics',
    claim: 'Secondi, non giorni.',
    text: 'Streaming con Kafka, ingestion ad alto throughput e materialized view su ClickHouse. Alert quando succede, non dopo.',
    tags: 'Kafka · ClickHouse · CDC →',
  },
];

const flow = [
  { step: '01 · Sorgenti', name: 'Eventi', text: 'App, web, CRM, CDC dai database operativi' },
  { step: '02 · Stream', name: 'Kafka', text: 'Schemi versionati, garanzie di consegna' },
  { step: '03 · OLAP', name: 'ClickHouse', text: 'MergeTree e materialized view progettate sulle query', hl: true },
  { step: '04 · Modelli', name: 'dbt', text: 'Trasformazioni testate, semantic layer' },
  { step: '05 · Azione', name: 'Decisione', text: 'Dashboard, alert, reverse ETL verso i team' },
];

const confluentScores = [
  { topic: 'Apache Kafka', score: 100 },
  { topic: 'Kafka Connect', score: 100 },
  { topic: 'Kafka Streams', score: 100 },
  { topic: 'Schema Registry', score: 100 },
  { topic: 'Apache Flink', score: 88 },
];

const otherCerts = [
  { issuer: 'Databricks', name: 'Azure Databricks Platform Architect', date: '2025 · valida fino 2027' },
  { issuer: 'Anthropic', name: 'Building with the Claude API', date: '2026' },
  { issuer: 'HackerRank', name: 'SQL Advanced', date: '2025' },
  { issuer: 'ClickHouse', name: 'ClickHouse Developer Course', date: '2025' },
  { issuer: 'Uplimit', name: 'Data Storytelling', date: '2025' },
];

const principles = [
  { title: 'La latenza è una scelta di business.', text: 'Real-time dove cambia una decisione, batch dove basta. Il costo segue il valore.' },
  { title: 'Ogni numero è riproducibile.', text: 'Versionato, testato, documentato. Se una metrica cambia, si sa dove e perché.' },
  { title: 'Prima la domanda, poi lo stack.', text: 'Gli strumenti cambiano. Un modello dati costruito attorno alle decisioni resta.' },
];

const profileJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: `${PERSON_URL}/`,
  name: title,
  description,
  mainEntity: personNode(),
  isPartOf: { '@type': 'WebSite', url: SITE_URL },
});
---

<Layout title={title} description={description} image={andriiImage.src} type="profile" preloadImage markdownAlternate="/about.md">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500&family=Geist+Mono:wght@400;500&display=swap"
    />
  </Fragment>

  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main id="main-content" class="ca flex-1" data-pagefind-body>
      <script type="application/ld+json" set:html={profileJsonLd} is:inline />

      <!-- Hero -->
      <section class="ca-wrap ca-hero" aria-labelledby="ca-title">
        <div class="ca-hero-text">
          <div class="ca-eyebrow">
            <span class="ca-pulse" aria-hidden="true"></span>
            <span>Andrii Dyshkantiuk · Analytics Engineer</span>
          </div>
          <h1 id="ca-title" class="ca-h1">Dati in tempo reale. <em>Decisioni</em> senza attesa.</h1>
          <p class="ca-lead">
            Progetto sistemi di data analytics, analytics engineering e real-time analytics per team che non possono aspettare il report di domani. Certificato ClickHouse e Confluent.
          </p>
          <div class="ca-actions">
            <a href="/contact/" class="ca-btn ca-btn-primary">Parliamo del tuo progetto <span aria-hidden="true">→</span></a>
            <a href={LINKEDIN_URL} target="_blank" rel="noreferrer" class="ca-btn ca-btn-ghost">LinkedIn</a>
          </div>
        </div>
        <figure class="ca-portrait">
          <div class="ca-portrait-frame">
            <Image
              src={andriiImage}
              alt="Ritratto di Andrii Dyshkantiuk"
              width={920}
              height={1150}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              quality={86}
              class="ca-portrait-img"
            />
          </div>
          <figcaption class="ca-portrait-cap">
            <span>ClickHouse · Confluent certified</span><span class="ca-lime">2026</span>
          </figcaption>
        </figure>
      </section>

      <!-- Specs -->
      <section class="ca-specs" aria-label="In sintesi">
        <div class="ca-specs-grid">
          {specs.map((s) => (
            <div class="ca-spec">
              <span class="ca-label">{s.label}</span>
              <span class="ca-spec-value">{s.value}</span>
              <span class="ca-spec-note">{s.note}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Discipline -->
      <section class="ca-wrap ca-section ca-section-lg" aria-labelledby="ca-disc-title">
        <div class="ca-disc-head">
          <h2 id="ca-disc-title" class="ca-h2">Tre discipline, <em>un solo sistema.</em></h2>
          <p class="ca-disc-intro">Analisi, ingegneria e tempo reale non sono reparti separati: sono lo stesso dato in tre momenti.</p>
        </div>
        <div class="ca-disc-grid">
          {disciplines.map((d, i) => (
            <a href={d.href} class="ca-disc">
              <span class="ca-mono ca-lime">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ca-disc-title">{d.title}</h3>
              <p class="ca-disc-claim">{d.claim}</p>
              <p class="ca-disc-text">{d.text}</p>
              <span class="ca-mono ca-disc-tags">{d.tags}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Architettura -->
      <section class="ca-arch" aria-labelledby="ca-arch-title">
        <div class="ca-wrap ca-section">
          <span class="ca-label ca-label-lg">Come costruisco</span>
          <h2 id="ca-arch-title" class="ca-h2 ca-arch-title">Dall'evento alla decisione.</h2>
          <div class="ca-track" aria-hidden="true">
            {[0, 1, 2, 3, 4].map((i) => <span style={`--i:${i}`}></span>)}
          </div>
          <ol class="ca-flow" role="list">
            {flow.map((n) => (
              <li class:list={['ca-node', { 'is-hl': n.hl }]}>
                <span class="ca-node-step">{n.step}</span>
                <span class="ca-node-name">{n.name}</span>
                <span class="ca-node-text">{n.text}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Certificazioni -->
      <section class="ca-wrap ca-section" aria-labelledby="ca-cert-title">
        <span class="ca-label ca-label-lg">Certificazioni</span>
        <h2 id="ca-cert-title" class="ca-h2 ca-cert-title">Verificate dai vendor <em>dello stack che uso.</em></h2>
        <div class="ca-cert-grid">
          <article class="ca-cert">
            <div class="ca-cert-meta"><span class="ca-label">ClickHouse, Inc.</span><span class="ca-mono ca-lime">Nov 2026</span></div>
            <h3 class="ca-cert-name">ClickHouse Certified Developer</h3>
            <p class="ca-cert-text">Esame pratico ufficiale: modellazione MergeTree, performance delle query, ingestion ad alto throughput, OLAP in tempo reale.</p>
            <a href={CLICKHOUSE_CERTIFICATE_URL} target="_blank" rel="noopener" class="ca-verify">Verifica ↗</a>
          </article>
          <article class="ca-cert">
            <div class="ca-cert-meta"><span class="ca-label">Confluent, an IBM Company</span><span class="ca-mono ca-lime">Gen 2026</span></div>
            <h3 class="ca-cert-name">Data Streaming Engineer</h3>
            <ul class="ca-scores" role="list">
              {confluentScores.map((s) => (
                <li class="ca-score">
                  <span>{s.topic}</span>
                  <span class="ca-bar" aria-hidden="true"><span style={`width:${s.score}%`}></span></span>
                  <span class:list={['ca-score-num', { 'ca-lime': s.score === 100 }]}>{s.score}%</span>
                </li>
              ))}
            </ul>
            <a href={CONFLUENT_CERTIFICATE_URL} target="_blank" rel="noopener" class="ca-verify">Verifica ↗</a>
          </article>
        </div>
        <ul class="ca-cert-list" role="list">
          {otherCerts.map((c) => (
            <li>
              <a href={LINKEDIN_CERTIFICATIONS_URL} target="_blank" rel="noreferrer" class="ca-cert-row">
                <span class="ca-label">{c.issuer}</span>
                <span class="ca-cert-row-name">{c.name}</span>
                <span class="ca-mono ca-cert-row-date">{c.date}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href={LINKEDIN_CERTIFICATIONS_URL} target="_blank" rel="noreferrer" class="ca-mono ca-all-certs">Tutte le certificazioni su LinkedIn ↗</a>
      </section>

      <!-- Principi -->
      <section class="ca-principles" aria-labelledby="ca-pr-title">
        <div class="ca-wrap ca-section">
          <h2 id="ca-pr-title" class="ca-label ca-label-lg">Principi</h2>
          <div class="ca-pr-list">
            {principles.map((p) => (
              <div class="ca-pr">
                <h3 class="ca-pr-title">{p.title}</h3>
                <p class="ca-pr-text">{p.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Collaborazione -->
      <section class="ca-wrap ca-collab" aria-label="Come collaborare">
        <div class="ca-collab-card ca-collab-lime">
          <span class="ca-label ca-label-dark">Per aziende e team</span>
          <h3 class="ca-collab-title">Architettura, audit, pipeline real-time.</h3>
          <p class="ca-collab-text">Disegno o rimetto in ordine lo stack analytics, porto i dati in tempo reale e formo il team perché lo sappia gestire.</p>
          <a href="/contact/" class="ca-btn ca-btn-dark">Richiedi una call →</a>
        </div>
        <div class="ca-collab-card ca-collab-outline">
          <span class="ca-label">Per chi studia</span>
          <h3 class="ca-collab-title">Il corso, aperto e gratuito.</h3>
          <p class="ca-collab-text ca-muted">Lo stesso metodo che uso sui progetti, dal tracking all'agentic AI. Codice pubblico su GitHub.</p>
          <div class="ca-collab-links">
            <a href="/#corsi" class="ca-lime">Inizia il percorso →</a>
            <a href={GITHUB_REPO_URL} target="_blank" rel="noreferrer" class="ca-muted">GitHub ↗</a>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="ca-cta" aria-labelledby="ca-cta-title">
        <div class="ca-wrap ca-cta-inner">
          <h2 id="ca-cta-title" class="ca-cta-title">I tuoi dati arrivano prima <em>delle tue decisioni?</em></h2>
          <a href="/contact/" class="ca-btn ca-btn-primary ca-btn-lg">Parliamone →</a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .ca {
    --ca-bg: #0d0e10;
    --ca-surface: #121316;
    --ca-surface-2: #131417;
    --ca-surface-3: #17181c;
    --ca-text: #ecebe4;
    --ca-text-2: #c3c3bb;
    --ca-muted: #a4a59e;
    --ca-label: #8d8e87;
    --ca-line: #22242a;
    --ca-line-2: #2a2c32;
    --ca-line-3: #34363d;
    --ca-lime: #d9f26a;
    --ca-lime-hover: #e6f88f;
    --ca-serif: 'Instrument Serif', Georgia, serif;
    --ca-sans: Geist, Inter, system-ui, sans-serif;
    --ca-mono: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    --ca-gutter: clamp(20px, 4vw, 40px);

    background: var(--ca-bg);
    color: var(--ca-text);
    font-family: var(--ca-sans);
    -webkit-font-smoothing: antialiased;
    padding-top: 64px;
  }
  .ca *,
  .ca *::before,
  .ca *::after { box-sizing: border-box; }
  .ca a { color: var(--ca-text); text-decoration: none; transition: color 0.15s, background-color 0.15s, border-color 0.15s; }
  .ca a:hover { color: var(--ca-lime); }
  .ca a:focus-visible { outline: 2px solid var(--ca-lime); outline-offset: 3px; }
  .ca em { font-style: italic; color: var(--ca-lime); }
  .ca h1, .ca h2, .ca h3, .ca p, .ca figure, .ca ol, .ca ul { margin: 0; padding: 0; }
  .ca ol, .ca ul { list-style: none; }

  .ca .ca-wrap { max-width: 1200px; margin: 0 auto; padding-left: var(--ca-gutter); padding-right: var(--ca-gutter); }
  .ca .ca-section { padding-top: clamp(72px, 10vw, 120px); padding-bottom: clamp(72px, 10vw, 120px); }
  .ca .ca-section-lg { padding-top: clamp(72px, 10vw, 128px); padding-bottom: clamp(72px, 10vw, 128px); }
  .ca .ca-lime { color: var(--ca-lime); }
  .ca .ca-muted { color: var(--ca-muted); }
  .ca .ca-mono { font: 400 12px var(--ca-mono); }
  .ca .ca-label { font: 400 11px var(--ca-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ca-label); }
  .ca .ca-label-lg { font-size: 12px; display: block; }
  .ca .ca-label-dark { color: var(--ca-bg); font-weight: 500; font-size: 12px; }

  .ca .ca-h1,
  .ca .ca-h2,
  .ca .ca-cta-title,
  .ca .ca-cert-name,
  .ca .ca-pr-title,
  .ca .ca-collab-title,
  .ca .ca-spec-value,
  .ca .ca-disc-claim { font-family: var(--ca-serif); font-weight: 400; }

  /* Buttons */
  .ca .ca-btn { display: inline-flex; align-items: center; gap: 10px; height: 48px; padding: 0 24px; border-radius: 999px; font: 500 15px var(--ca-sans); white-space: nowrap; }
  .ca .ca-btn-primary { background: var(--ca-lime); color: var(--ca-bg); }
  .ca .ca-btn-primary:hover { background: var(--ca-lime-hover); color: var(--ca-bg); }
  .ca .ca-btn-ghost { border: 1px solid var(--ca-line-3); font-weight: 400; }
  .ca .ca-btn-ghost:hover { border-color: var(--ca-text); color: var(--ca-text); }
  .ca .ca-btn-dark { align-self: flex-start; height: 46px; padding: 0 22px; background: var(--ca-bg); color: var(--ca-text); font-size: 14px; }
  .ca .ca-btn-dark:hover { background: #25272d; color: var(--ca-text); }
  .ca .ca-btn-lg { height: 52px; padding: 0 28px; font-size: 16px; }

  /* Hero */
  .ca .ca-hero {
    padding-top: clamp(56px, 9vw, 120px);
    padding-bottom: clamp(48px, 7vw, 88px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(40px, 6vw, 80px);
    align-items: end;
  }
  .ca .ca-hero-text { display: flex; flex-direction: column; gap: 32px; }
  .ca .ca-eyebrow { display: flex; align-items: center; gap: 10px; font: 400 12px var(--ca-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ca-muted); }
  .ca .ca-pulse { width: 8px; height: 8px; flex: none; border-radius: 50%; background: var(--ca-lime); animation: ca-blink 1.6s ease-in-out infinite; }
  .ca .ca-h1 { font-size: clamp(48px, 7.4vw, 96px); line-height: 0.98; letter-spacing: -0.02em; text-wrap: balance; }
  .ca .ca-lead { max-width: 540px; font: 300 clamp(17px, 1.5vw, 20px) / 1.55 var(--ca-sans); color: var(--ca-text-2); text-wrap: pretty; }
  .ca .ca-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .ca .ca-portrait { position: relative; max-width: 460px; width: 100%; justify-self: end; }
  .ca .ca-portrait-frame { aspect-ratio: 4 / 5; border-radius: 4px; overflow: hidden; background: var(--ca-surface-3); }
  .ca .ca-portrait-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(1) contrast(1.05); }
  .ca .ca-portrait-cap {
    position: absolute; left: 16px; right: 16px; bottom: 16px;
    display: flex; justify-content: space-between; gap: 12px;
    padding: 12px 14px; margin: 0;
    background: rgba(13, 14, 16, 0.82); backdrop-filter: blur(8px);
    border: 1px solid var(--ca-line-2); border-radius: 3px;
    font: 400 12px var(--ca-mono); color: var(--ca-text-2);
  }

  /* Specs */
  .ca .ca-specs { border-top: 1px solid var(--ca-line); border-bottom: 1px solid var(--ca-line); }
  .ca .ca-specs-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: 1px; background: var(--ca-line); }
  .ca .ca-spec { padding: 32px clamp(20px, 3vw, 32px); background: var(--ca-bg); display: flex; flex-direction: column; gap: 12px; }
  .ca .ca-spec-value { font-size: 40px; line-height: 1; }
  .ca .ca-spec-note { font: 300 14px / 1.5 var(--ca-sans); color: var(--ca-muted); }

  /* Discipline */
  .ca .ca-disc-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 56px; }
  .ca .ca-h2 { font-size: clamp(36px, 4.6vw, 60px); line-height: 1.02; letter-spacing: -0.015em; text-wrap: balance; max-width: 640px; }
  .ca .ca-disc-intro { max-width: 340px; font: 300 16px / 1.55 var(--ca-sans); color: var(--ca-muted); }
  .ca .ca-disc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 1px; background: var(--ca-line); border: 1px solid var(--ca-line); }
  .ca .ca-disc { background: var(--ca-bg); padding: 36px 32px 32px; display: flex; flex-direction: column; gap: 20px; min-height: 340px; }
  .ca .ca-disc:hover { background: var(--ca-surface-2); color: var(--ca-text); }
  .ca .ca-disc-title { font: 500 24px / 1.2 var(--ca-sans); letter-spacing: -0.01em; }
  .ca .ca-disc-claim { font-style: italic; font-size: 22px; line-height: 1.3; color: var(--ca-text); }
  .ca .ca-disc-text { font: 300 15px / 1.6 var(--ca-sans); color: var(--ca-muted); flex: 1; }
  .ca .ca-disc-tags { color: var(--ca-label); }
  .ca .ca-disc:hover .ca-disc-tags { color: var(--ca-lime); }

  /* Architettura */
  .ca .ca-arch { background: var(--ca-surface); border-top: 1px solid var(--ca-line); border-bottom: 1px solid var(--ca-line); }
  .ca .ca-arch-title { margin: 16px 0 56px; max-width: none; }
  .ca .ca-track { position: relative; height: 1px; background: var(--ca-line-2); margin: 0 0 24px; }
  .ca .ca-track span {
    position: absolute; top: -3px; left: 0; width: 7px; height: 7px; border-radius: 50%;
    background: var(--ca-lime); box-shadow: 0 0 12px var(--ca-lime); opacity: 0;
    animation: ca-flow 3.6s linear infinite; animation-delay: calc(var(--i) * 0.72s);
  }
  .ca .ca-flow { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 145px), 1fr)); gap: 12px; }
  .ca .ca-node { padding: 24px 20px; border: 1px solid var(--ca-line-2); border-radius: 4px; background: var(--ca-bg); display: flex; flex-direction: column; gap: 10px; }
  .ca .ca-node.is-hl { border-color: var(--ca-lime); }
  .ca .ca-node-step { font: 400 11px var(--ca-mono); color: var(--ca-label); }
  .ca .ca-node.is-hl .ca-node-step { color: var(--ca-lime); }
  .ca .ca-node-name { font: 500 18px var(--ca-sans); }
  .ca .ca-node-text { font: 300 13px / 1.5 var(--ca-sans); color: var(--ca-muted); }

  /* Certificazioni */
  .ca .ca-cert-title { margin: 16px 0 48px; max-width: 760px; }
  .ca .ca-cert-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 16px; }
  .ca .ca-cert { padding: 36px 32px; border: 1px solid var(--ca-lime); border-radius: 4px; display: flex; flex-direction: column; gap: 18px; }
  .ca .ca-cert-meta { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .ca .ca-cert-name { font-size: 36px; line-height: 1.05; }
  .ca .ca-cert-text { font: 300 15px / 1.6 var(--ca-sans); color: var(--ca-muted); flex: 1; }
  .ca .ca-verify { align-self: flex-start; font: 400 13px var(--ca-mono); color: var(--ca-lime); border-bottom: 1px solid var(--ca-lime); padding-bottom: 3px; }
  .ca .ca-verify:hover { color: var(--ca-text); border-color: var(--ca-text); }
