---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import {
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Briefcase,
  Database,
  GraduationCap,
} from 'lucide-react';
import Footer from '../components/Footer.astro';
import { Navbar } from '../components/Navbar';
import andriiImage from '../assets/andrii.webp';
import { BOOKING_URL, GITHUB_PROFILE_URL, GITHUB_REPO_URL, LINKEDIN_URL, SITE_URL } from '../consts';
import { COURSE_MODULES } from '../data/course-modules';
import Layout from '../layouts/Layout.astro';
import { serializeJsonLd } from '../utils/jsonld';

const totalModules = COURSE_MODULES.length;
const totalLessons = (await getCollection('corso')).filter((entry) => entry.id.includes('/')).length;

const personJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/about#andrii-dyshkantiuk`,
  name: 'Andrii Dyshkantiuk',
  url: `${SITE_URL}/about`,
  jobTitle: 'MarTech Expert, Data Engineer e Formatore',
  description:
    'Andrii Dyshkantiuk lavora tra marketing analytics, data engineering e formazione pratica. È il fondatore di GinnyTech.',
  sameAs: [LINKEDIN_URL, GITHUB_PROFILE_URL],
  knowsAbout: [
    'Marketing Analytics',
    'Data Engineering',
    'Business Intelligence',
    'MarTech',
    'SQL',
    'Python',
    'ClickHouse',
    'Apache Kafka',
  ],
});
---

<Layout
  title="Chi è Andrii Dyshkantiuk | GinnyTech"
  description="Scopri chi c'è dietro GinnyTech: Andrii Dyshkantiuk, tra MarTech, analytics, data engineering e formazione pratica senza paywall."
>
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main id="main-content" class="relative flex-1 overflow-hidden bg-[#050505] selection:bg-neon-mint/30 selection:text-white">
      <script type="application/ld+json" set:html={personJsonLd} is:inline />

      <div class="absolute inset-x-0 top-0 h-[42rem] bg-gradient-to-b from-mint-900/20 via-transparent to-transparent pointer-events-none"></div>
      <div class="absolute right-[-8rem] top-16 h-[28rem] w-[28rem] rounded-full bg-neon-blue/10 blur-[140px] pointer-events-none"></div>
      <div class="absolute left-[-10rem] bottom-24 h-[30rem] w-[30rem] rounded-full bg-acid-yellow/[0.08] blur-[170px] pointer-events-none"></div>

      <div class="container mx-auto px-6 pt-28 pb-20 relative z-10">
        <section class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(320px,0.85fr)] lg:gap-14">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold tracking-[0.24em] text-acid-yellow uppercase backdrop-blur-sm">
              <span class="h-2 w-2 rounded-full bg-acid-yellow shadow-[0_0_12px_rgba(204,255,0,0.9)]"></span>
              Dietro GinnyTech
            </div>

            <h1 class="mt-6 max-w-4xl font-heading text-4xl font-bold leading-tight text-white md:text-6xl">
              Costruisco sistemi dati che aiutano il marketing a ragionare meglio.
            </h1>

            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300 md:text-xl">
              Sono <strong class="text-white">Andrii Dyshkantiuk</strong>. Lavoro tra analytics, data engineering e
              MarTech, e GinnyTech è il posto in cui trasformo progetti reali in formazione chiara, aperta e utile.
            </p>

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-400 md:text-lg">
              Qui non trovi teoria confezionata. Trovi il modo in cui affronto tracking, pipeline, dashboard, modelli di
              attribuzione e decisioni operative quando i dati devono davvero servire a qualcuno.
            </p>

            <div class="mt-8 grid gap-3 sm:grid-cols-3">
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-sm">
                <div class="font-heading text-3xl font-bold text-acid-yellow">15+</div>
                <p class="mt-1 text-sm text-slate-400">Anni sul campo tra marketing, BI e infrastruttura dati</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-sm">
                <div class="font-heading text-3xl font-bold text-neon-blue">{totalModules}</div>
                <p class="mt-1 text-sm text-slate-400">Moduli pubblicati nel percorso formativo</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-sm">
                <div class="font-heading text-3xl font-bold text-white">{totalLessons}</div>
                <p class="mt-1 text-sm text-slate-400">Lezioni pratiche già online e consultabili gratis</p>
              </div>
            </div>

            <div class="mt-10 flex flex-wrap gap-4">
              <a
                href="/#corsi"
                class="inline-flex items-center gap-2 rounded-full bg-[#ccff00] px-6 py-3 font-ui text-sm font-bold text-black transition hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00] focus-visible:ring-offset-2 focus-visible:ring-offset-[#050505]"
              >
                Esplora il corso
                <ArrowRight className="h-4 w-4" />
              </a>
              <a
                href={BOOKING_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3 font-ui text-sm font-semibold text-white transition hover:border-acid-yellow/50 hover:bg-white/[0.08] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-[#050505]"
              >
                Prenota una call
                <ArrowUpRight className="h-4 w-4" />
              </a>
            </div>
          </div>

          <aside class="glass-panel rounded-[2rem] p-5 sm:p-6">
            <div class="overflow-hidden rounded-[1.5rem] border border-white/10 bg-black/30">
              <Image
                src={andriiImage}
                alt="Ritratto di Andrii Dyshkantiuk"
                class="aspect-[3/4] w-full object-cover"
                loading="eager"
                decoding="async"
                quality={88}
              />
            </div>

            <div class="mt-5 flex flex-wrap gap-2">
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-200">MarTech</span>
              <span class="rounded-full border border-neon-blue/20 bg-neon-blue/5 px-3 py-1 text-xs font-semibold text-neon-blue">Data Engineering</span>
              <span class="rounded-full border border-acid-yellow/20 bg-acid-yellow/5 px-3 py-1 text-xs font-semibold text-acid-yellow">Formazione pratica</span>
            </div>

            <div class="mt-5 rounded-[1.5rem] border border-white/10 bg-white/[0.03] p-5">
              <h2 class="font-heading text-2xl font-bold text-white">Cosa porto nel progetto</h2>
              <ul class="mt-4 space-y-3 text-sm leading-relaxed text-slate-300">
                <li class="flex gap-3">
                  <span class="mt-1 text-acid-yellow">●</span>
                  <span>Esperienza diretta con dashboard, tracking, reporting e decisioni operative.</span>
                </li>
                <li class="flex gap-3">
                  <span class="mt-1 text-neon-blue">●</span>
                  <span>Competenza tecnica su pipeline, warehouse, SQL, Python, ClickHouse e Kafka.</span>
                </li>
                <li class="flex gap-3">
                  <span class="mt-1 text-white">●</span>
                  <span>Un approccio didattico che punta a trasferire metodo, non solo nozioni.</span>
                </li>
              </ul>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
              <a
                href={LINKEDIN_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 transition hover:text-neon-blue"
              >
                LinkedIn
                <ArrowUpRight className="h-4 w-4" />
              </a>
              <a
                href={GITHUB_REPO_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 transition hover:text-acid-yellow"
              >
                GitHub
                <ArrowUpRight className="h-4 w-4" />
              </a>
            </div>
          </aside>
        </section>

        <section class="mt-16 md:mt-20">
          <div class="max-w-2xl">
            <h2 class="font-heading text-3xl font-bold text-white md:text-4xl">Come lavoro</h2>
            <p class="mt-4 text-lg leading-relaxed text-slate-400">
              Il mio lavoro sta nel punto in cui il marketing smette di essere solo creatività e diventa anche
              infrastruttura, misurazione e disciplina operativa.
            </p>
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-3">
            <article class="group rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm transition hover:-translate-y-1 hover:border-acid-yellow/40 hover:shadow-[0_0_30px_rgba(204,255,0,0.08)]">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-acid-yellow/20 bg-acid-yellow/10 text-acid-yellow">
                <Database className="h-5 w-5" />
              </div>
              <h3 class="mt-5 font-heading text-2xl font-bold text-white">Analytics che regge</h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Definisco metriche, sistemi di tracciamento e controlli di qualità per evitare dashboard belle ma inutili.
              </p>
            </article>

            <article class="group rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm transition hover:-translate-y-1 hover:border-neon-blue/40 hover:shadow-[0_0_30px_rgba(0,243,255,0.08)]">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-neon-blue/20 bg-neon-blue/10 text-neon-blue">
                <Briefcase className="h-5 w-5" />
              </div>
              <h3 class="mt-5 font-heading text-2xl font-bold text-white">Progetti reali, non demo</h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Lavoro su casi in cui ogni scelta impatta budget, funnel, reporting manageriale e operatività dei team.
              </p>
            </article>

            <article class="group rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm transition hover:-translate-y-1 hover:border-white/25 hover:shadow-[0_0_30px_rgba(255,255,255,0.06)]">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-white/15 bg-white/5 text-white">
                <GraduationCap className="h-5 w-5" />
              </div>
              <h3 class="mt-5 font-heading text-2xl font-bold text-white">Formazione trasferibile</h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Spiego strumenti e logiche in modo che restino utili anche quando cambiano stack, team o piattaforme.
              </p>
            </article>
          </div>
        </section>

        <section class="mt-16 grid gap-6 md:mt-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(300px,0.95fr)]">
          <article class="glass-panel rounded-[2rem] p-8 md:p-10">
            <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-neon-blue">
              <BookOpen className="h-4 w-4" />
              Perché esiste GinnyTech
            </div>

            <h2 class="mt-5 font-heading text-3xl font-bold text-white md:text-4xl">
              Ho creato il sito che avrei voluto trovare anni fa.
            </h2>

            <div class="mt-6 space-y-4 text-base leading-relaxed text-slate-300 md:text-lg">
              <p>
                In Italia si trovano corsi di marketing, corsi di programmazione e corsi di analytics. Quasi mai si trovano
                nello stesso posto, con una logica unica e con esempi che somigliano al lavoro vero.
              </p>
              <p>
                GinnyTech nasce per chi deve collegare dati, strumenti, reporting e decisioni. È un progetto
                <strong class="text-white">open-source</strong>, senza paywall, costruito per dare un metodo concreto.
              </p>
              <p>
                Ogni lezione è pensata per ridurre il divario tra “so la teoria” e “so come impostare il lavoro quando nessuno
                mi dice da dove iniziare”.
              </p>
            </div>
          </article>

          <article class="rounded-[2rem] border border-white/10 bg-white/[0.03] p-8 md:p-10">
            <h2 class="font-heading text-2xl font-bold text-white md:text-3xl">Principi del progetto</h2>

            <div class="mt-6 space-y-4">
              <div class="rounded-2xl border border-acid-yellow/15 bg-acid-yellow/[0.03] p-4">
                <h3 class="font-heading text-lg font-bold text-white">Niente fuffa</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">Solo concetti, strumenti e problemi che tornano davvero nella pratica.</p>
              </div>
              <div class="rounded-2xl border border-neon-blue/15 bg-neon-blue/[0.03] p-4">
                <h3 class="font-heading text-lg font-bold text-white">Metodo prima degli strumenti</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">Gli stack cambiano. Il modo corretto di ragionare sui dati resta.</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <h3 class="font-heading text-lg font-bold text-white">Accesso aperto</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">La conoscenza tecnica utile non dovrebbe essere bloccata dietro un abbonamento.</p>
              </div>
            </div>
          </article>
        </section>

        <section class="mt-16 md:mt-20">
          <div class="max-w-2xl">
            <h2 class="font-heading text-3xl font-bold text-white md:text-4xl">Per chi è utile</h2>
            <p class="mt-4 text-lg leading-relaxed text-slate-400">
              GinnyTech serve sia a chi sta entrando in questo mondo, sia a chi deve rimettere ordine in sistemi già
              esistenti e troppo frammentati.
            </p>
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-2">
            <article class="rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm">
              <h3 class="font-heading text-2xl font-bold text-white">Studenti e professionisti junior</h3>
              <ul class="mt-5 space-y-3 text-slate-400">
                <li class="flex gap-3"><span class="mt-1 text-acid-yellow">●</span><span>Per capire come si collegano marketing, analytics e infrastruttura dati.</span></li>
                <li class="flex gap-3"><span class="mt-1 text-acid-yellow">●</span><span>Per costruire competenze spendibili, non solo definizioni da memorizzare.</span></li>
                <li class="flex gap-3"><span class="mt-1 text-acid-yellow">●</span><span>Per imparare a leggere problemi reali con strumenti reali.</span></li>
              </ul>
            </article>

            <article class="rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm">
              <h3 class="font-heading text-2xl font-bold text-white">Team, founder e aziende</h3>
              <ul class="mt-5 space-y-3 text-slate-400">
                <li class="flex gap-3"><span class="mt-1 text-neon-blue">●</span><span>Per mettere ordine tra tracking, pipeline, KPI e reporting decisionale.</span></li>
                <li class="flex gap-3"><span class="mt-1 text-neon-blue">●</span><span>Per allineare marketing e tecnologia con un linguaggio comune.</span></li>
                <li class="flex gap-3"><span class="mt-1 text-neon-blue">●</span><span>Per trasformare consulenza e formazione in competenza interna, non dipendenza esterna.</span></li>
              </ul>
            </article>
          </div>
        </section>

        <section class="mt-16 rounded-[2rem] border border-white/10 bg-gradient-to-br from-white/[0.05] via-white/[0.03] to-acid-yellow/[0.04] p-8 md:mt-20 md:p-10">
          <div class="max-w-3xl">
            <h2 class="font-heading text-3xl font-bold text-white md:text-4xl">
              Se vuoi imparare dal lavoro reale, parti da qui.
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-slate-300">
              Puoi iniziare subito dal corso gratuito, oppure prenotare una call se hai un progetto, un dubbio tecnico o
              una direzione da chiarire.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/#corsi"
              class="inline-flex items-center gap-2 rounded-full bg-[#ccff00] px-6 py-3 font-ui text-sm font-bold text-black transition hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00] focus-visible:ring-offset-2 focus-visible:ring-offset-[#050505]"
            >
              Vai al percorso
              <ArrowRight className="h-4 w-4" />
            </a>
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3 font-ui text-sm font-semibold text-white transition hover:border-acid-yellow/50 hover:text-acid-yellow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-[#050505]"
            >
              Prenota una call
              <ArrowUpRight className="h-4 w-4" />
            </a>
          </div>
        </section>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
