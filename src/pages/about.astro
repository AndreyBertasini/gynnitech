---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import '@fontsource/jetbrains-mono/500.css';
import Footer from '../components/Footer.astro';
import { Navbar } from '../components/Navbar';
import andriiImage from '../assets/andrii.webp';
import { CLICKHOUSE_CERTIFICATE_URL, GITHUB_REPO_URL, LINKEDIN_URL } from '../consts';
import { COURSE_MODULES } from '../data/course-modules';
import Layout from '../layouts/Layout.astro';
import { PERSON_TOPICS, personNode } from '../lib/entity';
import { serializeJsonLd } from '../utils/jsonld';

// Tutti i numeri della pagina vengono dai contenuti reali del corso: si aggiornano da soli.
const lessons = (await getCollection('corso')).filter((entry) => entry.id.includes('/') && entry.data.draft !== true);
const wordCount = (body = '') => body.split(/\s+/).filter(Boolean).length;
const totalModules = COURSE_MODULES.length;
const totalLessons = lessons.length;
const totalWords = lessons.reduce((sum, entry) => sum + wordCount(entry.body), 0);
const wordsLabel = `${Math.round(totalWords / 1000)}k`;

// Mappa del corso: una riga per modulo, un quadrato per lezione, intensità = lunghezza della lezione.
const maxWords = Math.max(...lessons.map((entry) => wordCount(entry.body)));
const level = (words: number) => Math.max(1, Math.min(4, Math.ceil((words / maxWords) * 4)));
const rows = COURSE_MODULES.map((module) => {
  const cells = lessons
    .filter((entry) => entry.id.startsWith(`${module.id}/`))
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
    .map((entry) => ({ id: entry.id, title: entry.data.title, words: wordCount(entry.body) }));
  return { id: module.id, title: module.title, cells };
}).filter((row) => row.cells.length > 0);
const maxCols = Math.max(...rows.map((row) => row.cells.length));
const peak = rows.flatMap((row) => row.cells.map((cell) => ({ ...cell, module: row.title }))).reduce((a, b) => (b.words > a.words ? b : a));

const stack = [
  { name: 'SQL', role: 'La base di tutto', text: 'Ogni analisi seria parte da una query che un collega può rileggere, rieseguire e contestare.' },
  { name: 'ClickHouse', role: 'Certified Developer', text: 'Database colonnare per aggregare milioni di eventi in secondi, con tabelle MergeTree progettate attorno alle query.', badge: true },
  { name: 'dbt', role: 'Trasformazioni versionate', text: 'Modelli SQL con test, documentazione e dipendenze esplicite: se una metrica cambia, si vede dove e perché.' },
  { name: 'Kafka', role: 'Flussi di eventi', text: 'Eventi che arrivano in tempo reale, con schemi, consumer group e garanzie di consegna da progettare.' },
  { name: 'Python', role: 'Quando SQL non basta', text: 'Modelli, analisi esplorative e script che trasformano un controllo manuale in un passaggio ripetibile.' },
  { name: 'GA4 e GTM', role: 'Tracciamento', text: 'Eventi, dataLayer e consenso: il punto in cui il marketing produce i dati che userà per decidere.' },
];

const principles = [
  { title: 'Analytics che regge', text: 'Definisco metriche, sistemi di tracciamento e controlli di qualità per evitare dashboard belle ma inutili.' },
  { title: 'Progetti reali, non demo', text: 'Lavoro su casi in cui ogni scelta impatta budget, funnel, reporting manageriale e operatività dei team.' },
  { title: 'Formazione trasferibile', text: 'Spiego strumenti e logiche in modo che restino utili anche quando cambiano stack, team o piattaforme.' },
  { title: 'Tutto verificabile', text: 'Il corso è aperto e il codice è su GitHub: se trovi un errore, lo vedi e lo puoi segnalare.' },
];

const chapters = ['Il profilo', 'I numeri', 'La certificazione', 'Lo stack', 'La mappa del corso', 'Come lavoro', 'Temi e percorsi'];
const total = String(chapters.length).padStart(2, '0');
const ch = (i: number) => `${String(i + 1).padStart(2, '0')} / ${total}`;

const personJsonLd = serializeJsonLd({ '@context': 'https://schema.org', ...personNode() });
---

<Layout
  title="Chi è Andrii Dyshkantiuk | GinnyTech"
  description="Andrii Dyshkantiuk, Analytics Engineer e ClickHouse Certified Developer: chi c'è dietro GinnyTech, il corso gratuito di MarTech, analytics e data engineering."
  image={andriiImage.src}
  preloadImage
  markdownAlternate="/about.md"
>
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main id="main-content" class="ab relative flex-1 overflow-hidden bg-[var(--sl-color-bg)] selection:bg-accent/30 selection:text-white" data-pagefind-body>
      <script type="application/ld+json" set:html={personJsonLd} is:inline />

      <div class="ab-wrap">
        <!-- 01 · PROFILO -->
        <section class="ab-hero" data-chapter={`${ch(0)} · ${chapters[0]}`} aria-labelledby="ab-title">
          <div class="ab-ghost" aria-hidden="true">DATI</div>
          <div class="ab-hero-text">
            <p class="ab-mono ab-kicker"><span>Dietro GinnyTech</span><span>{ch(0)} · Il profilo</span></p>
            <h1 id="ab-title" class="font-heading">
              Andrii Dyshkantiuk.
              <span class="ab-accent">Costruisco sistemi dati che aiutano il marketing a ragionare meglio.</span>
            </h1>
            <p class="ab-lead">
              Lavoro tra analytics, data engineering e MarTech. GinnyTech è il posto in cui trasformo progetti reali in
              formazione chiara, aperta e gratuita: tracking, pipeline, dashboard e modelli di attribuzione, spiegati come
              li affronto quando i dati devono davvero servire a qualcuno.
            </p>
            <div class="ab-actions">
              <a href="/#corsi" class="ab-btn ab-btn-primary">Esplora il corso <ArrowRight className="h-4 w-4" /></a>
              <a href={LINKEDIN_URL} target="_blank" rel="noreferrer" class="ab-btn ab-btn-ghost">Profilo LinkedIn <ArrowUpRight className="h-4 w-4" /></a>
            </div>
          </div>
          <figure class="ab-photo">
            <Image src={andriiImage} alt="Ritratto di Andrii Dyshkantiuk" class="ab-photo-img" loading="eager" decoding="async" quality={88} />
            <figcaption class="ab-mono">Andrii Dyshkantiuk · Analytics Engineer</figcaption>
          </figure>
        </section>

        <!-- 02 · NUMERI -->
        <section class="ab-kpis" data-chapter={`${ch(1)} · ${chapters[1]}`} aria-label="GinnyTech in numeri">
          <a href="/#corsi" class="kpi kpi-xl kpi-lime">
            <span class="ab-mono kpi-label">Lezioni gratuite online <span class="kpi-tag">Corso</span></span>
            <span class="kpi-num" data-count={totalLessons}>{totalLessons}</span>
          </a>
          <div class="kpi kpi-white">
            <span class="ab-mono kpi-label">Moduli</span>
            <span class="kpi-num" data-count={totalModules}>{totalModules}</span>
          </div>
          <div class="kpi kpi-outline">
            <span class="ab-mono kpi-label">Parole di corso</span>
            <span class="kpi-num">{wordsLabel}</span>
          </div>
          <div class="kpi kpi-dark">
            <span class="ab-mono kpi-label">Anni sul campo</span>
            <span class="kpi-num">15+</span>
          </div>
          <div class="kpi kpi-blue">
            <span class="ab-mono kpi-label">Paywall</span>
            <span class="kpi-num" data-count="0">0</span>
          </div>
        </section>

        <!-- 03 · CERTIFICAZIONE -->
        <section class="ab-cert ab-rv" data-chapter={`${ch(2)} · ${chapters[2]}`} aria-labelledby="ab-cert-title">
          <div class="ab-seal" aria-hidden="true">
            <svg viewBox="0 0 120 120" width="112" height="112">
              <defs><path id="ab-circle" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
              <circle cx="60" cy="60" r="58" fill="none" stroke="currentColor" stroke-width="1" opacity=".45" />
              <text font-size="9" letter-spacing="3" fill="currentColor"><textPath href="#ab-circle">CLICKHOUSE · CERTIFIED DEVELOPER ·</textPath></text>
              <g fill="currentColor"><rect x="44" y="46" width="5" height="28" /><rect x="52" y="46" width="5" height="28" /><rect x="60" y="46" width="5" height="28" /><rect x="68" y="46" width="5" height="28" /><rect x="76" y="56" width="5" height="8" /></g>
            </svg>
          </div>
          <div>
            <p class="ab-mono">{ch(2)} · Certificazione · 7 novembre 2026</p>
            <h2 id="ab-cert-title" class="font-heading">ClickHouse Certified Developer</h2>
            <p>
              Esame pratico ufficiale di ClickHouse, Inc.: modellazione MergeTree, performance delle query, ingestion ad alto
              throughput e architetture OLAP in tempo reale. È lo stesso database che insegno nel modulo di
              <a href="/course/real-time-analytics/">analytics in tempo reale</a>.
            </p>
          </div>
          <a href={CLICKHOUSE_CERTIFICATE_URL} target="_blank" rel="noopener" class="ab-btn ab-btn-dark">Vedi il certificato <ArrowUpRight className="h-4 w-4" /></a>
        </section>

        <!-- 04 · STACK -->
        <section class="ab-section" data-chapter={`${ch(3)} · ${chapters[3]}`} aria-labelledby="ab-stack-title">
          <header class="ab-head ab-rv">
            <p class="ab-mono">{ch(3)} · Lo stack</p>
            <h2 id="ab-stack-title" class="font-heading">Gli strumenti che uso e insegno</h2>
            <p>Pochi, scelti bene, ognuno con un compito preciso. Ciascuno ha il suo modulo nel corso.</p>
          </header>
          <ul class="ab-stack" role="list">
            {stack.map((item, i) => (
              <li class={`ab-tile ab-rv ${item.badge ? 'is-hl' : ''}`} style={`--i:${i}`}>
                <span class="ab-mono ab-idx">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="font-heading">{item.name}</h3>
                <p class="ab-mono ab-role">{item.badge && <span class="ab-dot" aria-hidden="true"></span>}{item.role}</p>
                <p>{item.text}</p>
              </li>
            ))}
          </ul>
        </section>

        <!-- 05 · MAPPA -->
        <section class="ab-section" data-chapter={`${ch(4)} · ${chapters[4]}`} aria-labelledby="ab-map-title">
          <header class="ab-head ab-rv">
            <p class="ab-mono">{ch(4)} · La mappa del corso</p>
            <h2 id="ab-map-title" class="font-heading">{totalLessons} lezioni, un quadrato alla volta</h2>
            <p>Ogni riga è un modulo, ogni quadrato una lezione. Più è acceso, più la lezione è lunga e densa. Clicca un quadrato per aprirla.</p>
          </header>
          <figure class="ab-heat">
            <p class="ab-mono ab-peak">Lezione più densa · {peak.title} · {peak.words.toLocaleString('it-IT')} parole</p>
            <div class="ab-heat-scroll">
              <div class="ab-heat-grid" style={`--cols:${maxCols}`}>
                {rows.map((row, r) => (
                  <>
                    <a class="ab-mono ab-heat-row" href={`/course/${row.id}/`} title={row.title}>{row.title}</a>
                    {Array.from({ length: maxCols }, (_, c) => {
                      const cell = row.cells[c];
                      return cell
                        ? <a class={`ab-cell q-${level(cell.words)} ${cell.id === peak.id ? 'is-peak' : ''}`} style={`--d:${c * 18 + r * 26}ms`} href={`/course/${cell.id}/`} title={`${cell.title} · ${cell.words.toLocaleString('it-IT')} parole`} aria-label={`${row.title}: ${cell.title}`}></a>
                        : <span class="ab-cell q-0" aria-hidden="true"></span>;
                    })}
                  </>
                ))}
              </div>
            </div>
            <figcaption class="ab-mono ab-legend">
              <span>Breve</span>
              <span class="ab-scale" aria-hidden="true">{[1, 2, 3, 4].map((q) => <i class={`q-${q}`}></i>)}</span>
              <span>Lunga</span>
              <span class="ab-legend-note">1 quadrato = 1 lezione · {totalModules} moduli · {wordsLabel} parole</span>
            </figcaption>
          </figure>
        </section>

        <!-- 06 · COME LAVORO -->
        <section class="ab-section" data-chapter={`${ch(5)} · ${chapters[5]}`} aria-labelledby="ab-work-title">
          <header class="ab-head ab-rv">
            <p class="ab-mono">{ch(5)} · Come lavoro</p>
            <h2 id="ab-work-title" class="font-heading">Dove il marketing diventa infrastruttura</h2>
            <p>Il mio lavoro sta nel punto in cui il marketing smette di essere solo creatività e diventa anche misurazione e disciplina operativa.</p>
          </header>
          <ol class="ab-pr" role="list">
            {principles.map((p, i) => (
              <li class={`ab-pr-card ab-rv pr-${i}`} style={`--i:${i}`}>
                <span class="ab-pr-num" aria-hidden="true">{i + 1}</span>
                <h3 class="font-heading">{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))}
          </ol>
        </section>

        <!-- 07 · TEMI -->
        <section class="ab-section" data-chapter={`${ch(6)} · ${chapters[6]}`} aria-labelledby="temi">
          <header class="ab-head ab-rv">
            <p class="ab-mono">{ch(6)} · Temi e percorsi</p>
            <h2 id="temi" class="font-heading">Temi su cui lavoro e insegno</h2>
            <p>Ogni tema porta al modulo del corso in cui lo affronto, con esempi e casi pratici.</p>
          </header>
          <ul class="ab-topics" role="list">
            {PERSON_TOPICS.map((topic, i) => (
              <li class="ab-rv" style={`--i:${i % 6}`}>
                <a href={topic.href}><span class="ab-mono">{String(i + 1).padStart(2, '0')}</span>{topic.name}<ArrowRight className="h-4 w-4 shrink-0" /></a>
              </li>
            ))}
          </ul>
          <div class="ab-for">
            <article class="ab-rv">
              <p class="ab-mono">Per chi studia</p>
              <h3 class="font-heading">Persone che vogliono crescere</h3>
              <p>Per imparare a leggere problemi reali con strumenti reali, senza paywall e senza teoria confezionata.</p>
            </article>
            <article class="ab-rv" style="--i:1">
              <p class="ab-mono">Per i team</p>
              <h3 class="font-heading">Team, founder e aziende</h3>
              <p>Per mettere ordine tra tracking, pipeline, KPI e reporting, e formare il team su un percorso comune e aperto.</p>
            </article>
          </div>
        </section>

        <!-- CTA -->
        <section class="ab-cta ab-rv" aria-labelledby="ab-cta-title">
          <p class="ab-mono">Fine · Si comincia</p>
          <h2 id="ab-cta-title" class="font-heading">Se vuoi imparare dal lavoro reale, parti da qui.</h2>
          <p>Il corso è gratuito e il materiale è aperto: se trovi un errore o vuoi proporre un miglioramento, il progetto è su GitHub.</p>
          <div class="ab-actions">
            <a href="/#corsi" class="ab-btn ab-btn-primary">Vai al percorso <ArrowRight className="h-4 w-4" /></a>
            <a href={GITHUB_REPO_URL} target="_blank" rel="noreferrer" class="ab-btn ab-btn-ghost">Il progetto su GitHub <ArrowUpRight className="h-4 w-4" /></a>
          </div>
        </section>
      </div>

      <div class="ab-rail ab-mono" aria-hidden="true">
        <span class="ab-rail-label">{ch(0)} · {chapters[0]}</span>
        <span class="ab-rail-bar"><i></i></span>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.querySelector<HTMLElement>('.ab');

  const countUp = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    if (reduce || !target) return;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / 1100);
      el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (root && 'IntersectionObserver' in window && !reduce) {
    // Si nasconde per l'animazione solo ciò che è sotto la piega: senza JS tutto resta visibile.
    const targets = root.querySelectorAll<HTMLElement>('.ab-rv, .ab-heat, .ab-kpis');
    targets.forEach((el) => {
      if (el.getBoundingClientRect().top > window.innerHeight) el.classList.add('is-armed');
    });
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        entry.target.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
        io.unobserve(entry.target);
      }
    }, { threshold: 0.15 });
    targets.forEach((el) => io.observe(el));

    const label = root.querySelector<HTMLElement>('.ab-rail-label');
    const rail = root.querySelector<HTMLElement>('.ab-rail');
    const chapterIo = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting && label) label.textContent = (entry.target as HTMLElement).dataset.chapter ?? '';
    }, { rootMargin: '-45% 0px -50% 0px' });
    root.querySelectorAll<HTMLElement>('[data-chapter]').forEach((el) => chapterIo.observe(el));

    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      rail?.style.setProperty('--p', String(max > 0 ? scrollY / max : 0));
      rail?.classList.toggle('is-on', scrollY > 300);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .ab {
    --lime: var(--color-accent, #ccff00);
    --line: var(--color-brand-border, #1e2128);
    --surface: var(--color-brand-surface, #0d0f14);
    --elevated: var(--color-brand-elevated, #12151c);
    --muted: var(--color-text-secondary, #9498a3);
    --blue: var(--color-info, #60a5fa);
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-text-primary, #e4e6ec);
  }
  .ab-wrap { max-width: 1320px; margin: 0 auto; padding: 6.5rem 1.5rem 4rem; }
  .ab-mono { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .ab a { text-decoration: none; }
  .ab-accent { display: block; color: var(--lime); font-weight: 700; }

  /* Buttons */
  .ab-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .ab-btn { display: inline-flex; align-items: center; gap: 0.5rem; border-radius: 999px; padding: 0.75rem 1.4rem; font-family: var(--font-ui); font-size: 0.875rem; font-weight: 700; transition: filter .2s ease, border-color .2s ease, color .2s ease; }
  .ab-btn-primary { background: var(--lime); color: #000; }
  .ab-btn-primary:hover { filter: brightness(1.1); color: #000; }
  .ab-btn-ghost { border: 1px solid rgba(255,255,255,.15); background: rgba(255,255,255,.05); color: #fff; }
  .ab-btn-ghost:hover { border-color: var(--lime); color: var(--lime); }
  .ab-btn-dark { background: #000; color: var(--lime); border: 1px solid #000; white-space: nowrap; }
  .ab-btn-dark:hover { background: #111; color: var(--lime); }

  /* Hero */
  .ab-hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.6fr); gap: 3rem; align-items: end; padding-bottom: 2.5rem; }
  .ab-ghost { position: absolute; left: 22%; top: 42%; transform: translateY(-50%); font-family: var(--font-heading); font-weight: 800; font-size: clamp(8rem, 24vw, 20rem); line-height: 1; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 1px rgba(204,255,0,.12); pointer-events: none; user-select: none; }
  .ab-hero-text { position: relative; z-index: 1; }
  .ab-kicker { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .ab-hero h1 { margin: 0; font-size: clamp(2.1rem, 5vw, 4rem); font-weight: 500; line-height: 1.06; letter-spacing: -0.03em; color: #fff; }
  .ab-lead { max-width: 640px; margin: 1.5rem 0 2rem; color: #cbd5e1; font-size: 1.1rem; line-height: 1.7; }
  .ab-photo { position: relative; z-index: 1; margin: 0; }
  .ab-photo-img { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); filter: grayscale(.15); }
  .ab-photo figcaption { margin-top: .6rem; }

  /* KPI blocks */
  .ab-kpis { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: minmax(130px, auto); gap: 10px; padding: 2rem 0 4rem; border-bottom: 1px solid var(--line); }
  .kpi { display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; padding: 1rem 1.1rem; border-radius: 4px; min-width: 0; color: inherit; }
  .kpi-label { display: flex; justify-content: space-between; align-items: start; gap: .5rem; color: inherit; font-weight: 700; font-size: .64rem; }
  .kpi-tag { border: 1px solid currentColor; padding: .1rem .35rem; white-space: nowrap; }
  .kpi-num { font-family: var(--font-heading); font-size: clamp(2.6rem, 5.5vw, 4.4rem); font-weight: 300; line-height: .95; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .kpi-outline .kpi-num, .kpi-dark .kpi-num, .kpi-blue .kpi-num { font-size: clamp(2.2rem, 3.6vw, 3.4rem); }
  .kpi-xl { grid-column: span 3; grid-row: span 2; }
  .kpi-xl .kpi-num { font-size: clamp(4.5rem, 12vw, 9rem); }
  .kpi-lime { background: var(--lime); color: #000; transition: transform .25s ease; }
  .kpi-lime:hover { transform: translateY(-3px); color: #000; }
  .kpi-white { grid-column: span 3; background: #f4f5f7; color: #08090d; }
  .kpi-outline { grid-column: span 1; border: 1px solid var(--lime); color: var(--lime); background: rgba(204,255,0,.04); }
  .kpi-dark { grid-column: span 1; background: var(--elevated); border: 1px solid var(--line); color: #fff; }
  .kpi-blue { grid-column: span 1; background: var(--blue); color: #08090d; }

  /* Certification band */
  .ab-cert { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 2.5rem; align-items: center; margin-top: 4rem; padding: 2.25rem; border-radius: 4px; background: var(--lime); color: #000; }
  .ab-cert .ab-mono { color: rgba(0,0,0,.65); }
  .ab-cert h2 { margin: .4rem 0 .6rem; font-size: clamp(1.7rem, 3.5vw, 2.6rem); font-weight: 500; letter-spacing: -0.02em; color: #000; }
  .ab-cert p:not(.ab-mono) { max-width: 62ch; color: rgba(0,0,0,.8); }
  .ab-cert a:not(.ab-btn) { color: #000; text-decoration: underline; text-underline-offset: 3px; }
  .ab-seal { color: #000; }
  .ab-seal svg { display: block; animation: ab-spin 40s linear infinite; font-family: var(--mono); }
  @keyframes ab-spin { to { transform: rotate(360deg); } }

