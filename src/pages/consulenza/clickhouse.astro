---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import {
  ArrowRight,
  ArrowUpRight,
  Award,
  CheckCircle2,
  Cpu,
  Database,
  Gauge,
  Layers,
  Server,
  ShieldCheck,
  TrendingDown,
  Zap,
} from 'lucide-react';
import { BOOKING_URL, CONTACT_EMAIL, CREDLY_CLICKHOUSE_BADGE_URL, SITE_AUTHOR, SITE_URL } from '../../consts';
import {
  ORGANIZATION_ID,
  PERSON_ID,
  breadcrumbListNode,
  organizationNode,
  personNode,
} from '../../lib/entity';
import { serializeJsonLd } from '../../utils/jsonld';

const pageUrl = `${SITE_URL}/consulenza/clickhouse/`;
const title = 'Consulenza ClickHouse Italia: Certified Developer, Migrazione & Tuning | GinnyTech';
const description =
  'Consulenza ClickHouse in Italia con ClickHouse Certified Developer (Andrii Dyshkantiuk): progettazione MergeTree, migrazione da BigQuery/PostgreSQL, pipeline Kafka e query tuning.';

const faqs = [
  {
    q: 'Quando conviene passare a ClickHouse rispetto a BigQuery, Snowflake o PostgreSQL?',
    a: 'ClickHouse è ideale quando i costi a consumo di BigQuery o Snowflake crescono in modo imprevedibile, quando PostgreSQL va in timeout su query analitiche oltre 50-100 milioni di righe, oppure quando servono dashboard real-time e customer-facing con latenze sotto i 100 millisecondi su miliardi di eventi.',
  },
  {
    q: 'Cosa certifica la qualifica ClickHouse Certified Developer?',
    a: 'È la certificazione tecnica ufficiale di ClickHouse Inc., ottenuta superando un esame pratico hands-on su progettazione dello schema colonnare (famiglia MergeTree), scelta di PRIMARY KEY e ORDER BY, Materialized Views incrementali, ingestion ad alto throughput, deduplicazione e query optimization.',
  },
  {
    q: 'Meglio ClickHouse Cloud o ClickHouse Self-Hosted (Docker / Kubernetes / bare-metal)?',
    a: 'Dipende dai vincoli di budget, compliance e competenze DevOps interne. ClickHouse Cloud azzera la gestione operativa separando storage (S3/GCS) e compute; ClickHouse Self-Hosted su server dedicati o Kubernetes garantisce il massimo risparmio infrastrutturale e il pieno controllo sui dati. Supporto entrambe le architetture.',
  },
  {
    q: 'Come gestite gli aggiornamenti e i duplicati in ClickHouse?',
    a: 'ClickHouse non usa lock transazionali OLTP classici: gli update e la deduplicazione si progettano a livello di engine tramite ReplacingMergeTree, CollapsingMergeTree o VersionedCollapsingMergeTree, combinati con query idempotenti, partizionamento corretto e modelli incrementali in dbt.',
  },
  {
    q: 'Possiamo affiancare ClickHouse al nostro database PostgreSQL senza riscrivere il backend?',
    a: 'Sì. L’approccio più rapido e sicuro è l’offloading analitico: PostgreSQL continua a servire le transazioni applicative (OLTP), mentre gli eventi e le tabelle analitiche vengono replicati in ClickHouse (via CDC, Kafka, PeerDB o batch incrementali) per alimentare dashboard, report e API analitiche istantanee.',
  },
  {
    q: 'Come si svolge un Audit o un progetto di migrazione ClickHouse?',
    a: 'Partiamo da una call tecnica di 15 minuti per inquadrare volumi, query critiche e obiettivi di costo/latenza. Seguono un Audit Architetturale (1-2 settimane) con benchmark sui vostri dati reali o uno Sprint di Implementazione insieme al vostro team, lasciando codice documentato e know-how interno.',
  },
];

const jsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    personNode(),
    organizationNode('Organization'),
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'it-IT',
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': PERSON_ID },
      author: { '@id': PERSON_ID },
      publisher: { '@id': ORGANIZATION_ID },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'Consulenza ClickHouse Italia — Architettura, Migrazione e Performance Tuning',
      serviceType: 'ClickHouse Database Consulting & Real-Time Analytics Engineering',
      provider: { '@id': PERSON_ID },
      brand: { '@id': ORGANIZATION_ID },
      areaServed: {
        '@type': 'Country',
        name: 'Italy',
      },
      url: pageUrl,
      description,
      offers: {
        '@type': 'Offer',
        url: BOOKING_URL,
        availability: 'https://schema.org/InStock',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
    breadcrumbListNode([
      { name: 'Home', url: SITE_URL },
      { name: 'Consulenza', url: `${SITE_URL}/consulting` },
      { name: 'Consulenza ClickHouse', url: pageUrl },
    ]),
  ],
});
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  markdownAlternate="/consulenza/clickhouse.md"
  keywords={[
    'consulenza clickhouse',
    'consulente clickhouse italia',
    'clickhouse certified developer',
    'migrazione bigquery clickhouse',
    'ottimizzazione query clickhouse',
    'clickhouse mergetree',
    'database olap real time',
    'ridurre costi bigquery',
    'query lente postgresql',
    'clickhouse dbt kafka',
  ]}
>
  <div class="min-h-screen flex flex-col">
    <Navbar client:idle />

    <main
      id="main-content"
      class="relative flex-1 bg-[var(--sl-color-bg)] overflow-hidden selection:bg-accent/30 selection:text-white"
      data-pagefind-body
    >
      <script type="application/ld+json" set:html={jsonLd} is:inline />

      <div class="absolute inset-x-0 top-0 h-[40rem] bg-gradient-to-b from-accent/15 via-transparent to-transparent pointer-events-none"></div>

      <div class="container mx-auto px-6 pt-28 pb-24 relative z-10 max-w-6xl">
        {/* Breadcrumb visibile */}
        <nav aria-label="Breadcrumb" class="mb-8 text-xs font-mono text-slate-400 flex items-center gap-2">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/consulting" class="hover:text-white transition-colors">Consulenza</a>
          <span>/</span>
          <span class="text-accent">ClickHouse</span>
        </nav>

        {/* Hero Section */}
        <section class="grid lg:grid-cols-[minmax(0,1.2fr)_minmax(300px,0.8fr)] gap-10 items-center mb-20">
          <div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent/10 border border-accent/30 text-accent text-xs font-mono font-semibold uppercase tracking-wider mb-6">
              <Award className="w-4 h-4" />
              ClickHouse Certified Developer · Italia
            </div>

            <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-[1.12] tracking-tight mb-6">
              Consulenza <span class="text-accent">ClickHouse</span> per query sub-secondo e costi cloud sotto controllo.
            </h1>

            <p class="text-lg text-slate-300 leading-relaxed mb-4">
              Quando PostgreSQL va in timeout sulle dashboard analitiche o la fattura di BigQuery/Snowflake esplode a ogni scansione, <strong class="text-white">ClickHouse</strong> permette di interrogare miliardi di righe in pochi millisecondi con una frazione dell&apos;hardware.
            </p>

            <p class="text-base text-slate-400 leading-relaxed mb-8">
              Ma ClickHouse non si progetta come un database relazionale: sbagliare <code class="text-accent">ORDER BY</code>, partizionamento o gestione dei duplicati trasforma un motore velocissimo in un collo di bottiglia. Lavora direttamente con <strong class="text-white">{SITE_AUTHOR}</strong>, <strong class="text-accent">ClickHouse Certified Developer</strong>, per progettare, migrare o ottimizzare il tuo cluster.
            </p>

            <div class="flex flex-wrap gap-4">
              <a
                href={BOOKING_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-7 py-3.5 font-ui text-sm font-bold text-black transition hover:brightness-110"
              >
                Prenota una call tecnica (15 min)
                <ArrowRight className="w-4 h-4" />
              </a>
              <a
                href={CREDLY_CLICKHOUSE_BADGE_URL}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3.5 font-ui text-sm font-semibold text-white transition hover:border-accent/50 hover:text-accent"
              >
                Verifica Certificazione Credly
                <ArrowUpRight className="w-4 h-4" />
              </a>
            </div>
          </div>

          {/* Card Certificazione & Numeri Chiave */}
          <aside class="rounded-[2rem] border border-accent/30 bg-gradient-to-br from-accent/[0.09] via-white/[0.03] to-transparent p-7 sm:p-8">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-14 h-14 rounded-2xl bg-accent/15 border border-accent/40 flex items-center justify-center text-accent shrink-0">
                <Award className="w-7 h-7" />
              </div>
              <div>
                <div class="text-xs font-mono uppercase tracking-widest text-accent">Credenziale Verificata</div>
                <h2 class="font-heading text-xl font-bold text-white">ClickHouse Certified Developer</h2>
                <p class="text-xs text-slate-400">Esame pratico hands-on ufficiale · ClickHouse Inc.</p>
              </div>
            </div>

            <div class="space-y-3 text-sm text-slate-300 border-t border-white/10 pt-5 mb-6">
              <div class="flex items-start gap-2.5">
                <CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" />
                <span>Modellazione fisica su engine <strong class="text-white">MergeTree</strong>, <strong class="text-white">ReplacingMergeTree</strong> e <strong class="text-white">AggregatingMergeTree</strong></span>
              </div>
              <div class="flex items-start gap-2.5">
                <CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" />
                <span>Pre-aggregazione real-time con <strong class="text-white">Materialized Views</strong> incrementali</span>
              </div>
              <div class="flex items-start gap-2.5">
                <CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" />
                <span>Integrazione con <strong class="text-white">dbt-clickhouse</strong>, <strong class="text-white">Kafka</strong>, <strong class="text-white">S3/Parquet</strong> e CDC da Postgres</span>
              </div>
              <div class="flex items-start gap-2.5">
                <CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" />
                <span>Compressione codec (<code class="text-accent">ZSTD</code>, <code class="text-accent">Delta</code>, <code class="text-accent">LowCardinality</code>) e skip indexes</span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 pt-2">
              <div class="rounded-xl border border-white/10 bg-black/30 p-3.5">
                <div class="font-heading text-2xl font-bold text-accent">-60 / -80%</div>
                <div class="text-xs text-slate-400 mt-0.5">Riduzione tipica costi vs warehouse pay-per-scan</div>
              </div>
              <div class="rounded-xl border border-white/10 bg-black/30 p-3.5">
                <div class="font-heading text-2xl font-bold text-white">&lt; 100ms</div>
                <div class="text-xs text-slate-400 mt-0.5">Latenza target su dashboard e API analitiche</div>
              </div>
            </div>
          </aside>
        </section>

        {/* Sintomi: Quando ti serve uno specialista ClickHouse */}
        <section class="mb-24" aria-labelledby="sintomi-clickhouse">
          <div class="max-w-3xl mb-10">
            <h2 id="sintomi-clickhouse" class="font-heading text-2xl md:text-3xl font-bold text-white mb-3">
              I 4 segnali che è il momento di intervenire
            </h2>
            <p class="text-slate-400 leading-relaxed">
              Le aziende mi contattano quando l&apos;infrastruttura dati attuale frena il prodotto o erode i margini, oppure quando hanno già installato ClickHouse ma riscontrano errori di memoria e merge lenti.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 hover:border-accent/40 transition">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent mb-4">
                <TrendingDown className="w-5 h-5" />
              </div>
              <h3 class="font-heading text-xl font-bold text-white mb-2">
                1. Costi BigQuery o Snowflake fuori controllo
              </h3>
              <p class="text-slate-400 text-sm leading-relaxed">
                Paghi per terabyte scansionato o per crediti compute a ogni refresh di Looker, Metabase o Tableau. Spostando i carichi ad alta frequenza su ClickHouse (Cloud o Self-Hosted) trasformi un costo variabile esplosivo in una spesa prevedibile e ridotta fino al 70-80%.
              </p>
            </article>

            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 hover:border-accent/40 transition">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent mb-4">
                <Gauge className="w-5 h-5" />
              </div>
              <h3 class="font-heading text-xl font-bold text-white mb-2">
                2. PostgreSQL o MySQL bloccati dalle query analitiche
              </h3>
              <p class="text-slate-400 text-sm leading-relaxed">
                Il database transazionale di produzione soffre di CPU al 100% e lock perché report interni o dashboard clienti eseguono <code class="text-slate-200">GROUP BY</code> su decine di milioni di righe. Separiamo OLTP e OLAP replicando i dati su ClickHouse senza toccare il codice applicativo core.
              </p>
            </article>

            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 hover:border-accent/40 transition">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent mb-4">
                <Cpu className="w-5 h-5" />
              </div>
              <h3 class="font-heading text-xl font-bold text-white mb-2">
                3. Errori `MEMORY_LIMIT_EXCEEDED` e `Too many parts`
              </h3>
              <p class="text-slate-400 text-sm leading-relaxed">
                Hai già adottato ClickHouse ma lo usi come se fosse Postgres: micro-insert sincroni, <code class="text-slate-200">ALTER TABLE UPDATE</code>, <code class="text-slate-200">JOIN</code> non ottimizzate o <code class="text-slate-200">ORDER BY</code> ad alta cardinalità. Riprogettiamo chiavi di ordinamento, batching e Materialized Views per eliminare i colli di bottiglia.
              </p>
            </article>

            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 hover:border-accent/40 transition">
              <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent mb-4">
                <Zap className="w-5 h-5" />
              </div>
              <h3 class="font-heading text-xl font-bold text-white mb-2">
                4. Event Tracking, Log &amp; Product Analytics in tempo reale
              </h3>
              <p class="text-slate-400 text-sm leading-relaxed">
                Devi raccogliere milioni di eventi first-party al giorno (clickstream, telemetria IoT, log applicativi, conversioni server-side) e renderli interrogabili istantaneamente da analisti, agenti AI o funzionalità di prodotto customer-facing.
              </p>
            </article>
          </div>
        </section>

        {/* Cosa facciamo in pratica: Servizi Verticali ClickHouse */}
        <section class="mb-24" aria-labelledby="servizi-clickhouse">
          <div class="max-w-3xl mb-10">
            <h2 id="servizi-clickhouse" class="font-heading text-2xl md:text-3xl font-bold text-white mb-3">
              Ambiti di intervento su ClickHouse
            </h2>
            <p class="text-slate-400 leading-relaxed">
              Dalla progettazione dello schema fisico alla messa in produzione della pipeline completa con <strong class="text-slate-200">Kafka</strong> e <strong class="text-slate-200">dbt</strong>.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-6">
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6">
              <Database className="w-6 h-6 text-accent mb-4" />
              <h3 class="font-heading text-lg font-bold text-white mb-2">
                Schema Design &amp; MergeTree Tuning
              </h3>
              <ul class="space-y-2 text-sm text-slate-400">
                <li>• Scelta dell&apos;engine (<code class="text-slate-300">MergeTree</code>, <code class="text-slate-300">Replacing</code>, <code class="text-slate-300">Aggregating</code>, <code class="text-slate-300">Summing</code>)</li>
                <li>• Ottimizzazione di <code class="text-slate-300">PRIMARY KEY</code>, <code class="text-slate-300">ORDER BY</code> e <code class="text-slate-300">PARTITION BY</code></li>
                <li>• Codec di compressione, <code class="text-slate-300">LowCardinality</code>, Projections e Skip Indexes</li>
                <li>• Politiche di <code class="text-slate-300">TTL</code> e tiering automatico su object storage S3</li>
              </ul>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6">
              <Layers className="w-6 h-6 text-accent mb-4" />
              <h3 class="font-heading text-lg font-bold text-white mb-2">
                Pipeline Real-Time, CDC &amp; dbt
              </h3>
              <ul class="space-y-2 text-sm text-slate-400">
                <li>• Ingestion streaming da <strong class="text-slate-200">Apache Kafka / Redpanda</strong> e code eventi</li>
                <li>• Replica CDC da PostgreSQL/MySQL (PeerDB, Debezium, ClickPipes)</li>
                <li>• Materialized Views incrementali per rollup sub-secondo</li>
                <li>• Modellazione, test e documentazione con <code class="text-slate-300">dbt-clickhouse</code></li>
              </ul>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6">
              <Server className="w-6 h-6 text-accent mb-4" />
              <h3 class="font-heading text-lg font-bold text-white mb-2">
                Migrazione &amp; Architettura Cluster
              </h3>
              <ul class="space-y-2 text-sm text-slate-400">
                <li>• Migrazione da BigQuery, Snowflake, Redshift o Elasticsearch</li>
                <li>• Sizing per <strong class="text-slate-200">ClickHouse Cloud</strong> o <strong class="text-slate-200">Self-Hosted</strong> (ClickHouse Keeper, ReplicatedMergeTree)</li>
                <li>• Osservabilità tramite <code class="text-slate-300">system.query_log</code> e <code class="text-slate-300">system.part_log</code></li>
                <li>• Formazione hands-on per il tuo team di Data &amp; Backend Engineer</li>
              </ul>
            </div>
          </div>
        </section>

        {/* Modalità di Lavoro */}
        <section class="mb-24" aria-labelledby="pacchetti-clickhouse">
          <div class="max-w-3xl mb-10">
            <h2 id="pacchetti-clickhouse" class="font-heading text-2xl md:text-3xl font-bold text-white mb-3">
              Come possiamo lavorare insieme
            </h2>
            <p class="text-slate-400 leading-relaxed">
              Interventi mirati, senza vincoli annuali e con trasferimento completo di codice e know-how al tuo team.
            </p>
          </div>

          <div class="grid lg:grid-cols-3 gap-6">
            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 flex flex-col justify-between">
              <div>
                <div class="text-xs font-mono uppercase tracking-widest text-accent mb-2">1 · Diagnosi Rapida</div>
                <h3 class="font-heading text-xl font-bold text-white mb-3">ClickHouse Architecture &amp; Query Audit</h3>
                <p class="text-sm text-slate-400 leading-relaxed mb-5">
                  Analisi approfondita di un cluster ClickHouse esistente o studio di fattibilità/benchmark per migrare da BigQuery/PostgreSQL.
                </p>
                <ul class="space-y-2 text-sm text-slate-300 mb-6">
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Analisi di <code class="text-xs">system.query_log</code>, parti e memoria</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Redesign di <code class="text-xs">ORDER BY</code> e Materialized Views</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Report esecutivo con PR pronte da applicare</span></li>
                </ul>
              </div>
              <a href={BOOKING_URL} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 hover:border-accent/50 hover:text-accent px-5 py-3 text-sm font-semibold text-white transition">
                Richiedi un Audit <ArrowRight className="w-4 h-4" />
              </a>
            </article>

            <article class="rounded-2xl border border-accent/40 bg-gradient-to-b from-accent/[0.08] to-white/[0.02] p-7 flex flex-col justify-between">
              <div>
                <div class="text-xs font-mono uppercase tracking-widest text-accent mb-2">2 · Progetto Chiavi in Mano</div>
                <h3 class="font-heading text-xl font-bold text-white mb-3">Migrazione &amp; Pipeline Real-Time</h3>
                <p class="text-sm text-slate-300 leading-relaxed mb-5">
                  Progettazione e messa in produzione del tuo data warehouse su ClickHouse, inclusa ingestion da Kafka/Postgres e trasformazioni dbt.
                </p>
                <ul class="space-y-2 text-sm text-slate-200 mb-6">
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Setup ClickHouse Cloud o Self-Hosted sicuro</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Pipeline di ingestion idempotenti e zero-downtime</span></li>
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Affiancamento e training pratico al tuo team</span></li>
                </ul>
              </div>
              <a href={BOOKING_URL} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--color-accent)] hover:brightness-110 px-5 py-3 text-sm font-bold text-black transition">
                Prenota call esplorativa <ArrowRight className="w-4 h-4" />
              </a>
            </article>

            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-7 flex flex-col justify-between">
              <div>
                <div class="text-xs font-mono uppercase tracking-widest text-accent mb-2">3 · Supporto Continuativo</div>
                <h3 class="font-heading text-xl font-bold text-white mb-3">Advisory &amp; Sparring Tecnico</h3>
                <p class="text-sm text-slate-400 leading-relaxed mb-5">
                  Un <strong class="text-slate-200">ClickHouse Certified Developer</strong> a fianco dei tuoi sviluppatori per code review, evoluzione dello schema e scelte architetturali.
                </p>
                <ul class="space-y-2 text-sm text-slate-300 mb-6">
                  <li class="flex items-start gap-2"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>Review periodica di query, migrazioni e modelli dbt</span></li>
