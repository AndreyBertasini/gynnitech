---

interface Props {
  sbagliato: string;
  giusto: string;
}

const { sbagliato, giusto } = Astro.props;
---

<div class="lz-errore">
  <div class="lz-errore__lato lz-errore__lato--no">
    <p class="lz-errore__titolo"><span class="lz-segno lz-segno--no" aria-hidden="true">✗</span><span>Sbagliato</span></p>
    {Astro.slots.has('sbagliato') && <div class="lz-errore__disegno"><slot name="sbagliato" /></div>}
    <p class="lz-errore__testo">{sbagliato}</p>
  </div>
  <div class="lz-errore__lato lz-errore__lato--si">
    <p class="lz-errore__titolo"><span class="lz-segno lz-segno--si" aria-hidden="true">✓</span><span>Giusto</span></p>
    {Astro.slots.has('giusto') && <div class="lz-errore__disegno"><slot name="giusto" /></div>}
    <p class="lz-errore__testo">{giusto}</p>
  </div>
</div>
