---
import { cellMark, parseEvidenzia } from '../../lib/lezione/model';

/** Mini-tabella (prompt D): griglia di quadratini, accento solo dove conta. */
interface Props {
  colonne: string;
  righe: string;
  evidenzia?: string;
  separa?: string;
  didascalia?: string;
  passo?: string;
}

const { colonne, righe, evidenzia, separa, didascalia, passo } = Astro.props;
const nomi = colonne.split(',').map((c) => c.trim()).filter(Boolean);
const numeroRighe = Number(righe);
if (nomi.length === 0 || !Number.isInteger(numeroRighe) || numeroRighe < 1) {
  throw new Error(`<MiniTabella colonne="${colonne}" righe="${righe}">: servono colonne e un numero di righe.`);
}
const evidenze = parseEvidenzia(evidenzia, nomi);
const celle = Array.from({ length: numeroRighe }, (_, r) => nomi.map((nome) => cellMark(evidenze, r + 1, nome)));
---

<div class="lz-minitab-blocco" data-passo={passo}>
  <div class="lz-scroll">
    <div class="lz-minitab" style={`--lz-cols:${nomi.length}`} data-separa={separa} role="img" aria-label={didascalia ?? colonne}>
      {nomi.map((nome) => <span class="lz-minitab__head">{nome}</span>)}
      {celle.map((riga) =>
        riga.map((mark) => <span class:list={['lz-minitab__cell', { 'lz-accento': mark.statico }]} data-accento={mark.passo} />),
      )}
    </div>
  </div>
  {didascalia && <p class="lz-didascalia">{didascalia}</p>}
</div>
