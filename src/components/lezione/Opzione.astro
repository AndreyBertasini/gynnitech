---
interface Props {
  nome: string;
  testo: string;
  verdetto: 'si' | 'no';
  passo?: string;
}

const { nome, testo, verdetto, passo } = Astro.props;
if (verdetto !== 'si' && verdetto !== 'no') throw new Error(`<Opzione nome="${nome}">: verdetto deve essere "si" o "no".`);
const giusta = verdetto === 'si';
---

<div class:list={['lz-opzione', giusta ? 'lz-opzione--si' : 'lz-opzione--no']} data-passo={passo}>
  <span class:list={['lz-segno', giusta ? 'lz-segno--si' : 'lz-segno--no']} aria-hidden="true">{giusta ? '✓' : '✗'}</span>
  <p class="lz-opzione__nome">{nome}</p>
  <p class="lz-opzione__testo">{testo}</p>
</div>
