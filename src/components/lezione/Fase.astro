---
interface Props {
  nome: string;
  testo: string;
  evidenzia?: string;
  passo?: string;
}

const { nome, testo, evidenzia, passo } = Astro.props;
---

<li class:list={['lz-fase', { 'lz-accento': evidenzia === 'si' }]} data-passo={passo}>
  <p class="lz-fase__nome">{nome}</p>
  <p class="lz-fase__testo">{testo}</p>
</li>
