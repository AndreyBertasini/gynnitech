---
interface Props {
  nome: string;
  valore: string;
  etichetta?: string;
  tipo?: 'evidenzia' | 'normale' | 'vuoto';
  passo?: string;
}

const { nome, valore, etichetta, tipo = 'normale', passo } = Astro.props;
if (!/^\d+(\.\d+)?$/.test(valore)) throw new Error(`<Barra nome="${nome}">: valore deve essere un numero.`);
---

<div class:list={['lz-barra-q', `lz-barra-q--${tipo}`]} data-valore={valore} data-passo={passo} style={`--lz-v:${valore}`}>
  <span class="lz-barra-q__num">{etichetta ?? valore}</span>
  <span class="lz-barra-q__pista"><span class="lz-barra-q__riempi" /></span>
  <span class="lz-barra-q__nome">{nome}</span>
</div>
