---

const ctx = Astro.locals.lezione;
if (!ctx) throw new Error('<Percorso /> fuori da una lezione con formato: "3s".');
---

<div class="lz-percorso">
  <p class="lz-percorso__meta"><span>Lezione</span> <span>{ctx.numero}</span> <span>di</span> <span>{ctx.totale}</span></p>
  <ol class="lz-percorso__pillole">
    {ctx.sezioni.map((nome, i) => (
      <li class="lz-pillola"><span class="lz-pillola__n">{i + 1}</span> <span>{nome}</span></li>
    ))}
  </ol>
</div>
