---
import { progressSegments, sectionLabel } from '../../lib/lezione/model';

interface Props {
  sezione: string;
  titolo: string;
  messaggio: string;
  didascalia?: string;
}

const { sezione, titolo, messaggio, didascalia } = Astro.props;
const numero = Number(sezione);
const ctx = Astro.locals.lezione;
sectionLabel(ctx, numero); // lancia se la sezione non esiste
const sezioni = ctx!.sezioni;
const segmenti = progressSegments(sezioni.length, numero);
---

<figure class="lz-slide">
  <div class="lz-slide__testa">
    <p class="lz-slide__titolo">{titolo}</p>
    <p class="lz-etichetta"><span>{numero}</span> · <span>{sezioni[numero - 1]}</span></p>
  </div>
  <div class="lz-area"><slot /></div>
  {didascalia && <p class="lz-didascalia">{didascalia}</p>}
  <figcaption class="lz-msg"><span class="lz-stella" aria-hidden="true">★</span><span>{messaggio}</span></figcaption>
  <div class="lz-barra" aria-hidden="true">
    {segmenti.map((attiva) => <span class:list={['lz-barra__seg', { 'lz-barra__seg--on': attiva }]} />)}
  </div>
</figure>
