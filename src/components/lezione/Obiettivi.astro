---
/** Obiettivi della lezione nel corpo (da learningObjectives), al posto del vecchio box «Cosa imparerai». */
const ctx = Astro.locals.lezione;
if (!ctx) throw new Error('<Obiettivi /> fuori da una lezione con formato: "3s".');
if (ctx.obiettivi.length === 0) throw new Error('<Obiettivi />: la lezione non ha learningObjectives.');
---

<div class="lz-obiettivi">
  <p class="lz-obiettivi__titolo">Alla fine della lezione sai:</p>
  <ol class="lz-obiettivi__lista">
    {ctx.obiettivi.map((obiettivo) => <li>{obiettivo}</li>)}
  </ol>
</div>
