---
/** Pattern e anti-pattern dopo ogni figura: cosa fare e cosa evitare, in una riga ciascuno. */
interface Props {
  si: string;
  no: string;
}

const { si, no } = Astro.props;
---

<div class="lz-pattern">
  <p class="lz-pattern__riga"><span class="lz-segno lz-segno--si" aria-hidden="true">✓</span><span><strong>Pattern</strong> {si}</span></p>
  <p class="lz-pattern__riga"><span class="lz-segno lz-segno--no" aria-hidden="true">✗</span><span><strong>Anti-pattern</strong> {no}</span></p>
</div>
