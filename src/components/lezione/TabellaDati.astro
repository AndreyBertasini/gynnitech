---
import { highlightTableRows, parseRighe } from '../../lib/lezione/model';

/** Tabella con dati veri (prompt E): avvolge una tabella Markdown, righe importanti in accento. */
interface Props {
  evidenzia?: string;
}

const html = highlightTableRows(await Astro.slots.render('default'), parseRighe(Astro.props.evidenzia));
---

<div class="lz-scroll">
  <div class="lz-tabdati" set:html={html} />
</div>
