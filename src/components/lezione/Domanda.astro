---

interface Props {
  risposta: string;
}

const { risposta } = Astro.props;
---

<div class="lz-domanda">
  <p class="lz-domanda__testo"><span class="lz-domanda__icona" aria-hidden="true">?</span><span><slot /></span></p>
  <details>
    <summary>Mostra risposta</summary>
    <p>{risposta}</p>
  </details>
</div>
