---
interface Props {
  nome: string;
  sottotitolo: string;
  esempio?: string;
  scelta?: string;
  passo?: string;
}

const { nome, sottotitolo, esempio, scelta, passo } = Astro.props;
---

<section class:list={['lz-lato', { 'lz-lato--scelta': scelta }]} data-passo={passo}>
  {scelta && <span class="lz-pillola-scelta">{scelta}</span>}
  <p class="lz-lato__nome">{nome}</p>
  <p class="lz-lato__sotto">{sottotitolo}</p>
  {esempio && <code class="lz-lato__esempio">{esempio}</code>}
</section>
