---
interface Props {
  nome: string;
  a: string;
  b: string;
  passo?: string;
}

const { nome, a, b, passo } = Astro.props;
---

<div class="lz-criterio" data-passo={passo}>
  <p class="lz-criterio__a">{a}</p>
  <span class="lz-criterio__nome">{nome}</span>
  <p class="lz-criterio__b">{b}</p>
</div>
