---
import { maxDataValore } from '../../lib/lezione/model';

/** Quantità a confronto (prompt F): altezza delle <Barra> proporzionale al valore massimo. */
const html = await Astro.slots.render('default');
const massimo = maxDataValore(html);
---

<div class="lz-barre" style={`--lz-max:${massimo}`} set:html={html} />
