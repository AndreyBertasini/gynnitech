---
import { extractPassi, progressSegments, sectionLabel } from '../../lib/lezione/model';

/** Schema che cresce: una vista per passo; senza JavaScript tutte le viste una sotto l'altra. */
interface Props {
  sezione: string;
  titolo: string;
}

const { sezione, titolo } = Astro.props;
const numero = Number(sezione);
const ctx = Astro.locals.lezione;
sectionLabel(ctx, numero); // lancia se la sezione non esiste
const sezioni = ctx!.sezioni;
const segmenti = progressSegments(sezioni.length, numero);

const { passi, disegno } = extractPassi(await Astro.slots.render('default'));
if (passi.length < 3 || passi.length > 6) {
  throw new Error(`<Schema titolo="${titolo}">: servono da 3 a 6 <Passo>, trovati ${passi.length}.`);
}
const totale = passi.length;
---

<figure class="lz-schema" tabindex="0" data-totale={totale}>
  <div class="lz-slide__testa">
    <p class="lz-slide__titolo">{titolo}</p>
    <p class="lz-etichetta"><span>{numero}</span> · <span>{sezioni[numero - 1]}</span></p>
  </div>
  <div class="lz-schema__comandi">
    <button type="button" class="lz-schema__prec"><span aria-hidden="true">◀</span><span class="lz-sr">Passo precedente</span></button>
    {passi.map((_, i) => (
      <button type="button" class="lz-schema__cerchio"><span class="lz-sr">Passo</span> {i + 1}</button>
    ))}
    <button type="button" class="lz-schema__succ"><span aria-hidden="true">▶</span><span class="lz-sr">Passo successivo</span></button>
  </div>
  <p class="lz-schema__stato lz-sr" aria-live="polite"></p>
  {passi.map((testo, i) => (
    <div class="lz-vista" data-attuale={i + 1}>
      <p class="lz-vista__riga"><span>Passo</span> <span>{i + 1}</span> <span>di</span> <span>{totale}</span> — <span set:html={testo} /></p>
      <div class="lz-area" set:html={disegno} />
    </div>
  ))}
  <div class="lz-barra" aria-hidden="true">
    {segmenti.map((attiva) => <span class:list={['lz-barra__seg', { 'lz-barra__seg--on': attiva }]} />)}
  </div>
</figure>

<script>
  import { initSchemas } from './schema-stepper';
  initSchemas(document);
</script>
