---
import { extractPassi } from '../../lib/lezione/model';

/** Schema che cresce, tutto visibile: una riga per passo, testo a sinistra e disegno a destra. */
interface Props {
  sezione?: string;
  titolo: string;
}

const { titolo } = Astro.props;
const { passi, disegno } = extractPassi(await Astro.slots.render('default'));
if (passi.length < 3 || passi.length > 6) {
  throw new Error(`<Schema titolo="${titolo}">: servono da 3 a 6 <Passo>, trovati ${passi.length}.`);
}
---

<figure class="lz-schema">
  <p class="lz-slide__titolo">{titolo}</p>
  <ol class="lz-schema__passi">
    {passi.map((testo, i) => (
      <li class="lz-vista" data-attuale={i + 1}>
        <p class="lz-vista__riga"><span class="lz-segno lz-segno--n" aria-hidden="true">{i + 1}</span><span set:html={testo} /></p>
        <div class="lz-area" set:html={disegno} />
      </li>
    ))}
  </ol>
</figure>
