---
import Search from '@astrojs/starlight/components/Search.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';

const { sidebar } = Astro.props;
---

<div class="sidebar-wrapper h-full flex flex-col">
  <div class="p-4 border-b border-[var(--sl-color-hairline)] bg-[var(--sl-color-bg-sidebar)] sticky top-0 z-10">
    <Search {...Astro.props} />
  </div>
  
  <div class="overflow-y-auto flex-grow px-4 py-4">
    {sidebar && <SidebarSublist sublist={sidebar} />}
  </div>

  <div class="md:hidden border-t border-[var(--sl-color-hairline)]">
    <MobileMenuFooter {...Astro.props} />
  </div>
</div>

<style>
  /* Custom styles to ensure search looks good in sidebar */
  :global(.sidebar-wrapper site-search) {
    width: 100%;
  }
  
  :global(.sidebar-wrapper button[data-open-modal]) {
    width: 100% !important;
    border: 1px solid var(--sl-color-hairline);
    background-color: var(--sl-color-bg-nav);
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--sl-color-gray-3);
  }
  
  :global(.sidebar-wrapper button[data-open-modal]:hover) {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text);
  }
</style>
