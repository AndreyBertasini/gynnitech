---
import { BookOpen, Code2, BarChart3, Zap, FlaskConical, GraduationCap, ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';
import { COURSE_MODULES } from '../data/course-modules';

const totalModules = COURSE_MODULES.length;
const totalLessons = (await getCollection('corso')).filter((entry) => entry.id.includes('/')).length;

const steps = [
  {
    icon: BookOpen,
    title: "Fondamenti & Raccolta Dati",
    description: "Riceverai il metodo per progettare piani di tracciamento infallibili. Imparerai a strutturare i dati alla fonte garantendo qualità e privacy fin dal primo evento.",
    color: 'from-teal-500 to-emerald-400'
  },
  {
    icon: Code2,
    title: "SQL, Python & Pipeline",
    description: "Costruirai da zero il tuo stack tecnologico. Dominerai SQL e Python per creare pipeline automatizzate che portano i dati grezzi fino alla dashboard finale.",
    color: 'from-blue-500 to-cyan-400'
  },
  {
    icon: BarChart3,
    title: "Metriche & Visualizzazione",
    description: "Svilupperai la sensibilità per distinguere le vanity metrics dai KPI reali. Creerai dashboard che non solo mostrano numeri, ma guidano le decisioni strategiche.",
    color: 'from-green-500 to-emerald-400'
  },
  {
    icon: Zap,
    title: "Real-Time & ClickHouse",
    description: "Otterrai le competenze per gestire Big Data in tempo reale. Imparerai a configurare ClickHouse e viste materializzate per analisi istantanee su grandi volumi.",
    color: 'from-yellow-400 to-orange-500'
  },
  {
    icon: FlaskConical,
    title: "Data Science & Sperimentazione",
    description: "Acquisirai gli strumenti del Data Scientist applicati al business. A/B testing, modelli di attribuzione e clustering per trasformare le ipotesi in certezze matematiche.",
    color: 'from-pink-500 to-rose-400'
  },
  {
    icon: GraduationCap,
    title: "Strategia & Management",
    description: "Riceverai i framework di management per guidare team e progetti. Imparerai a comunicare con gli stakeholder e a tradurre l'analisi tecnica in impatto di business.",
    color: 'from-violet-500 to-purple-400'
  }
];
---

<section class="py-16 bg-brand-darker relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-5 font-heading leading-tight">
        Da zero a Data Analyst. Passo dopo passo.
      </h2>
      <p class="text-slate-400 text-lg font-sans leading-relaxed max-w-xl mx-auto">
        {totalModules} moduli e {totalLessons} lezioni. Un percorso strutturato che ti porta dalle basi fino all'analisi avanzata e alla sperimentazione statistica.
      </p>
    </div>

    {/* Cards Grid — same style as /course CourseCard */}
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {steps.map((step, index) => {
        const Icon = step.icon;
        return (
          <div class="group relative block h-full">
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-white/5 to-white/0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <div class="relative h-full overflow-hidden rounded-2xl border border-white/10 bg-[#0a0e14]/80 p-8 transition-all duration-300 group-hover:border-accent group-hover:shadow-[0_0_30px_-10px_rgba(204,255,0,0.2)] backdrop-blur-md">
              
              {/* Glow effect */}
              <div class={`absolute -right-20 -top-20 h-64 w-64 rounded-full bg-gradient-to-br ${step.color} opacity-[0.05] blur-3xl transition-opacity duration-500 group-hover:opacity-20`}></div>

              <div class="relative z-10 flex h-full flex-col">
                <div class="mb-6 flex items-start justify-between">
                  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5 border border-white/10 text-white transition-transform duration-300 group-hover:scale-110 group-hover:border-accent/50 group-hover:text-accent shadow-[0_0_10px_rgba(0,0,0,0.5)]">
                    <Icon className="h-6 w-6" />
                  </div>
                  <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[10px] font-ui font-medium tracking-widest text-slate-400 group-hover:text-accent group-hover:border-accent/30 transition-colors">
                    STEP {String(index + 1).padStart(2, '0')}
                  </span>
                </div>

                <h3 class="mb-3 text-2xl font-bold text-white transition-colors group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-white group-hover:to-accent font-heading tracking-tight">{step.title}</h3>
                
                <p class="mb-8 flex-grow text-sm leading-relaxed text-slate-400 font-sans">{step.description}</p>
              </div>
            </div>
          </div>
        )
      })}
    </div>

    {/* Bottom CTA */}
    <div class="text-center mt-10">
      <a href="/#corsi" class="inline-flex items-center gap-2 px-8 py-4 bg-white/[0.06] border border-white/10 hover:border-accent/50 text-white font-semibold rounded-full transition-all duration-300 hover:bg-white/10 hover:shadow-[0_0_25px_rgba(204,255,0,0.15)] font-ui group">
        Esplora tutti i moduli
        <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>
  </div>
</section>
