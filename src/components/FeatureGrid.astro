---
import { FileText, Settings, BarChart3, Zap, Globe, Shield } from 'lucide-react';

const features = [
  {
    icon: FileText,
    title: "MDX Powered",
    description: "Write your content in MDX. Use components inside your markdown for rich, interactive experiences."
  },
  {
    icon: Settings,
    title: "Highly Customizable",
    description: "Style your documentation to match your brand perfectly with Tailwind CSS and custom components."
  },
  {
    icon: Zap,
    title: "Blazing Fast",
    description: "Built on Astro for optimal performance. Zero JavaScript by default means instant page loads."
  },
  {
    icon: BarChart3,
    title: "Built-in Analytics",
    description: "Understand how users interact with your documentation with privacy-friendly analytics."
  },
  {
    icon: Globe,
    title: "Global CDN",
    description: "Deployed to the edge. Your documentation is served from the closest server to your users."
  },
  {
    icon: Shield,
    title: "Enterprise Secure",
    description: "SOC2 compliant platform with advanced security features for enterprise teams."
  }
];
---

<section class="py-24 bg-brand-darker relative">
  <div class="container mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 font-audiowide text-glow-blue">Il Marketing non si Inventa, si Architetta.</h2>
      <p class="text-slate-400 text-lg font-sans">Focus sui contenuti, al resto pensiamo noi. Una piattaforma completa per la tua base di conoscenza.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => {
        const Icon = feature.icon;
        return (
          <div class="p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-acid-yellow/50 hover:bg-white/10 transition-all group backdrop-blur-sm hover:shadow-[0_0_20px_rgba(204,255,0,0.1)]">
            <div class="w-12 h-12 bg-brand-dark rounded-lg flex items-center justify-center text-acid-yellow border border-white/10 mb-4 group-hover:scale-110 transition-transform group-hover:border-acid-yellow group-hover:shadow-[0_0_10px_rgba(204,255,0,0.3)]">
              <Icon className="w-6 h-6" />
            </div>
            <h3 class="text-xl font-semibold text-white mb-2 font-orbitron">{feature.title}</h3>
            <p class="text-slate-400 leading-relaxed font-sans">{feature.description}</p>
          </div>
        )
      })}
    </div>
  </div>
</section>
