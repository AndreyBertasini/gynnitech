---
import { BookOpen, Code2, BarChart3, Zap, FlaskConical, GraduationCap, ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';
import { COURSE_MODULES } from '../data/course-modules';

const totalModules = COURSE_MODULES.length;
const totalLessons = (await getCollection('corso')).filter((entry) => entry.id.includes('/')).length;

const steps = [
  {
    icon: BookOpen,
    title: 'Fondamenti e raccolta dati',
    description: 'Impari a progettare un tracking plan chiaro: eventi, proprietà, consenso e qualità del dato prima di aprire una dashboard.',
    color: 'from-accent/60 to-white/20',
  },
  {
    icon: Code2,
    title: 'SQL, Python e pipeline',
    description: 'Costruisci il flusso base: dati grezzi, trasformazioni, controlli e output leggibili per analisi e report.',
    color: 'from-accent/50 to-white/15',
  },
  {
    icon: BarChart3,
    title: 'Metriche e visualizzazione',
    description: 'Distingui KPI utili da vanity metrics e costruisci dashboard che aiutano a decidere, non solo a guardare numeri.',
    color: 'from-accent/55 to-white/20',
  },
  {
    icon: Zap,
    title: 'Real-time e ClickHouse',
    description: 'Capisci quando serve il tempo reale e come usare ClickHouse, viste materializzate e modelli veloci sui dati operativi.',
    color: 'from-accent/60 to-amber-300/35',
  },
  {
    icon: FlaskConical,
    title: 'Data science e sperimentazione',
    description: 'Usi A/B test, attribuzione e modelli semplici per capire cosa cambia davvero un risultato di business.',
    color: 'from-accent/50 to-white/15',
  },
  {
    icon: GraduationCap,
    title: 'Strategia e management',
    description: 'Traduci analisi tecniche in priorità, roadmap e decisioni comprensibili per stakeholder e team.',
    color: 'from-accent/55 to-white/20',
  },
];
---

<section class="py-16 bg-[var(--sl-color-bg)] relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-5 font-heading leading-tight">
        Da zero a Data Analyst. Passo dopo passo.
      </h2>
      <p class="text-slate-400 text-lg font-sans leading-relaxed max-w-xl mx-auto">
        {totalModules} moduli e {totalLessons} lezioni. Parti dalle basi, costruisci strumenti reali e arrivi a esperimenti, dashboard e decisioni.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {steps.map((step, index) => {
        const Icon = step.icon;
        return (
          <div class="group relative block h-full">
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-white/5 to-white/0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <div class="relative h-full overflow-hidden rounded-2xl border border-white/10 bg-[#0a0e14]/80 p-8 transition duration-300 group-hover:border-accent group-hover:shadow-[0_0_30px_-10px_rgba(204,255,0,0.2)] backdrop-blur-md">
              <div class="relative z-10 flex h-full flex-col">
                <div class="mb-6 flex items-start justify-between">
                  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/5 border border-white/10 text-white transition-transform duration-300 group-hover:scale-110 group-hover:border-accent/50 group-hover:text-accent shadow-[0_0_10px_rgba(0,0,0,0.5)]">
                    <Icon className="h-6 w-6" />
                  </div>
                  <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[10px] font-ui font-medium tracking-widest text-slate-400 group-hover:text-accent group-hover:border-accent/30 transition-colors">
                    STEP {String(index + 1).padStart(2, '0')}
                  </span>
                </div>

                <h3 class="mb-3 text-2xl font-bold text-white transition-colors group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-white group-hover:to-accent font-heading tracking-tight">{step.title}</h3>
                <p class="mb-8 flex-grow text-sm leading-relaxed text-slate-400 font-sans">{step.description}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="text-center mt-10">
      <a href="/#corsi" class="inline-flex items-center gap-2 px-8 py-4 bg-white/[0.06] border border-white/10 hover:border-accent/50 text-white font-semibold rounded-full transition duration-300 hover:bg-white/10 hover:shadow-[0_0_25px_rgba(204,255,0,0.15)] font-ui group">
        Esplora tutti i moduli
        <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>
  </div>
</section>
