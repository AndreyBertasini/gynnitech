---
import { getCollection } from 'astro:content';

const allLessons = await getCollection('corso');
const totalLessons = allLessons.length;

// Count modules (unique directories)
const uniqueModules = new Set(allLessons.map(lesson => lesson.id.split('/')[0]));
const totalModules = uniqueModules.size;
---

<section class="py-16 border-y border-white/5 bg-white/[0.02] relative z-20">
  <div class="container mx-auto px-6">
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16 text-center">

      {/* Lessons */}
      <div class="flex flex-col items-center min-w-[120px]">
        <span class="text-4xl md:text-5xl font-bold text-white font-heading">{totalLessons}+</span>
        <span class="text-xs md:text-sm text-slate-500 uppercase tracking-widest mt-2 font-medium">Lezioni</span>
      </div>

      <div class="w-px h-12 bg-white/10 hidden md:block"></div>

      {/* Modules */}
      <div class="flex flex-col items-center min-w-[120px]">
        <span class="text-4xl md:text-5xl font-bold text-white font-heading">{totalModules}</span>
        <span class="text-xs md:text-sm text-slate-500 uppercase tracking-widest mt-2 font-medium">Moduli</span>
      </div>

      <div class="w-px h-12 bg-white/10 hidden md:block"></div>

      {/* Duration */}
      <div class="flex flex-col items-center min-w-[120px]">
        <span class="text-4xl md:text-5xl font-bold text-white font-heading">~45<span class="text-2xl align-top text-slate-500 ml-1">min</span></span>
        <span class="text-xs md:text-sm text-slate-500 uppercase tracking-widest mt-2 font-medium">Durata Media</span>
      </div>

      <div class="w-px h-12 bg-white/10 hidden md:block"></div>

      {/* Free */}
      <div class="flex flex-col items-center min-w-[120px]">
        <span class="text-4xl md:text-5xl font-bold text-acid-yellow font-heading">100%</span>
        <span class="text-xs md:text-sm text-acid-yellow/80 uppercase tracking-widest mt-2 font-medium">Gratuito</span>
      </div>

    </div>

    <div class="mt-12 text-center max-w-2xl mx-auto">
      <p class="text-slate-400 font-light text-lg">
        Livello universitario. Approccio pratico. <span class="text-white font-medium border-b border-acid-yellow/30 pb-0.5">Costruito per il mercato italiano.</span>
      </p>
    </div>
  </div>
</section>
