---
import { Database, Unlock, Hammer } from 'lucide-react';
---

<section class="py-20 bg-brand-dark relative z-10">
  <div class="container mx-auto px-6">
    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">

      {/* Card 1 */}
      <div class="p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-acid-yellow/50 transition-all duration-300 hover:-translate-y-1 group">
        <div class="w-12 h-12 bg-acid-yellow/10 rounded-lg flex items-center justify-center mb-6 text-acid-yellow group-hover:scale-110 transition-transform duration-300">
          <Database className="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-white mb-3 font-heading">Esperienza Reale</h3>
        <p class="text-slate-400 leading-relaxed font-light">
          Lezioni costruite da chi lavora ogni giorno con dati, tracking e analytics nel settore italiano.
        </p>
      </div>

      {/* Card 2 */}
      <div class="p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-acid-yellow/50 transition-all duration-300 hover:-translate-y-1 group">
        <div class="w-12 h-12 bg-acid-yellow/10 rounded-lg flex items-center justify-center mb-6 text-acid-yellow group-hover:scale-110 transition-transform duration-300">
          <Unlock className="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-white mb-3 font-heading">Tutto Gratis, Sempre</h3>
        <p class="text-slate-400 leading-relaxed font-light">
          Nessun paywall, nessun upsell. Un contributo alla community di chi vuole crescere.
        </p>
      </div>

      {/* Card 3 */}
      <div class="p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-acid-yellow/50 transition-all duration-300 hover:-translate-y-1 group">
        <div class="w-12 h-12 bg-acid-yellow/10 rounded-lg flex items-center justify-center mb-6 text-acid-yellow group-hover:scale-110 transition-transform duration-300">
          <Hammer className="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-white mb-3 font-heading">Orientato al Fare</h3>
        <p class="text-slate-400 leading-relaxed font-light">
          Non solo teoria — impari a costruire tracking plan, dashboard, e strategie data-driven.
        </p>
      </div>

    </div>
  </div>
</section>
