---
import { getCollection } from 'astro:content';
import { ArrowRight, FileText } from 'lucide-react';

// Define the module metadata based on the Learning Path
// Using a type for clarity
type ModuleInfo = {
  title: string;
  description: string;
  order: number;
};

const moduleMetadata: Record<string, ModuleInfo> = {
  'metriche-fondamenti': {
    title: 'Metriche & Fondamenti',
    description: 'Le basi del MarTech: metriche chiave, funnel e KPI che contano davvero.',
    order: 1
  },
  'data-collection': {
    title: 'Data Collection & Tracking',
    description: 'Come raccogliere dati puliti con GTM, GA4 e Server-Side Tracking.',
    order: 2
  },
  'gestione-data-driven': {
    title: 'Gestione Data Driven',
    description: 'Framework decisionali e cultura del dato per team di crescita.',
    order: 3
  },
  'analisi-prodotto': {
    title: 'Analisi Prodotto',
    description: 'Capire il comportamento utente: retention, attivazione e product market fit.',
    order: 4
  },
  'analisi-marketing': {
    title: 'Analisi Marketing',
    description: 'Attribuzione, ottimizzazione canali e misurazione del ROI.',
    order: 5
  },
  'dashboard-visualizzazione': {
    title: 'Dashboard & Visualizzazione',
    description: 'Creare report che guidano le decisioni, non solo grafici colorati.',
    order: 6
  },
  's3-data-lake': {
    title: 'S3 Data Lake',
    description: 'Introduzione al moderno storage dei dati nel cloud.',
    order: 7
  },
  'data-warehousing': {
    title: 'Data Warehousing',
    description: 'SQL avanzato e modellazione dati per analisti.',
    order: 8
  },
  'infrastructure-ops': {
    title: 'Infrastructure Ops',
    description: 'CI/CD, Terraform e gestione dell\'infrastruttura dati.',
    order: 9
  },
  'real-time-analytics': {
    title: 'Real-Time Analytics',
    description: 'Analisi in tempo reale con ClickHouse e Materialized Views.',
    order: 10
  },
  'kafka-streaming': {
    title: 'Kafka Streaming',
    description: 'Architetture di streaming avanzate per i dati.',
    order: 11
  },
  'marketing-data-science': {
    title: 'Marketing Data Science',
    description: 'Modelli predittivi, Python e Machine Learning applicato al marketing.',
    order: 12
  }
};

const allLessons = await getCollection('corso');

// Group lessons by module and count
const moduleCounts: Record<string, number> = {};
allLessons.forEach(lesson => {
  const moduleId = lesson.id.split('/')[0];
  if (moduleId) {
      moduleCounts[moduleId] = (moduleCounts[moduleId] || 0) + 1;
  }
});

// Create the display list (Top 6 modules for preview)
const modulesList = Object.keys(moduleMetadata)
  .filter(id => (moduleCounts[id] || 0) > 0) // Only show modules with content
  .map(id => ({
    id,
    ...moduleMetadata[id],
    count: moduleCounts[id] || 0
  }))
  .sort((a, b) => a.order - b.order)
  .slice(0, 6); // Show top 6
---

<section class="py-20 bg-brand-dark relative z-10">
  <div class="container mx-auto px-6 max-w-5xl">

    <div class="mb-16 text-center">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6 font-heading tracking-tight">Cosa Imparerai</h2>
      <p class="text-xl text-slate-400 font-light max-w-2xl mx-auto">Un percorso strutturato, dalla base all'ingegneria dei dati.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {modulesList.map((module) => (
        <a href={`/course/${module.id}`} class="group block h-full">
          <div class="h-full p-8 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-acid-yellow/50 hover:bg-white/[0.05] transition-all duration-300 flex flex-col justify-between group-hover:-translate-y-1">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono text-acid-yellow/70 border border-acid-yellow/20 px-2 py-1 rounded uppercase tracking-wider bg-acid-yellow/5">
                  Modulo {module.order}
                </span>
                <span class="flex items-center gap-1.5 text-xs text-slate-500 font-medium">
                  <FileText className="w-3.5 h-3.5" />
                  {module.count} Lezioni
                </span>
              </div>

              <h3 class="text-xl font-bold text-white mb-3 group-hover:text-acid-yellow transition-colors font-heading leading-tight">
                {module.title}
              </h3>

              <p class="text-sm text-slate-400 font-light leading-relaxed mb-6">
                {module.description}
              </p>
            </div>

            <div class="flex items-center text-sm font-medium text-slate-500 group-hover:text-acid-yellow transition-colors mt-auto pt-4 border-t border-white/5">
              Esplora il modulo
              <ArrowRight className="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" />
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a href="/course" class="inline-flex items-center px-8 py-4 bg-white/5 border border-white/10 text-white font-bold rounded-full hover:bg-white/10 hover:border-acid-yellow/50 transition-all group backdrop-blur-sm">
        Vedi il programma completo
        <ArrowRight className="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

  </div>
</section>
