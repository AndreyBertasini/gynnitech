---
import { ArrowRight } from 'lucide-react';
---

<section class="py-32 relative overflow-hidden bg-brand-dark">
  {/* Background */}
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-full bg-gradient-to-t from-acid-yellow/10 via-transparent to-transparent opacity-50"></div>
    <div class="absolute bottom-[-20%] left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-acid-yellow/20 rounded-[100%] blur-[120px]"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 text-center">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-8 font-heading tracking-tight leading-none">
        Il futuro appartiene a chi sa <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-b from-acid-yellow to-white/80">leggere i dati</span>
      </h2>

      <p class="text-xl md:text-2xl text-slate-400 mb-12 font-light max-w-2xl mx-auto">
        Inizia quando vuoi. Procedi al tuo ritmo. <br class="hidden md:block" />
        È tutto qui, per te.
      </p>

      <a
        href="/course"
        class="inline-flex items-center px-10 py-5 bg-acid-yellow text-brand-dark font-bold text-xl rounded-full hover:bg-[#b3e600] hover:scale-105 transition-all shadow-[0_0_40px_rgba(204,255,0,0.4)] hover:shadow-[0_0_60px_rgba(204,255,0,0.6)] font-ui"
      >
        Inizia il Corso
        <ArrowRight className="w-6 h-6 ml-2" />
      </a>
    </div>
  </div>
</section>
