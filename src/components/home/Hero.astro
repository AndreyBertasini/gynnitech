---
import { ArrowRight } from 'lucide-react';
---

<section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-brand-dark pt-20 pb-32">
  {/* Background Elements - Minimal & abstract */}
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-acid-yellow/5 rounded-full blur-[120px] opacity-60"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[600px] h-[600px] bg-neon-blue/5 rounded-full blur-[100px] opacity-40"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 flex flex-col items-center text-center">

    {/* Badge */}
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/[0.03] border border-white/10 text-sm font-medium text-acid-yellow mb-8 backdrop-blur-md">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-acid-yellow opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-acid-yellow"></span>
      </span>
      Il primo corso MarTech open-source in Italia
    </div>

    {/* H1 */}
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white tracking-tighter mb-8 leading-[1.1] font-heading max-w-5xl">
      Impara a costruire con i dati, <br class="hidden md:block" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-acid-yellow via-white to-white">non solo a studiarli</span>
    </h1>

    {/* Subtitle */}
    <p class="text-lg md:text-xl text-slate-400 mb-10 max-w-2xl leading-relaxed font-light">
      Un percorso gratuito e pratico per trasformare la tua carriera nel marketing digitale.
      Nato dall'esperienza reale, non dalla teoria accademica.
    </p>

    {/* CTAs */}
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
      <a
        href="/course"
        class="w-full sm:w-auto px-8 py-4 bg-acid-yellow text-brand-dark font-bold text-lg rounded-full hover:bg-[#b3e600] transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(204,255,0,0.3)] flex items-center justify-center gap-2 font-ui"
      >
        Esplora il Corso
        <ArrowRight className="w-5 h-5" />
      </a>

      <a
        href="/perche-questo-corso"
        class="w-full sm:w-auto px-8 py-4 bg-transparent border border-white/20 text-white font-medium text-lg rounded-full hover:bg-white/5 hover:border-white/40 transition-all backdrop-blur-sm flex items-center justify-center font-ui"
      >
        Scopri perché è gratis
      </a>
    </div>

  </div>
</section>
