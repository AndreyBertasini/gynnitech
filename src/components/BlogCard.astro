---
interface Props {
  category: string;
  title: string;
  description: string;
  date: string;
  slug: string;
}

const { category, title, description, date, slug } = Astro.props;
---

<a href={`/blog/${slug}`} class="group block h-full">
  <article class="h-full min-h-[260px] flex flex-col p-6 rounded-2xl bg-white/5 border border-white/5 hover:border-neon-blue/50 hover:bg-white/10 transition-all hover:shadow-[0_0_20px_rgba(0,243,255,0.15)] hover:-translate-y-1 backdrop-blur-sm">
    <div class="flex items-center gap-2 mb-4">
      <span class="text-xs font-semibold text-neon-blue uppercase tracking-wider font-ui">{category}</span>
      <span class="w-1 h-1 rounded-full bg-slate-600"></span>
      <time class="text-xs text-slate-400 font-mono">{date}</time>
    </div>
    
    <h3 class="text-xl font-bold text-white mb-3 group-hover:text-neon-blue transition-colors line-clamp-2 font-heading tracking-tight">
      {title}
    </h3>
    
    <p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow line-clamp-3 font-sans">
      {description}
    </p>
    
    <div class="flex items-center text-sm font-medium text-white group-hover:text-neon-blue transition-colors mt-auto pt-4 border-t border-white/5 font-ui">
      Leggi articolo
      <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </article>
</a>
