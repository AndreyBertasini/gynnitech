---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const uniqueId = `pipeline-${Astro.url.pathname.replace(/[^a-z0-9]/gi, '-')}-${Math.random().toString(36).slice(2, 8)}`;
const strokeId = `${uniqueId}-stroke`;
const glowId = `${uniqueId}-glow`;

const pipelineNodes = [
  { label: 'Fonti', detail: 'DB / file / API / news', x: 52, y: 96 },
  { label: 'Ingestion', detail: 'pipeline dati', x: 190, y: 96 },
  { label: 'Memoria', detail: 'OLAP + semantica', x: 338, y: 96 },
  { label: 'Orchestratore', detail: 'task decomposition', x: 506, y: 96 },
  { label: 'Subagenti', detail: 'paralleli', x: 682, y: 58 },
  { label: 'Validazione', detail: 'cross-check', x: 682, y: 134 },
  { label: 'Decisione', detail: 'human-in-the-loop', x: 852, y: 96 },
];
---

<svg class:list={['pipeline-svg', className]} viewBox="0 0 920 192" role="img" aria-label="Pipeline agentica da fonti dati a decisione validata">
  <defs>
    <linearGradient id={strokeId} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0%" stop-color="#ccff00" stop-opacity="0.32" />
      <stop offset="45%" stop-color="#ccff00" />
      <stop offset="100%" stop-color="#fbbf24" stop-opacity="0.9" />
    </linearGradient>
    <filter id={glowId} x="-20%" y="-80%" width="140%" height="260%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>
  <path class="pipeline-track" d="M98 96H148C166 96 170 96 190 96H288C315 96 315 96 338 96H450C474 96 478 96 506 96H590C620 96 626 58 656 58H682" />
  <path class="pipeline-track" d="M590 96C620 96 626 134 656 134H682" />
  <path class="pipeline-track" d="M708 58C764 58 776 96 824 96H852" />
  <path class="pipeline-track" d="M708 134C764 134 776 96 824 96H852" />
  <path class="pipeline-pulse" style={`stroke: url(#${strokeId}); filter: url(#${glowId});`} d="M98 96H148C166 96 170 96 190 96H288C315 96 315 96 338 96H450C474 96 478 96 506 96H590C620 96 626 58 656 58H682" />
  <path class="pipeline-pulse delayed" style={`stroke: url(#${strokeId}); filter: url(#${glowId});`} d="M590 96C620 96 626 134 656 134H682C764 134 776 96 824 96H852" />
  {pipelineNodes.map((node) => (
    <g class="pipeline-node" style={`filter: url(#${glowId});`}>
      <circle cx={node.x} cy={node.y} r="7" />
      <rect x={node.x - 44} y={node.y - 28} width="88" height="56" rx="10" />
      <text x={node.x} y={node.y - 3} text-anchor="middle">{node.label}</text>
      <text class="node-detail" x={node.x} y={node.y + 15} text-anchor="middle">{node.detail}</text>
    </g>
  ))}
</svg>
