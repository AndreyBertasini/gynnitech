---
import { BOOKING_URL } from '../consts';
import { ArrowRight } from 'lucide-react';
---

<div class="course-cta">
  <div class="course-cta-body">
    <span class="course-cta-kicker">Consulenza Analytics Engineering &amp; ClickHouse Certified</span>
    <p class="course-cta-text">
      Devi portare questa architettura in produzione, ridurre i costi BigQuery/PostgreSQL o progettare pipeline su{' '}
      <a href="/consulenza/clickhouse" class="underline decoration-accent/60 underline-offset-4 hover:text-accent">ClickHouse</a>{' '}
      e{' '}
      <a href="/consulting" class="underline decoration-accent/60 underline-offset-4 hover:text-accent">dbt</a>? Confrontati con un ClickHouse Certified Developer.
    </p>
  </div>
  <a href={BOOKING_URL} class="course-cta-button" rel="noopener">
    Prenota una call
    <ArrowRight className="w-4 h-4" />
  </a>
</div>
