---
import { ArrowRight } from 'lucide-react';
---

<section class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden">
  {/* Background Effects */}
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-mint-500/20 blur-[120px] rounded-full opacity-30 pointer-events-none"></div>
  
  <div class="container mx-auto px-6 relative z-10 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-mint-500/10 border border-mint-500/20 text-mint-400 text-sm font-medium mb-8">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-mint-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-mint-500"></span>
      </span>
      v1.0 is now available
    </div>
    
    <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6 leading-tight max-w-4xl mx-auto">
      The documentation <br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-mint-300 to-mint-500">you've always wanted</span>
    </h1>
    
    <p class="text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
      Beautiful out of the box, easy to maintain, and optimized for user engagement. Built for the intelligence age.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/docs/introduction" class="w-full sm:w-auto px-8 py-4 bg-mint-500 hover:bg-mint-400 text-brand-dark font-bold rounded-full transition-all shadow-[0_0_20px_rgba(61,177,134,0.4)] hover:shadow-[0_0_30px_rgba(61,177,134,0.6)] flex items-center justify-center gap-2">
        Get Started
        <ArrowRight class="w-5 h-5" />
      </a>
      <a href="#" class="w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-full border border-white/10 transition-all backdrop-blur-sm">
        Book a Demo
      </a>
    </div>

    {/* Abstract Visual / Code Preview */}
    <div class="mt-20 relative mx-auto max-w-5xl rounded-xl border border-white/10 bg-brand-darker shadow-2xl overflow-hidden group hover:border-mint-500/30 transition-colors duration-500">
        <div class="absolute inset-0 bg-gradient-to-b from-mint-500/5 to-transparent pointer-events-none"></div>
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-white/5">
            <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/50"></div>
        </div>
        <div class="p-8 font-mono text-sm text-left overflow-x-auto">
            <div class="flex">
                <div class="text-slate-600 select-none pr-4 text-right border-r border-white/10 mr-4">
                    1<br/>2<br/>3<br/>4<br/>5<br/>6<br/>7
                </div>
                <div class="text-slate-300">
                    <span class="text-purple-400">import</span> <span class="text-yellow-300">{`{ Meta }`}</span> <span class="text-purple-400">from</span> <span class="text-green-400">'@mintlify/components'</span>;<br/><br/>
                    <span class="text-purple-400">export const</span> <span class="text-blue-400">metadata</span> = <span class="text-yellow-300">{`{`}</span><br/>
                    &nbsp;&nbsp;<span class="text-blue-300">title</span>: <span class="text-green-400">"Introduction"</span>,<br/>
                    &nbsp;&nbsp;<span class="text-blue-300">description</span>: <span class="text-green-400">"Welcome to the new era of documentation"</span>,<br/>
                    <span class="text-yellow-300">{`}`}</span>;<br/><br/>
                    <span class="text-slate-500">// Start building your docs in seconds</span>
                </div>
            </div>
        </div>
    </div>
  </div>
</section>
