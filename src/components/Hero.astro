---
import { ArrowRight } from 'lucide-react';
---

<section class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden">
  {/* Background Effects */}
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-neon-blue/20 blur-[150px] rounded-full opacity-30 pointer-events-none mix-blend-screen"></div>
  <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-neon-pink/10 blur-[150px] rounded-full opacity-30 pointer-events-none mix-blend-screen"></div>
  
  <div class="container mx-auto px-6 relative z-10 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-acid-yellow text-sm font-medium mb-8 backdrop-blur-sm shadow-[0_0_15px_rgba(204,255,0,0.1)]">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-acid-yellow opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-acid-yellow"></span>
      </span>
      Nuova Piattaforma v2.0
    </div>
    
    <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6 leading-tight max-w-4xl mx-auto font-audiowide">
      Data Intelligence <br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-blue via-neon-green to-acid-yellow text-glow">Next Gen</span>
    </h1>
    
    <p class="text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
      Domina i dati con corsi pratici, mentorship esperta e tecnologie all'avanguardia. 
      Il futuro dell'analytics è qui.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/course" class="w-full sm:w-auto px-8 py-4 bg-acid-yellow text-brand-dark font-bold rounded-full transition-all shadow-[0_0_20px_rgba(204,255,0,0.4)] hover:shadow-[0_0_30px_rgba(204,255,0,0.6)] hover:scale-105 flex items-center justify-center gap-2 font-orbitron">
        Inizia Ora
        <ArrowRight class="w-5 h-5" />
      </a>
      <a href="/consulting" class="w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-full border border-white/10 transition-all backdrop-blur-sm hover:border-neon-blue hover:shadow-[0_0_15px_rgba(0,243,255,0.3)] font-orbitron">
        Consulenza
      </a>
    </div>

    {/* Abstract Visual / Code Preview */}
    <div class="mt-20 relative mx-auto max-w-5xl rounded-xl border border-white/10 bg-brand-darker/80 shadow-2xl overflow-hidden group hover:border-neon-blue/50 transition-colors duration-500 backdrop-blur-xl">
        <div class="absolute inset-0 bg-gradient-to-b from-neon-blue/5 to-transparent pointer-events-none"></div>
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-white/5">
            <div class="w-3 h-3 rounded-full bg-neon-pink/80 shadow-[0_0_8px_rgba(255,0,255,0.5)]"></div>
            <div class="w-3 h-3 rounded-full bg-acid-yellow/80 shadow-[0_0_8px_rgba(204,255,0,0.5)]"></div>
            <div class="w-3 h-3 rounded-full bg-neon-green/80 shadow-[0_0_8px_rgba(57,255,20,0.5)]"></div>
        </div>
        <div class="p-8 font-mono text-sm text-left overflow-x-auto">
            <div class="flex">
                <div class="text-slate-600 select-none pr-4 text-right border-r border-white/10 mr-4 font-orbitron opacity-50">
                    1<br/>2<br/>3<br/>4<br/>5<br/>6<br/>7
                </div>
                <div class="text-slate-300">
                    <span class="text-neon-pink">import</span> <span class="text-acid-yellow">{`{ Analytics }`}</span> <span class="text-neon-pink">from</span> <span class="text-neon-green">'@ginnytech/core'</span>;<br/><br/>
                    <span class="text-neon-pink">export const</span> <span class="text-neon-blue">future</span> = <span class="text-acid-yellow">{`{`}</span><br/>
                    &nbsp;&nbsp;<span class="text-neon-blue">vision</span>: <span class="text-neon-green">"Data Driven Mastery"</span>,<br/>
                    &nbsp;&nbsp;<span class="text-neon-blue">stack</span>: <span class="text-neon-green">["ClickHouse", "dbt", "Python"]</span>,<br/>
                    <span class="text-acid-yellow">{`}`}</span>;<br/><br/>
                    <span class="text-slate-500">// Deploy your potential now...</span>
                </div>
            </div>
        </div>
    </div>
  </div>
</section>
