---
import { Github, Linkedin } from 'lucide-react';
---

<footer class="bg-brand-dark border-t border-white/10 pt-16 pb-8">
  <div class="container mx-auto px-6">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-white mb-6 font-orbitron">
          <div class="w-8 h-8 bg-brand-dark border border-white/10 rounded-lg flex items-center justify-center text-lg shadow-[0_0_15px_rgba(204,255,0,0.2)]">
            🍐
          </div>
          GinnyTech
        </a>
        <p class="text-slate-400 text-sm leading-relaxed">
          Progetto educativo open-source per imparare Data Analytics e Marketing Engineering. Creato da Andrii Dyshkantiuk.
        </p>
      </div>
      
      <div>
        <h4 class="font-bold text-white mb-6 font-audiowide tracking-wide text-glow-blue">Formazione</h4>
        <ul class="space-y-4 text-sm text-slate-400">
          <li><a href="/course" class="hover:text-neon-blue transition-colors hover:drop-shadow-[0_0_5px_rgba(0,243,255,0.5)]">Corso</a></li>
          <li><a href="/blog" class="hover:text-neon-blue transition-colors hover:drop-shadow-[0_0_5px_rgba(0,243,255,0.5)]">Blog</a></li>
          <li><a href="/consulting" class="hover:text-neon-blue transition-colors hover:drop-shadow-[0_0_5px_rgba(0,243,255,0.5)]">Consulenza</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-white mb-6 font-audiowide tracking-wide text-glow-pink">Risorse</h4>
        <ul class="space-y-4 text-sm text-slate-400">
          <li><a href="/course/data-collection/introduction/" class="hover:text-neon-pink transition-colors hover:drop-shadow-[0_0_5px_rgba(255,0,255,0.5)]">Documentazione</a></li>
          <li><a href="https://github.com/AndreyBertasini/gynnitech" target="_blank" rel="noreferrer" class="hover:text-neon-pink transition-colors hover:drop-shadow-[0_0_5px_rgba(255,0,255,0.5)]">GitHub</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-white mb-6 font-audiowide tracking-wide text-glow-yellow">Progetto</h4>
        <ul class="space-y-4 text-sm text-slate-400">
          <li><a href="/about" class="hover:text-acid-yellow transition-colors hover:drop-shadow-[0_0_5px_rgba(204,255,0,0.5)]">Chi Sono</a></li>
          <li><a href="/contact" class="hover:text-acid-yellow transition-colors hover:drop-shadow-[0_0_5px_rgba(204,255,0,0.5)]">Contatti</a></li>
          <li><a href="/privacy" class="hover:text-acid-yellow transition-colors hover:drop-shadow-[0_0_5px_rgba(204,255,0,0.5)]">Privacy</a></li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-slate-500 text-sm">© {new Date().getFullYear()} GinnyTech — Progetto open-source di <a href="https://www.linkedin.com/in/andrii-dyshkantiuk/" target="_blank" rel="noreferrer" class="text-slate-400 hover:text-white transition-colors">Andrii Dyshkantiuk</a></p>
      <div class="flex items-center gap-6">
        <a href="https://github.com/AndreyBertasini/gynnitech" target="_blank" rel="noreferrer" class="text-slate-500 hover:text-white transition-colors"><Github className="w-5 h-5" /></a>
        <a href="https://www.linkedin.com/in/andrii-dyshkantiuk/" target="_blank" rel="noreferrer" class="text-slate-500 hover:text-white transition-colors"><Linkedin className="w-5 h-5" /></a>
      </div>
    </div>
  </div>
</footer>
