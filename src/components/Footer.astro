---
import { ArrowUpRight } from 'lucide-react';
import { CookieIcon } from '@radix-ui/react-icons';
import { BOOKING_URL, GITHUB_REPO_URL, LINKEDIN_URL } from '../consts';
---

<footer class="bg-[var(--sl-color-bg)] border-t border-white/[0.06] relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    {/* Main Footer Grid */}
    <div class="py-16 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
      {/* Brand Column */}
      <div class="md:col-span-4">
        <a href="/" class="inline-flex items-center gap-2.5 font-bold text-xl text-white mb-5 font-heading group">
          <div class="w-9 h-9 bg-[var(--sl-color-bg)] border border-white/10 rounded-xl flex items-center justify-center text-lg shadow-[0_0_15px_rgba(204,255,0,0.15)] group-hover:shadow-[0_0_20px_rgba(204,255,0,0.3)] transition-shadow">
            <CookieIcon className="w-5 h-5 text-[var(--color-accent)] drop-shadow-[0_0_5px_rgba(204,255,0,0.5)]" />
          </div>
          GinnyTech
        </a>
        <p class="text-slate-500 text-sm leading-relaxed max-w-xs mb-6">
          Percorso gratuito di <span class="text-slate-400">Andrii Dyshkantiuk</span> per imparare dati, marketing engineering e decisioni con strumenti reali.
        </p>
        <div class="flex items-center gap-3">
          <a href={GITHUB_REPO_URL} target="_blank" rel="noreferrer" aria-label="GitHub" class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-slate-500 hover:text-white hover:border-white/20 hover:bg-white/[0.08] transition">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="w-4.5 h-4.5 fill-current">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.42-4.04-1.42-.55-1.38-1.33-1.74-1.33-1.74-1.09-.74.09-.73.09-.73 1.2.08 1.84 1.24 1.84 1.24 1.08 1.83 2.83 1.3 3.52.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.32-5.47-5.86 0-1.29.47-2.34 1.23-3.16-.12-.3-.53-1.54.12-3.2 0 0 1-.32 3.3 1.2a11.5 11.5 0 0 1 6.01 0c2.29-1.52 3.29-1.2 3.29-1.2.65 1.66.24 2.9.12 3.2.77.82 1.23 1.87 1.23 3.16 0 4.55-2.8 5.56-5.48 5.86.43.37.81 1.09.81 2.2v3.26c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z" />
            </svg>
          </a>
          <a href={LINKEDIN_URL} target="_blank" rel="noreferrer" aria-label="LinkedIn" class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-slate-500 hover:text-accent hover:border-accent/20 hover:bg-accent/[0.05] transition">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="w-4.5 h-4.5 fill-current">
              <path d="M4.98 3.5a2.48 2.48 0 1 0 0 4.96 2.48 2.48 0 0 0 0-4.96ZM2.75 9h4.46v12H2.75V9Zm7.01 0h4.27v1.64h.06c.59-1.12 2.04-2.3 4.2-2.3 4.49 0 5.31 2.96 5.31 6.8V21h-4.45v-5.16c0-1.23-.02-2.8-1.71-2.8-1.71 0-1.97 1.33-1.97 2.71V21H9.76V9Z" />
            </svg>
          </a>
        </div>
      </div>

      {/* Links Columns */}
      <div class="md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-5">Formazione</h4>
        <ul class="space-y-3">
          <li><a href="/#corsi" class="text-sm text-slate-500 hover:text-white transition-colors">Corso gratuito</a></li>
          <li><a href="/course/learning-path" class="text-sm text-slate-500 hover:text-white transition-colors">Learning path</a></li>
          <li><a href="/blog" class="text-sm text-slate-500 hover:text-white transition-colors">Articoli</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-5">Risorse</h4>
        <ul class="space-y-3">
          <li><a href="/perche-questo-corso" class="text-sm text-slate-500 hover:text-white transition-colors">Perché questo corso</a></li>
          <li><a href="/glossario" class="text-sm text-slate-500 hover:text-white transition-colors">Glossario</a></li>
          <li><a href={GITHUB_REPO_URL + '/issues'} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-white transition-colors">Correzioni <ArrowUpRight className="w-3 h-3" /></a></li>
          <li><a href="/privacy" class="text-sm text-slate-500 hover:text-white transition-colors">Privacy</a></li>
          <li><a href="/cookie-policy" class="text-sm text-slate-500 hover:text-white transition-colors">Cookie policy</a></li>
          <li><a href="/gdpr" class="text-sm text-slate-500 hover:text-white transition-colors">GDPR e diritti</a></li>
          <li>
            <button type="button" data-cookie-preferences class="text-left text-sm text-slate-500 hover:text-white transition-colors">
              Preferenze cookie
            </button>
          </li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-5">Progetto</h4>
        <ul class="space-y-3">
          <li><a href="/about" class="text-sm text-slate-500 hover:text-white transition-colors">Chi sono</a></li>
          <li><a href="/agenti-analisi-dati" class="text-sm text-slate-500 hover:text-white transition-colors">Agenti AI</a></li>
          <li><a href="/consulting" class="text-sm text-slate-500 hover:text-white transition-colors">Consulenza</a></li>
          <li>
            <a href={GITHUB_REPO_URL} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-white transition-colors">
              GitHub <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
          <li><a href="/contact" class="text-sm text-slate-500 hover:text-white transition-colors">Contatti</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-5">Contatti</h4>
        <ul class="space-y-3">
          <li>
            <a href={BOOKING_URL} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-accent transition-colors">
              Prenota una call <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
          <li>
            <a href={LINKEDIN_URL} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-accent transition-colors">
              LinkedIn <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="border-t border-white/[0.06] py-6 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-slate-600 text-xs">
        &copy; {new Date().getFullYear()} GinnyTech - Creato da <a href={LINKEDIN_URL} target="_blank" rel="noreferrer" class="text-slate-500 hover:text-white transition-colors">Andrii Dyshkantiuk</a>
      </p>
      <p class="text-slate-600 text-xs">
        Open-source su <a href={GITHUB_REPO_URL} target="_blank" rel="noreferrer" class="text-slate-500 hover:text-white transition-colors">GitHub</a>
      </p>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('click', function (event) {
      var target = event.target instanceof Element ? event.target.closest('[data-cookie-preferences]') : null;
      if (!target) return;
      event.preventDefault();
      window.dispatchEvent(new CustomEvent('ginnytech:open-cookie-preferences'));
    });
  </script>
</footer>
