---
import { Github, Twitter, Linkedin } from 'lucide-react';
---

<footer class="bg-brand-dark border-t border-white/10 pt-16 pb-8">
  <div class="container mx-auto px-6">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-white mb-6">
          <div class="w-8 h-8 bg-mint-500 rounded-lg flex items-center justify-center text-white font-bold">
            M
          </div>
          Mintlify
        </a>
        <p class="text-slate-400 text-sm leading-relaxed">
          The continuous documentation platform. Beautiful out of the box, easy to maintain, and optimized for user engagement.
        </p>
      </div>
      
      <div>
        <h4 class="font-bold text-white mb-6">Product</h4>
        <ul class="space-y-4 text-sm text-slate-400">
          <li><a href="#" class="hover:text-mint-400 transition-colors">Documentation</a></li>
          <li><a href="#" class="hover:text-mint-400 transition-colors">Analytics</a></li>
          <li><a href="#" class="hover:text-mint-400 transition-colors">AI Search</a></li>
          <li><a href="#" class="hover:text-mint-400 transition-colors">Customization</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-white mb-6">Resources</h4>
        <ul class="space-y-4 text-sm text-slate-400">
          <li><a href="/docs" class="hover:text-mint-400 transition-colors">Docs</a></li>
          <li><a href="/blog" class="hover:text-mint-400 transition-colors">Blog</a></li>
          <li><a href="#" class="hover:text-mint-400 transition-colors">Community</a></li>
          <li><a href="#" class="hover:text-mint-400 transition-colors">Showcase</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-white mb-6">Company</h4>
        <ul class="space-y-4 text-sm text-slate-400">
          <li><a href="#" class="hover:text-mint-400 transition-colors">About</a></li>
          <li><a href="#" class="hover:text-mint-400 transition-colors">Careers</a></li>
          <li><a href="#" class="hover:text-mint-400 transition-colors">Contact</a></li>
          <li><a href="#" class="hover:text-mint-400 transition-colors">Privacy</a></li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-slate-500 text-sm">© {new Date().getFullYear()} Mintlify, Inc. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-slate-500 hover:text-white transition-colors"><Twitter className="w-5 h-5" /></a>
        <a href="#" class="text-slate-500 hover:text-white transition-colors"><Github className="w-5 h-5" /></a>
        <a href="#" class="text-slate-500 hover:text-white transition-colors"><Linkedin className="w-5 h-5" /></a>
      </div>
    </div>
  </div>
</footer>
