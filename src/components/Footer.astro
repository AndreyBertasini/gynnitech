---
import { Github, Linkedin, ArrowUpRight } from 'lucide-react';
import { CookieIcon } from '@radix-ui/react-icons';
---

<footer class="bg-brand-darker border-t border-white/[0.06] relative overflow-hidden">
  {/* Subtle background glow */}
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-acid-yellow/[0.02] rounded-full blur-[150px] pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    {/* Main Footer Grid */}
    <div class="py-16 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
      {/* Brand Column */}
      <div class="md:col-span-4">
        <a href="/" class="inline-flex items-center gap-2.5 font-bold text-xl text-white mb-5 font-heading group">
          <div class="w-9 h-9 bg-brand-dark border border-white/10 rounded-xl flex items-center justify-center text-lg shadow-[0_0_15px_rgba(204,255,0,0.15)] group-hover:shadow-[0_0_20px_rgba(204,255,0,0.3)] transition-shadow">
            <CookieIcon className="w-5 h-5 text-[#ccff00] drop-shadow-[0_0_5px_rgba(204,255,0,0.5)]" />
          </div>
          GinnyTech
        </a>
        <p class="text-slate-500 text-sm leading-relaxed max-w-xs mb-6">
          Progetto educativo open-source per imparare Data Analytics e Marketing Engineering con strumenti reali.
        </p>
        <div class="flex items-center gap-3">
          <a href="https://github.com/AndreyBertasini/gynnitech" target="_blank" rel="noreferrer" aria-label="GitHub" class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-slate-500 hover:text-white hover:border-white/20 hover:bg-white/[0.08] transition-all">
            <Github className="w-4.5 h-4.5" />
          </a>
          <a href="https://www.linkedin.com/in/andrii-dyshkantiuk/" target="_blank" rel="noreferrer" aria-label="LinkedIn" class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-slate-500 hover:text-neon-blue hover:border-neon-blue/20 hover:bg-neon-blue/[0.05] transition-all">
            <Linkedin className="w-4.5 h-4.5" />
          </a>
        </div>
      </div>

      {/* Links Columns */}
      <div class="md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-5">Formazione</h4>
        <ul class="space-y-3">
          <li><a href="/course" class="text-sm text-slate-500 hover:text-white transition-colors">Corso</a></li>
          <li><a href="/blog" class="text-sm text-slate-500 hover:text-white transition-colors">Blog</a></li>
          <li><a href="/course/data-collection/introduction/" class="text-sm text-slate-500 hover:text-white transition-colors">Prima lezione</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-5">Risorse</h4>
        <ul class="space-y-3">
          <li><a href="/perche-questo-corso" class="text-sm text-slate-500 hover:text-white transition-colors">Informazioni</a></li>
          <li><a href="/course/data-collection/introduction/" class="text-sm text-slate-500 hover:text-white transition-colors">Documentazione</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-5">Progetto</h4>
        <ul class="space-y-3">
          <li><a href="/about" class="text-sm text-slate-500 hover:text-white transition-colors">Chi Sono</a></li>
          <li>
            <a href="https://github.com/AndreyBertasini/gynnitech" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-white transition-colors">
              GitHub <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
          <li><a href="/contact" class="text-sm text-slate-500 hover:text-white transition-colors">Contatti</a></li>
          <li><a href="/privacy" class="text-sm text-slate-500 hover:text-white transition-colors">Privacy</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-5">Contatti</h4>
        <ul class="space-y-3">
          <li>
            <a href="https://tidycal.com/andriidyshkantiuk/15-minute-meeting" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-acid-yellow transition-colors">
              Prenota una call <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/andrii-dyshkantiuk/" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-neon-blue transition-colors">
              LinkedIn <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="border-t border-white/[0.06] py-6 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-slate-600 text-xs">
        &copy; {new Date().getFullYear()} GinnyTech — Creato da <a href="https://www.linkedin.com/in/andrii-dyshkantiuk/" target="_blank" rel="noreferrer" class="text-slate-500 hover:text-white transition-colors">Andrii Dyshkantiuk</a>
      </p>
      <p class="text-slate-600 text-xs">
        Open-source su <a href="https://github.com/AndreyBertasini/gynnitech" target="_blank" rel="noreferrer" class="text-slate-500 hover:text-white transition-colors">GitHub</a>
      </p>
    </div>
  </div>
</footer>
