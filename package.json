{
  "name": "ginnytech",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "npm run llms:full && astro build && npm run translate:static && npm run normalize:redirects && npm run normalize:links && npm run index:search && npm run audit:site",
    "preview": "astro preview",
    "astro": "astro",
    "validate:content": "tsx scripts/validation.ts",
    "validate:articolo": "tsx scripts/validate-lezioni-articolo.ts",
    "validate:v2": "tsx scripts/validate-lezioni-v2.ts",
    "check:mdx": "tsx scripts/check-mdx.ts",
    "pipeline:lezioni": "tsx scripts/pipeline-lezioni.ts",
    "publish:pass": "tsx scripts/publish-pass.ts",
    "translate:static": "tsx scripts/translate-static-en.ts",
    "normalize:redirects": "tsx scripts/normalize-redirect-html.ts",
    "normalize:links": "tsx scripts/normalize-internal-links.ts",
    "index:search": "pagefind --site dist --include-characters \"/#_+\"",
    "llms:full": "tsx scripts/generate-llms-full.ts",
    "snapshot:site": "tsx scripts/snapshot-site.ts",
    "audit:site": "tsx scripts/site-quality-audit.ts",
    "test": "vitest run",
    "check": "npm run validate:content && npm run validate:articolo && npm run validate:v2 && npm run check:mdx && astro check && npm run test",
    "release:course-v2": "python .codex/skills/course-editorial-system/scripts/course_catalog.py audit --repo-root . && npm run check && npm run build",
    "deploy:cloudflare": "npx wrangler pages deploy dist --project-name gynnitech --branch main --commit-dirty=true",
    "publish:course-v2": "npm run release:course-v2 && npm run deploy:cloudflare",
    "generate:article-covers": "node scripts/generate-article-covers.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/astro": "^10.60.0",
    "@spotlightjs/astro": "^3.2.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.3.8",
    "astro-mermaid": "^2.1.0",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
