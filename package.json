{
  "name": "ginnytech",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build && npm run translate:static && npm run index:search && npm run audit:site",
    "preview": "astro preview",
    "astro": "astro",
    "validate:content": "tsx scripts/validation.ts",
    "translate:static": "tsx scripts/translate-static-en.ts",
    "index:search": "pagefind --site dist --include-characters \"/#_+\"",
    "audit:site": "tsx scripts/site-quality-audit.ts",
    "test": "vitest run",
    "check": "npm run validate:content && astro check && npm run test",
    "release:course-v2": "python .codex/skills/course-editorial-system/scripts/course_catalog.py audit --repo-root . && npm run check && npm run build",
    "deploy:cloudflare": "npx wrangler pages deploy dist --project-name gynnitech --branch main --commit-dirty=true",
    "publish:course-v2": "npm run release:course-v2 && npm run deploy:cloudflare",
    "generate:article-covers": "node scripts/generate-article-covers.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.39.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/astro": "^10.55.0",
    "@spotlightjs/astro": "^3.2.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.2",
    "astro-mermaid": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.14.1",
    "starlight-image-zoom": "^0.14.2",
    "starlight-links-validator": "^0.24.0",
    "starlight-scroll-to-top": "^1.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "dotenv": "^17.3.1",
    "glob": "^13.0.3",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.4.0",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "^2.9.0"
    }
  }
}
