    "starlight-links-validator": "^0.24.1",
    "starlight-scroll-to-top": "^1.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "dotenv": "^17.3.1",
    "glob": "^13.0.3",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "hast-util-select": "^6.0.4",
    "pagefind": "^1.5.2",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
