{
  "name": "gynnitech-cms",
  "version": "1.0.0",
  "description": "Payload CMS backend for GinnyTech — deployed on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "cf:build": "next build && npx @opennextjs/cloudflare build",
    "cf:preview": "next build && npx @opennextjs/cloudflare build && wrangler dev",
    "cf:deploy": "next build && npx @opennextjs/cloudflare build && wrangler deploy",
    "cf:db:create": "wrangler d1 create gynnitech-cms-db",
    "cf:db:migrate": "wrangler d1 migrations apply gynnitech-cms-db --remote",
    "cf:db:migrate:local": "wrangler d1 migrations apply gynnitech-cms-db --local"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.78.0",
    "@payloadcms/next": "3.78.0",
    "@payloadcms/richtext-lexical": "3.78.0",
    "@payloadcms/storage-r2": "3.78.0",
    "graphql": "16.9.0",
    "next": "~15.4.11",
    "payload": "3.78.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@opennextjs/cloudflare": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
