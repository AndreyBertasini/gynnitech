# ──────────────────────────────────────────────────────────
# Payload CMS — Environment Variables (sviluppo locale)
# Copia in .env e compila i valori reali.
# In produzione su Cloudflare usa: wrangler secret put NOME_VARIABILE
# ──────────────────────────────────────────────────────────

# Segreto JWT (genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PAYLOAD_SECRET=cambia-questo-con-stringa-random-sicura

# Database locale SQLite (solo dev — in prod usa Cloudflare D1 via wrangler binding)
DATABASE_URI=file:./dev.db

# URL pubblico di questo server Payload (senza trailing slash)
# Dev locale:
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Produzione Workers:
# NEXT_PUBLIC_SERVER_URL=https://gynnitech-cms.NOME-ACCOUNT.workers.dev
# Con dominio custom:
# NEXT_PUBLIC_SERVER_URL=https://cms.ginnytech.it

# URL del sito Astro (per CORS)
ASTRO_SITE_URL=http://localhost:3000
# Produzione: ASTRO_SITE_URL=https://ginnytech.it

# ── Cloudflare R2 (per upload media) ─────────────────────
# Crea un API Token R2 su: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Usa "Object Read & Write" sul bucket gynnitech-cms-media

# Endpoint R2 del tuo account: https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=https://TUO-ACCOUNT-ID.r2.cloudflarestorage.com

R2_BUCKET=gynnitech-cms-media
R2_ACCESS_KEY_ID=il-tuo-r2-access-key-id
R2_SECRET_ACCESS_KEY=il-tuo-r2-secret-access-key

# ── Cloudflare Pages Deploy Hook (per rebuild Astro automatico) ───────────────
# Ottieni da: Cloudflare Dashboard → Pages → gynnitech → Settings → Deploy Hooks
CLOUDFLARE_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/IL-TUO-HOOK
